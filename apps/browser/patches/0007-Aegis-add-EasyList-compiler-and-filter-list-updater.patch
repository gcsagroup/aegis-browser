@@ -161,6 +167,7 @@ void RendererUpdater::InitializeRenderer(
       std::move(bound_session_request_throttled_handler));
 
   renderer_configuration->SetConfiguration(CreateRendererDynamicParams());
+  PushAegisFilterListTo(renderer_configuration);
 }
 
 RendererUpdater::RendererConfigurations
@@ -237,6 +244,30 @@ void RendererUpdater::UpdateAllRenderers() {
   }
 }
 
+void RendererUpdater::PushAegisFilterList() {
+  auto renderer_configurations = GetRendererConfigurations();
+  for (auto& renderer_configuration : renderer_configurations) {
+    content::RenderProcessHost* render_process_host =
+        renderer_configuration.first;
+    if (!render_process_host->IsInitializedAndNotDead()) {
+      continue;
+    }
+    PushAegisFilterListTo(renderer_configuration.second);
+  }
+}
+
+void RendererUpdater::PushAegisFilterListTo(
+    mojo::AssociatedRemote<chrome::mojom::RendererConfiguration>& remote) {
+  if (!remote) {
+    return;
+  }
+  const aegis::CompiledFilterList list =
+      aegis::FilterListMatcher::GetInstance()->CurrentList();
+  remote->SetAegisFilterList(aegis::JoinNewline(list.hosts),
+                             aegis::JoinNewline(list.path_rules),
+                             aegis::JoinNewline(list.exceptions));
+}
