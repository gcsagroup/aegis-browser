From 021633e5b3ab6a11c23822cdee7d10cf644c0a12 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Tue, 17 Nov 2026 15:32:47 +0800
Subject: [PATCH] test(mac): verify AIM presentation after hidden input

Use the product popup state manager and settled native activation for
AIM first show and reopen. Check input delivery and require successful
native presentation in both classic and Full popup modes.
---
 .../omnibox_popup_visibility_browsertest.cc   | 76 +++++++++++++++++++
 1 file changed, 76 insertions(+)

diff --git a/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc b/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc
index aee0b252564684e283b94148ad78d3e7c2a0172b..f16830ff248bae22dbaf0228f22d7ce8c76a25be 100644
--- a/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc
+++ b/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc
@@ -2,8 +2,13 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
 
+#include "base/functional/callback_helpers.h"
+#include "base/run_loop.h"
+#include "base/test/run_until.h"
 #include "base/test/scoped_feature_list.h"
+#include "chrome/browser/ui/omnibox/omnibox_controller.h"
 #include "chrome/browser/ui/omnibox/omnibox_next_features.h"
+#include "chrome/browser/ui/omnibox/omnibox_popup_state_manager.h"
 #include "chrome/browser/ui/views/frame/browser_view.h"
 #include "chrome/browser/ui/views/location_bar/location_bar_view.h"
 #include "chrome/browser/ui/views/omnibox/omnibox_popup_aim_presenter.h"
@@ -13,10 +18,13 @@
 #include "chrome/browser/ui/views/toolbar/toolbar_view.h"
 #include "chrome/test/base/in_process_browser_test.h"
 #include "components/omnibox/common/omnibox_features.h"
+#include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/visibility.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/test/browser_test.h"
 #include "content/public/test/browser_test_utils.h"
+#include "ui/compositor/compositor.h"
+#include "ui/views/widget/widget.h"
 
 class OmniboxPopupVisibilityBrowserTest
     : public InProcessBrowserTest,
@@ -86,6 +94,74 @@ IN_PROC_BROWSER_TEST_P(OmniboxPopupVisibilityBrowserTest,
   }
 }
 
+IN_PROC_BROWSER_TEST_P(OmniboxPopupVisibilityBrowserTest,
+                       UnshownAimInputCanPresentAndReopen) {
+  auto* location_bar = BrowserView::GetBrowserViewForBrowser(browser())
+                           ->toolbar()
+                           ->location_bar_view();
+  ASSERT_TRUE(location_bar);
+  auto* aim = location_bar->GetOmniboxPopupAimPresenter();
+  ASSERT_TRUE(aim);
+  ASSERT_TRUE(aim->GetWebUIContent());
+  auto* contents = aim->GetWebUIContent()->GetWrappedWebContents();
+  ASSERT_TRUE(contents);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  EXPECT_FALSE(aim->IsShown());
+  EXPECT_EQ(content::Visibility::HIDDEN, contents->GetVisibility());
+  content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(contents);
+  ASSERT_TRUE(content::ExecJs(contents, R"JS(
+    const input = document.createElement('input');
+    input.id = 'presentation-input';
+    document.body.appendChild(input);
+    input.focus();
+  )JS"));
+
+  // Exercise pending input-timing work before the pre-warmed native popup has
+  // ever presented, then require successful presentation on its first show.
+  for (int key = 0; key < 3; ++key) {
+    SCOPED_TRACE(key);
+    content::SimulateCharTyped(contents, u'a');
+    ASSERT_EQ(true, content::EvalJs(contents, R"JS(
+      new Promise(resolve => setTimeout(() => resolve(true), 0))
+    )JS"));
+    ASSERT_EQ(key + 1, content::EvalJs(contents, R"JS(
+      document.querySelector('#presentation-input').value.length
+    )JS"));
+    ASSERT_TRUE(contents->GetPrimaryMainFrame()->IsRenderFrameLive());
+  }
+
+  for (int show = 0; show < 2; ++show) {
+    SCOPED_TRACE(show);
+    auto* browser_widget =
+        BrowserView::GetBrowserViewForBrowser(browser())->GetWidget();
+    ASSERT_TRUE(browser_widget);
+    browser_widget->Activate();
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return browser_widget->IsActive(); }));
+    ASSERT_TRUE(base::test::RunUntil(
+        [&]() { return !location_bar->in_popup_state_transition(); }));
+    location_bar->GetOmniboxController()->popup_state_manager()->SetPopupState(
+        OmniboxPopupState::kAim);
+    ASSERT_TRUE(aim->IsShown());
+    ASSERT_TRUE(aim->GetWidget());
+    ASSERT_TRUE(aim->GetWidget()->GetCompositor());
+    base::RunLoop presented;
+    aim->GetWidget()
+        ->GetCompositor()
+        ->RequestSuccessfulPresentationTimeForNextFrame(
+            base::BindOnce(base::IgnoreArgs<const viz::FrameTimingDetails&>(
+                presented.QuitClosure())));
+    aim->GetWidget()->GetCompositor()->ScheduleFullRedraw();
+    presented.Run();
+    EXPECT_EQ(content::Visibility::VISIBLE, contents->GetVisibility());
+
+    location_bar->GetOmniboxController()->popup_state_manager()->SetPopupState(
+        OmniboxPopupState::kNone);
+    EXPECT_FALSE(aim->IsShown());
+    EXPECT_EQ(content::Visibility::HIDDEN, contents->GetVisibility());
+  }
+}
+
 INSTANTIATE_TEST_SUITE_P(AllPopupModes,
                          OmniboxPopupVisibilityBrowserTest,
                          testing::Bool());
