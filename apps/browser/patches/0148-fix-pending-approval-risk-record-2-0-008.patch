 chrome/browser/aegis/agent/aegis_agent_service.cc  | 2 ++
 chrome/browser/ui/webui/help/aegis_github_update.h | 6 +++---
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/aegis/agent/aegis_agent_service.cc b/chrome/browser/aegis/agent/aegis_agent_service.cc
index 9551f82cb7..b0d93b846d 100644
--- a/chrome/browser/aegis/agent/aegis_agent_service.cc
+++ b/chrome/browser/aegis/agent/aegis_agent_service.cc
@@ -2692,6 +2692,8 @@ void AegisAgentService::ExecuteTool(
     if (decision.disposition ==
         AgentPolicyDisposition::kRequireActionApproval) {
       if (task && task->state() == AgentTaskState::kRunning) {
+        // 等待审批即记录实际风险；不消费预算，也不授予执行权限。
+        action_risks_[task_id][call.action_id] = decision.risk;
         Transition(task_id, AgentTaskState::kAwaitingActionApproval,
                    "exact action approval required");
       }
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 578b15309e..a7b48f251d 100644
