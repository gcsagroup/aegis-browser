From 0b4057f581e72fdfe82c7fd2f4b29747af83a0dd Mon Sep 17 00:00:00 2001
From: Aegis Development <development@example.invalid>
Date: Thu, 19 Nov 2026 11:15:08 +0800
Subject: [PATCH] fix: declare desktop screenshot dependency and mark
 macOS-only includes

---
 chrome/browser/ui/browser_command_controller.cc   | 3 ++-
 chrome/browser/ui/toolbar/BUILD.gn                | 2 ++
 chrome/browser/ui/webui/aegis/aegis_ui.cc         | 3 ++-
 chrome/browser/ui/webui/aegis/aegis_ui_handler.cc | 5 +++--
 4 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 05e47394d41b3f8c2821100a45a910ab886c46ac..70d6eba0ee1772b79fb8e0a8f3848765e4d41ec6 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -156,7 +156,8 @@
 #endif
 
 #if BUILDFLAG(IS_MAC)
-#include "chrome/browser/aegis/access/access_navigation_retry_tab_helper.h"
+// 下方停止加载命令的重试状态只在 macOS 读取，依赖随 is_mac 分支引入。
+#include "chrome/browser/aegis/access/access_navigation_retry_tab_helper.h"  // nogncheck
 #include "chrome/browser/ui/browser_commands_mac.h"
 #endif
 
diff --git a/chrome/browser/ui/toolbar/BUILD.gn b/chrome/browser/ui/toolbar/BUILD.gn
index 09bd207962983a8c99b8cf2bd20e09017f854784..8d6f4ef1295c7201bf6268f6bb717da712624c1e 100644
--- a/chrome/browser/ui/toolbar/BUILD.gn
+++ b/chrome/browser/ui/toolbar/BUILD.gn
@@ -131,6 +131,8 @@ source_set("impl") {
       "//chrome/browser:browser_process",
       "//chrome/browser:defaults",
       "//chrome/browser:global_features",
+      # 桌面菜单直接调用网页截图接口，仅实现目标需要链接 Aegis。
+      "//chrome/browser/aegis",
       "//chrome/browser/favicon",
       "//chrome/browser/feedback",
       "//chrome/browser/feedback:feedback_impl",
diff --git a/chrome/browser/ui/webui/aegis/aegis_ui.cc b/chrome/browser/ui/webui/aegis/aegis_ui.cc
index bd43980248e36c59a9a1cf7553526560727e1c3e..a6bb99632e21f93edc5e3e8aeb4037e66255fc7b 100644
--- a/chrome/browser/ui/webui/aegis/aegis_ui.cc
+++ b/chrome/browser/ui/webui/aegis/aegis_ui.cc
@@ -9,7 +9,8 @@
 #if BUILDFLAG(IS_MAC)
 #include "base/functional/bind.h"
 #include "base/memory/ref_counted_memory.h"
-#include "chrome/browser/aegis/access/access_build_channel.h"
+// 对应 BUILD.gn 的 is_mac 依赖；GN 的头文件扫描不会求值 BUILDFLAG。
+#include "chrome/browser/aegis/access/access_build_channel.h"  // nogncheck
 #endif
 #if !BUILDFLAG(IS_ANDROID)
 #include "chrome/browser/ui/webui/aegis/aegis_gesture_handler.h"
diff --git a/chrome/browser/ui/webui/aegis/aegis_ui_handler.cc b/chrome/browser/ui/webui/aegis/aegis_ui_handler.cc
index d8b5beb4d4fcdb5e677c412ddbd7c0f15a4068c5..02ca8316fc7c396f8630bb63e56356ee23e463c3 100644
--- a/chrome/browser/ui/webui/aegis/aegis_ui_handler.cc
+++ b/chrome/browser/ui/webui/aegis/aegis_ui_handler.cc
@@ -22,8 +22,9 @@
 #include "chrome/browser/aegis/aegis_service.h"
 #include "chrome/browser/aegis/aegis_service_factory.h"
 #if BUILDFLAG(IS_MAC)
-#include "chrome/browser/aegis/access/access_build_channel.h"
-#include "chrome/browser/aegis/access/access_options_service.h"
+// Access 选项桥仅在 macOS 构建，依赖在 BUILD.gn 的 is_mac 分支声明。
+#include "chrome/browser/aegis/access/access_build_channel.h"  // nogncheck
+#include "chrome/browser/aegis/access/access_options_service.h"  // nogncheck
 #include "chrome/browser/aegis/aegis_torrent_client.h"
 #endif
 #include "chrome/browser/aegis/agent/aegis_agent_service.h"
-- 
2.56.0.windows.4

