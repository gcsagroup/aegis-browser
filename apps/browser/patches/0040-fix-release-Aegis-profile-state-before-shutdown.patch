From b71d38d266377ae5d3123327bacd25341847c3ca Mon Sep 17 00:00:00 2001
From: MacBook Pro <lazy@MacBook-Pro.local>
Date: Tue, 25 Aug 2026 00:30:07 +0800
Subject: [PATCH] fix: release Aegis profile state before shutdown

---
 chrome/browser/aegis/aegis_service.cc | 47 +++++++++++++++++++++++++--
 chrome/browser/aegis/aegis_service.h  | 11 ++++++-
 2 files changed, 55 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/aegis/aegis_service.cc b/chrome/browser/aegis/aegis_service.cc
index 963323df6e..d8dae036f1 100644
--- a/chrome/browser/aegis/aegis_service.cc
+++ b/chrome/browser/aegis/aegis_service.cc
@@ -5,10 +5,11 @@
 
 #include <algorithm>
 
-#include "base/logging.h"
+#include "base/check.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback.h"
 #include "base/json/json_reader.h"
+#include "base/logging.h"
 #include "base/memory/singleton.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/time/time.h"
@@ -42,14 +43,22 @@ AegisService* AegisService::GetInstance() {
 AegisService::AegisService() = default;
 
 AegisService::~AegisService() {
-  CdpWsHook::SetClientCountCallback({});
+  ClearReporterCallbacks();
 }
 
 void AegisService::InitializeForProfile(Profile* profile) {
+  CHECK(profile);
   if (!IsEnabled()) {
     VLOG(1) << "Aegis disabled by feature flag";
     return;
   }
+  if (initialized_) {
+    if (profile_ == profile) {
+      return;
+    }
+    ShutdownForProfile();
+  }
+  profile_observation_.Observe(profile);
   prefs_ = profile->GetPrefs();
   profile_ = profile;
   initialized_ = true;
@@ -81,6 +90,33 @@ void AegisService::InitializeForProfile(Profile* profile) {
                                            : " (tracker blocking off)");
 }
 
+void AegisService::OnProfileWillBeDestroyed(Profile* profile) {
+  if (profile_ == profile) {
+    ShutdownForProfile();
+  }
+}
+
+void AegisService::ShutdownForProfile() {
+  profile_observation_.Reset();
+  host_receivers_.Clear();
+  ClearReporterCallbacks();
+  if (ai_control_) {
+    ai_control_->Stop();
+  }
+  ai_control_.reset();
+  ollama_.reset();
+  if (cookie_janitor_) {
+    cookie_janitor_->Stop();
+  }
+  cookie_janitor_.reset();
+  filter_list_updater_.reset();
+  privacy_events_.clear();
+  cdp_ws_clients_ = 0;
+  prefs_ = nullptr;
+  profile_ = nullptr;
+  initialized_ = false;
+}
+
 bool AegisService::IsEnabled() const {
   return base::FeatureList::IsEnabled(features::kAegisEnabled);
 }
@@ -425,6 +461,13 @@ void AegisService::InstallReporterCallbacks() {
       }));
 }
 
+void AegisService::ClearReporterCallbacks() {
+  BlockReporter::SetBlockedCallback({});
+  BlockReporter::SetReferrerCallback({});
+  BlockReporter::SetParamsCallback({});
+  CdpWsHook::SetClientCountCallback({});
+}
+
 namespace {
 
 std::string NormalizeLocale(const std::string& locale) {
diff --git a/chrome/browser/aegis/aegis_service.h b/chrome/browser/aegis/aegis_service.h
