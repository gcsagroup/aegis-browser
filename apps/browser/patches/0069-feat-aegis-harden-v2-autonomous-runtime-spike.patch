+TEST(AegisV2RuntimeSpikeTest, GoalRouterAcceptsExactAllowedEntry) {
+  auto runtime = Runtime();
+  EXPECT_EQ(runtime.RouteExplicitEntry(GURL("https://fixture.test/research")),
