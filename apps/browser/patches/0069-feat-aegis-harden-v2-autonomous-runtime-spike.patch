diff --git a/chrome/browser/aegis/agent/v2_runtime_spike.cc b/chrome/browser/aegis/agent/v2_runtime_spike.cc
index 0236484ba2..a3e3f08d98 100644
--- a/chrome/browser/aegis/agent/v2_runtime_spike.cc
+++ b/chrome/browser/aegis/agent/v2_runtime_spike.cc
@@ -10,7 +10,8 @@ namespace aegis::agent {
 
 bool V2DocumentBinding::IsValid() const {
   return !profile_id.empty() && !task_id.empty() && tab_id > 0 &&
-         !frame_token.empty() && !document_token.empty() && !origin.opaque();
+         !frame_token.empty() && !document_token.empty() && url.is_valid() &&
+         !origin.opaque() && origin == url::Origin::Create(url);
 }
 
 V2RuntimeSpike::V2RuntimeSpike(std::string profile_id,
@@ -34,6 +35,15 @@ GURL V2RuntimeSpike::BuildDiscoveryUrl(const GURL& search_endpoint,
   return net::AppendQueryParameter(search_endpoint, "q", goal);
 }
 
+GURL V2RuntimeSpike::RouteExplicitEntry(const GURL& entry_url) const {
+  if (stopped_ || !entry_url.SchemeIsHTTPOrHTTPS() ||
+      entry_url.has_username() || entry_url.has_password() ||
+      !AllowsOrigin(url::Origin::Create(entry_url))) {
+    return GURL();
+  }
+  return entry_url;
+}
+
 bool V2RuntimeSpike::AdoptOwnedTab(int32_t tab_id) {
   if (stopped_ || tab_id <= 0 || owned_tabs_.size() >= max_tabs_) {
     return false;
@@ -79,11 +89,32 @@ V2SpikeDecision V2RuntimeSpike::Authorize(const V2SpikeAction& action) {
   if (document == documents_.end() || document->second != action.binding) {
     return V2SpikeDecision::kStaleDocument;
   }
+  if (action.risk != V2SpikeRisk::kNone &&
+      action.tool != V2SpikeTool::kRequestHandoff) {
+    return V2SpikeDecision::kHandoffRequired;
+  }
+  std::string semantic_action_key = action.semantic_action_key;
+  if (action.tool == V2SpikeTool::kReadBookmarks) {
+    semantic_action_key = "native:read-bookmarks";
+  }
+  if (!semantic_action_key.empty() &&
+      consumed_semantic_action_keys_.contains(semantic_action_key)) {
+    return V2SpikeDecision::kDuplicateSemanticAction;
+  }
+  if ((action.tool == V2SpikeTool::kClick ||
+       action.tool == V2SpikeTool::kType) &&
+      semantic_action_key.empty()) {
+    return V2SpikeDecision::kToolDenied;
+  }
+  if (action.tool == V2SpikeTool::kComplete && !action.completion_verified) {
+    return V2SpikeDecision::kCompletionNotVerified;
+  }
   if (action.tool == V2SpikeTool::kReadBookmarks) {
     if (action.destination) {
       return V2SpikeDecision::kToolDenied;
     }
     consumed_action_ids_.insert(action.action_id);
+    consumed_semantic_action_keys_.insert(std::move(semantic_action_key));
     return V2SpikeDecision::kAllow;
   }
   if (action.tool == V2SpikeTool::kNavigate) {
@@ -93,10 +124,29 @@ V2SpikeDecision V2RuntimeSpike::Authorize(const V2SpikeAction& action) {
         !AllowsOrigin(url::Origin::Create(*action.destination))) {
       return V2SpikeDecision::kInvalidDestination;
     }
+    if (*action.destination == action.binding.url) {
+      return V2SpikeDecision::kNoOpNavigation;
+    }
+    for (const char* key :
+         {"to", "url", "redirect", "next", "continue", "return"}) {
+      std::string nested_value;
+      if (net::GetValueForKeyInQuery(*action.destination, key, &nested_value)) {
+        const GURL nested_destination(nested_value);
+        if (!nested_destination.SchemeIsHTTPOrHTTPS() ||
+            nested_destination.has_username() ||
+            nested_destination.has_password() ||
+            !AllowsOrigin(url::Origin::Create(nested_destination))) {
+          return V2SpikeDecision::kRedirectTargetDenied;
+        }
+      }
+    }
   } else if (action.destination) {
     return V2SpikeDecision::kToolDenied;
   }
   consumed_action_ids_.insert(action.action_id);
+  if (!semantic_action_key.empty()) {
+    consumed_semantic_action_keys_.insert(std::move(semantic_action_key));
+  }
   return V2SpikeDecision::kAllow;
 }
 
@@ -131,6 +181,7 @@ std::vector<int32_t> V2RuntimeSpike::Stop() {
   owned_tabs_.clear();
   documents_.clear();
   consumed_action_ids_.clear();
+  consumed_semantic_action_keys_.clear();
   dom_failed_documents_.clear();
   visual_fallback_documents_.clear();
   return owned_tabs;
