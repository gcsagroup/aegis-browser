 TEST(AegisV2RuntimeSpikeTest, BindsEveryActionToCurrentDocument) {
   auto runtime = Runtime();
   ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
   ASSERT_TRUE(runtime.CommitDocument(Binding()));
   V2SpikeAction action{.action_id = "action-1",
                        .tool = V2SpikeTool::kClick,
-                       .binding = Binding()};
+                       .binding = Binding(),
+                       .semantic_action_key = "tab-7:button-refresh"};
   EXPECT_EQ(runtime.Authorize(action), V2SpikeDecision::kAllow);
   action.action_id = "action-2";
   action.binding.document_token = "stale-document";
   EXPECT_EQ(runtime.Authorize(action), V2SpikeDecision::kStaleDocument);
 }
 
+TEST(AegisV2RuntimeSpikeTest, RejectsSemanticReplayAcrossDocumentChanges) {
+  auto runtime = Runtime();
+  ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
+  ASSERT_TRUE(runtime.CommitDocument(Binding()));
+  EXPECT_EQ(runtime.Authorize({.action_id = "first-click",
+                               .tool = V2SpikeTool::kClick,
+                               .binding = Binding(),
+                               .semantic_action_key = "tab-7:add-to-cart"}),
+            V2SpikeDecision::kAllow);
+  V2DocumentBinding changed = Binding("document-2");
+  ASSERT_TRUE(runtime.CommitDocument(changed));
+  EXPECT_EQ(runtime.Authorize({.action_id = "second-click",
+                               .tool = V2SpikeTool::kClick,
+                               .binding = changed,
+                               .semantic_action_key = "tab-7:add-to-cart"}),
+            V2SpikeDecision::kDuplicateSemanticAction);
+}
+
 TEST(AegisV2RuntimeSpikeTest, RejectsCrossProfileTabAndOpenRedirect) {
   auto runtime = Runtime();
   ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
@@ -68,6 +96,51 @@ TEST(AegisV2RuntimeSpikeTest, RejectsCrossProfileTabAndOpenRedirect) {
   EXPECT_EQ(runtime.Authorize(redirect), V2SpikeDecision::kInvalidDestination);
 }
 
+TEST(AegisV2RuntimeSpikeTest, RejectsNoOpAndNestedOpenRedirectNavigation) {
+  auto runtime = Runtime();
+  ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
+  ASSERT_TRUE(runtime.CommitDocument(Binding()));
+  EXPECT_EQ(runtime.Authorize({.action_id = "no-op",
+                               .tool = V2SpikeTool::kNavigate,
+                               .binding = Binding(),
+                               .destination = Binding().url}),
+            V2SpikeDecision::kNoOpNavigation);
+  EXPECT_EQ(
+      runtime.Authorize(
+          {.action_id = "nested-redirect",
+           .tool = V2SpikeTool::kNavigate,
+           .binding = Binding(),
+           .destination = GURL("https://fixture.test/"
+                               "redirect?to=https%3A%2F%2Foutside.test%2F")}),
+      V2SpikeDecision::kRedirectTargetDenied);
+}
+
+TEST(AegisV2RuntimeSpikeTest, CompletionAndSensitiveActionsHaveHardGates) {
+  auto runtime = Runtime();
+  ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
+  ASSERT_TRUE(runtime.CommitDocument(Binding()));
+  EXPECT_EQ(runtime.Authorize({.action_id = "early-complete",
+                               .tool = V2SpikeTool::kComplete,
+                               .binding = Binding()}),
+            V2SpikeDecision::kCompletionNotVerified);
+  EXPECT_EQ(runtime.Authorize({.action_id = "verified-complete",
+                               .tool = V2SpikeTool::kComplete,
+                               .binding = Binding(),
+                               .completion_verified = true}),
+            V2SpikeDecision::kAllow);
+  EXPECT_EQ(runtime.Authorize({.action_id = "purchase-click",
+                               .tool = V2SpikeTool::kClick,
+                               .binding = Binding(),
+                               .semantic_action_key = "tab-7:purchase",
+                               .risk = V2SpikeRisk::kFinalTransaction}),
+            V2SpikeDecision::kHandoffRequired);
+  EXPECT_EQ(runtime.Authorize({.action_id = "handoff",
+                               .tool = V2SpikeTool::kRequestHandoff,
+                               .binding = Binding(),
+                               .risk = V2SpikeRisk::kFinalTransaction}),
+            V2SpikeDecision::kAllow);
+}
