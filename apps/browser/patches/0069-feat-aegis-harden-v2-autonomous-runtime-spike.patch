   auto runtime = Runtime();
   ASSERT_TRUE(runtime.AdoptOwnedTab(kOwnedTab));
@@ -100,6 +173,10 @@ TEST(AegisV2RuntimeSpikeTest, NativeBookmarksAreReadOnly) {
