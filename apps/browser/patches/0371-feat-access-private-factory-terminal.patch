@@ -351,3 +351,25 @@ source_set("request_ownership_registry_test_support") {
     ":request_ownership_registry_unittests",
   ]
 }
+
+// Exercises the Browser-only terminal hook without changing factory security.
+test("access_terminal_factory_unittests") {
+  sources = [
+    "access_network_test_main.cc",
+    "access_terminal_factory_unittest.cc",
+    "//services/network/public/cpp/url_loader_factory_builder_unittest.cc",
+  ]
+  deps = [
+    "//base",
+    "//base/test:test_support",
+    "//mojo/core/embedder",
+    "//mojo/public/cpp/bindings",
+    "//net",
+    "//services/network:test_support",
+    "//services/network/public/cpp",
+    "//services/network/public/mojom",
+    "//testing/gmock",
+    "//testing/gtest",
+    "//url",
+  ]
+}
