+  for (int scenario : {0, 1, 2, 3}) {
+    AgentToolResult result;
+    result.ok = scenario != 3;
+    if (scenario != 0) {
+      result.value.Set("tab_ids", base::ListValue().Append(1).Append(2).Append(
+                                      scenario == 1   ? 2
+                                      : scenario == 2 ? 99
+                                                      : 3));
