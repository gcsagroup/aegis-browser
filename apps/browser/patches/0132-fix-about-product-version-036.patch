-// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v1.1.0.35。
-inline constexpr char kProductVersion[] = "1.1.0.35";
-inline constexpr char kProductVersionLabel[] = "Ver 1.1 (035)";
+// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v1.1.0.36。
+inline constexpr char kProductVersion[] = "1.1.0.36";
