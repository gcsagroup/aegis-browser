+void ActorUiTabController::OpenTaskUi() {
+  BrowserWindowInterface* browser = tab_->GetBrowserWindowInterface();
+  ActorTask* task = actor_keyed_service_->GetTaskFromTab(*tab_);
+  if (!browser || !task) {
+    return;
+  }
+  if (task->source_info().type == TaskSourceInfo::Client::kAegis) {
+    // The Aegis side panel is already the owning task UI. Pausing is enough;
+    // opening Glic here would route the task into the wrong client and can
+    // trip Glic's availability checks.
+    return;
+  }
+  auto* glic_service =
+      glic::GlicKeyedServiceFactory::GetGlicKeyedService(browser->GetProfile());
+  if (glic_service) {
+    glic_service->ToggleUI(browser, /*prevent_close=*/true,
+                           glic::mojom::InvocationSource::kHandoffButton);
+  }
+}
