@@ -0,0 +1,48 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/aegis/access/access_account_refresh.h"
+
+#include <array>
+#include <cstdint>
+
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+
+namespace aegis::access {
+
+std::u16string FormatAccessUsageBytes(std::string_view raw) {
+  uint64_t bytes;
+  if (!base::StringToUint64(raw, &bytes) || base::NumberToString(bytes) != raw) {
+    return u"—";
+  }
+  const auto exact = base::ASCIIToUTF16(raw) + u" B";
+  if (bytes < 1024) {
+    return exact;
+  }
+
+  constexpr auto units =
+      std::to_array<std::u16string_view>({u"B", u"KiB", u"MiB", u"GiB",
+                                         u"TiB", u"PiB", u"EiB"});
+  uint64_t divisor = 1;
+  size_t unit = 0;
+  while (unit + 1 < units.size() && bytes / divisor >= 1024) {
+    divisor *= 1024;
+    ++unit;
+  }
+  // On macOS the full-width product preserves truncation even at EiB scale.
+  const uint64_t fraction =
+      static_cast<unsigned __int128>(bytes % divisor) * 100 / divisor;
+  std::u16string result = base::NumberToString16(bytes / divisor);
+  result += fraction < 10 ? u".0" : u".";
+  result += base::NumberToString16(fraction);
+  result += u" ";
+  result += units[unit];
+  result += u" (";
+  result += exact;
+  result += u")";
+  return result;
+}
+
+AccessAccountRefresh::AccessAccountRefresh() = default;
+AccessAccountRefresh::~AccessAccountRefresh() = default;
+
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_account_refresh.h b/chrome/browser/aegis/access/access_account_refresh.h
new file mode 100644
index 0000000000000000000000000000000000000000..45833a2459bca868f1daa1275f1da5013ef81cdc
--- /dev/null
+++ b/chrome/browser/aegis/access/access_account_refresh.h
@@ -0,0 +1,102 @@
+// Copyright 2026 GCSA
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_ACCOUNT_REFRESH_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_ACCOUNT_REFRESH_H_
+
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+
+namespace aegis::access {
+
+// Presentation shared with Settings' binary units and exact byte counts.
+std::u16string FormatAccessUsageBytes(std::string_view raw);
+
+// Profile-owned schedule, shared by every quota surface. Only a completed
+// request starts the next interval. Backgrounding never cancels a request or
+// permits a second one; late completion cannot restart a background timer.
+class AccessAccountRefresh {
+ public:
+  AccessAccountRefresh();
+  ~AccessAccountRefresh();
+
+  void SetActivity(bool app_foreground, bool profile_focused,
+                   base::TimeTicks now) {
+    app_foreground_ = app_foreground;
+    profile_focused_ = profile_focused;
+    UpdateActivity(now);
+  }
+
+  void SetVisible(base::UnguessableToken owner, bool visible,
+                  base::TimeTicks now) {
+    const bool was_visible = !owners_.empty();
+    if (visible) owners_.insert(owner);
+    else owners_.erase(owner);
+    UpdateActivity(now);
+    if (was_visible == !owners_.empty() || failures_ || in_flight_) return;
+    next_ = owners_.empty() ? now + base::Seconds(30) : now;
+  }
+
+  bool Begin(base::TimeTicks now, bool manual = false) {
+    if (!active_) return false;
+    if (manual) {
+      if (last_manual_ && now - *last_manual_ < base::Seconds(1)) return false;
+      last_manual_ = now;
+    }
+    if (in_flight_ || (!manual && now < next_)) return false;
+    in_flight_ = true;
+    return true;
+  }
+
+  void Complete(bool succeeded, base::TimeTicks now) {
+    in_flight_ = false;
+    const bool refresh_on_resume = refresh_after_current_;
+    refresh_after_current_ = false;
+    failures_ = succeeded ? 0 : (failures_ == 0 ? 1 : 2);
+    if (refresh_on_resume) {
+      next_ = now;
+      return;
+    }
+    next_ = now + (failures_ == 1 ? base::Seconds(15)
+        : failures_ == 2 ? base::Seconds(30)
+        : owners_.empty() ? base::Seconds(30) : base::Seconds(5));
+  }
+
+  std::optional<base::TimeDelta> DueIn(base::TimeTicks now) const {
+    if (!active_ || in_flight_) return std::nullopt;
+    return next_ > now ? next_ - now : base::TimeDelta();
+  }
+
+  bool in_flight() const { return in_flight_; }
+
+  void IdentityChanged(base::TimeTicks now) {
+    failures_ = 0;
+    last_manual_.reset();
+    next_ = now;
+  }
+
+ private:
+  void UpdateActivity(base::TimeTicks now) {
+    const bool active = app_foreground_ && (profile_focused_ || !owners_.empty());
+    if (active_ == active) return;
+    active_ = active;
+    refresh_after_current_ = active && in_flight_;
+    if (active) next_ = now;
+  }
+
+  bool app_foreground_ = false;
+  bool profile_focused_ = false;
+  bool active_ = false;
+  bool in_flight_ = false;
+  bool refresh_after_current_ = false;
+  int failures_ = 0;
+  std::set<base::UnguessableToken> owners_;
+  std::optional<base::TimeTicks> last_manual_;
+  base::TimeTicks next_;
+};
+
+}  // namespace aegis::access
+#endif
diff --git a/chrome/browser/aegis/access/access_account_refresh_unittest.cc b/chrome/browser/aegis/access/access_account_refresh_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..e7978577fc294a052eb4bf3edeaf8d42fd035f92
--- /dev/null
+++ b/chrome/browser/aegis/access/access_account_refresh_unittest.cc
@@ -0,0 +1,131 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/aegis/access/access_account_refresh.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis::access {
+namespace {
+
+TEST(AccessAccountRefreshTest, DisplaysTheSameExactBinaryUnitsAsSettings) {
+  EXPECT_EQ(FormatAccessUsageBytes("0"), u"0 B");
+  EXPECT_EQ(FormatAccessUsageBytes("1023"), u"1023 B");
+  EXPECT_EQ(FormatAccessUsageBytes("1024"), u"1.00 KiB (1024 B)");
+  EXPECT_EQ(FormatAccessUsageBytes("8800000000"),
+            u"8.19 GiB (8800000000 B)");
+  EXPECT_EQ(FormatAccessUsageBytes("18446744073709551615"),
+            u"15.99 EiB (18446744073709551615 B)");
+  for (std::string_view invalid : {"", "-1", "00", "+1",
+                                  "18446744073709551616"}) {
+    EXPECT_EQ(FormatAccessUsageBytes(invalid), u"—");
+  }
+}
+
+TEST(AccessAccountRefreshTest, SharesOneRequestAndUsesVisibleCadence) {
+  AccessAccountRefresh refresh;
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  refresh.SetActivity(true, true, now);
+  ASSERT_TRUE(refresh.Begin(now));
+  EXPECT_FALSE(refresh.Begin(now, true));
+  refresh.Complete(true, now);
+  EXPECT_EQ(refresh.DueIn(now), base::Seconds(30));
+
+  const auto first = base::UnguessableToken::Create();
+  const auto second = base::UnguessableToken::Create();
+  refresh.SetVisible(first, true, now);
+  ASSERT_TRUE(refresh.Begin(now));
+  refresh.SetVisible(second, true, now);
+  refresh.SetVisible(first, false, now);
+  EXPECT_FALSE(refresh.DueIn(now));
+  const auto done = now + base::Seconds(7);
+  refresh.Complete(true, done);
+  EXPECT_EQ(refresh.DueIn(done), base::Seconds(5));
+  refresh.SetVisible(second, false, done);
+  EXPECT_EQ(refresh.DueIn(done), base::Seconds(30));
+}
+
+TEST(AccessAccountRefreshTest, BackgroundCompletionCannotPollAndResumeRefreshes) {
+  AccessAccountRefresh refresh;
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  refresh.SetActivity(true, true, now);
+  ASSERT_TRUE(refresh.Begin(now));
+  refresh.SetActivity(false, false, now);
+  EXPECT_FALSE(refresh.Begin(now, true));
+  refresh.Complete(true, now);
+  EXPECT_FALSE(refresh.DueIn(now + base::Minutes(1)));
+  refresh.SetActivity(true, true, now + base::Minutes(1));
+  EXPECT_TRUE(refresh.Begin(now + base::Minutes(1)));
+}
+
+TEST(AccessAccountRefreshTest, VisibleProfileContinuesWhileAnotherHasFocus) {
+  AccessAccountRefresh first;
+  AccessAccountRefresh second;
+  const auto usage = base::UnguessableToken::Create();
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  first.SetActivity(true, true, now);
+  first.SetVisible(usage, true, now);
+  ASSERT_TRUE(first.Begin(now));
+  first.Complete(true, now);
+
+  const auto changed = now + base::Seconds(1);
+  first.SetActivity(true, false, changed);
+  second.SetActivity(true, true, changed);
+  EXPECT_EQ(first.DueIn(changed), base::Seconds(4));
+  EXPECT_TRUE(second.Begin(changed));
+  second.Complete(true, changed);
+  EXPECT_EQ(second.DueIn(changed), base::Seconds(30));
+
+  first.SetActivity(false, false, changed);
+  EXPECT_FALSE(first.DueIn(changed));
+  first.SetActivity(true, false, changed);
+  EXPECT_EQ(first.DueIn(changed), base::TimeDelta());
+  first.SetVisible(usage, false, changed);
+  EXPECT_FALSE(first.DueIn(changed));
+}
+
+TEST(AccessAccountRefreshTest, ResumeWhilePendingQueuesOnlyOneRefresh) {
+  AccessAccountRefresh refresh;
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  refresh.SetActivity(true, true, now);
+  ASSERT_TRUE(refresh.Begin(now));
+  refresh.SetActivity(false, false, now);
+  refresh.SetActivity(true, true, now);
+  EXPECT_FALSE(refresh.Begin(now));
+  refresh.Complete(true, now);
+  ASSERT_TRUE(refresh.Begin(now));
+  refresh.Complete(true, now);
+  EXPECT_EQ(refresh.DueIn(now), base::Seconds(30));
+}
+
+TEST(AccessAccountRefreshTest, DebouncesManualRequestsAndBacksOffUntilSuccess) {
+  AccessAccountRefresh refresh;
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  refresh.SetActivity(true, true, now);
+  refresh.SetVisible(base::UnguessableToken::Create(), true, now);
+  ASSERT_TRUE(refresh.Begin(now, true));
+  refresh.Complete(false, now);
+  EXPECT_EQ(refresh.DueIn(now), base::Seconds(15));
+  EXPECT_FALSE(refresh.Begin(now + base::Milliseconds(999), true));
+  EXPECT_FALSE(refresh.Begin(now + base::Seconds(14)));
+  const auto retry = now + base::Seconds(15);
+  ASSERT_TRUE(refresh.Begin(retry));
+  refresh.Complete(false, retry);
+  EXPECT_EQ(refresh.DueIn(retry), base::Seconds(30));
+  const auto manual = retry + base::Seconds(1);
+  ASSERT_TRUE(refresh.Begin(manual, true));
+  refresh.Complete(true, manual);
+  EXPECT_EQ(refresh.DueIn(manual), base::Seconds(5));
+}
+
+TEST(AccessAccountRefreshTest, AccountChangeClearsPreviousBackoffAndDebounce) {
+  AccessAccountRefresh refresh;
+  const auto now = base::TimeTicks() + base::Seconds(100);
+  refresh.SetActivity(true, true, now);
+  ASSERT_TRUE(refresh.Begin(now, true));
+  refresh.Complete(false, now);
+  EXPECT_FALSE(refresh.Begin(now, true));
+  refresh.IdentityChanged(now);
+  EXPECT_TRUE(refresh.Begin(now, true));
+}
+
+}  // namespace
+}  // namespace aegis::access
