+    access_account_refresh_.IdentityChanged(now);
+  }
+  ScheduleAccessAccountRefresh();
+  auto weak = weak_ptr_factory_.GetWeakPtr();
+  auto callbacks = std::exchange(access_account_waiters_, {});
+  for (auto& callback : callbacks) {
+    if (!weak) break;
