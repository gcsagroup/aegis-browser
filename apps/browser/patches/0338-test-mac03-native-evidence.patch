+bool Mac03Print(std::string_view prefix, const base::DictValue& value) {
+  std::string json;
+  if (!base::JSONWriter::Write(value, &json) ||
+      prefix.size() + json.size() + 1 > 16384) {
+    return false;
+  }
+  return fprintf(stdout, "%.*s%s\n", static_cast<int>(prefix.size()),
+                 prefix.data(), json.c_str()) >= 0 && fflush(stdout) == 0;
+}
