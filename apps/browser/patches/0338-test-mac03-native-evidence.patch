+        const absent = {type:'absent'};
+        const expected = phase === 'S08' ? [absent,absent,absent,absent,0,0] :
+            phase === 'S06' ? [await describe(stable),absent,absent,absent,1,0] :
+            [await describe(stable),await describe(corrupt),await describe(pack),absent,2,1];
+        expected[4] = {type:'number',value:expected[4]};
+        expected[5] = {type:'number',value:expected[5]};
