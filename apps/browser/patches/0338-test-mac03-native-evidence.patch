+class Mac03Observer : public content::WebContentsObserver,
+                      public content::DedicatedWorkerService::Observer {
+ public:
+  Mac03Observer(content::WebContents* page, std::string run_id,
+                std::string challenge, Mac03Deadline& deadline)
+      : content::WebContentsObserver(page),
+        frame_(page->GetPrimaryMainFrame()->GetGlobalId()),
+        service_(page->GetPrimaryMainFrame()->GetStoragePartition()
+                     ->GetDedicatedWorkerService()),
+        run_id_(std::move(run_id)), challenge_(std::move(challenge)),
+        first_(base::TimeTicks::Now()), deadline_(deadline) {}
+  ~Mac03Observer() override {
+    if (attached_) service_->RemoveObserver(this);
+  }
+  void DidFinishNavigation(content::NavigationHandle* handle) override {
+    if (handle->IsInPrimaryMainFrame()) Fail("navigation after pin");
+  }
+  void PrimaryPageChanged(content::Page&) override { Fail("primary page replaced"); }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (frame->GetGlobalId() == frame_) Fail("pinned frame deleted");
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Fail("renderer terminated");
+  }
+  bool Healthy() const {
+    return error_.empty() && web_contents() &&
+        web_contents()->GetPrimaryMainFrame()->GetGlobalId() == frame_;
+  }
+  const std::string& error() const { return error_; }
+  content::GlobalRenderFrameHostId frame() const { return frame_; }
+  const base::ListValue& events() const { return events_; }
+  void Fail(std::string_view reason) {
+    if (error_.empty()) error_ = std::string(reason);
+  }
+  bool CheckDeadline() {
+    if (!deadline_.Remaining().is_positive()) Fail("MAC03 phase deadline");
+    return Healthy();
+  }
+  bool Drain(base::DictValue& startup) {
+    if (!CheckDeadline()) return false;
+    base::test::ScopedRunLoopTimeout drain_timeout(FROM_HERE, deadline_.Remaining());
+    service_->AddObserver(this);
+    attached_ = true;
+    // These OnWorkerCreated calls describe preexisting workers, not new births.
+    enumerating_startup_ = true;
+    service_->EnumerateDedicatedWorkers(this);
+    enumerating_startup_ = false;
+    if (preexisting_.size() > 1) Fail("multiple preexisting workers");
+    if (!base::test::RunUntil([&] { return !Healthy() || live_.empty(); }))
+      Fail("startup worker retirement timeout");
+    Mac03Snapshot snapshot(service_);
+    if (!snapshot.tokens.empty() || retired_ != preexisting_)
+      Fail("startup retirement/enumeration mismatch");
+    base::ListValue observed, retired;
+    for (const auto& token : preexisting_) observed.Append(token);
+    for (const auto& token : retired_) retired.Append(token);
+    startup.Set("observedPreexistingTokens", std::move(observed));
+    startup.Set("retiredPreexistingTokens", std::move(retired));
+    startup.Set("finalEnumeration", base::ListValue());
+    startup_ = false;
+    return CheckDeadline();
+  }
+  bool Begin(std::string_view phase) {
+    deadline_.StartPhase();
+    if (!CheckDeadline()) return false;
+    if (!phase_.empty() || !live_.empty()) Fail("overlapping phase");
+    phase_ = phase;
+    phase_count_ = 0;
+    created_ = 0;
+    Emit(base::DictValue().Set("kind", "phase_begin").Set("source", "browser-test"));
+    Snapshot("before");
+    return Healthy();
+  }
+  bool Result(base::DictValue result) {
+    if (!CheckDeadline()) return false;
+    if (result.size() != 3 || !result.FindString("runId") ||
+        *result.FindString("runId") != run_id_ ||
+        !result.FindString("challenge") ||
+        *result.FindString("challenge") != challenge_ ||
+        !result.FindDict("payload")) {
+      Fail("unbound EvalJs result");
+      return false;
+    }
+    result.Set("kind", "eval_result");
+    result.Set("source", "test-evaljs-return");
+    Emit(std::move(result));
+    return Healthy();
+  }
+  bool End() {
+    if (!CheckDeadline()) return false;
+    // EvalJs and retirement consume the same absolute phase interval.
+    base::test::ScopedRunLoopTimeout retirement_timeout(FROM_HERE, deadline_.Remaining());
+    if (!base::test::RunUntil([&] { return !Healthy() || live_.empty(); }))
+      Fail("worker retirement timeout");
+    Snapshot("after");
+    Emit(base::DictValue().Set("kind", "phase_end").Set("source", "browser-test"));
+    const bool worker = phase_[0] == 'P' || phase_[0] == 'R';
+    if (phase_count_ != (worker ? 8 : 5) || created_ != (worker ? 1 : 0))
+      Fail("phase lifecycle count");
+    phase_.clear();
+    return CheckDeadline();
+  }
+  bool FinalEmpty() {
+    Mac03Snapshot snapshot(service_);
+    if (!snapshot.tokens.empty() || !live_.empty() || !phase_.empty() ||
+        events_.size() != 125 || all_tokens_.size() != preexisting_.size() + 10)
+      Fail("final worker/event matrix");
+    return Healthy();
+  }
+  void OnWorkerCreated(const blink::DedicatedWorkerToken& token,
+                       content::ChildProcessId process_id,
+                       const url::Origin& origin,
+                       content::DedicatedWorkerCreator creator) override {
+    const std::string key = token.ToString();
+    const auto* frame = std::get_if<content::GlobalRenderFrameHostId>(&creator);
+    if (!frame || *frame != frame_ ||
+        origin.Serialize() != "chrome-untrusted://aegis-agent" ||
+        process_id.value() <= 0 || !live_.empty() ||
+        !all_tokens_.insert(key).second) {
+      Fail("unexpected Worker creator/origin/token");
+      return;
+    }
+    live_.emplace(key, false);
+    if (enumerating_startup_) {
+      preexisting_.push_back(key);
+      return;
+    }
+    if (startup_ || phase_.empty() || phase_[0] == 'S' || ++created_ != 1) {
+      Fail("unsolicited Worker creation");
+      return;
+    }
+    Emit(base::DictValue().Set("kind", "worker_created")
+        .Set("source", "dedicated-worker-service").Set("token", key)
+        .Set("processChildId", process_id.value())
+        .Set("creatorFrame", Mac03Frame(*frame))
+        .Set("securityOrigin", origin.Serialize()));
+  }
+  void OnFinalResponseURLDetermined(const blink::DedicatedWorkerToken& token,
+                                    const GURL& url) override {
+    const std::string key = token.ToString();
+    auto found = live_.find(key);
+    if (found == live_.end() || found->second ||
+        url.spec() != "chrome-untrusted://aegis-agent/local_ai/worker.js") {
+      Fail("unexpected Worker final URL");
+      return;
+    }
+    found->second = true;
+    if (startup_) return;
+    Emit(base::DictValue().Set("kind", "worker_final_url")
+        .Set("source", "dedicated-worker-service").Set("token", key)
+        .Set("url", url.spec()));
+  }
+  void OnBeforeWorkerDestroyed(const blink::DedicatedWorkerToken& token,
+                               content::DedicatedWorkerCreator creator) override {
+    const std::string key = token.ToString();
+    const auto* frame = std::get_if<content::GlobalRenderFrameHostId>(&creator);
+    auto found = live_.find(key);
+    if (!frame || *frame != frame_ || found == live_.end() ||
+        (!startup_ && !found->second)) {
+      Fail("unexpected Worker destruction");
+      return;
+    }
+    live_.erase(found);
+    if (startup_) {
+      retired_.push_back(key);
+      return;
+    }
+    Emit(base::DictValue().Set("kind", "worker_destroyed")
+        .Set("source", "dedicated-worker-service").Set("token", key)
+        .Set("creatorFrame", Mac03Frame(*frame)));
+  }
+
+ private:
+  void Snapshot(std::string_view position) {
+    Mac03Snapshot snapshot(service_);
+    if (!snapshot.tokens.empty()) Fail("nonempty phase enumeration");
+    Emit(base::DictValue().Set("kind", "enumeration")
+        .Set("source", "dedicated-worker-service-snapshot")
+        .Set("position", std::string(position)).Set("tokens", base::ListValue()));
+  }
+  void Emit(base::DictValue event) {
+    const int64_t micros = (base::TimeTicks::Now() - first_).InMicroseconds();
+    if (phase_.empty() || micros < 0 || micros > 600000000 ||
+        events_.size() >= 125) {
+      Fail("event clock/phase/capacity");
+      return;
+    }
+    event.Set("seq", static_cast<int>(events_.size()) + 1);
+    event.Set("phase", phase_);
+    event.Set("monotonicMicros", static_cast<int>(micros));
+    if (!Mac03Print("AEGIS_MAC03_V2 ", base::DictValue().Set("runId", run_id_)
+            .Set("challenge", challenge_).Set("event", event.Clone())))
+      Fail("event stdout persistence");
+    events_.Append(std::move(event));
+    ++phase_count_;
+  }
+  const content::GlobalRenderFrameHostId frame_;
+  const raw_ptr<content::DedicatedWorkerService> service_;
+  const std::string run_id_;
+  const std::string challenge_;
+  const base::TimeTicks first_;
+  Mac03Deadline& deadline_;
+  bool attached_ = false;
+  bool enumerating_startup_ = false;
+  bool startup_ = true;
+  int phase_count_ = 0;
+  int created_ = 0;
+  std::string phase_;
+  std::string error_;
+  std::set<std::string> all_tokens_;
+  std::map<std::string, bool> live_;
+  std::vector<std::string> preexisting_, retired_;
+  base::ListValue events_;
+};
