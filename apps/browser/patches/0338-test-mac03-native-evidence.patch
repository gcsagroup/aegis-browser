+// One observer remains attached through publication. Snapshot observers are
+// registered only for their synchronous enumeration and emit no live events.
+class Mac03Snapshot : public content::DedicatedWorkerService::Observer {
+ public:
+  explicit Mac03Snapshot(content::DedicatedWorkerService* service) {
+    service->AddObserver(this);
+    service->EnumerateDedicatedWorkers(this);
+    service->RemoveObserver(this);
+  }
+  void OnWorkerCreated(const blink::DedicatedWorkerToken& token,
+                       content::ChildProcessId process_id,
+                       const url::Origin& origin,
+                       content::DedicatedWorkerCreator creator) override {
+    tokens.push_back(token.ToString());
+  }
+  void OnBeforeWorkerDestroyed(const blink::DedicatedWorkerToken&,
+                               content::DedicatedWorkerCreator) override {}
+  void OnFinalResponseURLDetermined(const blink::DedicatedWorkerToken&,
+                                    const GURL&) override {}
+  std::vector<std::string> tokens;
+};
