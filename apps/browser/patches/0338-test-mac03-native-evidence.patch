+constexpr char kMac03Bootstrap[] = R"MAC03JS(
+(async () => {
+  const runId = $1, challenge = $2;
+  const check = (ok, reason) => { if (!ok) throw Error('MAC03: ' + reason); };
+  check(!Object.hasOwn(globalThis, '__aegisMac03'), 'helper reused');
+  const hash = async bytes => Array.from(new Uint8Array(
+      await crypto.subtle.digest('SHA-256', bytes)),
+      byte => byte.toString(16).padStart(2, '0')).join('');
+  const canonical = value => Array.isArray(value) ? value.map(canonical) :
+      value && typeof value === 'object' ? Object.fromEntries(Object.keys(value).sort().map(key => [key, canonical(value[key])])) : value;
+  const equal = (a, b, reason) => check(JSON.stringify(canonical(a)) === JSON.stringify(canonical(b)), reason);
+  const fetchBytes = async path => {
+    const response = await fetch(path, {credentials: 'omit'});
+    check(response.ok, 'manifest response');
+    const bytes = await response.arrayBuffer();
+    check(bytes.byteLength <= 262144, 'manifest capacity');
+    return bytes;
+  };
+  const {LocalAiClient} = await import('./local_ai_client.js');
+  const {languagePacks, routePacks} = await import('./local_ai/catalog.js');
+  const translation = await fetchBytes('./local_ai/translation_manifest.json');
+  const research = await fetchBytes('./local_ai/research_manifest.json');
+  const rows = JSON.parse(new TextDecoder('utf-8', {fatal: true}).decode(translation));
+  const packs = languagePacks(rows), catalogPackIds = packs.map(pack => pack.id);
+  const route = routePacks(rows, 'en-zh').map(pack => pack.id);
+  equal(route, ['en-zh'], 'direct route');
+  const client = new LocalAiClient();
+  const bytes = label => new TextEncoder().encode(label + ':' + runId + ':' + challenge).buffer;
+  const stable = bytes('stable'), corrupt = bytes('corrupt'), poison = bytes('poison');
+  const ks = 'mac03:' + runId + ':sentinel', kp = 'mac03:' + runId + ':poison';
+  const kc = await hash(new TextEncoder().encode('corrupt-key:' + runId + ':' + challenge));
+  check(kc !== await hash(corrupt) && !rows.some(row => row.decompressedHash === kc),
+        'corrupt key must be separate from actual and public hashes');
+  const pack = {version: 0, rows: [
+    {fileType: 'model', decompressedHash: kc, decompressedSize: corrupt.byteLength}]};
+  const connections = [];
+  let nextPhase = 0;
+  const phases = ['P00','S00','P01','R01','P02','S01','R02','P03','S02','R03',
+                  'P04','S03','S04','S05','P05','S06','P06','S07','S08'];
+  const describe = async (value, keyResult = false) => {
+    if (value === undefined) return {type: 'absent'};
+    if (typeof value === 'number') return {type: 'number', value};
+    if (keyResult && typeof value === 'string') return {type: 'key', value};
+    if (value instanceof ArrayBuffer) {
+      check(value.byteLength > 0 && value.byteLength <= 256, 'actual buffer capacity');
+      return {type: 'array-buffer', byteLength: value.byteLength, sha256: await hash(value)};
+    }
+    check(value && typeof value === 'object', 'actual pack type');
+    equal(Object.keys(value).sort(), ['rows','version'], 'actual pack fields');
+    return {type: 'pack', ...value};
+  };
+  const transaction = async (db, index, mode, operations, abort = false) => {
+    // No await between creating the transaction and queueing all requests.
+    const tx = db.transaction(['files','packs'], mode);
+    const callbacks = [], observed = [];
+    let requestFailure = null;
+    const terminal = new Promise((resolve, reject) => {
+      tx.oncomplete = () => {
+        callbacks.push({kind: 'transaction_complete'});
+        if (requestFailure) reject(requestFailure);
+        else resolve({terminal: 'complete', error: null});
+      };
+      tx.onabort = () => {
+        callbacks.push({kind: 'transaction_abort'});
+        if (requestFailure) reject(requestFailure);
+        else resolve({terminal: 'abort', error: tx.error?.name ?? null});
+      };
+      tx.onerror = () => { requestFailure ??= Error('transaction error'); };
+      operations.forEach(([verb, store, key, value], index) => {
+        const input = verb === 'put' ? structuredClone(value) : null;
+        const request = verb === 'put' ? tx.objectStore(store).put(value, key) :
+            verb === 'count' ? tx.objectStore(store).count() : tx.objectStore(store)[verb](key);
+        const row = {id: 'q' + index, verb, store, key: key ?? null, input};
+        request.onerror = () => { requestFailure = Error('request error: ' + request.error?.name); };
+        request.onsuccess = () => {
+          row.result = structuredClone(request.result);
+          observed.push(row);
+          callbacks.push({kind: 'request_success', requestId: row.id});
+          if (abort && index === operations.length - 1) {
+            check(observed.length === operations.length, 'all puts before abort');
+            callbacks.push({kind: 'abort_called'});
+            tx.abort();
+          }
+        };
+      });
+    });
+    const result = await terminal;
+    check(result.terminal === (abort ? 'abort' : 'complete'), 'actual transaction terminal');
+    check(observed.length === operations.length, 'actual successful request count');
+    // Digest cloned native results only after transaction completion/abort.
+    const requests = [];
+    for (const row of observed) requests.push({...row,
+      input: row.input === null ? null : await describe(row.input),
+      result: await describe(row.result, row.verb === 'put')});
+    return {id: 't' + index, mode, stores: ['files','packs'], requests, callbacks, ...result};
+  };
+  const probe = async phase => {
+    const openTrace = ['open_requested'], closeTrace = [], transactions = [];
+    let openFailure = null;
+    const db = await new Promise((resolve, reject) => {
+      const request = indexedDB.open('aegis-local-translation-v1', 2);
+      request.onupgradeneeded = () => {
+        openFailure = Error('unexpected upgrade'); request.transaction.abort();
+      };
+      request.onblocked = () => { openFailure = Error('blocked'); reject(openFailure); };
+      request.onerror = () => reject(openFailure ?? Error('open error: ' + request.error?.name));
+      request.onsuccess = () => {
+        if (openFailure) { request.result.close(); reject(openFailure); return; }
+        openTrace.push('open_success'); resolve(request.result);
+      };
+    });
+    let versionChanged = false;
+    db.onversionchange = () => { versionChanged = true; db.close(); };
+    const ordinal = connections.length + 1;
+    try {
+      check(!connections.includes(db), 'actual IDB object reused');
+      connections.push(db);
+      check(db.version === 2, 'database version');
+      equal([...db.objectStoreNames], ['files','packs'], 'database stores');
+      const reads = [['get','files',ks],['get','files',kc],['get','packs','en-zh'],
+                     ['get','files',kp],['count','files'],['count','packs']];
+      if (phase === 'S00') {
+        transactions.push(await transaction(db, 0, 'readonly',
+            [['count','files'],['count','packs']]));
+        equal(transactions[0].requests.map(row => row.result),
+              [{type:'number',value:0},{type:'number',value:0}], 'fresh store');
+        transactions.push(await transaction(db, 1, 'readwrite',
+            [['put','files',ks,stable],['put','files',kc,corrupt],['put','packs','en-zh',pack]]));
+      } else if (phase === 'S04') {
+        transactions.push(await transaction(db, 0, 'readwrite',
