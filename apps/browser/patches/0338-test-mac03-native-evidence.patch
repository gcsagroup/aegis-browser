+bool Mac03PhysicalPath(const base::FilePath& path, bool directory) {
+#if BUILDFLAG(IS_POSIX)
+  base::FilePath normalized;
+  struct stat info;
+  return path.IsAbsolute() &&
+      base::NormalizeFilePath(path, &normalized) && normalized == path &&
+      lstat(path.value().c_str(), &info) == 0 && info.st_uid == getuid() &&
+      (directory ? S_ISDIR(info.st_mode) : S_ISREG(info.st_mode) && info.st_nlink == 1);
+#else
+  return false;  // Native evidence publication is a macOS-only contract.
+#endif
+}
