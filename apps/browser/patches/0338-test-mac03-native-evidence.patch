+      }
+      check(!versionChanged, 'version change');
+    } finally {
+      db.close(); closeTrace.push('close_requested');
+    }
+    let closedError = '';
+    try { db.transaction(['files','packs'], 'readonly'); }
+    catch (error) { closedError = error.name; }
