+void AegisInstallUi::PaintProgress(HWND window) {
+  PAINTSTRUCT paint;
+  HDC dc = ::BeginPaint(window, &paint);
+  int saved = ::SaveDC(dc);
+  RECT track;
+  ::GetClientRect(window, &track);
+  ::FillRect(dc, &track,
+             high_contrast_
+                 ? ::GetSysColorBrush(COLOR_WINDOW)
+                 : static_cast<HBRUSH>(::GetStockObject(WHITE_BRUSH)));
+  FillRounded(dc, track, Scale(4),
+              high_contrast_ ? ::GetSysColor(COLOR_WINDOWTEXT) : kTrack);
+  if (!failed_) {
+    RECT segment = track;
+    if (!complete_) {
+      // 整数平滑往返只表示忙碌；不与文件数、时长或安装完成率建立虚假映射。
+      int t = animate_ ? static_cast<int>(::GetTickCount64() % 2400) : 600;
+      if (t > 1200)
+        t = 2400 - t;
+      t = t * 1000 / 1200;
+      int eased = t * t * (3000 - 2 * t) / 1000000;
+      int width = (track.right - track.left) / 4;
+      segment.left = (track.right - width) * eased / 1000;
+      segment.right = segment.left + width;
+    }
+    FillRounded(dc, segment, Scale(4),
+                high_contrast_ ? ::GetSysColor(COLOR_HIGHLIGHT) : kAccent);
+  }
+  ::RestoreDC(dc, saved);
+  ::EndPaint(window, &paint);
+}
+
+void AegisInstallUi::PaintButton(const DRAWITEMSTRUCT& item) {
+  int saved = ::SaveDC(item.hDC);
+  bool pressed = (item.itemState & ODS_SELECTED) != 0;
+  COLORREF background = high_contrast_ ? ::GetSysColor(COLOR_HIGHLIGHT)
+                        : pressed      ? RGB(0, 102, 130)
+                                       : kAccent;
+  ::FillRect(item.hDC, &item.rcItem,
+             high_contrast_
+                 ? ::GetSysColorBrush(COLOR_WINDOW)
+                 : static_cast<HBRUSH>(::GetStockObject(WHITE_BRUSH)));
+  FillRounded(item.hDC, item.rcItem, Scale(10), background);
+  ::SetBkMode(item.hDC, TRANSPARENT);
+  ::SetTextColor(item.hDC, high_contrast_ ? ::GetSysColor(COLOR_HIGHLIGHTTEXT)
+                                          : RGB(255, 255, 255));
+  ::SelectObject(item.hDC, font_);
+  RECT text = item.rcItem;
+  ::DrawText(item.hDC, L"关闭", -1, &text,
+             DT_CENTER | DT_VCENTER | DT_SINGLELINE);
+  if ((item.itemState & ODS_FOCUS) && !(item.itemState & ODS_NOFOCUSRECT)) {
+    ::InflateRect(&text, -Scale(4), -Scale(4));
+    ::DrawFocusRect(item.hDC, &text);
+  }
+  ::RestoreDC(item.hDC, saved);
 }
 
