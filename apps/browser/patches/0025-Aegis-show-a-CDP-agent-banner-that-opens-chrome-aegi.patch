From c431572ee1a9f841da0d9108da0238898d1ba403 Mon Sep 17 00:00:00 2001
From: GCSA-aegis <aegis@gcsa.local>
Date: Fri, 14 Aug 2026 17:19:59 +0800
Subject: [PATCH] Aegis: show a CDP agent banner that opens chrome://aegis

Replace the stock automation infobar copy so a loopback agent
connection is visible, and send the action to chrome://aegis.
---
 ...tools_remote_server_infobar_browsertest.cc | 10 +++----
 ...devtools_remote_server_infobar_delegate.cc | 14 +++++----
 chrome/common/aegis/BUILD.gn                  |  7 ++++-
 chrome/common/aegis/cdp_infobar_copy.cc       | 29 ++++++++++++++++++
 chrome/common/aegis/cdp_infobar_copy.h        | 18 +++++++++++
 .../common/aegis/cdp_infobar_copy_unittest.cc | 30 +++++++++++++++++++
 6 files changed, 96 insertions(+), 12 deletions(-)
 create mode 100644 chrome/common/aegis/cdp_infobar_copy.cc
 create mode 100644 chrome/common/aegis/cdp_infobar_copy.h
 create mode 100644 chrome/common/aegis/cdp_infobar_copy_unittest.cc

diff --git a/chrome/browser/devtools/devtools_remote_server_infobar_browsertest.cc b/chrome/browser/devtools/devtools_remote_server_infobar_browsertest.cc
index 6272231ab7..5a2c8763d7 100644
--- a/chrome/browser/devtools/devtools_remote_server_infobar_browsertest.cc
+++ b/chrome/browser/devtools/devtools_remote_server_infobar_browsertest.cc
@@ -63,7 +63,7 @@ IN_PROC_BROWSER_TEST_F(DevToolsRemoteServerInfobarBrowserTest,
   ASSERT_EQ(1u, manager->infobars().size());
 
   content::TestNavigationObserver navigation_observer(
-      GURL("chrome://inspect#remote-debugging"));
+      GURL("chrome://aegis/"));
   navigation_observer.StartWatchingNewWebContents();
 
   auto* confirm =
@@ -74,8 +74,8 @@ IN_PROC_BROWSER_TEST_F(DevToolsRemoteServerInfobarBrowserTest,
 
   navigation_observer.Wait();
   EXPECT_EQ(2, second_browser->tab_strip_model()->count());
-  EXPECT_EQ(GURL("chrome://inspect#remote-debugging"),
-            second_browser->tab_strip_model()
-                ->GetActiveWebContents()
-                ->GetVisibleURL());
+  EXPECT_EQ("aegis", second_browser->tab_strip_model()
+                         ->GetActiveWebContents()
+                         ->GetVisibleURL()
+                         .host());
 }
diff --git a/chrome/browser/devtools/devtools_remote_server_infobar_delegate.cc b/chrome/browser/devtools/devtools_remote_server_infobar_delegate.cc
index 4880c68434..8325ef79da 100644
--- a/chrome/browser/devtools/devtools_remote_server_infobar_delegate.cc
+++ b/chrome/browser/devtools/devtools_remote_server_infobar_delegate.cc
@@ -20,12 +20,12 @@
 #include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
 #include "chrome/browser/ui/navigator/browser_navigator.h"
 #include "chrome/browser/ui/navigator/browser_navigator_params.h"
-#include "chrome/grit/generated_resources.h"
+#include "chrome/common/aegis/cdp_infobar_copy.h"
+#include "chrome/common/webui_url_constants.h"
 #include "components/infobars/core/confirm_infobar_delegate.h"
 #include "components/infobars/core/infobar_delegate.h"
 #include "ui/base/l10n/l10n_util.h"
 #include "ui/gfx/text_constants.h"
-#include "ui/strings/grit/ui_strings.h"
 
 DevToolsRemoteServerInfobarDelegate::DevToolsRemoteServerInfobarDelegate() =
     default;
@@ -44,7 +44,9 @@ bool DevToolsRemoteServerInfobarDelegate::ShouldExpire(
 }
 
 std::u16string DevToolsRemoteServerInfobarDelegate::GetMessageText() const {
-  return l10n_util::GetStringUTF16(IDS_CONTROLLED_BY_AUTOMATION);
+  // Aegis：写明是本机 CDP agent，而不是 Chromium 默认的「自动化测试」。
+  return aegis::CdpInfobarMessage(
+      l10n_util::GetApplicationLocale(std::string()));
 }
 
 int DevToolsRemoteServerInfobarDelegate::GetButtons() const {
@@ -59,8 +61,8 @@ int DevToolsRemoteServerInfobarDelegate::GetButtons() const {
 
 std::u16string DevToolsRemoteServerInfobarDelegate::GetButtonLabel(
     InfoBarButton button) const {
-  return l10n_util::GetStringUTF16(
-      IDS_DEV_TOOLS_CONNECTION_DIALOG_DISABLE_TEXT);
+  return aegis::CdpInfobarButton(
+      l10n_util::GetApplicationLocale(std::string()));
 }
 
 bool DevToolsRemoteServerInfobarDelegate::Accept() {
@@ -71,7 +73,7 @@ bool DevToolsRemoteServerInfobarDelegate::Accept() {
   if (!browser) {
     return ConfirmInfoBarDelegate::Accept();
   }
-  GURL internal_url("chrome://inspect#remote-debugging");
+  GURL internal_url(chrome::kChromeUIAegisURL);
   NavigateParams params(browser, internal_url, ui::PAGE_TRANSITION_LINK);
   params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
   Navigate(&params);
