+  auto envelope = network::mojom::AegisAccessRequestEnvelope::New();
+  envelope->request_token = ownership.request_id;
+  envelope->incarnation = private_context_->incarnation();
+  envelope->hop = hop;
+  envelope->target = target;
+  envelope->method = method;
