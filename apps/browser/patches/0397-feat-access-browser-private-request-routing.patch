+network::mojom::AegisAccessRequestEnvelopePtr AccessProxyingURLLoaderFactory::BuildEnvelope(
+    const aegis_access::RequestOwnershipRecord& ownership, const GURL& target,
+    const std::string& method, uint32_t hop) {
