@@ -4,6 +4,8 @@
 
 #include "net/http/http_stream_factory_job_controller.h"
 
+#include "net/http/access_proxy_route.h"
+
 #include <string>
 #include <utility>
 
@@ -158,7 +160,8 @@ HttpStreamFactory::JobController::JobController(
       is_preconnect_(is_preconnect),
       is_websocket_(is_websocket),
       enable_ip_based_pooling_for_h2_(enable_ip_based_pooling_for_h2),
-      enable_alternative_services_(enable_alternative_services),
+      enable_alternative_services_(enable_alternative_services &&
+                                   !http_request_info.access_proxy_route),
       delay_main_job_with_available_spdy_session_(
           delay_main_job_with_available_spdy_session),
       management_config_(http_request_info.connection_management_config),
@@ -837,6 +840,16 @@ int HttpStreamFactory::JobController::DoResolveProxy() {
 
   next_state_ = STATE_RESOLVE_PROXY_COMPLETE;
 
+  if (request_info_.access_proxy_route) {
+    const auto& chain = request_info_.access_proxy_route->proxy_chain();
+    if (!chain.GetProxyServer(0).is_http()) {
+      return ERR_NOT_IMPLEMENTED;
+    }
+    proxy_info_.UseProxyChain(chain);
+    proxy_info_.set_traffic_annotation(request_info_.traffic_annotation);
+    return OK;
+  }
+
   if (request_info_.load_flags & LOAD_BYPASS_PROXY) {
     proxy_info_.UseDirect();
     return OK;
@@ -1570,6 +1583,12 @@ int HttpStreamFactory::JobController::ReconsiderProxyAfterError(Job* job,
   DCHECK_EQ(1, GetJobCount());
   DCHECK(!proxy_resolve_request_);
 
+  // An Access route is an exact authorized endpoint, not a PAC fallback list.
+  // Do not mark it bad in, or fall back through, the session's native cache.
+  if (request_info_.access_proxy_route) {
+    return error;
+  }
+
   if (!job->should_reconsider_proxy()) {
     return error;
   }
