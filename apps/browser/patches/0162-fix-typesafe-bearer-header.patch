From a6b04f111d5c8596227cb1474e06eb6954e6f25c Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 23 Sep 2026 12:02:17 +0800
Subject: [PATCH] fix(aegis): build TypeSafe bearer header safely

---
 .../browser/aegis/agent/typesafe_goal_router_client.cc   | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/aegis/agent/typesafe_goal_router_client.cc b/chrome/browser/aegis/agent/typesafe_goal_router_client.cc
index 524db28..8ff158e 100644
--- a/chrome/browser/aegis/agent/typesafe_goal_router_client.cc
+++ b/chrome/browser/aegis/agent/typesafe_goal_router_client.cc
@@ -9,7 +9,6 @@
 
 #include "base/functional/bind.h"
 #include "base/json/json_writer.h"
-#include "base/strings/strcat.h"
 #include "base/strings/string_util.h"
 #include "base/time/time.h"
 #include "base/unguessable_token.h"
@@ -79,6 +78,12 @@ bool IsValidApiKey(std::string_view api_key) {
          base::TrimWhitespaceASCII(api_key, base::TRIM_ALL) == api_key;
 }
 
+std::string BuildBearerAuthorization(std::string_view api_key) {
+  std::string authorization = "Bearer ";
+  authorization.append(api_key);
+  return authorization;
+}
+
 base::DictValue ChoiceQuestion(std::string instructions,
                                base::DictValue criteria) {
   base::DictValue question;
@@ -224,7 +229,7 @@ TypeSafeGoalRouterClient::Start(std::string goal,
   request->headers.SetHeader(net::HttpRequestHeaders::kAccept,
                              "application/json");
   request->headers.SetHeader(net::HttpRequestHeaders::kAuthorization,
-                             base::StrCat({"Bearer ", api_key}));
+                             BuildBearerAuthorization(api_key));
 
   request_id_ = base::UnguessableToken::Create().ToString();
   original_goal_ = std::move(goal);
-- 
