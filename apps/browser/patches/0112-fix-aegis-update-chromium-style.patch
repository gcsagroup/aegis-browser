 chrome/browser/ui/webui/help/version_updater.h      |  2 +-
 .../settings/settings_localized_strings_provider.cc |  2 +-
 7 files changed, 21 insertions(+), 14 deletions(-)
 create mode 100644 chrome/browser/ui/webui/help/version_updater.cc

diff --git a/chrome/app/app-Info.plist b/chrome/app/app-Info.plist
index ea07226701..77fcd36f3a 100644
