   browser_version = VersionUI::GetAnnotatedVersionStringForUi();
 #else
   browser_version = base::StrCat(
-      {u"Ver 1.1 (002) · Chromium ", base::UTF8ToUTF16(version_info::GetVersionNumber()), u" ",
+      {u"Ver 1.1 (003) · Chromium ", base::UTF8ToUTF16(version_info::GetVersionNumber()), u" ",
