index 0000000000..470dac6e96
--- /dev/null
+++ b/chrome/browser/ui/webui/help/version_updater.cc
@@ -0,0 +1,6 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/ui/webui/help/version_updater.h"
+
+base::FilePath VersionUpdater::GetDownloadedUpdatePath() const {
+  return {};
+}
diff --git a/chrome/browser/ui/webui/help/version_updater.h b/chrome/browser/ui/webui/help/version_updater.h
index 43b2888344..f4878215ca 100644
--- a/chrome/browser/ui/webui/help/version_updater.h
+++ b/chrome/browser/ui/webui/help/version_updater.h
@@ -87,7 +87,7 @@ class VersionUpdater {
 
   virtual ~VersionUpdater() = default;
   // 仅返回已经完成下载与校验的本地更新包，不接受前端传入路径。
-  virtual base::FilePath GetDownloadedUpdatePath() const { return {}; }
+  virtual base::FilePath GetDownloadedUpdatePath() const;
 
   // Sub-classes must implement this method to create the respective
   // specialization. |web_contents| may be null, in which case any required UX
