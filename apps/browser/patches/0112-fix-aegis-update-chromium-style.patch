diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 614bc20d4c..019bbdea70 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -19,9 +19,9 @@ class SimpleURLLoader;
 }  // namespace network
 
 namespace aegis {
-// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v1.1.0.2。
-inline constexpr char kProductVersion[] = "1.1.0.2";
-inline constexpr char kProductVersionLabel[] = "Ver 1.1 (002)";
+// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v1.1.0.3。
+inline constexpr char kProductVersion[] = "1.1.0.3";
+inline constexpr char kProductVersionLabel[] = "Ver 1.1 (003)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
 inline constexpr char kReleasePage[] =
diff --git a/chrome/browser/ui/webui/help/aegis_github_update_unittest.cc b/chrome/browser/ui/webui/help/aegis_github_update_unittest.cc
index 1885112f1b..3adf78a965 100644
