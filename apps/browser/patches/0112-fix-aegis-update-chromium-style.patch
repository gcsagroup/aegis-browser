+++ b/chrome/browser/ui/webui/help/aegis_github_update_unittest.cc
@@ -23,7 +23,7 @@ namespace {
 constexpr char kPlatform[] = "mac-arm64.dmg";
 constexpr char kPayload[] = "representative update package";
 
-base::DictValue Release(std::string version = "1.1.0.3") {
+base::DictValue Release(std::string version = "1.1.0.4") {
   base::DictValue asset;
   const std::string name = "GCSA-aegis-" + version + "-" + kPlatform;
   asset.Set("name", name);
diff --git a/chrome/browser/ui/webui/help/version_updater.cc b/chrome/browser/ui/webui/help/version_updater.cc
