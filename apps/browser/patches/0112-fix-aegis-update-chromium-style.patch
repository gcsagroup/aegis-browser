+++ b/chrome/app/app-Info.plist
@@ -4,9 +4,9 @@
 <dict>
   <!-- 产品更新版本独立于 Chromium 的框架定位版本。 -->
   <key>AegisProductVersion</key>
-  <string>1.1.0.2</string>
+  <string>1.1.0.3</string>
   <key>AegisProductVersionLabel</key>
-  <string>Ver 1.1 (002)</string>
+  <string>Ver 1.1 (003)</string>
 	<key>CFBundleDevelopmentRegion</key>
 	<string>en</string>
 	<key>CFBundleDisplayName</key>
diff --git a/chrome/browser/ui/webui/help/BUILD.gn b/chrome/browser/ui/webui/help/BUILD.gn
index 641db50d1b..05d287abde 100644
