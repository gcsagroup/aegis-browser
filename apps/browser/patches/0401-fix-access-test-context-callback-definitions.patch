index 0000000000000000000000000000000000000000..92d7d59007c27baff7985404c0c592561fd8f0ac
--- /dev/null
+++ b/services/network/test/test_network_context.cc
@@ -0,0 +1,25 @@
+// Copyright 2026 GCSA
+#include "services/network/test/test_network_context.h"
+
+namespace network {
+void TestNetworkContext::InstallAegisAccessSnapshot(mojom::AegisAccessSnapshotPtr snapshot,
+      InstallAegisAccessSnapshotCallback callback) {
+    auto ack = mojom::AegisAccessSnapshotAck::New();
+    ack->owner = snapshot->owner.Clone();
+    ack->incarnation = snapshot->incarnation;
+    ack->sequence = snapshot->sequence;
+    ack->common_generations = snapshot->common_generations.Clone();
+    ack->accepted = false;
+    std::move(callback).Run(std::move(ack));
+  }
+void TestNetworkContext::BeginAegisAccessRestore(mojom::AegisAccessOwnerPtr,
+      const std::string&, BeginAegisAccessRestoreCallback callback) {
+    std::move(callback).Run(false);
+  }
+void TestNetworkContext::CreateAegisAccessURLLoaderFactory(
+      mojo::PendingReceiver<mojom::AegisAccessURLLoaderFactory>,
+      mojom::URLLoaderFactoryParamsPtr, mojom::AegisAccessFactoryBindingPtr,
+      CreateAegisAccessURLLoaderFactoryCallback callback) {
+    std::move(callback).Run(false);
+  }
+}  // namespace network
