 }
 
 body.settings-only main {
+  gap: 24px;
   max-width: none;
-  padding: 0 0 24px;
+  padding: 0;
   margin: 0;
 }
 
@@ -966,10 +967,27 @@ body.settings-only[data-settings-section='experiments'] main > #reading-research
 }
 
 body.settings-only .card {
-  margin: 0 0 20px;
+  margin: 0;
+  padding: 20px;
+  border-radius: 12px;
   box-shadow: none;
 }
 
+body.settings-only .language-pack-filters {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr));
+  align-items: start;
+}
+
+body.settings-only .language-pack-filters label {
+  min-width: 0;
+}
+
+body.settings-only .language-pack-filters select {
+  display: block;
+  margin-top: 8px;
+}
+
 body.settings-only input,
 body.settings-only select {
   max-width: 100%;
diff --git a/chrome/browser/resources/settings/aegis_page/aegis_page.html b/chrome/browser/resources/settings/aegis_page/aegis_page.html
index 43b38333fbd50837b7808c572931b01c4f1586d9..222447ac0173e23c04c5227faf1ad577a12a5647 100644
