diff --git a/chrome/browser/resources/aegis/gestures.css b/chrome/browser/resources/aegis/gestures.css
index fed8a057746ddab9a62e18db16ef705ea7feaf0a..15a82a37a8c7061401ca2366c24378a0bbce9fb5 100644
--- a/chrome/browser/resources/aegis/gestures.css
+++ b/chrome/browser/resources/aegis/gestures.css
@@ -383,6 +383,32 @@ select {
 .site-entry span { flex:1;
  overflow-wrap:anywhere; }
 
+/* 设置页使用统一内容边界；独立手势页保留原来的间距。 */
+:host section {
+  padding:20px;
+  margin:0 0 24px;
+}
+
+:host .section-head {
+  flex-wrap:wrap;
+}
+
+.switch-row > span,
+.binding > *,
+.site-entry > span {
+  min-width:0;
+}
+
+.switch-row input[type=checkbox] {
+  flex:none;
+}
+
+.binding-edit select,
+#add-site-form input {
+  min-width:min(160px, 100%);
+  max-width:100%;
+}
+
 [role='status'] { min-height:1.4em; }
 @media(max-width: 650px) { .binding { grid-template-columns:1fr; } .binding-controls { grid-column:1; } }
 
diff --git a/chrome/browser/resources/aegis_agent/agent.css b/chrome/browser/resources/aegis_agent/agent.css
index 488aa0919ed94fa2c1edb34a30673fe3377b5412..faa56b94facaef7116e6b666e31e58292876b190 100644
--- a/chrome/browser/resources/aegis_agent/agent.css
+++ b/chrome/browser/resources/aegis_agent/agent.css
