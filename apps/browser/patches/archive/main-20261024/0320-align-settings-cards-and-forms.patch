 <h1 class="page-title">[[pageTitle_(mode)]]</h1>
@@ -121,7 +129,7 @@
       <label class="setting-row">行距<select id="reading-spacing"><option value="150">紧凑</option><option value="180">标准</option><option value="210">宽松</option></select></label>
       <label class="setting-row">正文宽度<select id="reading-width"><option value="680">窄</option><option value="820">标准</option><option value="1100">宽</option></select></label>
       <p id="reading-status" role="status" aria-live="polite"></p><button id="reading-retry" hidden>重试保存</button>
-    </div><article id="reading-preview" aria-label="阅读外观预览"><h3>阅读外观预览</h3><p>用舒适的字号和行距阅读，让注意力留在内容上。</p><p>Reading should feel clear and comfortable.</p><ul><li>正文和列表</li><li><a href="#" id="preview-link">链接样式</a></li></ul><pre><code>const message = 'Hello';</code></pre></article></div>
+    </div><div class="reading-preview-frame"><article id="reading-preview" aria-label="阅读外观预览"><h3>阅读外观预览</h3><p>用舒适的字号和行距阅读，让注意力留在内容上。</p><p>Reading should feel clear and comfortable.</p><ul><li>正文和列表</li><li><a href="#" id="preview-link">链接样式</a></li></ul><pre><code>const message = 'Hello';</code></pre></article></div></div>
   </section>
