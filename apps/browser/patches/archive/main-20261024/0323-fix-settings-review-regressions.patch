From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GCSA-ToolsTeam <316909304+GCSA-ToolsTeam@users.noreply.github.com>
Date: Fri, 23 Oct 2026 21:00:00 +0800
Subject: [PATCH] 修复下载保存冲突与阅读语言包入口

保存失败后取消本轮待执行草稿，允许阅读侧栏主动展开语言包，并同步 Worker 资源摘要。

---
diff --git a/chrome/browser/resources/aegis_agent/agent.css b/chrome/browser/resources/aegis_agent/agent.css
index 667657b4cc3e4eb6cf550f7ce19017fcbba2315e..ec39cd4ff5247d6af534b75fd347d84b9f97dac5 100644
--- a/chrome/browser/resources/aegis_agent/agent.css
+++ b/chrome/browser/resources/aegis_agent/agent.css
@@ -935,6 +935,11 @@ body.central-settings #reading-ai-settings {
   display: none !important;
 }
 
+/* 阅读时主动管理语言包可在原处展开，切回其他视图后继续隐藏。 */
+body.central-settings main > #reading-view:not([hidden]) ~ #reading-ai-settings[open] {
+  display: block !important;
+}
+
 body.settings-only {
   --bg: light-dark(#fff, #202124);
   --surface: light-dark(#fff, #202124);
diff --git a/chrome/browser/resources/aegis_agent/local_ai/asset_manifest.json b/chrome/browser/resources/aegis_agent/local_ai/asset_manifest.json
index 04017530025d9bee06d2a00e3c297d0a863f39b0..603e39a4f7bf9b38c03d418faac80507c2b76ca1 100644
