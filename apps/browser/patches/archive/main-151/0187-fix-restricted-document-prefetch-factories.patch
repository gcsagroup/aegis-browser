@@ -123,6 +127,27 @@ SubresourceProxyingURLLoaderService::GetFactory(
   return weak_bind_context;
 }
 
+std::optional<SubresourceProxyingURLLoaderService::DocumentDefaultFactoryKind>
+SubresourceProxyingURLLoaderService::
+    CloneCommittedDocumentFactoryForTesting(
+        RenderFrameHostImpl* frame,
+        mojo::PendingReceiver<network::mojom::URLLoaderFactory> receiver) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  for (const auto& [_, context] :
+       loader_factory_receivers_.GetAllContexts()) {
+    if ((*context)->document_state() != BindContext::DocumentState::kCommitted ||
+        (*context)->render_frame_host.get() != frame ||
+        (*context)->document.AsRenderFrameHostIfValid() != frame) {
+      continue;
+    }
+    const DocumentDefaultFactoryKind kind =
+        (*context)->document_default_factory_kind;
+    loader_factory_receivers_.Add(this, std::move(receiver), *context);
+    return kind;
+  }
+  return std::nullopt;
+}
