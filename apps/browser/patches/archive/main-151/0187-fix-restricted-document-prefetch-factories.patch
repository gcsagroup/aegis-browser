+IN_PROC_BROWSER_TEST_F(PrefetchBrowserTestBase,
+                       HttpMhtmlSubframePrefetchKeepsRestrictedDefault) {
+  embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+      [](const net::test_server::HttpRequest&)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+        response->set_content("network-response");
+        return response;
+      }));
+  auto healthy_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/mhtml-prefetch-health");
+  auto blocked_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/mhtml-prefetch-blocked");
+  auto restricted_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/mhtml-prefetch-restricted");
+  auto recursive_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/mhtml-prefetch-recursive");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  host_resolver()->AddRule("example.com", "127.0.0.1");
+
+  auto* partition = static_cast<StoragePartitionImpl*>(
+      shell()->web_contents()->GetBrowserContext()->GetDefaultStoragePartition());
+  auto* service = partition->GetSubresourceProxyingURLLoaderService();
+  auto load_prefetch = [&](network::mojom::URLLoaderFactory* factory,
+                           const GURL& url, const GURL& initiator,
+                           int additional_load_flags, bool recursive) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->load_flags = net::LOAD_PREFETCH | additional_load_flags;
+    request->destination = network::mojom::RequestDestination::kDocument;
+    request->request_initiator = url::Origin::Create(initiator);
+    if (recursive) {
+      request->recursive_prefetch_token = base::UnguessableToken::Create();
+    }
+    auto loader = network::SimpleURLLoader::Create(
+        std::move(request), TRAFFIC_ANNOTATION_FOR_TESTS);
+    base::test::TestFuture<std::optional<std::string>> result;
+    loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+        factory, result.GetCallback());
+    EXPECT_TRUE(result.Wait());
+    return std::pair(loader->NetError(), result.Get().value_or(""));
+  };
+
+  const GURL healthy_page = embedded_test_server()->GetURL("/first");
+  ASSERT_TRUE(NavigateToURL(shell(), healthy_page));
+  auto* healthy_frame = static_cast<RenderFrameHostImpl*>(
+      shell()->web_contents()->GetPrimaryMainFrame());
+  mojo::Remote<network::mojom::URLLoaderFactory> healthy_factory;
+  const auto healthy_kind = service->CloneCommittedDocumentFactoryForTesting(
+      healthy_frame, healthy_factory.BindNewPipeAndPassReceiver());
+  ASSERT_TRUE(healthy_kind.has_value());
+  EXPECT_EQ(*healthy_kind,
+            SubresourceProxyingURLLoaderService::DocumentDefaultFactoryKind::
+                kNetworkService);
+  EXPECT_EQ(load_prefetch(healthy_factory.get(),
+                          embedded_test_server()->GetURL(
+                              "/mhtml-prefetch-health"),
+                          healthy_page, /*additional_load_flags=*/0,
+                          /*recursive=*/false),
+            (std::pair(net::OK, std::string("network-response"))));
+  EXPECT_EQ(healthy_requests->GetRequestCount(), 1);
+
+  // The archive gives its iframe an HTTP committed URL but a NotImplemented
+  // default factory. Its original restriction must survive prefetch routing.
+  const GURL child_url("http://example.com/found.html");
+  std::string archive =
+      "From: The chromium developers\n"
+      "Subject: <the subject>\n"
+      "Date: Mon, May 27 2019 11:55:42 GMT+0200\n"
+      "MIME-Version: 1.0\n"
+      "Content-Type: multipart/related; boundary=\"MHTML_BOUNDARY\"; "
+      "type=\"text/html\"\n\n"
+      "--MHTML_BOUNDARY\nContent-Type: text/html\n"
+      "Content-Location: http://example.com/\n\n"
+      "<iframe src=\"http://example.com/found.html\"></iframe>\n"
+      "--MHTML_BOUNDARY\nContent-Type: text/html\n"
+      "Content-Location: http://example.com/found.html\n\nchild\n"
+      "--MHTML_BOUNDARY--";
+  base::ReplaceChars(archive, "\n", "\r\n", &archive);
+  base::ScopedTempDir temp_dir;
+  {
+    base::ScopedAllowBlockingForTesting allow_blocking;
+    ASSERT_TRUE(temp_dir.CreateUniqueTempDir());
+    ASSERT_TRUE(base::WriteFile(temp_dir.GetPath().AppendASCII("page.mhtml"),
+                                archive));
+  }
+  ASSERT_TRUE(NavigateToURL(
+      shell(), net::FilePathToFileURL(temp_dir.GetPath().AppendASCII(
+                   "page.mhtml"))));
+  auto* main_frame = static_cast<RenderFrameHostImpl*>(
+      shell()->web_contents()->GetPrimaryMainFrame());
+  ASSERT_EQ(main_frame->child_count(), 1u);
+  auto* child_frame = main_frame->child_at(0)->current_frame_host();
+  ASSERT_TRUE(child_frame->is_mhtml_document());
+  ASSERT_EQ(child_frame->GetLastCommittedURL(), child_url);
+
+  mojo::Remote<network::mojom::URLLoaderFactory> restricted_factory;
+  const auto restricted_kind = service->CloneCommittedDocumentFactoryForTesting(
+      child_frame, restricted_factory.BindNewPipeAndPassReceiver());
+  ASSERT_TRUE(restricted_kind.has_value());
+  EXPECT_EQ(*restricted_kind,
+            SubresourceProxyingURLLoaderService::DocumentDefaultFactoryKind::
+                kPreserve);
+  EXPECT_EQ(load_prefetch(restricted_factory.get(),
+                          embedded_test_server()->GetURL(
+                              "/mhtml-prefetch-blocked"),
+                          child_url, /*additional_load_flags=*/0,
+                          /*recursive=*/false)
+                .first,
+            net::ERR_NOT_IMPLEMENTED);
+  EXPECT_EQ(load_prefetch(restricted_factory.get(),
+                          embedded_test_server()->GetURL(
+                              "/mhtml-prefetch-restricted"),
+                          child_url,
+                          net::LOAD_RESTRICTED_PREFETCH_FOR_MAIN_FRAME,
+                          /*recursive=*/false)
+                .first,
+            net::ERR_BLOCKED_BY_CLIENT);
+  EXPECT_EQ(load_prefetch(restricted_factory.get(),
+                          embedded_test_server()->GetURL(
+                              "/mhtml-prefetch-recursive"),
+                          child_url, /*additional_load_flags=*/0,
+                          /*recursive=*/true)
+                .first,
+            net::ERR_BLOCKED_BY_CLIENT);
+  EXPECT_EQ(healthy_requests->GetRequestCount(), 1);
+  EXPECT_EQ(blocked_requests->GetRequestCount(), 0);
+  EXPECT_EQ(restricted_requests->GetRequestCount(), 0);
+  EXPECT_EQ(recursive_requests->GetRequestCount(), 0);
+}
