@@ -121,6 +121,20 @@ class NetworkServiceProxyDelegateTest : public testing::Test {
     loop.Run();
   }
 
+  bool PublishAegisAccessPolicy(
+      mojom::AegisAccessPolicyPublicationMetadataPtr metadata) {
+    base::RunLoop loop;
+    std::optional<bool> accepted;
+    client_->OnAegisAccessPolicyPublished(
+        std::move(metadata),
+        base::BindLambdaForTesting([&](bool value) {
+          accepted = value;
+          loop.Quit();
+        }));
+    loop.Run();
+    return accepted.value_or(false);
+  }
+
   void RunUntilIdle() { task_environment_.RunUntilIdle(); }
 
   TestCustomProxyConnectionObserver* TestObserver() const { return observer_; }
@@ -134,6 +148,58 @@ class NetworkServiceProxyDelegateTest : public testing::Test {
   base::test::TaskEnvironment task_environment_;
 };
 
+TEST_F(NetworkServiceProxyDelegateTest,
+       AegisAccessPolicyPublicationAcknowledgesOnlyValidExactMetadata) {
+  auto config = mojom::CustomProxyConfig::New();
+  auto delegate = CreateDelegate(std::move(config));
+
+  auto valid = mojom::AegisAccessPolicyPublicationMetadata::New();
+  valid->operation_id = "operation-42";
+  valid->operation_sequence = 42;
+  valid->policy_generation = 42;
+  valid->selection_generation = 7;
+  valid->network_epoch = 9;
+  valid->channel = 0;
+  valid->profile_token = "profile-token";
+  valid->storage_partition_token = "partition-token";
+  auto same = valid->Clone();
+  auto older = valid->Clone();
+  auto wrong_partition = valid->Clone();
+  auto changed_version = valid->Clone();
+  EXPECT_TRUE(PublishAegisAccessPolicy(std::move(valid)));
+  EXPECT_TRUE(PublishAegisAccessPolicy(std::move(same)));
+  older->operation_sequence = 41;
+  older->policy_generation = 41;
+  older->operation_id = "operation-41";
+  EXPECT_FALSE(PublishAegisAccessPolicy(std::move(older)));
+  wrong_partition->storage_partition_token = "other-partition";
+  EXPECT_FALSE(PublishAegisAccessPolicy(std::move(wrong_partition)));
+  changed_version->network_epoch = 10;
+  EXPECT_FALSE(PublishAegisAccessPolicy(std::move(changed_version)));
+
+  auto stale = mojom::AegisAccessPolicyPublicationMetadata::New();
+  stale->operation_id = "operation-42";
+  stale->operation_sequence = 42;
+  stale->policy_generation = 41;
+  stale->selection_generation = 7;
+  stale->network_epoch = 9;
+  stale->channel = 0;
+  stale->profile_token = "profile-token";
+  stale->storage_partition_token = "partition-token";
+  EXPECT_FALSE(PublishAegisAccessPolicy(std::move(stale)));
+
+  auto wrong_owner = mojom::AegisAccessPolicyPublicationMetadata::New();
+  wrong_owner->operation_id = "operation-43";
+  wrong_owner->operation_sequence = 43;
+  wrong_owner->policy_generation = 43;
+  wrong_owner->selection_generation = 0;
+  wrong_owner->network_epoch = 10;
+  wrong_owner->channel = 4;
+  wrong_owner->profile_token = "profile-token";
+  wrong_owner->storage_partition_token = "partition-token";
+  EXPECT_FALSE(PublishAegisAccessPolicy(std::move(wrong_owner)));
+}
