diff --git a/services/network/network_service_proxy_delegate.cc b/services/network/network_service_proxy_delegate.cc
index 8075625c0c..7a1888a1af 100644
--- a/services/network/network_service_proxy_delegate.cc
+++ b/services/network/network_service_proxy_delegate.cc
@@ -197,6 +197,42 @@ void NetworkServiceProxyDelegate::OnCustomProxyConfigUpdated(
   std::move(callback).Run();
 }
 
+void NetworkServiceProxyDelegate::OnAegisAccessPolicyPublished(
+    mojom::AegisAccessPolicyPublicationMetadataPtr metadata,
+    OnAegisAccessPolicyPublishedCallback callback) {
+  const bool valid =
+      metadata && !metadata->operation_id.empty() &&
+      metadata->operation_sequence != 0 && metadata->policy_generation != 0 &&
+      metadata->policy_generation == metadata->operation_sequence &&
+      metadata->network_epoch != 0 && metadata->channel <= 3 &&
+      !metadata->profile_token.empty() &&
+      !metadata->storage_partition_token.empty();
+  if (!valid) {
+    std::move(callback).Run(false);
+    return;
+  }
+  // This channel belongs to one browser-owned NetworkContext. Bind its owner
+  // on first publication and retain a monotonic publication receipt. Routing
+  // policy itself remains in the browser request runtime, never in SQLite here.
+  if (aegis_policy_publication_) {
+    const auto& current = *aegis_policy_publication_;
+    if (metadata->channel != current.channel ||
+        metadata->profile_token != current.profile_token ||
+        metadata->storage_partition_token != current.storage_partition_token ||
+        metadata->operation_sequence < current.operation_sequence ||
+        metadata->network_epoch < current.network_epoch ||
+        (metadata->selection_generation != 0 &&
+         metadata->selection_generation < current.selection_generation) ||
+        (metadata->operation_sequence == current.operation_sequence &&
+         !metadata->Equals(current))) {
+      std::move(callback).Run(false);
+      return;
+    }
+  }
+  aegis_policy_publication_ = std::move(metadata);
+  std::move(callback).Run(true);
+}
