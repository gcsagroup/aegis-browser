-// Client to update the custom proxy config.
+// Exact browser-owned identity for one Aegis Access policy candidate. The
+// NetworkContext ACKs only the exact metadata it received; this does not grant
+// authority to read or reconstruct policy state in the Network Service.
+struct AegisAccessPolicyPublicationMetadata {
+  string operation_id;
+  uint64 operation_sequence;
+  uint64 policy_generation;
+  uint64 selection_generation;
+  uint64 network_epoch;
+  uint32 channel;
+  string profile_token;
+  string storage_partition_token;
+};
+
+// Client to update the custom proxy config and acknowledge exact Aegis Access
+// policy candidate publication.
 interface CustomProxyConfigClient {
   OnCustomProxyConfigUpdated(CustomProxyConfig proxy_config) => ();
+  OnAegisAccessPolicyPublished(AegisAccessPolicyPublicationMetadata metadata)
+      => (bool accepted);
 };
 
