+// Copyright 2026 GCSA
+
+#ifndef COMPONENTS_AEGIS_ACCESS_REQUEST_OWNERSHIP_REGISTRY_UNIT_TEST_H_
+#define COMPONENTS_AEGIS_ACCESS_REQUEST_OWNERSHIP_REGISTRY_UNIT_TEST_H_
