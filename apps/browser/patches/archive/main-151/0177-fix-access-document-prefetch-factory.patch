   BindContext& current_context = *current_bind_context();
 
-  if (!current_context.render_frame_host) {
+  // The receiver can outlive its document. Never use the frame's new committed
+  // state to start a request attributed to the old document.
+  if (!current_context.render_frame_host ||
+      current_context.document.AsRenderFrameHostIfValid() !=
+          current_context.render_frame_host.get()) {
     mojo::Remote<network::mojom::URLLoaderClient>(std::move(client))
         ->OnComplete(network::URLLoaderCompletionStatus(net::ERR_ABORTED));
     return;
   }
 
-  scoped_refptr<network::SharedURLLoaderFactory> network_loader_factory_to_use =
-      current_context.factory;
+  scoped_refptr<network::SharedURLLoaderFactory> network_loader_factory_to_use;
 
   // The request must not already have its `trusted_params` initialized.
   if (resource_request.trusted_params) {
@@ -143,6 +147,22 @@ void PrefetchURLLoaderServiceContext::CreatePrefetchLoaderAndStart(
     resource_request.trusted_params->isolation_info =
         isolation_info_iterator->second;
     network_loader_factory_to_use = current_context.cross_origin_factory;
+  } else {
+    // Build this factory only after the document commits. The ordinary
+    // subresource factory bundle was cloned before commit, so its default
+    // factory can miss embedder interception installed for the document.
+    if (!current_context.document_prefetch_factory) {
+      auto factories =
+          std::make_unique<blink::PendingURLLoaderFactoryBundle>();
+      factories->set_bypass_redirect_checks(
+          current_context.render_frame_host->CreateNetworkServiceDefaultFactory(
+              factories->pending_default_factory()
+                  .InitWithNewPipeAndPassReceiver()));
+      current_context.document_prefetch_factory =
+          network::SharedURLLoaderFactory::Create(std::move(factories));
+    }
+    network_loader_factory_to_use =
+        current_context.document_prefetch_factory;
   }
 
   if (prefetch_load_callback_for_testing_) {
