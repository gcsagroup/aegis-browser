+IN_PROC_BROWSER_TEST_F(PrefetchBrowserTestBase,
+                       StaleDocumentPrefetchFactoryAbortsBeforeNetwork) {
+  embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+      [](const net::test_server::HttpRequest&)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+        response->set_content("ok");
+        return response;
+      }));
+  auto healthy_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/prefetch-health");
+  auto stale_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/prefetch-stale");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  DisableBackForwardCacheForTesting(shell()->web_contents(),
+                                    BackForwardCache::TEST_REQUIRES_NO_CACHING);
+  ASSERT_TRUE(NavigateToURL(shell(), embedded_test_server()->GetURL("/first")));
+
+  auto* partition = static_cast<StoragePartitionImpl*>(
+      shell()->web_contents()->GetBrowserContext()->GetDefaultStoragePartition());
+  auto* service = partition->GetSubresourceProxyingURLLoaderService();
+  auto* first_frame = static_cast<RenderFrameHostImpl*>(
+      shell()->web_contents()->GetPrimaryMainFrame());
+  const WeakDocumentPtr first_document = first_frame->GetWeakDocumentPtr();
+
+  auto load_prefetch = [&](network::mojom::URLLoaderFactory* factory,
+                           const GURL& url) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->load_flags = net::LOAD_PREFETCH;
+    request->destination = network::mojom::RequestDestination::kDocument;
+    request->request_initiator =
+        url::Origin::Create(embedded_test_server()->GetURL("/first"));
+    auto loader = network::SimpleURLLoader::Create(
+        std::move(request), TRAFFIC_ANNOTATION_FOR_TESTS);
+    base::test::TestFuture<std::optional<std::string>> result;
+    loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+        factory, result.GetCallback());
+    EXPECT_TRUE(result.Wait());
+    return loader->NetError();
+  };
+
+  mojo::Remote<network::mojom::URLLoaderFactory> healthy_factory;
+  auto healthy_context = service->GetFactory(
+      healthy_factory.BindNewPipeAndPassReceiver(),
+      first_frame->GetFrameTreeNodeId(),
+      partition->GetURLLoaderFactoryForBrowserProcess(),
+      first_frame->GetWeakPtr(), nullptr);
+  healthy_context->OnDidCommitNavigation(first_document);
+  EXPECT_EQ(load_prefetch(healthy_factory.get(),
+                          embedded_test_server()->GetURL("/prefetch-health")),
+            net::OK);
+  EXPECT_EQ(healthy_requests->GetRequestCount(), 1);
+  EXPECT_EQ(stale_requests->GetRequestCount(), 0);
+
+  ASSERT_TRUE(NavigateToURL(shell(), embedded_test_server()->GetURL("/second")));
+  ASSERT_EQ(first_document.AsRenderFrameHostIfValid(), nullptr);
+  auto* current_frame = static_cast<RenderFrameHostImpl*>(
+      shell()->web_contents()->GetPrimaryMainFrame());
+
+  // Bind the expired document to a live frame to exercise the document guard
+  // independently of the existing RenderFrameHost liveness guard.
+  mojo::Remote<network::mojom::URLLoaderFactory> stale_factory;
+  auto stale_context = service->GetFactory(
+      stale_factory.BindNewPipeAndPassReceiver(),
+      current_frame->GetFrameTreeNodeId(),
+      partition->GetURLLoaderFactoryForBrowserProcess(),
+      current_frame->GetWeakPtr(), nullptr);
+  stale_context->OnDidCommitNavigation(first_document);
+  EXPECT_EQ(load_prefetch(stale_factory.get(),
+                          embedded_test_server()->GetURL("/prefetch-stale")),
+            net::ERR_ABORTED);
+  EXPECT_EQ(healthy_requests->GetRequestCount(), 1);
+  EXPECT_EQ(stale_requests->GetRequestCount(), 0);
+}
