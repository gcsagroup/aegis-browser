 namespace {
 
 constexpr char kTargetHost[] = "target.example";
@@ -30,6 +41,8 @@ class AccessNetworkContextTransportTest : public testing::Test {
   AccessNetworkContextTransportTest() = default;
 
   void SetUp() override {
