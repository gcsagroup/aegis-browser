         override {
-      return network_loader_factory_->CreateLoaderAndStart(
-          std::move(receiver), request_id, options, request, std::move(client),
-          traffic_annotation);
+      if (!require_access_route_) {
+        network_loader_factory_->CreateLoaderAndStart(
+            std::move(receiver), request_id, options, request,
+            std::move(client), traffic_annotation);
+        return;
+      }
+      auto route = request.throttling_profile_id
+                       ? access_routes_.extract(*request.throttling_profile_id)
+                       : decltype(access_routes_)::node_type();
+      if (route.empty()) {
+        mojo::Remote<mojom::URLLoaderClient>(std::move(client))->OnComplete(
+            URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
+        return;
+      }
+
+      ResourceRequest continued_request = request;
+      continued_request.throttling_profile_id = route.mapped().throttling_id;
+      network_loader_factory_->CreateLoaderAndStartWithSyncClient(
+          std::move(receiver), request_id, options, continued_request,
+          std::move(client), {}, traffic_annotation,
+          std::move(route.mapped().state));
     }
     void Clone(
         mojo::PendingReceiver<mojom::URLLoaderFactory> receiver) override {
@@ -216,9 +237,77 @@ class CorsURLLoaderFactory::FactoryOverride final {
       return network_loader_factory_->GetDevToolsObserver();
     }
 
+    void RequireAccessRoute() { require_access_route_ = true; }
+    bool requires_access_route() const { return require_access_route_; }
+
+    void RegisterAccessRoute(
+        const base::UnguessableToken& token,
+        scoped_refptr<AccessRequestRouteState> state,
+        std::optional<base::UnguessableToken> throttling_id) {
+      CHECK(require_access_route_);
+      CHECK(access_routes_
+                .try_emplace(token, AccessContinuation{std::move(state),
+                                                      throttling_id})
+                .second);
+    }
+
+    void DiscardAccessRoute(const base::UnguessableToken& token) {
+      access_routes_.erase(token);
+    }
+
    private:
+    struct AccessContinuation {
+      scoped_refptr<AccessRequestRouteState> state;
+      std::optional<base::UnguessableToken> throttling_id;
+    };
+
     std::unique_ptr<network::URLLoaderFactory> network_loader_factory_;
     mojo::ReceiverSet<mojom::URLLoaderFactory> receivers_;
+    bool require_access_route_ = false;
+    std::map<base::UnguessableToken, AccessContinuation> access_routes_;
+  };
+
+  // 与单个 CORS loader 同寿命。真实续传消耗标识，合成响应和取消由
+  // 析构时回收。预检或重建 loader 时各自分配标识，仍共享本请求路由。
+  class AccessRouteFactory final : public mojom::URLLoaderFactory {
+   public:
+    AccessRouteFactory(FactoryOverride* owner,
+                       scoped_refptr<AccessRequestRouteState> state)
+        : owner_(owner), state_(std::move(state)) {}
+    ~AccessRouteFactory() override {
+      for (const auto& token : tokens_) {
+        owner_->network_loader_factory_.DiscardAccessRoute(token);
+      }
+    }
+
+    void CreateLoaderAndStart(
+        mojo::PendingReceiver<mojom::URLLoader> receiver,
+        int32_t request_id,
+        uint32_t options,
+        const ResourceRequest& request,
+        mojo::PendingRemote<mojom::URLLoaderClient> client,
+        const net::MutableNetworkTrafficAnnotationTag& annotation) override {
+      const auto& token = tokens_.emplace_back(base::UnguessableToken::Create());
+      owner_->network_loader_factory_.RegisterAccessRoute(
+          token, state_, request.throttling_profile_id);
+      ResourceRequest intercepted_request = request;
+      // DevTools 覆盖工厂只透传此字段，网络限速在返回后的 URLLoader 层
+      // 生效。只在这对专用 Mojo 端点之间携带标识，续传时恢复原字段。
+      intercepted_request.throttling_profile_id = token;
+      owner_->get()->CreateLoaderAndStart(std::move(receiver), request_id, options,
+                                         intercepted_request, std::move(client),
+                                         annotation);
+    }
+
+    void Clone(mojo::PendingReceiver<mojom::URLLoaderFactory> receiver) override {
+      receivers_.Add(this, std::move(receiver));
+    }
+
+   private:
+    const raw_ptr<FactoryOverride> owner_;
+    const scoped_refptr<AccessRequestRouteState> state_;
+    std::vector<base::UnguessableToken> tokens_;
+    mojo::ReceiverSet<mojom::URLLoaderFactory> receivers_;
   };
 
   FactoryOverride(
@@ -235,6 +324,11 @@ class CorsURLLoaderFactory::FactoryOverride final {
 
   mojom::URLLoaderFactory* get() { return overriding_factory_.get(); }
 
+  void RequireAccessRoute() { network_loader_factory_.RequireAccessRoute(); }
+  bool requires_access_route() const {
+    return network_loader_factory_.requires_access_route();
+  }
+
   bool ShouldSkipCorsEnabledSchemeCheck() {
     return skip_cors_enabled_scheme_check_;
   }
@@ -422,6 +516,12 @@ void CorsURLLoaderFactory::CreateLoaderAndStart(
       resource_request, std::move(client), traffic_annotation, nullptr);
 }
 
+void CorsURLLoaderFactory::RequireAccessRouteForOverride() {
+  if (factory_override_) {
+    factory_override_->RequireAccessRoute();
+  }
+}
+
 void CorsURLLoaderFactory::CreateLoaderAndStartWithAccessRoute(
