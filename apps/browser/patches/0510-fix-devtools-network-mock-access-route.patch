@@ -453,8 +553,12 @@ void CorsURLLoaderFactory::CreateLoaderAndStartWithAccessRoute(
   }
 
   if (access_route_state &&
-      (factory_override_ || resource_request.web_bundle_token_params ||
-       resource_request.destination == mojom::RequestDestination::kWebBundle)) {
+      (resource_request.web_bundle_token_params ||
+       resource_request.destination == mojom::RequestDestination::kWebBundle ||
+       (factory_override_ &&
+        (!factory_override_->requires_access_route() ||
+         factory_override_->ShouldSkipCorsEnabledSchemeCheck() ||
+         disable_web_security_)))) {
     mojo::Remote<mojom::URLLoaderClient>(std::move(client))->OnComplete(
         URLLoaderCompletionStatus(net::ERR_BLOCKED_BY_CLIENT));
     return;
@@ -547,8 +651,13 @@ void CorsURLLoaderFactory::CreateLoaderAndStartWithAccessRoute(
       // in this shared native storage.
       shared_dictionary_storage.reset();
       resource_request.shared_dictionary_writer_enabled = false;
-      private_factory = std::make_unique<AccessRouteBoundURLLoaderFactory>(
-          network_loader_factory_.get(), access_route_state);
+      if (factory_override_) {
+        private_factory = std::make_unique<FactoryOverride::AccessRouteFactory>(
+            factory_override_.get(), access_route_state);
+      } else {
+        private_factory = std::make_unique<AccessRouteBoundURLLoaderFactory>(
+            network_loader_factory_.get(), access_route_state);
+      }
     }
     std::unique_ptr<CorsURLLoader> loader = std::make_unique<CorsURLLoader>(
         std::move(receiver), process_id_, request_id, options,
