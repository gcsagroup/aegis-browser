From 0916bd98524e800e4fd88b6fd1a0f3d6abe6f0c4 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Thu, 12 Nov 2026 01:19:22 +0800
Subject: [PATCH] feat(access): admit private macOS Alpha and Beta test nodes

---
 chrome/BUILD.gn                               |  4 +--
 chrome/browser/aegis/access/BUILD.gn          | 32 ++++++++++++++-----
 .../aegis/access/access_build_channel.cc      | 27 +++++++++++++---
 .../aegis/access/access_build_channel.h       |  4 ++-
 .../aegis/access/access_local_core_manager.cc | 20 ++++++++----
 .../aegis/access/access_local_core_manager.h  |  2 +-
 .../access_local_core_manager_unittest.cc     | 16 ++++++++--
 .../access/access_service_coordinator.cc      |  3 +-
 .../access_site_proxy_bubble_controller.cc    |  4 +--
 .../access_site_proxy_product_unittest.cc     |  4 +--
 chrome/browser/aegis/access/alpha_access.gni  | 20 +++++++++---
 .../access/prepare_alpha_access_resources.py  | 18 +++++------
 .../prepare_alpha_access_resources_test.py    | 15 ++++++++-
 .../verify_no_alpha_access_resources.py       |  8 ++---
 14 files changed, 127 insertions(+), 50 deletions(-)

diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index f8e7701432de883f07b68053e166811f6eebda80..08af2daeeb3e6865effb0cdd548566b007c03c4c 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1407,7 +1407,7 @@ if (is_win) {
     ]
 
     public_deps = [ ":chrome_dll" ]
-    if (!aegis_alpha_test_node_enabled) {
+    if (!aegis_private_test_node_enabled) {
       public_deps +=
           [ "//chrome/browser/aegis/access:alpha_test_resource_guard" ]
     }
@@ -1423,7 +1423,7 @@ if (is_win) {
       "//chrome/browser/web_applications/isolated_web_apps/key_distribution/preload:component_bundle",
       "//components/privacy_sandbox/privacy_sandbox_attestations/preload:component_bundle",
     ]
-    if (aegis_alpha_test_node_enabled) {
+    if (aegis_private_test_node_enabled) {
       bundle_deps +=
           [ "//chrome/browser/aegis/access:alpha_access_bundle_data" ]
     }
diff --git a/chrome/browser/aegis/access/BUILD.gn b/chrome/browser/aegis/access/BUILD.gn
index ba2ef93753d931f45f77b39c415d914ca0bfae95..35d16216da660d57ca57f0857746b5a2ce507a9a 100644
--- a/chrome/browser/aegis/access/BUILD.gn
+++ b/chrome/browser/aegis/access/BUILD.gn
@@ -7,16 +7,29 @@ import("//testing/test.gni")
 
 buildflag_header("access_buildflags") {
   header = "access_buildflags.h"
-  flags = [ "AEGIS_ALPHA_TEST_NODE_ENABLED=$aegis_alpha_test_node_enabled" ]
+  allow_dev_files = !is_official_build
+  flags = [
+    "AEGIS_DEV_LOCAL_NODE_ALLOWED=$allow_dev_files",
+    "AEGIS_PRIVATE_TEST_NODE_ENABLED=$aegis_private_test_node_enabled",
+    "AEGIS_BETA_TEST_NODE_ENABLED=$aegis_beta_test_node_enabled",
+  ]
 }
 
-if (aegis_alpha_test_node_enabled) {
+if (aegis_private_test_node_enabled) {
+  private_channel = "alpha"
+  private_dir = aegis_alpha_test_resources_dir
+  if (aegis_beta_test_node_enabled) {
+    private_channel = "beta"
+    private_dir = aegis_beta_test_resources_dir
+  }
+  # Both variants overwrite the same three resources. This also keeps the
+  # normal-build guard effective for output directories reused across channels.
   action("alpha_access_resource_files") {
     script = "prepare_alpha_access_resources.py"
     inputs = [
-      "$aegis_alpha_test_resources_dir/core-manifest.json",
-      "$aegis_alpha_test_resources_dir/node.json",
-      "$aegis_alpha_test_resources_dir/xray",
+      "$private_dir/core-manifest.json",
+      "$private_dir/node.json",
+      "$private_dir/xray",
     ]
     outputs = [
       "$root_out_dir/AegisAlphaAccess/core-manifest.json",
@@ -25,9 +38,9 @@ if (aegis_alpha_test_node_enabled) {
     ]
     args = [
       "--channel",
-      "alpha",
+      private_channel,
       "--source-dir",
-      rebase_path(aegis_alpha_test_resources_dir, root_build_dir),
+      rebase_path(private_dir, root_build_dir),
       "--output-dir",
       rebase_path("$root_out_dir/AegisAlphaAccess", root_build_dir),
     ]
@@ -75,13 +88,14 @@ source_set("access_local_core_manager") {
     sources += [ "access_local_core_manager_unavailable.cc" ]
   }
   deps = [
+    ":access_build_channel",
     ":access_buildflags",
     "//base",
     "//crypto",
     "//net",
     "//url",
   ]
-  if (aegis_alpha_test_node_enabled) {
+  if (aegis_private_test_node_enabled) {
     data_deps = [ ":alpha_access_resource_files" ]
   } else {
     data_deps = [ ":alpha_test_resource_guard" ]
@@ -110,6 +124,7 @@ test("access_local_core_manager_unittests") {
     sources = [ "access_local_core_manager_unavailable_unittest.cc" ]
   }
   deps = [
+    ":access_build_channel",
     ":access_buildflags",
     ":access_local_core_manager",
     "//base",
@@ -344,6 +359,7 @@ source_set("access_service_coordinator") {
   ]
   deps = [
     ":access_async_rule_store",
+    ":access_build_channel",
     ":access_identity_generation_source",
     ":access_proxy_selection_generation_source",
     ":access_published_request_runtime",
diff --git a/chrome/browser/aegis/access/access_build_channel.cc b/chrome/browser/aegis/access/access_build_channel.cc
index c446f9b69ab4c6a76e6222f18524a89d567b073f..f91e3e05582b7b4adfa7a042f4974263661ceafd 100644
--- a/chrome/browser/aegis/access/access_build_channel.cc
+++ b/chrome/browser/aegis/access/access_build_channel.cc
@@ -25,12 +25,29 @@ aegis_access::BrowserReleaseChannel BrowserReleaseChannel() {
 }
 }  // namespace
 
+aegis_access::ChannelNamespace BundledAccessTestChannel() {
+#if BUILDFLAG(AEGIS_BETA_TEST_NODE_ENABLED)
+  return aegis_access::ChannelNamespace::kBeta;
+#elif BUILDFLAG(AEGIS_PRIVATE_TEST_NODE_ENABLED)
+  return aegis_access::ChannelNamespace::kAlpha;
+#else
+  return aegis_access::ChannelNamespace::kInvalid;
+#endif
+}
+
 aegis_access::ChannelNamespace AccessChannelForCurrentBuild() {
-  auto channel = aegis_access::MapBrowserReleaseChannel(BrowserReleaseChannel());
-#if BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
-  if (channel == aegis_access::ChannelNamespace::kDev)
-    channel = aegis_access::ChannelNamespace::kAlpha;
+  const auto browser_channel = BrowserReleaseChannel();
+#if BUILDFLAG(AEGIS_PRIVATE_TEST_NODE_ENABLED)
+  // Only the unbranded UNKNOWN channel takes its identity from the build.
+  if (browser_channel == aegis_access::BrowserReleaseChannel::kUnknown)
+    return BundledAccessTestChannel();
 #endif
-  return channel;
+  return aegis_access::MapBrowserReleaseChannel(browser_channel);
+}
+
+const char* LocalAccessIdentityChannel(aegis_access::ChannelNamespace channel) {
+  if (channel == aegis_access::ChannelNamespace::kBeta) return "beta";
+  if (channel == aegis_access::ChannelNamespace::kAlpha) return "alpha";
+  return "dev";
 }
 }  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_build_channel.h b/chrome/browser/aegis/access/access_build_channel.h
index 5eed2306026a999b179ad31a08680753c23af91a..21d45462b50cf7d9f7a159be555fba8c35510662 100644
--- a/chrome/browser/aegis/access/access_build_channel.h
+++ b/chrome/browser/aegis/access/access_build_channel.h
@@ -5,8 +5,10 @@
 #include "components/aegis_access/access_route_types.h"
 
 namespace aegis::access {
-// Explicit Alpha test builds use Alpha ownership even when unbranded Chromium
+// Explicit private test builds use their selected channel even when unbranded Chromium
 // reports UNKNOWN. Chromium branding and the normal channel mapping are kept.
 aegis_access::ChannelNamespace AccessChannelForCurrentBuild();
+aegis_access::ChannelNamespace BundledAccessTestChannel();
+const char* LocalAccessIdentityChannel(aegis_access::ChannelNamespace channel);
 }  // namespace aegis::access
 #endif
diff --git a/chrome/browser/aegis/access/access_local_core_manager.cc b/chrome/browser/aegis/access/access_local_core_manager.cc
index 0b80b2bea40abb99a8818e28f50f3304941adca6..0b680a6f12acf368ff4cad26e2bc4194ba78c5af 100644
--- a/chrome/browser/aegis/access/access_local_core_manager.cc
+++ b/chrome/browser/aegis/access/access_local_core_manager.cc
@@ -30,6 +30,7 @@
 #include "base/timer/timer.h"
 #include "base/uuid.h"
 #include "base/values.h"
+#include "chrome/browser/aegis/access/access_build_channel.h"
 #include "chrome/browser/aegis/access/access_buildflags.h"
 #include "crypto/hash.h"
 #include "net/base/auth.h"
@@ -47,18 +48,24 @@
 
 namespace aegis::access {
 std::optional<AccessLocalCoreInput> ResolveAccessLocalCoreInput() {
-#if BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
+#if BUILDFLAG(AEGIS_PRIVATE_TEST_NODE_ENABLED)
+  if (AccessChannelForCurrentBuild() != BundledAccessTestChannel())
+    return std::nullopt;
   base::FilePath assets;
   if (!base::PathService::Get(base::DIR_ASSETS, &assets)) return std::nullopt;
   assets = assets.AppendASCII("AegisAlphaAccess");
   return AccessLocalCoreInput{assets.AppendASCII("core-manifest.json"),
-      assets.AppendASCII("node.json"), AccessLocalCoreSource::kAlphaBundle};
-#else
+      assets.AppendASCII("node.json"), AccessLocalCoreSource::kPrivateTestBundle};
+#elif BUILDFLAG(AEGIS_DEV_LOCAL_NODE_ALLOWED)
+  if (AccessChannelForCurrentBuild() != aegis_access::ChannelNamespace::kDev)
+    return std::nullopt;
   const auto* command = base::CommandLine::ForCurrentProcess();
   auto manifest = command->GetSwitchValuePath("aegis-access-dev-core-manifest");
   auto node = command->GetSwitchValuePath("aegis-access-dev-node-config");
   if (manifest.empty() || node.empty()) return std::nullopt;
   return AccessLocalCoreInput{std::move(manifest), std::move(node)};
+#else
+  return std::nullopt;
 #endif
 }
 namespace {
@@ -224,13 +231,14 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
     auto node = base::JSONReader::ReadDict(node_json, base::JSON_PARSE_RFC);
     if (!manifest || !node) return false;
     base::FilePath binary;
-    if (input_.source == AccessLocalCoreSource::kAlphaBundle) {
-#if BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
+    if (input_.source == AccessLocalCoreSource::kPrivateTestBundle) {
+#if BUILDFLAG(AEGIS_PRIVATE_TEST_NODE_ENABLED)
       const auto* channel = manifest->FindString("channel");
       const auto* relative = manifest->FindString("binaryRelativePath");
       const auto* node_name = manifest->FindString("nodeConfigRelativePath");
       const auto* node_pin = manifest->FindString("nodeConfigSha256");
-      if (manifest->FindInt("schemaVersion") != 1 || !channel || *channel != "alpha" ||
+      if (manifest->FindInt("schemaVersion") != 1 || !channel ||
+          *channel != LocalAccessIdentityChannel(BundledAccessTestChannel()) ||
           !relative || *relative != "xray" || !node_name || *node_name != "node.json" ||
           input_.node_config != input_.manifest.DirName().AppendASCII("node.json") ||
           !node_pin || base::HexEncodeLower(crypto::hash::Sha256(base::as_byte_span(node_json))) != *node_pin)
diff --git a/chrome/browser/aegis/access/access_local_core_manager.h b/chrome/browser/aegis/access/access_local_core_manager.h
index 97997097c479c7f8e302d7af1dcd1d1222a4cfe6..08796f8e5c86e095ec975957ad3f6485f14bc7d4 100644
