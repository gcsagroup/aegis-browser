diff --git a/chrome/browser/aegis/access/alpha_access.gni b/chrome/browser/aegis/access/alpha_access.gni
index 84d5b0b7f9f9f7db9dc5a79d189e1532429dc0cf..bd1b3a851d1f4104a4386892ce19a269852d85b5 100644
--- a/chrome/browser/aegis/access/alpha_access.gni
+++ b/chrome/browser/aegis/access/alpha_access.gni
@@ -1,13 +1,23 @@
 # Copyright 2026 GCSA
 
+import("//build/config/chrome_build.gni")
+
 declare_args() {
-  # Explicit local Alpha test build. Normal Dev/Beta/Release builds have no
-  # bundled node, executable, or private resource dependency.
   aegis_alpha_test_node_enabled = false
   aegis_alpha_test_resources_dir = ""
+  aegis_beta_test_node_enabled = false
+  aegis_beta_test_resources_dir = ""
 }
 
-assert(!aegis_alpha_test_node_enabled || (is_mac && !is_official_build),
-       "The built-in test node is limited to non-official macOS Alpha builds.")
+assert(!(aegis_alpha_test_node_enabled && aegis_beta_test_node_enabled),
+       "Select one private test channel per build.")
 assert(aegis_alpha_test_node_enabled == (aegis_alpha_test_resources_dir != ""),
-       "Alpha test resources require the explicit Alpha test build flag.")
+       "Alpha resources require an explicit Alpha test build.")
+assert(aegis_beta_test_node_enabled == (aegis_beta_test_resources_dir != ""),
+       "Beta resources require an explicit Beta test build.")
+
+aegis_private_test_node_enabled =
+    aegis_alpha_test_node_enabled || aegis_beta_test_node_enabled
+assert(!aegis_private_test_node_enabled ||
+           (is_mac && !is_official_build && !is_chrome_branded),
+       "Private test nodes require a non-official, unbranded macOS test build.")
diff --git a/chrome/browser/aegis/access/prepare_alpha_access_resources.py b/chrome/browser/aegis/access/prepare_alpha_access_resources.py
index 2090af3960b32e1fa024c1948fa973a943d9e195..10a9db3b6a11930020e2de8cfda5089e02df86e7 100644
--- a/chrome/browser/aegis/access/prepare_alpha_access_resources.py
+++ b/chrome/browser/aegis/access/prepare_alpha_access_resources.py
@@ -1,5 +1,5 @@
 #!/usr/bin/env python3
-"""Stage private Alpha Access inputs without printing node values."""
+"""Stage private Access inputs without printing node values."""
 
 import argparse
 import hashlib
@@ -10,25 +10,25 @@ import tempfile
 
 
 def stage(source: Path, output: Path, channel: str) -> None:
-    if channel != "alpha":
-        raise ValueError("Test resources are restricted to the Alpha channel")
+    if channel not in ("alpha", "beta"):
+        raise ValueError("Test resources are restricted to Alpha and Beta")
     manifest_bytes = (source / "core-manifest.json").read_bytes()
     manifest = json.loads(manifest_bytes)
-    if (manifest.get("schemaVersion") != 1 or manifest.get("channel") != "alpha"
+    if (manifest.get("schemaVersion") != 1 or manifest.get("channel") != channel
             or manifest.get("binaryRelativePath") != "xray"
             or manifest.get("nodeConfigRelativePath") != "node.json"):
-        raise ValueError("Invalid Alpha resource manifest")
+        raise ValueError("Invalid private resource manifest")
     binary = (source / "xray").read_bytes()
     node_bytes = (source / "node.json").read_bytes()
     if (hashlib.sha256(binary).hexdigest() != manifest.get("binarySha256")
             or hashlib.sha256(node_bytes).hexdigest() != manifest.get("nodeConfigSha256")):
-        raise ValueError("Alpha resource pin mismatch")
+        raise ValueError("Private resource pin mismatch")
     node = json.loads(node_bytes)
     outbound = node.get("outbounds", [None])[0]
     if (not isinstance(outbound, dict) or outbound.get("protocol") != "vless"
             or outbound.get("streamSettings", {}).get("network") != "tcp"
             or outbound.get("streamSettings", {}).get("security") != "reality"):
-        raise ValueError("Unsupported Alpha test transport")
+        raise ValueError("Unsupported private test transport")
     output.mkdir(parents=True, exist_ok=True, mode=0o700)
     os.chmod(output, 0o700)
     # Replace inodes, so an already assembled/running immutable candidate
@@ -36,7 +36,7 @@ def stage(source: Path, output: Path, channel: str) -> None:
     for name, data, mode in (("core-manifest.json", manifest_bytes, 0o600),
                              ("node.json", node_bytes, 0o600),
                              ("xray", binary, 0o700)):
-        descriptor, temporary = tempfile.mkstemp(dir=output, prefix=".alpha-")
+        descriptor, temporary = tempfile.mkstemp(dir=output, prefix=".private-")
         try:
             with os.fdopen(descriptor, "wb") as stream:
                 os.fchmod(stream.fileno(), mode)
@@ -57,7 +57,7 @@ def main() -> int:
