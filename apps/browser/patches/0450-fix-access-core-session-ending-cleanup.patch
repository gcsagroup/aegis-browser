+void AccessLocalCoreManager::ShutdownHandle::StopOnCoreThread() {
+  if (!worker_) {
+    CompleteStop();
+    return;
+  }
+  worker_->Stop(base::BindOnce([](std::shared_ptr<ShutdownHandle> handle) {
+    handle->CompleteStop();
+  }, shared_from_this()));
+}
