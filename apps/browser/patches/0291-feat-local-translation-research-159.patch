+// Copyright 2026 GCSA
+// 每次任务独占 Worker；取消或离开页面会终止推理并释放模型。
+import {getTrustedScriptURL} from '//resources/js/static_types.js';
+export class LocalAiClient {
+  private worker: Worker|null = null;
+  private reject: ((error: Error) => void)|null = null;
+  private timer = 0;
+  cancel(reason = 'cancelled') {
+    window.clearTimeout(this.timer);
+    this.worker?.terminate();
+    this.worker = null;
+    this.reject?.(new Error(reason));
+    this.reject = null;
+  }
+  async run(request: Record<string, unknown>, progress: (text: string) => void): Promise<any> {
+    this.cancel();
+    return new Promise((resolve, reject) => {
+      this.reject = reject;
+      const worker = new Worker(getTrustedScriptURL`./local_ai/worker.js` as string, {type: 'module'});
+      this.worker = worker;
+      this.timer = window.setTimeout(() => this.cancel('runtime_timeout'), request['op'] === 'download' ? 600000 : 180000);
+      const finish = () => {
+        window.clearTimeout(this.timer);
+        worker.terminate();
+        if (this.worker === worker) { this.worker = null; this.reject = null; }
+      };
+      worker.onmessage = ({data}) => {
+        if (data.progress) { progress(data.progress); return; }
+        finish();
+        if (data.error) reject(new Error(data.error)); else resolve(data.result);
+      };
+      worker.onerror = () => { finish(); reject(new Error('runtime_unavailable')); };
+      worker.postMessage(request);
+    });
+  }
+}
