+      (private_route_ && !private_control_.is_connected())) {
+    FailClosed(/*complete_registry=*/true);
+    return;
+  }
   if (!RebindOwnershipForRedirect(follow_url)) {
     FailClosed(/*complete_registry=*/ownership_registered_);
     return;
