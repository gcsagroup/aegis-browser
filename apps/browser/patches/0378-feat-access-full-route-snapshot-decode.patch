+# Decode the full Browser snapshot before changing live Network authority.
+test("access_route_wire_unittests") {
+  sources = [
+    "access_network_test_main.cc",
+    "access_route_wire_unittest.cc",
+  ]
+  deps = [
+    "//base",
+    "//base/test:test_support",
+    "//mojo/core/embedder",
+    "//net",
+    "//services/network/aegis:access_route_registry",
+    "//testing/gtest",
