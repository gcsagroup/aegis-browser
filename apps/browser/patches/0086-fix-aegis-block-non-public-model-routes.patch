From 0e50550a20cdcd9b06e72d9bd32da8033309a4e2 Mon Sep 17 00:00:00 2001
From: MacBook Pro <lazy@MacBook-Pro.local>
Date: Thu, 3 Sep 2026 00:05:18 +0800
Subject: [PATCH 86/90] fix(aegis): block non-public model routes

---
 chrome/browser/aegis/agent/agent_planner.cc        | 14 ++++----------
 .../browser/aegis/agent/agent_planner_unittest.cc  |  4 +++-
 2 files changed, 7 insertions(+), 11 deletions(-)

diff --git a/chrome/browser/aegis/agent/agent_planner.cc b/chrome/browser/aegis/agent/agent_planner.cc
index d67bef0cba..a8d4774a3c 100644
--- a/chrome/browser/aegis/agent/agent_planner.cc
+++ b/chrome/browser/aegis/agent/agent_planner.cc
@@ -14,7 +14,6 @@
 #include "base/strings/string_number_conversions.h"
 #include "base/strings/string_util.h"
 #include "chrome/browser/aegis/agent/agent_tool_registry.h"
-#include "net/base/ip_address.h"
 #include "net/base/url_util.h"
 #include "url/gurl.h"
 #include "url/origin.h"
@@ -228,17 +227,12 @@ bool GoalRequestsNamedSiteSearch(std::string_view goal) {
 bool IsModelRoutablePublicUrl(const GURL& url) {
   if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS() || url.host().empty() ||
       !url.username().empty() || !url.password().empty() ||
-      net::HostStringIsLocalhost(url.host())) {
+      net::IsHostnameNonUnique(url.HostNoBracketsPiece())) {
     return false;
   }
-  if (std::optional<net::IPAddress> literal =
-          net::IPAddress::FromIPLiteral(url.HostNoBrackets())) {
-    return literal->IsPubliclyRoutable();
-  }
-  // A model-selected single-label host is an intranet target, not an
-  // unambiguous public website. Explicit URLs supplied by the user bypass the
-  // model router and may still point at a local acceptance fixture.
-  return url.host().find('.') != std::string::npos;
+  // Explicit URLs supplied by the user bypass the model router and may still
+  // point at a local acceptance fixture.
+  return true;
 }
 
 std::string BrowserOwnedNamedSiteTarget(std::string_view goal,
diff --git a/chrome/browser/aegis/agent/agent_planner_unittest.cc b/chrome/browser/aegis/agent/agent_planner_unittest.cc
index e1a3f59569..b795469f1b 100644
--- a/chrome/browser/aegis/agent/agent_planner_unittest.cc
+++ b/chrome/browser/aegis/agent/agent_planner_unittest.cc
@@ -107,7 +107,9 @@ TEST(AegisAgentPlannerTest, GoalRouterRejectsUnsafeOrInconsistentEntry) {
 
   constexpr std::string_view kPrivateModelTargets[] = {
       "http://localhost:8000/fixture", "http://127.0.0.1/fixture",
-      "http://192.168.1.10/", "http://intranet/"};
+      "http://192.168.1.10/",          "http://intranet/",
+      "http://printer.local/",         "http://intranet.internal/",
+      "http://intranet.example/"};
   for (std::string_view target : kPrivateModelTargets) {
     EXPECT_FALSE(ParseAndValidateGoalRoute(
         GoalRouteEvent("research", "open_url", std::string(target)), &error))
-- 
2.52.0

