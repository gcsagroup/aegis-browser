     base::PassKey<ActorKeyedServiceFactory>)
-    : ProfileKeyedServiceFactory("ActorKeyedService",
-                                 ProfileSelections::BuildForRegularProfile()) {
+    : ProfileKeyedServiceFactory(
+          "ActorKeyedService",
+          ProfileSelections::BuildForRegularAndIncognito()) {
   DependsOn(IdentityManagerFactory::GetInstance());
 }
 
@@ -44,11 +47,26 @@ bool ActorKeyedServiceFactory::ServiceIsCreatedWithBrowserContext() const {
 std::unique_ptr<KeyedService>
 ActorKeyedServiceFactory::BuildServiceInstanceForBrowserContext(
     content::BrowserContext* context) const {
+  Profile* profile = Profile::FromBrowserContext(context);
+  if (!aegis::IsAegisProfileSupported(profile)) {
+    return nullptr;
+  }
+#if BUILDFLAG(IS_ANDROID)
+  // Aegis Agent's Incognito surface is currently desktop-only.
+  if (profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+#endif
   if (!base::FeatureList::IsEnabled(features::kGlicActor) &&
       !base::FeatureList::IsEnabled(aegis::features::kAegisAgent)) {
     return nullptr;
   }
-  Profile* profile = Profile::FromBrowserContext(context);
+  // Do not use the Aegis profile selection to expose Glic Actor in an
+  // Incognito Profile. The exception is owned by the Aegis Agent feature.
+  if (profile->IsOffTheRecord() &&
+      !base::FeatureList::IsEnabled(aegis::features::kAegisAgent)) {
+    return nullptr;
+  }
   return std::make_unique<ActorKeyedService>(profile);
 }
 
