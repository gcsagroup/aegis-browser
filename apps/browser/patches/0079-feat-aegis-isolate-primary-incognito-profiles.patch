+      /*create_if_needed=*/true);
+  ASSERT_TRUE(auxiliary_off_the_record);
+  ExpectUnsupported(auxiliary_off_the_record);
+}
+
+TEST_F(RendererUpdaterAegisProfileTest,
+       UsesExactPartitionsAndClearsOnlyDestroyedContext) {
+  std::unique_ptr<TestingProfile> profile_b = TestingProfile::Builder().Build();
+  Profile* profile_b_off_the_record =
+      profile_b->GetPrimaryOTRProfile(/*create_if_needed=*/true);
+
+  RendererUpdater* profile_a_regular_updater =
+      RendererUpdaterFactory::GetForProfile(regular_profile());
+  RendererUpdater* profile_a_off_the_record_updater =
+      RendererUpdaterFactory::GetForProfile(incognito_profile());
+  RendererUpdater* profile_b_regular_updater =
+      RendererUpdaterFactory::GetForProfile(profile_b.get());
+  RendererUpdater* profile_b_off_the_record_updater =
+      RendererUpdaterFactory::GetForProfile(profile_b_off_the_record);
+  ASSERT_TRUE(profile_a_regular_updater);
+  ASSERT_TRUE(profile_a_off_the_record_updater);
+  ASSERT_TRUE(profile_b_regular_updater);
+  ASSERT_TRUE(profile_b_off_the_record_updater);
+
+  const std::array<aegis::CnameCachePartitionId, 4> partitions = {
+      profile_a_regular_updater->aegis_cname_cache_partition_id(),
+      profile_a_off_the_record_updater->aegis_cname_cache_partition_id(),
+      profile_b_regular_updater->aegis_cname_cache_partition_id(),
+      profile_b_off_the_record_updater->aegis_cname_cache_partition_id()};
+  for (size_t i = 0; i < partitions.size(); ++i) {
+    EXPECT_NE(partitions[i], aegis::kInvalidCnameCachePartitionId);
+    for (size_t j = i + 1; j < partitions.size(); ++j) {
+      EXPECT_NE(partitions[i], partitions[j]);
+    }
+  }
+
+  constexpr std::string_view kHost = "metrics.shop.example";
+  aegis::CnameUncloakCache* cache = aegis::CnameUncloakCache::GetInstance();
+  cache->RememberCloakedHost(partitions[1], kHost, "stats.doubleclick.net");
+  EXPECT_FALSE(cache->IsCloakedHost(partitions[0], kHost));
+  EXPECT_TRUE(cache->IsCloakedHost(partitions[1], kHost));
+  EXPECT_FALSE(cache->IsCloakedHost(partitions[2], kHost));
+  EXPECT_FALSE(cache->IsCloakedHost(partitions[3], kHost));
+
+  for (size_t i = 0; i < partitions.size(); ++i) {
+    if (i == 1) {
+      continue;
+    }
+    cache->RememberCloakedHost(partitions[i], kHost, "stats.doubleclick.net");
+  }
+
+  regular_profile()->DestroyOffTheRecordProfile(incognito_profile());
+
+  EXPECT_TRUE(cache->IsCloakedHost(partitions[0], kHost));
+  EXPECT_FALSE(cache->IsCloakedHost(partitions[1], kHost));
+  EXPECT_TRUE(cache->IsCloakedHost(partitions[2], kHost));
+  EXPECT_TRUE(cache->IsCloakedHost(partitions[3], kHost));
+}
+
+}  // namespace
