       "//chrome/browser/aegis/access:access_proxy_selection_generation_source",
       "//chrome/browser/aegis/access:access_proxying_url_loader_factory",
       "//chrome/browser/aegis/access:access_published_request_runtime",
+      "//chrome/browser/aegis/access:access_request_dispatch_state",
       "//chrome/browser/net:impl",
       "//chrome/browser/bookmarks",
       "//chrome/browser/notifications:test_support",
@@ -264,6 +265,8 @@ if (!is_android) {
       "//chrome/common/aegis",
       "//chrome/test:test_support",
       "//chrome/test:test_support_ui",
       "//components/aegis_access",
+      "//components/aegis_access:access_identity_generation_state",
+      "//components/aegis_access:access_proxy_selection_generation_state",
       "//components/bookmarks/browser",
