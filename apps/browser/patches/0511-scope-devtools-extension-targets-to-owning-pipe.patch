 void DevToolsAgentHost::StopRemoteDebuggingPipeHandler() {
-  SetDevToolsPipeHandler(nullptr);
+  GetDevToolsPipeHandler().reset();
+}
+
+void RegisterRemoteDebuggingExtension(
+    DevToolsAgentHostClient* client,
+    std::string extension_id,
+    base::RepeatingCallback<bool(BrowserContext*)> is_enabled) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (auto* pipe = GetOwningPipe(client)) {
+    pipe->RegisterExtension(std::move(extension_id), std::move(is_enabled));
+  }
+}
+
+bool MayDebugRemoteExtension(DevToolsAgentHostClient* client,
+                            BrowserContext* browser_context,
+                            const GURL& url) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!browser_context || !url.is_valid() || !url.SchemeIs("chrome-extension")) {
+    return false;
+  }
+  auto* pipe = GetOwningPipe(client);
+  return pipe && pipe->MayDebugExtension(browser_context, url.host());
+}
+
+bool AllowRemoteDebuggingTargetUrl(
+    DevToolsManagerDelegate* delegate,
+    DevToolsAgentHostClient* client,
+    BrowserContext* browser_context,
+    DevToolsManagerDelegate::RemoteDebuggingTargetOperation operation,
+    std::string_view target_type,
+    const GURL& url) {
+  if (!delegate) {
+    return true;
+  }
+  if (!delegate->AllowRemoteDebugging()) {
+    return false;
+  }
+  if (delegate->AllowRemoteDebuggingTargetOperation(operation, target_type,
+                                                    url)) {
+    return true;
+  }
+
+  using Operation = DevToolsManagerDelegate::RemoteDebuggingTargetOperation;
+  switch (operation) {
+    case Operation::kEnumerate:
+    case Operation::kGetInfo:
+    case Operation::kAttach:
+    case Operation::kNavigate:
+    case Operation::kActivate:
+    case Operation::kClose:
+      return (target_type == DevToolsAgentHost::kTypePage ||
+              target_type == DevToolsAgentHost::kTypeTab ||
+              target_type == DevToolsAgentHost::kTypeFrame ||
+              target_type == DevToolsAgentHost::kTypeServiceWorker) &&
+             MayDebugRemoteExtension(client, browser_context, url);
+    case Operation::kWebSocketConnect:
+    case Operation::kCreate:
+    case Operation::kExposeDevToolsProtocol:
+    case Operation::kOpenDevTools:
+      return false;
+  }
+  return false;
 }
 
