+void DevToolsPipeHandler::RegisterExtension(
+    std::string extension_id,
+    base::RepeatingCallback<bool(BrowserContext*)> is_enabled) {
+  if (!shutting_down_) {
+    enabled_extensions_.insert_or_assign(std::move(extension_id),
+                                         std::move(is_enabled));
+  }
+}
+
+bool DevToolsPipeHandler::MayDebugExtension(BrowserContext* context,
+                                           std::string_view extension_id) {
+  const auto extension = enabled_extensions_.find(extension_id);
+  return extension != enabled_extensions_.end() && extension->second.Run(context);
+}
+
 void DevToolsPipeHandler::Shutdown() {
   if (shutting_down_)
     return;
   shutting_down_ = true;
+  enabled_extensions_.clear();
 
   // Disconnect from the target.
   CHECK(browser_target_, base::NotFatalUntil::M159);
