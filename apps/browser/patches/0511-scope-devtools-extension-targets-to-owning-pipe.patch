-void ExtensionsHandler::OnLoaded(std::unique_ptr<LoadUnpackedCallback> callback,
-                                 const extensions::Extension* extension,
-                                 const base::FilePath& path,
-                                 const std::u16string& err) {
+void ExtensionsHandler::OnLoaded(
+    std::unique_ptr<LoadUnpackedCallback> callback,
+    base::WeakPtr<content::BrowserContext> install_context,
+    extensions::ExtensionIdSet existing_unowned_ids,
+    const extensions::Extension* extension,
+    const base::FilePath& path,
+    const std::u16string& err) {
   if (err.empty()) {
+    // 固定密钥可能复用原有身份和存储。只授权管道新装或重新加载的开发扩展。
+    if (install_context && extension->public_key().empty() &&
+        !existing_unowned_ids.contains(extension->id())) {
+      content::RegisterRemoteDebuggingExtension(
+          client_, extension->id(),
+          base::BindRepeating(
+              [](base::WeakPtr<content::BrowserContext> installed_context,
+                 scoped_refptr<const extensions::Extension> installed,
+                 content::BrowserContext* target_context) {
+                if (installed_context.get() != target_context) {
+                  return false;
+                }
+                auto* registry =
+                    extensions::ExtensionRegistry::Get(target_context);
+                return registry &&
+                       registry->enabled_extensions().GetByID(installed->id()) ==
+                           installed.get();
+              },
+              install_context, base::WrapRefCounted(extension)));
+    }
     std::move(callback)->sendSuccess(extension->id());
     return;
   }
