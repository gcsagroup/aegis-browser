+// Copyright 2026 GCSA
+// Intended path: chrome/browser/ui/webui/aegis/aegis_ui.cc
+
+#include "chrome/browser/ui/webui/aegis/aegis_ui.h"
+
+#include "chrome/browser/profiles/profile.h"
