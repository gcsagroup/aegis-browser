   sources = [
+    "aegis_prefs.cc",
+    "aegis_prefs.h",
     "aegis_service.cc",
     "aegis_service.h",
   ]
   deps = [
     "//base",
+    "//chrome/browser/profiles:profile",
     "//chrome/common/aegis",
+    "//components/pref_registry",
+    "//components/prefs",
     "//url",
   ]
 }
