+      both.addEventListener('click', () => { for (const id of [pack.id, pack.to + '-' + pack.from]) if (this.packs.some(value => value.id === id) && (!this.statuses.get(id)?.ready || this.statuses.get(id)?.update)) this.selected.add(id); this.render(); });
