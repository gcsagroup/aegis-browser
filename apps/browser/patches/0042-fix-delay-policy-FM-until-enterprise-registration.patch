 };
+
+class NoAccountIdentityProvider final : public invalidation::IdentityProvider {
+ public:
+  CoreAccountId GetActiveAccountId() override { return CoreAccountId(); }
+
+  bool IsActiveAccountWithRefreshToken() override { return false; }
+
+  std::unique_ptr<invalidation::ActiveAccountAccessTokenFetcher>
+  FetchAccessToken(
+      const std::string& oauth_consumer_name,
+      const OAuth2AccessTokenManager::ScopeSet& scopes,
+      invalidation::ActiveAccountAccessTokenCallback callback) override {
+    ADD_FAILURE() << "未受管 Profile 不应请求 access token";
+    return nullptr;
+  }
+
+  void InvalidateAccessToken(const OAuth2AccessTokenManager::ScopeSet& scopes,
+                             const std::string& access_token) override {}
+};
+
+struct ListenerCounters {
+  size_t created = 0;
+  size_t started = 0;
+  size_t shutdown = 0;
+};
+
+class CountingInvalidationListener final
+    : public invalidation::FakeInvalidationListener {
+ public:
+  CountingInvalidationListener(int64_t project_number,
+                               ListenerCounters& counters)
+      : FakeInvalidationListener(project_number), counters_(counters) {}
+
+  void Shutdown() override {
+    EXPECT_TRUE(started_);
+    started_ = false;
+    ++counters_->shutdown;
+    FakeInvalidationListener::Shutdown();
+  }
+
+ private:
+  void Start(invalidation::RegistrationTokenHandler* handler) override {
+    EXPECT_FALSE(started_);
+    started_ = true;
+    ++counters_->started;
+  }
+
+  raw_ref<ListenerCounters> counters_;
+  bool started_ = false;
+};
 }  // namespace
 
 class FmRegistrationTokenUploaderTest : public testing::Test {
@@ -283,4 +348,147 @@ TEST_F(FmRegistrationTokenUploaderTest,
   core_.Disconnect();
 }
 
+class UserFmRegistrationTokenUploaderTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    TestingProfile::Builder profile_builder;
+    profile_builder.AddTestingFactory(
+        invalidation::ProfileInvalidationProviderFactory::GetInstance(),
+        base::BindOnce(
+            &UserFmRegistrationTokenUploaderTest::BuildInvalidationProvider,
+            base::Unretained(this)));
+    profile_ = profile_builder.Build();
+
+    auto store = std::make_unique<MockCloudPolicyStore>(
+        dm_protocol::GetChromeUserPolicyType());
+    policy_manager_ = std::make_unique<MockCloudPolicyManager>(
+        std::move(store), task_environment_.GetMainThreadTaskRunner());
+    uploader_ = std::make_unique<UserFmRegistrationTokenUploader>(
+        profile_.get(), policy_manager_.get());
+  }
+
+  void TearDown() override {
+    uploader_->Shutdown();
+    uploader_.reset();
+    profile_.reset();
+    policy_manager_.reset();
+  }
+
+  std::unique_ptr<KeyedService> BuildInvalidationProvider(
+      content::BrowserContext* context) {
+    Profile* profile = Profile::FromBrowserContext(context);
+    return std::make_unique<invalidation::ProfileInvalidationProvider>(
+        test_url_loader_factory_.GetSafeWeakWrapper(),
+        std::make_unique<NoAccountIdentityProvider>(), profile->GetPrefs(),
+        base::BindRepeating(
+            &UserFmRegistrationTokenUploaderTest::CreateListener,
+            base::Unretained(this)));
+  }
+
+  std::unique_ptr<invalidation::InvalidationListener> CreateListener(
+      int64_t project_number,
+      std::string log_prefix) {
+    ++counters_.created;
+    return std::make_unique<CountingInvalidationListener>(project_number,
+                                                          counters_);
+  }
+
+  void CompleteProfileInitialization() {
+    uploader_->OnProfileInitializationComplete(profile_.get());
+  }
+
+  MockCloudPolicyClient* ConnectClient(bool registered) {
+    auto client = std::make_unique<MockCloudPolicyClient>();
+    MockCloudPolicyClient* client_ptr = client.get();
+    if (registered) {
+      client_ptr->SetDMToken(kFakeDMToken);
+    }
+    policy_manager_->core()->Connect(std::move(client));
+    return client_ptr;
+  }
+
+  content::BrowserTaskEnvironment task_environment_;
+  network::TestURLLoaderFactory test_url_loader_factory_;
+  ListenerCounters counters_;
+  std::unique_ptr<TestingProfile> profile_;
+  std::unique_ptr<MockCloudPolicyManager> policy_manager_;
+  std::unique_ptr<UserFmRegistrationTokenUploader> uploader_;
+};
+
+TEST_F(UserFmRegistrationTokenUploaderTest,
+       UnregisteredClientDoesNotStartListeners) {
+  CompleteProfileInitialization();
+  ConnectClient(/*registered=*/false);
+
+  EXPECT_EQ(0u, counters_.created);
+  EXPECT_EQ(0u, counters_.started);
+  EXPECT_EQ(0u, counters_.shutdown);
+}
+
+TEST_F(UserFmRegistrationTokenUploaderTest,
+       FirstRegistrationStartsExactlyOnceAndSurvivesDisconnect) {
+  CompleteProfileInitialization();
+  MockCloudPolicyClient* client = ConnectClient(/*registered=*/false);
+
+  client->SetDMToken(kFakeDMToken);
+  client->NotifyRegistrationStateChanged();
+  const size_t listener_count = counters_.started;
+  ASSERT_GT(listener_count, 0u);
+  EXPECT_EQ(listener_count, counters_.created);
+  EXPECT_EQ(0u, counters_.shutdown);
+
+  client->NotifyRegistrationStateChanged();
+  EXPECT_EQ(listener_count, counters_.started);
+
+  client->SetDMToken(std::string());
+  client->NotifyRegistrationStateChanged();
+  EXPECT_EQ(listener_count, counters_.started);
+  EXPECT_EQ(0u, counters_.shutdown);
+
+  policy_manager_->core()->Disconnect();
+  ConnectClient(/*registered=*/true);
+  EXPECT_EQ(listener_count, counters_.started);
+  EXPECT_EQ(0u, counters_.shutdown);
+
+  uploader_->Shutdown();
+  EXPECT_EQ(listener_count, counters_.shutdown);
+}
+
+TEST_F(UserFmRegistrationTokenUploaderTest,
+       ReconnectBeforeFirstRegistrationStillStarts) {
+  CompleteProfileInitialization();
+  ConnectClient(/*registered=*/false);
+  policy_manager_->core()->Disconnect();
+
+  MockCloudPolicyClient* client = ConnectClient(/*registered=*/false);
+  client->SetDMToken(kFakeDMToken);
+  client->NotifyRegistrationStateChanged();
+
+  EXPECT_GT(counters_.started, 0u);
+  EXPECT_EQ(counters_.started, counters_.created);
+  EXPECT_EQ(0u, counters_.shutdown);
+}
+
+TEST_F(UserFmRegistrationTokenUploaderTest,
+       ConnectedClientStartsAfterProfileInitialization) {
+  ConnectClient(/*registered=*/true);
+  EXPECT_EQ(0u, counters_.started);
+
+  CompleteProfileInitialization();
+
+  EXPECT_GT(counters_.started, 0u);
+  EXPECT_EQ(counters_.started, counters_.created);
+  EXPECT_EQ(0u, counters_.shutdown);
+}
+
+TEST_F(UserFmRegistrationTokenUploaderTest, ShutdownDetachesObservers) {
+  CompleteProfileInitialization();
+  MockCloudPolicyClient* client = ConnectClient(/*registered=*/false);
+  uploader_->Shutdown();
+
+  client->SetDMToken(kFakeDMToken);
+  client->NotifyRegistrationStateChanged();
+  EXPECT_EQ(0u, counters_.started);
+}
+
 }  // namespace policy
