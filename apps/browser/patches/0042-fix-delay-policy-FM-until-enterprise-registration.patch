@@ -50,7 +50,7 @@ namespace policy {
 UserFmRegistrationTokenUploader::UserFmRegistrationTokenUploader(
     Profile* profile,
     CloudPolicyManager* policy_manager)
-    : policy_manager_(policy_manager) {
+    : profile_(profile), policy_manager_(policy_manager) {
   CHECK(profile);
   CHECK(policy_manager);
 
@@ -63,18 +63,96 @@ UserFmRegistrationTokenUploader::~UserFmRegistrationTokenUploader() = default;
 
 void UserFmRegistrationTokenUploader::Shutdown() {
   profile_observation_.Reset();
+  client_observation_.Reset();
+  core_observation_.Reset();
+
+  // 正常的 KeyedService 关闭顺序会先让依赖本服务的策略消费者解除
+  // listener observer，再由这里停止 FM registration handler。
   uploaders_.clear();
+
+  profile_ = nullptr;
+  policy_manager_ = nullptr;
 }
 
 void UserFmRegistrationTokenUploader::OnProfileInitializationComplete(
     Profile* profile) {
   CHECK(profile_observation_.IsObservingSource(profile));
+  CHECK_EQ(profile_, profile);
   profile_observation_.Reset();
 
-  // Initialize now that profile creation is complete and the invalidation
-  // service can safely be initialized.
+  CloudPolicyCore* core = policy_manager_->core();
+  CHECK(core);
+  core_observation_.Observe(core);
+
+  // AddObserver 不会重放已经发生的 Connect，因此需要主动检查当前状态。
+  if (core->IsConnected()) {
+    OnCoreConnected(core);
+  }
+}
+
+void UserFmRegistrationTokenUploader::OnCoreConnected(CloudPolicyCore* core) {
+  CHECK(core_observation_.IsObservingSource(core));
+  CHECK(policy_manager_);
+  CHECK_EQ(core, policy_manager_->core());
+  CHECK(core->client());
+
+  client_observation_.Reset();
+  client_observation_.Observe(core->client());
+  MaybeStartUploaders();
+}
+
+void UserFmRegistrationTokenUploader::OnRefreshSchedulerStarted(
+    CloudPolicyCore* core) {
+  CHECK(core_observation_.IsObservingSource(core));
+}
+
+void UserFmRegistrationTokenUploader::OnCoreDisconnecting(
+    CloudPolicyCore* core) {
+  CHECK(core_observation_.IsObservingSource(core));
+  client_observation_.Reset();
+
+  // uploader 必须跨 disconnect 保留。提前析构会关闭共享的 invalidation
+  // listener，而策略、远程命令等消费者此时可能仍在观察它。
+}
+
+void UserFmRegistrationTokenUploader::OnCoreDestruction(CloudPolicyCore* core) {
+  CHECK(core_observation_.IsObservingSource(core));
+
+  // 正常 Profile 生命周期会先调用 KeyedService::Shutdown()；这里仅作为
+  // Core 异常提前析构时的防御性兜底。
+  Shutdown();
+}
+
+void UserFmRegistrationTokenUploader::OnRegistrationStateChanged(
+    CloudPolicyClient* client) {
+  CHECK(client_observation_.IsObservingSource(client));
+
+  // 失去注册时不能销毁 uploader；它持有的 listener 与其他策略消费者共享。
+  if (client->is_registered()) {
+    MaybeStartUploaders();
+  }
+}
+
+void UserFmRegistrationTokenUploader::MaybeStartUploaders() {
+  if (!profile_ || !policy_manager_ || !uploaders_.empty()) {
+    return;
+  }
+
+  CloudPolicyCore* core = policy_manager_->core();
+  if (!core->IsConnected()) {
+    return;
+  }
+
+  CloudPolicyClient* client = core->client();
+  CHECK(client);
+  if (!client->is_registered()) {
+    return;
+  }
+
+  // Profile 已完成初始化且 CloudPolicyClient 已确认注册，此时才允许创建
+  // listener，避免普通未受管 Profile 在启动阶段触发 FM/GCM 注册。
   invalidation::ProfileInvalidationProvider* invalidation_provider =
-      GetInvalidationProvider(profile);
+      GetInvalidationProvider(profile_);
   if (!invalidation_provider) {
     VLOG(1) << "Invalidation provider does not exist.";
     return;
@@ -83,10 +161,10 @@ void UserFmRegistrationTokenUploader::OnProfileInitializationComplete(
   for (const int64_t project_number : GetAllInvalidationProjectNumbers()) {
     invalidation::InvalidationListener* invalidation_listener =
         invalidation_provider->GetInvalidationListener(project_number);
+    CHECK(invalidation_listener);
 
     uploaders_.emplace_back(std::make_unique<FmRegistrationTokenUploader>(
-        PolicyInvalidationScope::kUser, invalidation_listener,
-        policy_manager_->core()));
+        PolicyInvalidationScope::kUser, invalidation_listener, core));
   }
 }
 
