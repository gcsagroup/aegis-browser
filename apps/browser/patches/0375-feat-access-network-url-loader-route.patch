 }
 
+bool URLLoader::PrepareAccessRouteForSend(const GURL& target,
+                                         const std::string& method) {
+  if (!access_route_state_) {
+    return true;
+  }
+  auto decision = access_route_state_->BeginSend(
+      target, method, options_ & mojom::kURLLoadOptionAsCorsPreflight);
+  if (decision.net_error != net::OK) {
+    // ScheduleStart can run during construction, before the owner registers
+    // this URLLoader. Never delete it synchronously on a failed route gate.
+    TaskRunner(url_request_->priority())->PostTask(
+        FROM_HERE, base::BindOnce(&URLLoader::NotifyCompleted,
+                                 weak_ptr_factory_.GetWeakPtr(),
+                                 decision.net_error));
+    return false;
+  }
+  url_request_->SetAccessProxyRoute(std::move(decision.route));
+  return true;
+}
+
 URLLoader::~URLLoader() {
   TRACE_EVENT("loading", "URLLoader::~URLLoader",
               net::NetLogWithSourceToFlow(url_request_->net_log()));
@@ -781,6 +804,12 @@ void URLLoader::FollowRedirect(
     NOTREACHED();
   }
 
+  if (access_route_state_ &&
+      !PrepareAccessRouteForSend(new_url.value_or(*deferred_redirect_url_),
+                                access_redirect_method_)) {
+    return;
+  }
+
   // Note: There are some ordering dependencies here.
   // `CalculateStorageAccessStatus` depends on
   // `url_request->cookie_setting_overrides()`. `SetFetchMetadataHeaders`
@@ -975,6 +1004,18 @@ void URLLoader::OnReceivedRedirect(net::URLRequest* url_request,
   // Send the redirect response to the client, allowing them to inspect it and
   // optionally follow the redirect.
   *defer_redirect = true;
+  if (access_route_state_) {
+    if ((options_ & mojom::kURLLoadOptionAsCorsPreflight) ||
+        !access_route_state_->ObserveRedirect(redirect_info.new_url,
+                                             redirect_info.new_method)) {
+      TaskRunner(url_request_->priority())->PostTask(
+          FROM_HERE, base::BindOnce(&URLLoader::NotifyCompleted,
+                                   weak_ptr_factory_.GetWeakPtr(),
+                                   net::ERR_BLOCKED_BY_CLIENT));
+      return;
+    }
+    access_redirect_method_ = redirect_info.new_method;
+  }
 
   mojom::URLResponseHeadPtr response = BuildResponseHead();
   DispatchOnRawResponse();
@@ -2359,7 +2400,9 @@ bool URLLoader::HasDataPipe() const {
 
 void URLLoader::ResumeStart() {
   url_request_->LogUnblocked();
-  url_request_->Start();
+  if (PrepareAccessRouteForSend(url_request_->url(), url_request_->method())) {
+    url_request_->Start();
+  }
 }
 
 void URLLoader::OnBeforeSendHeadersComplete(
