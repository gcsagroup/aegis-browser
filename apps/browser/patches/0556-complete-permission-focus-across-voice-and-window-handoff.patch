+IN_PROC_BROWSER_TEST_F(OmniboxAimPopupFullWebUIBrowserTest,
+                       TabMicrophonePromptRemovedDuringHandoffBlursFullPopup) {
+  auto* other_browser = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other_browser);
+  auto* other_view = BrowserView::GetBrowserViewForBrowser(other_browser);
+  ASSERT_TRUE(other_view && other_view->GetWidget());
+  auto* other_widget = other_view->GetWidget();
+  auto* browser_widget = location_bar()->GetWidget()->GetTopLevelWidget();
+  browser_widget->Activate();
+  ui_test_utils::WaitUntilBrowserBecomeActive(browser());
+
+  ASSERT_NO_FATAL_FAILURE(ShowFocusedFullPopupWithTabMicrophonePrompt());
+  auto* controller = location_bar()->GetOmniboxController();
+  auto* presenter = location_bar()->GetOmniboxPopupView()->presenter();
+  test::PermissionRequestManagerTestApi api(browser());
+  auto* prompt_widget = api.GetPromptWindow();
+  ASSERT_TRUE(prompt_widget && prompt_widget->IsActive());
+  const auto prompt = prompt_widget->GetWeakPtr();
+  ASSERT_FALSE(other_widget->IsActive());
+
+  // Tear down the exact prompt in the same turn that it loses the key window.
+  // Its posted blur must run after the manager has removed the prompt.
+  other_widget->Activate();
+  ASSERT_TRUE(other_widget->IsActive());
+  ASSERT_TRUE(prompt && !prompt->IsActive() && !prompt->IsClosed());
+  ASSERT_FALSE(browser_widget->IsActive());
+  ASSERT_FALSE(presenter->GetWidget()->IsActive());
+  ASSERT_TRUE(controller->edit_model()->has_focus());
+  api.manager()->Dismiss(/*prompt_options=*/std::monostate());
+  ASSERT_FALSE(api.manager()->IsRequestInProgress());
+  ASSERT_FALSE(api.GetPromptWindow());
+  ASSERT_TRUE(!prompt || prompt->IsClosed());
+  ASSERT_TRUE(controller->edit_model()->has_focus());
+
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !controller->edit_model()->has_focus() &&
+           controller->popup_state_manager()->popup_state() ==
+               OmniboxPopupState::kNone;
+  }));
+  EXPECT_FALSE(presenter->IsShown());
+  EXPECT_FALSE(presenter->IsPermissionPromptPreventingClose());
+  EXPECT_TRUE(other_widget->IsActive());
+}
+
