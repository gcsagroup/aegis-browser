@@ -443,6 +458,21 @@ export class OmniboxComposeboxElement extends ComposeboxEmbedderMixin
   // Host API
   // ===========================================================================
 
+  // A browser focus request can arrive while the voice UI hides the editor.
+  // Let that session finish before focusing the editor in the rendered UI.
+  focusInputWhenVisible() {
+    if (this.inVoiceSearchMode &&
+        !this.getInputElement().inputElement.checkVisibility()) {
+      this.pendingInputFocus_ = !document.hidden;
+      return;
+    }
+    this.focusInput();
+  }
