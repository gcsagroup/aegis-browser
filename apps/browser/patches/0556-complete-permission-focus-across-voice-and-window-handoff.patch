+IN_PROC_BROWSER_TEST_F(
+    OmniboxAimPopupEmbeddedPermissionWebUILocationBarBrowserTest,
+    EmbeddedPromptEscapeRestoresInputAfterVoiceModeEnds) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  ASSERT_FALSE(browser_view->GetLocationBarView());
+  auto* bar = browser_view->GetLocationBar();
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(base::test::RunUntil([&] { return bar->GetAnchorOrNull(); }));
+
+  ASSERT_NO_FATAL_FAILURE(ShowFocusedAimPopup());
+  ASSERT_EQ(true, content::EvalJs(aim_contents_.get(), R"(
+    (async () => {
+      const app = document.querySelector('omnibox-aim-app');
+      const box = app.$.composebox;
+      // Recreate the recognizer with a local stand-in for audio/speech only.
+      // The rendered microphone still runs the real composebox click handler.
+      box.showVoiceSearch = false;
+      await box.updateComplete;
+      let speechStarts = 0;
+      window.webkitSpeechRecognition = class {
+        started = false;
+        start() {
+          this.started = true;
+          ++speechStarts;
+        }
+        stop() {
+          this.abort();
+        }
+        abort() {
+          if (this.started) {
+            this.started = false;
+            queueMicrotask(() => this.onend());
+          }
+        }
+      };
+      box.searchboxLayoutMode = 'TallBottomContext';
+      box.showVoiceSearch = true;
+      await box.updateComplete;
+      const voice = box.shadowRoot.querySelector('#voiceSearch');
+      await voice.updateComplete;
+      const input = box.getInputElement().inputElement;
+      const microphone = box.shadowRoot.querySelector('#voiceSearchButton');
+      if (!input.checkVisibility() || !microphone?.checkVisibility()) {
+        return false;
+      }
+      microphone.focus();
+      if (box.getActiveElement() !== microphone || box.isFocusInInput()) {
+        return false;
+      }
+      microphone.click();
+      await box.updateComplete;
+      window.aimVoiceTest = {box, voice, input, focusRequests: 0};
+      // Observe the existing Mojo callback without changing what it does.
+      const router = app.browserProxy_.callbackRouter;
+      const id = router.focusInput.addListener(() => {
+        ++window.aimVoiceTest.focusRequests;
+        router.removeListener(id);
+      });
+      return speechStarts === 1 && box.inVoiceSearchMode &&
+          !input.checkVisibility() && !box.isFocusInInput();
+    })()
+  )"));
+
+  ASSERT_NO_FATAL_FAILURE(ShowEmbeddedMicrophonePrompt());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return prompt_ && prompt_->IsActive() &&
+           content::EvalJs(aim_contents_.get(), R"(
+             window.aimVoiceTest.voice.isPermissionPromptOpen
+           )")
+               .ExtractBool();
+  }));
+  auto* dialog =
+      views::AsViewClass<views::DialogClientView>(prompt_->client_view());
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->AcceleratorPressed(
+      ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE)));
+  if (prompt_) {
+    EXPECT_EQ(views::Widget::ClosedReason::kEscKeyPressed,
+              prompt_->closed_reason());
+  }
+  ASSERT_NO_FATAL_FAILURE(WaitForAimWidgetRestoredAfterPromptClose());
+
+  // Wait for the actual browser focus message while the editor is still
+  // hidden. Activating the widget alone cannot satisfy the DOM focus check.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return content::EvalJs(aim_contents_.get(), R"(
+      document.hasFocus() && window.aimVoiceTest.focusRequests === 1 &&
+          !window.aimVoiceTest.voice.isPermissionPromptOpen
+    )")
+        .ExtractBool();
+  }));
+  EXPECT_EQ(true, content::EvalJs(aim_contents_.get(), R"(
+    (async () => {
+      const {box, voice, input} = window.aimVoiceTest;
+      if (!box.inVoiceSearchMode || input.checkVisibility() ||
+          box.isFocusInInput()) {
+        return false;
+      }
+      const exit = voice.shadowRoot.querySelector('#closeButton, #stopButton');
+      if (!exit?.checkVisibility()) {
+        return false;
+      }
+      exit.focus();
+      exit.click();
+      await box.updateComplete;
+      return document.hasFocus() && !box.inVoiceSearchMode &&
+          input.checkVisibility() && input.getRootNode().activeElement === input;
+    })()
+  )"));
+}
+
+IN_PROC_BROWSER_TEST_F(OmniboxAimPopupEmbeddedPermissionBrowserTest,
+                       AimActivationBeforeDeferredRestoreStillFocusesInput) {
+  ASSERT_NO_FATAL_FAILURE(ShowFocusedAimPopup());
+  ASSERT_EQ(true, content::EvalJs(aim_contents_.get(), R"(
+    (async () => {
+      const box = document.querySelector('omnibox-aim-app').$.composebox;
+      box.searchboxLayoutMode = 'TallBottomContext';
+      await box.updateComplete;
+      const microphone = box.shadowRoot.querySelector('#voiceSearchButton');
+      microphone.focus();
+      return box.getActiveElement() === microphone && !box.isFocusInInput();
+    })()
+  )"));
+  ASSERT_NO_FATAL_FAILURE(ShowEmbeddedMicrophonePrompt());
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return prompt_ && prompt_->IsActive(); }));
+
+  auto* other_browser = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other_browser);
+  auto* other_view = BrowserView::GetBrowserViewForBrowser(other_browser);
+  ASSERT_TRUE(other_view && other_view->GetWidget());
+  auto* other_widget = other_view->GetWidget();
+  other_widget->Activate();
+  ASSERT_TRUE(base::test::RunUntil([&] { return other_widget->IsActive(); }));
+  auto* presenter = GetAimPresenter();
+  ASSERT_TRUE(presenter && presenter->IsShown() && presenter->GetWidget());
+  auto* popup_widget = presenter->GetWidget();
+  auto* manager = GetPermissionManager();
+  ASSERT_TRUE(manager && manager->GetCurrentPrompt());
+  ASSERT_TRUE(prompt_ && !prompt_->IsActive());
+
+  // Keep the owner inactive during removal to queue the deferred restore.
+  // Return key status directly to AIM before pumping the task runner.
+  manager->Dismiss(/*prompt_options=*/std::monostate());
+  ASSERT_FALSE(manager->GetCurrentPrompt());
+  ASSERT_TRUE(other_widget->IsActive());
+  ASSERT_FALSE(browser_widget_->IsActive());
+  ASSERT_FALSE(popup_widget->IsActive());
+  ASSERT_TRUE(presenter->IsPermissionPromptPreventingClose());
+  popup_widget->Activate();
+  ASSERT_TRUE(popup_widget->IsActive());
+  ASSERT_FALSE(presenter->IsPermissionPromptPreventingClose())
+      << "Activation has cleared the close guard before the DOM restore task";
+  ASSERT_NO_FATAL_FAILURE(VerifyAimRestoredAfterPromptClose());
+}
+
 IN_PROC_BROWSER_TEST_F(OmniboxAimPopupEmbeddedPermissionBrowserTest,
