@@ -6758,8 +6758,16 @@ void ChromeContentBrowserClient::WillCreateURLLoaderFactory(
   if (type == URLLoaderFactoryType::kServiceWorkerSubResource && !frame) {
     aegis::access::AccessProxyingURLLoaderFactory::
         MaybeProxyServiceWorkerSubResource(
             Profile::FromBrowserContext(browser_context), render_process_id,
             factory_builder);
   }
 
+  if (type == URLLoaderFactoryType::kServiceWorkerScript && !frame &&
+      render_process_id != content::ChildProcessHost::kInvalidUniqueID) {
+    aegis::access::AccessProxyingURLLoaderFactory::
+        MaybeProxyServiceWorkerScript(
+            Profile::FromBrowserContext(browser_context), render_process_id,
+            factory_builder);
+  }
