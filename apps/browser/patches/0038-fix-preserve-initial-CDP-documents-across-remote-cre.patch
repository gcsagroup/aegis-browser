     const GURL& url,
     DevToolsManagerDelegate::TargetType target_type,
     bool new_window) {
-  NavigateParams params(ProfileManager::GetLastUsedProfile(), url,
-                        ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
+  return CreateNewTargetWithNavigationMode(url, target_type, new_window,
+                                           NewTargetNavigationMode::kNavigate);
+}
+
+scoped_refptr<DevToolsAgentHost>
+ChromeDevToolsManagerDelegate::CreateNewTargetWithNavigationMode(
+    const GURL& url,
+    DevToolsManagerDelegate::TargetType target_type,
+    bool new_window,
+    NewTargetNavigationMode navigation_mode) {
+  Profile* profile = ProfileManager::GetLastUsedProfile();
+  NavigateParams params(profile, url, ui::PAGE_TRANSITION_AUTO_TOPLEVEL);
   params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+  if (navigation_mode == NewTargetNavigationMode::kKeepInitialBlankDocument) {
+    content::WebContents::CreateParams create_params(profile);
+    create_params.desired_renderer_state =
+        content::WebContents::CreateParams::kInitializeAndWarmupRendererProcess;
+    params.contents_to_insert = content::WebContents::Create(create_params);
+  }
   Navigate(&params);
   if (!params.navigated_or_inserted_contents)
     return nullptr;
