+IN_PROC_BROWSER_TEST_F(AegisRemoteDevToolsProtocolTest,
+                       AegisRemoteCreationCanClaimUncommittedInitialDocument) {
+  content::WebContents::CreateParams create_params(browser()->profile());
+  create_params.desired_renderer_state =
+      content::WebContents::CreateParams::kInitializeAndWarmupRendererProcess;
+  auto created_contents_owner = content::WebContents::Create(create_params);
+  ASSERT_TRUE(created_contents_owner);
+  content::WebContents* created_contents = created_contents_owner.get();
+  browser()->tab_strip_model()->AppendWebContents(
+      std::move(created_contents_owner), /*foreground=*/false);
+
+  scoped_refptr<content::DevToolsAgentHost> created_target =
+      content::DevToolsAgentHost::GetOrCreateFor(created_contents);
+  ASSERT_TRUE(created_target);
+  EXPECT_EQ(content::DevToolsAgentHost::kTypePage, created_target->GetType());
+  EXPECT_TRUE(created_contents->GetLastCommittedURL().is_empty());
+  ASSERT_TRUE(created_target->GetDocumentForRemoteDebugging()
+                  .AsRenderFrameHostIfValid());
+  EXPECT_TRUE(AttachCreatedTargetForTesting(created_target));
+  EXPECT_TRUE(created_target->DetachClient(this));
+}
