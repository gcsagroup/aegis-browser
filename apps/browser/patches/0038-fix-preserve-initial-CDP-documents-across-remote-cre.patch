+bool IsInitialBlankDocumentUrl(const GURL& url) {
+  // A newly-created WebContents can expose its exact initial document before
+  // the synthetic about:blank commit has populated GetLastCommittedURL().
+  return url.is_empty() || url.IsAboutBlank();
+}
+
+bool TargetStillMatchesRequestedUrl(DevToolsAgentHost* target,
+                                    const GURL& requested_url) {
+  const GURL visible_url = target->GetURL();
+  return requested_url.IsAboutBlank() ? IsInitialBlankDocumentUrl(visible_url)
+                                      : visible_url == requested_url;
+}
