From b60ff25189d1806b8f458a4e07dae3c6687a130b Mon Sep 17 00:00:00 2001
From: GCSA-aegis <aegis@gcsa.local>
Date: Thu, 13 Aug 2026 17:34:58 +0800
Subject: [PATCH] Aegis: add chrome://aegis entries in Settings and menus

Expose GCSA-aegis from Privacy and security, the app menu, and the
macOS Chromium menu so users do not have to type the URL.
---
 chrome/app/chrome_command_ids.h               |  1 +
 chrome/app/settings_strings.grdp              |  9 +++++++++
 .../settings/privacy_page/privacy_page.html   |  7 +++++++
 .../settings/privacy_page/privacy_page.ts     |  6 ++++++
 .../browser/ui/browser_command_controller.cc  |  6 ++++++
 chrome/browser/ui/chrome_pages.cc             |  5 +++++
 chrome/browser/ui/chrome_pages.h              |  1 +
 chrome/browser/ui/cocoa/main_menu_builder.mm  |  3 +++
 chrome/browser/ui/toolbar/app_menu_model.cc   |  3 +++
 .../settings_localized_strings_provider.cc    | 19 +++++++++++++++++++
 10 files changed, 60 insertions(+)

diff --git a/chrome/app/chrome_command_ids.h b/chrome/app/chrome_command_ids.h
index a9f146ad7475522b005ba4aa940f64a7c6b12181..92c549e9dbc3d50ba0be5702196b5193c02d266f 100644
--- a/chrome/app/chrome_command_ids.h
+++ b/chrome/app/chrome_command_ids.h
@@ -292,7 +292,8 @@
 #define IDC_SHOW_READING_MODE_KEYBOARD 40303
 #define IDC_SHOW_TABS_FROM_OTHER_DEVICES_SIDE_PANEL 40304
 #define IDC_CHROME_ENTERPRISE_RELEASE_NOTES 40305
 #define IDC_SHOW_TTC_MENU 40306
+#define IDC_SHOW_AEGIS                  40310
 
 // Spell-check
 #define IDC_SPELLCHECK_SUGGESTION_0     41000
diff --git a/chrome/app/settings_strings.grdp b/chrome/app/settings_strings.grdp
index 8c079eb0a703e2d96d92cd61dcd40febc28301b3..4780cde8fb2e0f006797657d62f9ffa65865a825 100644
--- a/chrome/app/settings_strings.grdp
+++ b/chrome/app/settings_strings.grdp
@@ -1376,6 +1376,15 @@
     </message>
 
     <!-- Privacy Page -->
+    <message name="IDS_AEGIS_SETTINGS_MENU" desc="Menu item that opens chrome://aegis privacy modules.">
+      GCSA-aegis
+    </message>
+    <message name="IDS_AEGIS_SETTINGS_ROW_LABEL" desc="Label of the row on the Privacy and security settings page that opens chrome://aegis.">
+      GCSA-aegis
+    </message>
+    <message name="IDS_AEGIS_SETTINGS_ROW_SUBLABEL" desc="Sublabel of the row on the Privacy and security settings page that opens chrome://aegis.">
+      Tracker blocking, fingerprint guard, and Privacy AI
+    </message>
     <message name="IDS_SETTINGS_PRIVACY" desc="Name of the settings page which allows users to modify privacy and security settings.">
       Privacy and security
     </message>
diff --git a/chrome/browser/resources/settings/privacy_page/privacy_page.html b/chrome/browser/resources/settings/privacy_page/privacy_page.html
index 6445226c0aab0464d276b97c7f510a34c8629d8c..62d391a2c8043b245ce1c7091c266b0589bd5b9d 100644
--- a/chrome/browser/resources/settings/privacy_page/privacy_page.html
+++ b/chrome/browser/resources/settings/privacy_page/privacy_page.html
@@ -1,5 +1,11 @@
   <style include="cr-shared-style cr-hidden-style settings-shared"></style>
   <settings-section page-title="$i18n{privacyPageTitle}">
+    <cr-link-row id="aegisLinkRow"
+        start-icon="privacy:lock"
+        label="$i18n{aegisSettingsRowLabel}"
+        sub-label="$i18n{aegisSettingsRowSublabel}"
+        on-click="onAegisSettingsClick_"
+        external></cr-link-row>
     <template is="dom-if" if="[[showClearBrowsingDataDialog_]]" restamp>
       <settings-clear-browsing-data-dialog
           on-close="onCbdDialogClosed_"
@@ -12,6 +18,7 @@
       </settings-privacy-guide-dialog>
     </template>
     <cr-link-row id="clearBrowsingData"
+        class="hr"
         start-icon="cr:delete"
         label="$i18n{clearBrowsingData}"
         sub-label="$i18n{clearBrowsingDataDescription}"
diff --git a/chrome/browser/resources/settings/privacy_page/privacy_page.ts b/chrome/browser/resources/settings/privacy_page/privacy_page.ts
index c1fb233a132181d8a5f75228264c8e44dd1e34ea..08f191188e266d673ea56286e775c00d21aaa2a8 100644
--- a/chrome/browser/resources/settings/privacy_page/privacy_page.ts
+++ b/chrome/browser/resources/settings/privacy_page/privacy_page.ts
@@ -24,6 +24,7 @@ import type {CrToastElement} from 'chrome://resources/cr_elements/cr_toast/cr_to
 import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
 import {assert, assertNotReached} from 'chrome://resources/js/assert.js';
 import {focusWithoutInk} from 'chrome://resources/js/focus_without_ink.js';
+import {OpenWindowProxyImpl} from 'chrome://resources/js/open_window_proxy.js';
 import {afterNextRender, PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
 
 import {loadTimeData} from '../i18n_setup.js';
@@ -124,6 +125,11 @@ export class SettingsPrivacyPageElement extends SettingsPrivacyPageElementBase {
     Router.getInstance().navigateTo(routes.CLEAR_BROWSER_DATA);
   }
 
+  private onAegisSettingsClick_() {
+    this.interactedWithPage_();
+    OpenWindowProxyImpl.getInstance().openUrl('chrome://aegis');
+  }
+
   private onCookiesClick_() {
     this.interactedWithPage_();
 
diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 921461b9e9bd0423d6d180762d0a06d0a3cd9c94..50b9e17ec53e9150d74ea433a100d82b454626a1 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -1291,6 +1291,9 @@ void BrowserCommandController::HandleCommandWithDisposition(
     case IDC_OPTIONS:
       ShowSettings(webui::GetBrowserForOpeningWebUi(browser_));
       break;
+    case IDC_SHOW_AEGIS:
+      ShowAegisPage(browser_->GetBrowserForOpeningWebUi());
+      break;
     case IDC_EDIT_SEARCH_ENGINES:
       ShowSearchEngineSettings(webui::GetBrowserForOpeningWebUi(browser_));
       break;
@@ -2084,6 +2087,8 @@ void BrowserCommandController::UpdateSharedCommandsForIncognitoAvailability(
                                         !forced_incognito && !is_guest);
   command_updater->UpdateCommandEnabled(IDC_OPTIONS,
                                         !forced_incognito || is_guest);
+  command_updater->UpdateCommandEnabled(IDC_SHOW_AEGIS,
+                                        !forced_incognito || is_guest);
   command_updater->UpdateCommandEnabled(IDC_PERFORMANCE,
                                         !forced_incognito && !is_guest);
 }
@@ -2404,6 +2409,7 @@ void BrowserCommandController::UpdateCommandsForFullscreenMode() {
   command_updater_->UpdateCommandEnabled(IDC_EDIT_SEARCH_ENGINES, show_main_ui);
   command_updater_->UpdateCommandEnabled(IDC_VIEW_PASSWORDS, show_main_ui);
   command_updater_->UpdateCommandEnabled(IDC_ABOUT, show_main_ui);
+  command_updater_->UpdateCommandEnabled(IDC_SHOW_AEGIS, show_main_ui);
 #if BUILDFLAG(GOOGLE_CHROME_BRANDING)
   command_updater_->UpdateCommandEnabled(IDC_CHROME_TIPS, show_main_ui);
   command_updater_->UpdateCommandEnabled(IDC_CHROME_WHATS_NEW, show_main_ui);
diff --git a/chrome/browser/ui/chrome_pages.cc b/chrome/browser/ui/chrome_pages.cc
index e70ee6412075fd190f0591b738804623939635d2..e6b58495ad79c5cf686874750fefd5fc55d37a3c 100644
--- a/chrome/browser/ui/chrome_pages.cc
+++ b/chrome/browser/ui/chrome_pages.cc
@@ -467,6 +467,11 @@ void ShowSettings(BrowserWindowInterface* browser) {
   ShowSettingsSubPage(browser, std::string());
 }
 
+void ShowAegisPage(BrowserWindowInterface* browser) {
+  FocusWebContents(browser);
+  ShowSingletonTabIgnorePathOverwriteNTP(browser, GURL(kChromeUIAegisURL));
+}
+
 void ShowSettingsSubPage(BrowserWindowInterface* browser,
                          std::string_view sub_page) {
 #if BUILDFLAG(IS_CHROMEOS)
diff --git a/chrome/browser/ui/chrome_pages.h b/chrome/browser/ui/chrome_pages.h
index b70ea373b958c3e95db87d3489f6b71c1a6518d8..b6489127b02d2d56fbce313b38c1b5f3ebdf70f8 100644
--- a/chrome/browser/ui/chrome_pages.h
+++ b/chrome/browser/ui/chrome_pages.h
@@ -105,6 +105,7 @@ bool IsTrustedPopupWindowWithScheme(const BrowserWindowInterface* browser,
 // Various things that open in a settings UI.
 // NOTE: For Chrome OS settings, use SettingsWindowManager::ShowOSSettings().
 void ShowSettings(BrowserWindowInterface* browser);
+void ShowAegisPage(BrowserWindowInterface* browser);
 void ShowSettingsSubPage(BrowserWindowInterface* browser,
                          std::string_view sub_page);
 void ShowSettingsSubPageForProfile(Profile* profile, std::string_view sub_page);
diff --git a/chrome/browser/ui/cocoa/main_menu_builder.mm b/chrome/browser/ui/cocoa/main_menu_builder.mm
index 047674248727a122fb3aee712981eefd0a4c3049..f37456f8073e430f6410d7f3efaf2700c3298b70 100644
--- a/chrome/browser/ui/cocoa/main_menu_builder.mm
+++ b/chrome/browser/ui/cocoa/main_menu_builder.mm
@@ -78,6 +78,9 @@ NSMenuItem* BuildAppMenu(NSApplication* nsapp,
                   .target(app_delegate)
                   .action(@selector(showPreferences:))
                   .remove_if(is_pwa),
+              Item(IDS_AEGIS_SETTINGS_MENU)
+                  .command_id(IDC_SHOW_AEGIS)
+                  .remove_if(is_pwa),
               Item(IDS_PREFERENCES)
                   .command_id(IDC_WEB_APP_SETTINGS)
                   .remove_if(!is_pwa),
diff --git a/chrome/browser/ui/toolbar/app_menu_model.cc b/chrome/browser/ui/toolbar/app_menu_model.cc
index faaded8ad5427c95787fde91961ae6d543902336..4a051dc0958c5a301445d9c86347221bd93f6146 100644
--- a/chrome/browser/ui/toolbar/app_menu_model.cc
+++ b/chrome/browser/ui/toolbar/app_menu_model.cc
@@ -2332,6 +2332,9 @@ void AppMenuModel::Build() {
   AddItemWithStringIdAndVectorIcon(
       this, IDC_OPTIONS, IDS_SETTINGS,
       features::IsRoundedIconsEnabled() ? kSettingsIcon : kSettingsMenuOldIcon);
+  AddItemWithStringIdAndVectorIcon(
+      this, IDC_SHOW_AEGIS, IDS_AEGIS_SETTINGS_MENU,
+      features::IsRoundedIconsEnabled() ? kSettingsIcon : kSettingsMenuOldIcon);
 
   if (browser_defaults::kShowExitMenuItem) {
     AddItemWithStringIdAndVectorIcon(
diff --git a/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc b/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
index 01763a850c07badae922065057065a2591c0e2e6..db068e5e3de0e409b9d14f30b9f9408dce44e912 100644
--- a/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
+++ b/chrome/browser/ui/webui/settings/settings_localized_strings_provider.cc
@@ -2852,6 +2852,25 @@ void AddPrivacyStrings(content::WebUIDataSource* html_source,
        IDS_SETTINGS_SECURITY_JAVASCRIPT_GUARDRAILS_MANAGE_SITE_EXCEPTIONS_DESCRIPTION}};
   html_source->AddLocalizedStrings(kLocalizedStrings);
 
+  html_source->AddLocalizedString("aegisSettingsRowLabel",
+                                  IDS_AEGIS_SETTINGS_ROW_LABEL);
+  {
+    const std::string locale =
+        l10n_util::GetApplicationLocale(std::string());
+    if (locale.starts_with("zh-TW") || locale.starts_with("zh-HK")) {
+      html_source->AddString(
+          "aegisSettingsRowSublabel",
+          "追蹤器攔截、指紋防護與本地隱私摘要");
+    } else if (locale.starts_with("zh")) {
+      html_source->AddString(
+          "aegisSettingsRowSublabel",
+          "跟踪器拦截、指纹防护与本地隐私摘要");
+    } else {
+      html_source->AddLocalizedString("aegisSettingsRowSublabel",
+                                      IDS_AEGIS_SETTINGS_ROW_SUBLABEL);
+    }
+  }
+
   html_source->AddString("cookiesSettingsHelpCenterURL",
                          chrome::kCookiesSettingsHelpCenterURL);
 
-- 
2.52.0

