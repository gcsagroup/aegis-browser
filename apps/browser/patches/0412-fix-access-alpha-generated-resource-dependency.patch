diff --git a/chrome/browser/aegis/access/BUILD.gn b/chrome/browser/aegis/access/BUILD.gn
index 2053ecb7e51a035c8b12dc387c697f37c592dbb4..e091e90c5f4f101eb3ef08e19a9081d8eba516bd 100644
