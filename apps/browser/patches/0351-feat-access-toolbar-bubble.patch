diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1ee8403a9222ca4e43a7387b932e9dfadc0dcb36
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
@@ -0,0 +1,60 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_controller.h"
+
+#include "chrome/browser/profiles/profile.h"
+
+namespace aegis::access {
+namespace {
+
+const void* const kAccessSiteProxyBubbleControllerKey =
+    &kAccessSiteProxyBubbleControllerKey;
+
+}  // namespace
+
+AccessSiteProxyBubbleController::AccessSiteProxyBubbleController(
+    Profile* profile) {
+  (void)profile;
+}
+
+AccessSiteProxyBubbleController::~AccessSiteProxyBubbleController() = default;
+
+AccessSiteProxyBubbleController* AccessSiteProxyBubbleController::Get(
+    Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  return static_cast<AccessSiteProxyBubbleController*>(
+      profile->GetUserData(kAccessSiteProxyBubbleControllerKey));
+}
+
+AccessSiteProxyBubbleController* AccessSiteProxyBubbleController::GetOrCreate(
+    Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  if (AccessSiteProxyBubbleController* existing = Get(profile)) {
+    return existing;
+  }
+  auto controller = std::unique_ptr<AccessSiteProxyBubbleController>(
+      new AccessSiteProxyBubbleController(profile));
+  AccessSiteProxyBubbleController* raw = controller.get();
+  profile->SetUserData(kAccessSiteProxyBubbleControllerKey,
+                       std::move(controller));
+  return raw;
+}
+
+AccessSiteProxyBubbleSnapshot
+AccessSiteProxyBubbleController::SnapshotForCommittedUrl(
+    const GURL& committed_url) const {
+  return BuildSiteProxyBubbleSnapshot(committed_url, intent_store_,
+                                      connection_state_);
+}
+
+bool AccessSiteProxyBubbleController::ApplyHostProxyToggle(
+    const AccessSiteHost& host,
+    bool enabled) {
+  return ApplySiteProxyToggle(&intent_store_, host, enabled);
+}
+
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.h b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.h
new file mode 100644
index 0000000000000000000000000000000000000000..090a28677db7742d59eb4f1b6279d06398db5cf0
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.h
@@ -0,0 +1,55 @@
+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_CONTROLLER_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_CONTROLLER_H_
+
+#include "base/supports_user_data.h"
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
+
+class Profile;
+
+namespace aegis::access {
+
+// Profile-owned product state for the toolbar site-proxy bubble.
+// Holds intent separately from connection. Does not publish or ACK
+// (session finalize is P-mac-3).
+class AccessSiteProxyBubbleController : public base::SupportsUserData::Data {
+ public:
+  static AccessSiteProxyBubbleController* Get(Profile* profile);
+  static AccessSiteProxyBubbleController* GetOrCreate(Profile* profile);
+
+  AccessSiteProxyBubbleController(const AccessSiteProxyBubbleController&) =
+      delete;
+  AccessSiteProxyBubbleController& operator=(
+      const AccessSiteProxyBubbleController&) = delete;
+  ~AccessSiteProxyBubbleController() override;
+
+  AccessSiteIntentStore& intent_store() { return intent_store_; }
+  const AccessSiteIntentStore& intent_store() const { return intent_store_; }
+
+  AccessSiteConnectionState connection_state() const {
+    return connection_state_;
+  }
+  // P-mac-3 advances this through connecting/ready/unavailable. P-mac-2 keeps
+  // the default idle so switch-on never implies connectivity.
+  void SetConnectionState(AccessSiteConnectionState state) {
+    connection_state_ = state;
+  }
+
+  AccessSiteProxyBubbleSnapshot SnapshotForCommittedUrl(
+      const GURL& committed_url) const;
+
+  // Updates product intent only. Never sets connection to ready.
+  bool ApplyHostProxyToggle(const AccessSiteHost& host, bool enabled);
+
+ private:
+  explicit AccessSiteProxyBubbleController(Profile* profile);
+
+  AccessSiteIntentStore intent_store_;
+  AccessSiteConnectionState connection_state_ =
+      AccessSiteConnectionState::kIdle;
+};
+
+}  // namespace aegis::access
+
+#endif  // CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_CONTROLLER_H_
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_model.cc b/chrome/browser/aegis/access/access_site_proxy_bubble_model.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d61885b3a71ff11d153c4bcd7862af41fb17e2ee
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_model.cc
@@ -0,0 +1,102 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
+
+namespace aegis::access {
+namespace {
+
+AccessSiteProxyConnectionStatusId ConnectionStatusId(
+    AccessSiteConnectionState connection) {
+  switch (connection) {
+    case AccessSiteConnectionState::kIdle:
+      return AccessSiteProxyConnectionStatusId::kIdle;
+    case AccessSiteConnectionState::kConnecting:
+      return AccessSiteProxyConnectionStatusId::kConnecting;
+    case AccessSiteConnectionState::kReady:
+      return AccessSiteProxyConnectionStatusId::kReady;
+    case AccessSiteConnectionState::kUnavailable:
+      return AccessSiteProxyConnectionStatusId::kUnavailable;
+  }
+  return AccessSiteProxyConnectionStatusId::kUnavailable;
+}
+
+AccessSiteProxyIntentStatusId IntentStatusId(
+    AccessSiteIntent intent,
+    AccessSiteConnectionState connection) {
+  switch (intent) {
+    case AccessSiteIntent::kOff:
+      return AccessSiteProxyIntentStatusId::kOffBrowserDefault;
+    case AccessSiteIntent::kBlock:
+      return AccessSiteProxyIntentStatusId::kBlockLocalRefuse;
+    case AccessSiteIntent::kAllow:
+      return connection == AccessSiteConnectionState::kReady
+                 ? AccessSiteProxyIntentStatusId::kAllowConnected
+                 : AccessSiteProxyIntentStatusId::kAllowNotConnected;
+  }
+  return AccessSiteProxyIntentStatusId::kOffBrowserDefault;
+}
+
+}  // namespace
+
+std::string_view AccessSiteConnectionStateToString(
+    AccessSiteConnectionState state) {
+  switch (state) {
+    case AccessSiteConnectionState::kIdle:
+      return "idle";
+    case AccessSiteConnectionState::kConnecting:
+      return "connecting";
+    case AccessSiteConnectionState::kReady:
+      return "ready";
+    case AccessSiteConnectionState::kUnavailable:
+      return "unavailable";
+  }
+  return "unavailable";
+}
+
+AccessSiteHostResult ResolveTrustedNavigationHost(const GURL& committed_url) {
+  if (!committed_url.is_valid() || !committed_url.SchemeIsHTTPOrHTTPS() ||
+      !committed_url.has_host()) {
+    return {.status = AccessSiteHostStatus::kEmpty};
+  }
+  // Committed navigation URL only — never visible/typed speculative hosts.
+  return NormalizeAccessSiteHost(committed_url.host());
+}
+
+AccessSiteProxyBubbleSnapshot BuildSiteProxyBubbleSnapshot(
+    const GURL& committed_url,
+    const AccessSiteIntentStore& store,
+    AccessSiteConnectionState connection) {
+  AccessSiteProxyBubbleSnapshot snapshot;
+  snapshot.connection = connection;
+  snapshot.connection_status = ConnectionStatusId(connection);
+
+  const AccessSiteHostResult host = ResolveTrustedNavigationHost(committed_url);
+  if (host.status != AccessSiteHostStatus::kOk || !host.host.has_value()) {
+    snapshot.intent_status = AccessSiteProxyIntentStatusId::kNoTrustedSite;
+    return snapshot;
+  }
+
+  snapshot.has_trusted_site = true;
+  snapshot.host = *host.host;
+  snapshot.intent = store.Get(snapshot.host);
+  snapshot.toggle_enabled = true;
+  snapshot.toggle_on = snapshot.intent == AccessSiteIntent::kAllow;
+  snapshot.intent_status = IntentStatusId(snapshot.intent, connection);
+  return snapshot;
+}
+
+bool ApplySiteProxyToggle(AccessSiteIntentStore* store,
+                          const AccessSiteHost& host,
+                          bool enabled) {
+  if (!store || host.value.empty()) {
+    return false;
+  }
+  const AccessSiteHostResult checked = MakeAccessSiteHost(host.value);
+  if (checked.status != AccessSiteHostStatus::kOk) {
+    return false;
+  }
+  store->Set(host, enabled ? AccessSiteIntent::kAllow : AccessSiteIntent::kOff);
+  return true;
+}
+
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_model.h b/chrome/browser/aegis/access/access_site_proxy_bubble_model.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e6cce036de00914c9ceb37016a5e8e56d8b0ba9
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_model.h
@@ -0,0 +1,77 @@
+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_MODEL_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_MODEL_H_
+
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/aegis/access/access_site_intent.h"
+#include "url/gurl.h"
+
+namespace aegis::access {
+
+// Connection / session readiness for the toolbar bubble. Distinct from the
+// product site-proxy switch (AccessSiteIntent). P-mac-2 shows both; P-mac-3
+// advances connection through publish/ACK.
+enum class AccessSiteConnectionState {
+  kIdle,
+  kConnecting,
+  kReady,
+  kUnavailable,
+};
+
+// Short intent-line ids. UI localizes; never conflate with connection copy.
+enum class AccessSiteProxyIntentStatusId {
+  kNoTrustedSite,
+  kOffBrowserDefault,
+  kAllowNotConnected,
+  kAllowConnected,
+  kBlockLocalRefuse,
+};
+
+enum class AccessSiteProxyConnectionStatusId {
+  kIdle,
+  kConnecting,
+  kReady,
+  kUnavailable,
+};
+
+// Presentation snapshot for the toolbar site-proxy bubble.
+struct AccessSiteProxyBubbleSnapshot {
+  bool has_trusted_site = false;
+  AccessSiteHost host;
+  AccessSiteIntent intent = AccessSiteIntent::kOff;
+  AccessSiteConnectionState connection = AccessSiteConnectionState::kIdle;
+  // Checked when intent == allow. Independent of connection readiness.
+  bool toggle_on = false;
+  // False when the committed URL is not a trusted http(s) navigation host.
+  bool toggle_enabled = false;
+  AccessSiteProxyIntentStatusId intent_status =
+      AccessSiteProxyIntentStatusId::kNoTrustedSite;
+  AccessSiteProxyConnectionStatusId connection_status =
+      AccessSiteProxyConnectionStatusId::kIdle;
+};
+
+std::string_view AccessSiteConnectionStateToString(
+    AccessSiteConnectionState state);
+
+// Resolves an exact-host product key from the current navigation's trusted
+// URL only: last-committed http(s). Visible/typed URLs are not admitted.
+AccessSiteHostResult ResolveTrustedNavigationHost(const GURL& committed_url);
+
+// Builds bubble state. Intent comes from the product store; connection is an
+// independent input so switch-on never implies Access connectivity.
+AccessSiteProxyBubbleSnapshot BuildSiteProxyBubbleSnapshot(
+    const GURL& committed_url,
+    const AccessSiteIntentStore& store,
+    AccessSiteConnectionState connection);
+
+// Product toggle → allow/off intent. Does not publish, ACK, or claim ready.
+bool ApplySiteProxyToggle(AccessSiteIntentStore* store,
+                          const AccessSiteHost& host,
+                          bool enabled);
+
+}  // namespace aegis::access
+
+#endif  // CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_BUBBLE_MODEL_H_
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_model_unittest.cc b/chrome/browser/aegis/access/access_site_proxy_bubble_model_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..0229c8c22768b8664992f4e6ec9bb70fd4404589
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_model_unittest.cc
@@ -0,0 +1,103 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis::access {
+namespace {
+
+AccessSiteHost Host(std::string_view value) {
+  const auto result = MakeAccessSiteHost(value);
+  EXPECT_EQ(result.status, AccessSiteHostStatus::kOk);
+  return *result.host;
+}
+
+TEST(AccessSiteProxyBubbleModelTest, TrustedHostFromCommittedHttpOnly) {
+  const auto ok =
+      ResolveTrustedNavigationHost(GURL("https://News.Example/path?q=1"));
+  ASSERT_EQ(ok.status, AccessSiteHostStatus::kOk);
+  EXPECT_EQ(ok.host->value, "news.example");
+
+  EXPECT_EQ(ResolveTrustedNavigationHost(GURL("chrome://settings")).status,
+            AccessSiteHostStatus::kEmpty);
+  EXPECT_EQ(ResolveTrustedNavigationHost(GURL("file:///tmp/x")).status,
+            AccessSiteHostStatus::kEmpty);
+  EXPECT_EQ(ResolveTrustedNavigationHost(GURL()).status,
+            AccessSiteHostStatus::kEmpty);
+}
+
+TEST(AccessSiteProxyBubbleModelTest, SwitchStateDistinctFromConnection) {
+  AccessSiteIntentStore store;
+  const GURL url("https://news.example/");
+  store.Set(Host("news.example"), AccessSiteIntent::kAllow);
+
+  auto idle = BuildSiteProxyBubbleSnapshot(url, store,
+                                           AccessSiteConnectionState::kIdle);
+  EXPECT_TRUE(idle.has_trusted_site);
+  EXPECT_TRUE(idle.toggle_on);
+  EXPECT_TRUE(idle.toggle_enabled);
+  EXPECT_EQ(idle.intent, AccessSiteIntent::kAllow);
+  EXPECT_EQ(idle.intent_status,
+            AccessSiteProxyIntentStatusId::kAllowNotConnected);
+  EXPECT_EQ(idle.connection_status, AccessSiteProxyConnectionStatusId::kIdle);
+
+  auto ready = BuildSiteProxyBubbleSnapshot(url, store,
+                                            AccessSiteConnectionState::kReady);
+  EXPECT_TRUE(ready.toggle_on);
+  EXPECT_EQ(ready.intent_status,
+            AccessSiteProxyIntentStatusId::kAllowConnected);
+  EXPECT_EQ(ready.connection_status, AccessSiteProxyConnectionStatusId::kReady);
+
+  auto off = BuildSiteProxyBubbleSnapshot(url, AccessSiteIntentStore(),
+                                          AccessSiteConnectionState::kReady);
+  EXPECT_FALSE(off.toggle_on);
+  EXPECT_EQ(off.intent_status,
+            AccessSiteProxyIntentStatusId::kOffBrowserDefault);
+  // Connection may be ready globally while this site switch is off.
+  EXPECT_EQ(off.connection_status, AccessSiteProxyConnectionStatusId::kReady);
+}
+
+TEST(AccessSiteProxyBubbleModelTest, ToggleUpdatesIntentWithoutReadyClaim) {
+  AccessSiteIntentStore store;
+  const AccessSiteHost host = Host("www.example.com");
+  EXPECT_TRUE(ApplySiteProxyToggle(&store, host, true));
+  EXPECT_EQ(store.Get(host), AccessSiteIntent::kAllow);
+
+  auto snap = BuildSiteProxyBubbleSnapshot(GURL("https://www.example.com/"),
+                                           store,
+                                           AccessSiteConnectionState::kIdle);
+  EXPECT_TRUE(snap.toggle_on);
+  EXPECT_EQ(snap.intent_status,
+            AccessSiteProxyIntentStatusId::kAllowNotConnected);
+  EXPECT_EQ(snap.connection, AccessSiteConnectionState::kIdle);
+
+  EXPECT_TRUE(ApplySiteProxyToggle(&store, host, false));
+  EXPECT_EQ(store.Get(host), AccessSiteIntent::kOff);
+  EXPECT_TRUE(store.All().empty());
+}
+
+TEST(AccessSiteProxyBubbleModelTest, InternalPagesDisableToggle) {
+  AccessSiteIntentStore store;
+  auto snap = BuildSiteProxyBubbleSnapshot(GURL("chrome://aegis/"), store,
+                                           AccessSiteConnectionState::kIdle);
+  EXPECT_FALSE(snap.has_trusted_site);
+  EXPECT_FALSE(snap.toggle_enabled);
+  EXPECT_FALSE(snap.toggle_on);
+  EXPECT_EQ(snap.intent_status, AccessSiteProxyIntentStatusId::kNoTrustedSite);
+}
+
+TEST(AccessSiteProxyBubbleModelTest, BlockIntentSurfacesLocalRefuseStatus) {
+  AccessSiteIntentStore store;
+  store.Set(Host("blocked.example"), AccessSiteIntent::kBlock);
+  auto snap = BuildSiteProxyBubbleSnapshot(GURL("https://blocked.example/"),
+                                           store,
+                                           AccessSiteConnectionState::kIdle);
+  EXPECT_TRUE(snap.has_trusted_site);
+  EXPECT_FALSE(snap.toggle_on);
+  EXPECT_EQ(snap.intent_status,
+            AccessSiteProxyIntentStatusId::kBlockLocalRefuse);
+}
+
+}  // namespace
+}  // namespace aegis::access
