+  add("readingDateWarning", "The original date may use either month/day or day/month order. Confirm it before relying on the translation.", "原文日期可能采用月/日或日/月顺序，请确认后再使用译文。", "原文日期可能採用月/日或日/月順序，請確認後再使用譯文。");
