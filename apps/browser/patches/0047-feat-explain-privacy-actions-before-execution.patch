+        reason.weight);
   }
-  return WithWeight(base::EscapeForHTML(base::UTF8ToUTF16(reason.code)),
-                    reason.weight);
+  return WithoutTechnicalWeight(
+      base::EscapeForHTML(base::UTF8ToUTF16(reason.code)), reason.weight);
