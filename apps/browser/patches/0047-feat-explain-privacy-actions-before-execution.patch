   load_time_data.Set("explanationParagraph", std::u16string());
   load_time_data.Set("primaryButtonText",
diff --git a/chrome/browser/aegis/aegis_phish_blocking_page_unittest.cc b/chrome/browser/aegis/aegis_phish_blocking_page_unittest.cc
