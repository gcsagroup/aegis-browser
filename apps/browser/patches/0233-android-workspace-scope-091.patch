---
 chrome/browser/aegis/agent/agent_core_unittest.cc  | 2 ++
 chrome/browser/aegis/agent/agent_workflow.cc       | 3 +--
 chrome/browser/ui/webui/help/aegis_github_update.h | 4 ++--
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/aegis/agent/agent_core_unittest.cc b/chrome/browser/aegis/agent/agent_core_unittest.cc
index da413f749410b49c27bf5905f55ae03952bd73fb..cc16f0fbca769a1148cb946a75f0d5102e3331ee 100644
--- a/chrome/browser/aegis/agent/agent_core_unittest.cc
+++ b/chrome/browser/aegis/agent/agent_core_unittest.cc
@@ -396,6 +396,8 @@ TEST(AegisAgentWorkflowTest, BuiltInsUseBoundedPurposeSpecificScopes) {
   EXPECT_TRUE(browser_only->allowed_tools.contains("bookmark.list"));
   EXPECT_TRUE(browser_only->allowed_tools.contains("bookmark.plan"));
   EXPECT_TRUE(browser_only->allowed_tools.contains("tab.list"));
+  EXPECT_TRUE(browser_only->allowed_tools.contains("workspace.save"));
+  EXPECT_TRUE(browser_only->allowed_tools.contains("workspace.restore"));
   EXPECT_FALSE(browser_only->allowed_tools.contains("tab.create"));
   EXPECT_FALSE(browser_only->allowed_tools.contains("window.create"));
 }
diff --git a/chrome/browser/aegis/agent/agent_workflow.cc b/chrome/browser/aegis/agent/agent_workflow.cc
index 74cd63f06742cc23ff4dd50fcf23972012eec3ba..b0229eac00f4a0c0d613dd6b4c3630fe25f39956 100644
--- a/chrome/browser/aegis/agent/agent_workflow.cc
+++ b/chrome/browser/aegis/agent/agent_workflow.cc
@@ -12,8 +12,7 @@ namespace {
 
 bool IsToolSupportedOnCurrentPlatform(std::string_view tool) {
 #if BUILDFLAG(IS_ANDROID)
-  return !base::StartsWith(tool, "window.") &&
-         !base::StartsWith(tool, "workspace.");
+  return !base::StartsWith(tool, "window.");
 #else
   return true;
 #endif
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 9e9728714c380620adcc92d0b550382a66ad8b75..e4b22650d9db52df7be131546f99d93d83d27cb9 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -21,8 +21,8 @@ class SimpleURLLoader;
 
 namespace aegis {
 // 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.40。
-inline constexpr char kProductVersion[] = "2.0.0.90";
-inline constexpr char kProductVersionLabel[] = "Ver 2.0 (090)";
+inline constexpr char kProductVersion[] = "2.0.0.91";
+inline constexpr char kProductVersionLabel[] = "Ver 2.0 (091)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
 inline constexpr char kReleasePage[] =
