---
 chrome/browser/aegis/agent/aegis_agent_browsertest.cc | 1 +
 chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc | 4 +++-
 chrome/browser/ui/webui/help/aegis_github_update.h    | 4 ++--
 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
index a6da87faad751bb91705e75df93934a8a266267d..86ba59d43d1bde4d02a3337320216ebcfb3d32bd 100644
--- a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
+++ b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
@@ -6155,6 +6155,7 @@ IN_PROC_BROWSER_TEST_F(AegisAgentBrowserTest, ReadingPackDownloadScopeAndIntegri
       [&](content::URLLoaderInterceptor::RequestParams* params) {
         if (params->url_request.url.host() != "firefox-settings-attachments.cdn.mozilla.net") return false;
         ++requests;
+        EXPECT_EQ(params->url_request.headers.GetHeader("User-Agent"), "GCSA-Aegis-LocalTranslation/1.0");
         EXPECT_EQ(params->url_request.credentials_mode, network::mojom::CredentialsMode::kOmit);
         EXPECT_EQ(params->url_request.redirect_mode, network::mojom::RedirectMode::kError);
         EXPECT_TRUE(params->url_request.referrer.is_empty());
diff --git a/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc b/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc
index 4f75e6b60686312bed3b9d468c0bbfa9ebf4c374..7f917eaf575fed16e3c5a3547f2161ceab148a99 100644
--- a/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc
+++ b/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc
@@ -4,7 +4,6 @@
 
 #include <string>
 #include <memory>
-#include <optional>
 
 #include "base/functional/bind.h"
 #include "base/logging.h"
@@ -105,6 +104,9 @@ void FetchTranslationAsset(scoped_refptr<network::SharedURLLoaderFactory> factor
   if (!asset || *active >= 2) { std::move(callback).Run(nullptr); return; }
   auto request = std::make_unique<network::ResourceRequest>();
   request->url = GURL(std::string("https://firefox-settings-attachments.cdn.mozilla.net/") + asset->path);
+  // CDN 不接受通用 Chromium UA；使用真实的原生下载器身份，不冒充其他浏览器。
+  request->headers.SetHeader("User-Agent", "GCSA-Aegis-LocalTranslation/1.0");
+  request->headers.SetHeader("Accept", "application/octet-stream, */*");
   request->credentials_mode = network::mojom::CredentialsMode::kOmit;
   request->redirect_mode = network::mojom::RedirectMode::kError;
   request->load_flags = net::LOAD_DISABLE_CACHE;
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 98b5ea26b6ca9ed3821318f5993271df209c9a42..79ec483fbae0c3a13073b320221c7cbfba4ff8aa 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -21,8 +21,8 @@ class SimpleURLLoader;
 
 namespace aegis {
 // 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.40。
-inline constexpr char kProductVersion[] = "3.1.0.166";
-inline constexpr char kProductVersionLabel[] = "Ver 3.1 (166)";
+inline constexpr char kProductVersion[] = "3.1.0.167";
+inline constexpr char kProductVersionLabel[] = "Ver 3.1 (167)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
 inline constexpr char kReleasePage[] =
