From 79eec0e7a8fc86f29e814c6412dc47056627f490 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 11 Nov 2026 03:14:51 +0800
Subject: [PATCH] fix(access): explain reconnection without internal terms

---
 .../browser/aegis/access/access_site_proxy_bubble_controller.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
index 7878f2478f3c661d4862f79827c012688276b844..8d5e9ff0f58976b0cda42721bd997fa53bf9af8a 100644
--- a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
@@ -131,7 +131,7 @@ AccessSiteProxyBubbleController::SnapshotForCommittedUrl(
         ? runtime->CaptureCommonGenerationTupleOnUiThread(*owner) : std::nullopt;
     if (!local_core_ready_ || !common || !transport->HasCurrentPrivatePolicy(*owner, *common)) {
       state.connection = AccessSiteConnectionState::kUnavailable;
-      state.failure_reason = "The proxy network context is not ready.";
+      state.failure_reason = "Proxy connection is unavailable. Reload to reconnect.";
     }
   }
   AccessSiteIntentStore presentation;
