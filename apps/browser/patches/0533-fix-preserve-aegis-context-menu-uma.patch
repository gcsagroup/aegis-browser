+       {IDC_CONTENT_CONTEXT_ASK_GOOGLE_ABOUT_THIS_PAGE, 36},
+       {IDC_CONTENT_CONTEXT_INDIGO, 37},
        // To add new items:
        //   - Add one more line above this comment block, using the UMA value
        //     from the line below this comment block.
diff --git a/tools/metrics/histograms/metadata/ui/enums.xml b/tools/metrics/histograms/metadata/ui/enums.xml
index 90be50895611d3563471a31f2c2eab8c913cb861..2995971450a8619659c38e000d8a58d6b41898bf 100644
