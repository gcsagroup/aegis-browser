+++ b/tools/metrics/histograms/metadata/ui/enums.xml
@@ -80,9 +80,9 @@ chromium-metrics-reviews@google.com.
   <int value="32" label="Create image with Gemini in Chrome"/>
   <int value="33" label="Remove from dictionary"/>
   <int value="34" label="Open link in isolated window"/>
-  <int value="35" label="Ask Google about this page"/>
-  <int value="36" label="Try it on (Indigo)"/>
-  <int value="37" label="Send page context to Aegis Agent"/>
+  <int value="35" label="Send page context to Aegis Agent"/>
