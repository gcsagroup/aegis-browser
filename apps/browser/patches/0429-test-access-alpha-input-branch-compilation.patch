@@ -97,12 +97,13 @@ class ProductAckContext final : public network::TestNetworkContext,
 class AccessSiteProxyProductTest : public testing::Test {
  protected:
   void SetUp() override {
+#if !BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
     const auto* command = base::CommandLine::ForCurrentProcess();
-    if (!BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED) &&
-        (command->GetSwitchValuePath("aegis-access-dev-core-manifest").empty() ||
-        command->GetSwitchValuePath("aegis-access-dev-node-config").empty())) {
