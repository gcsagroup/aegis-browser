+++ b/chrome/browser/aegis/access/access_navigation_retry_state.h
@@ -33,6 +33,10 @@ class AccessNavigationRetryState {
   AccessNavigationRetryState& operator=(const AccessNavigationRetryState&) = delete;
 
   void BeginNavigation(int64_t navigation_id);
+  // Stop revokes the current ticket. Only a new user request from this
+  // same committed error entry may receive a new one.
+  void StopOnErrorEntry(int entry_id);
+  std::optional<AccessNavigationRetryTicket> CaptureForUserRetry(int entry_id);
   bool RecordFailure(int64_t navigation_id,
                      const GURL& original_url,
                      const GURL& failed_url,
@@ -45,6 +49,7 @@ class AccessNavigationRetryState {
  private:
   int64_t navigation_id_ = 0;
   std::optional<AccessNavigationRetryTicket> ticket_;
+  std::optional<int> stopped_entry_id_;
 };
 
 }  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_navigation_retry_state_unittest.cc b/chrome/browser/aegis/access/access_navigation_retry_state_unittest.cc
index 352314c6b2328a6a0ec692144948e137948180b0..afc6f39baf04773f2af37dd7dfad57a722f94aab 100644
--- a/chrome/browser/aegis/access/access_navigation_retry_state_unittest.cc
+++ b/chrome/browser/aegis/access/access_navigation_retry_state_unittest.cc
@@ -58,6 +58,27 @@ TEST(AccessNavigationRetryStateTest, AnotherTabCannotConsumeTheSameUrlTicket) {
   EXPECT_TRUE(second.Consume(*second.Capture()));
 }
 
+TEST(AccessNavigationRetryStateTest, StoppedFailureBelongsToItsOriginalEntry) {
+  AccessNavigationRetryState state;
+  state.BeginNavigation(17);
+  ASSERT_TRUE(state.RecordFailure(17, OriginalUrl(), FailedUrl(), "GET",
+                                  net::ERR_CONNECTION_RESET, true));
+  const auto old = state.Capture();
+  ASSERT_TRUE(old);
+  state.StopOnErrorEntry(10);
+  state.StopOnErrorEntry(11);
+  EXPECT_FALSE(state.Capture());
+  EXPECT_FALSE(state.Consume(*old));
+  EXPECT_FALSE(state.CaptureForUserRetry(11));
+  const auto fresh = state.CaptureForUserRetry(10);
+  ASSERT_TRUE(fresh);
+  EXPECT_NE(fresh->identity, old->identity);
+  EXPECT_FALSE(state.Consume(*old));
+  state.StopOnErrorEntry(10);
+  state.BeginNavigation(18);
+  EXPECT_FALSE(state.CaptureForUserRetry(10));
+}
+
 TEST(AccessNavigationRetryStateTest, DoesNotReplayNonIdempotentInitialMethod) {
   for (const auto* method : {"POST", "PATCH", "PUT", "DELETE"}) {
     AccessNavigationRetryState state;
diff --git a/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc b/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc
