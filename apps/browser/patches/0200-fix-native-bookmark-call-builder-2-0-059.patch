 chrome/browser/aegis/agent/agent_execution.cc      | 13 ++++++++-----
 chrome/browser/ui/webui/help/aegis_github_update.h |  4 ++--
 2 files changed, 10 insertions(+), 7 deletions(-)

diff --git a/chrome/browser/aegis/agent/agent_execution.cc b/chrome/browser/aegis/agent/agent_execution.cc
index 09df57e8af..3bb3ca8a4f 100644
--- a/chrome/browser/aegis/agent/agent_execution.cc
+++ b/chrome/browser/aegis/agent/agent_execution.cc
@@ -2065,11 +2065,14 @@ std::optional<AgentToolCall> BuildBoundBookmarkListCall(
       !task.scope().AllowsDataClass(AgentDataClass::kBookmarks)) {
     return std::nullopt;
   }
-  AgentModelEvent event;
-  event.type = AgentModelEventType::kToolCall;
-  event.tool_name = "bookmark.list";
-  std::string error;
-  return BindExecutionToolCall(task, step, std::nullopt, attempt, event, &error);
+  AgentToolCall call;
+  call.action_id = task.id() + ":" + step.step_id + ":" +
+                   std::to_string(attempt + 1);
+  if (call.action_id.size() > 128u) {
+    return std::nullopt;
+  }
+  call.tool_name = "bookmark.list";
+  return call;
 }
 
