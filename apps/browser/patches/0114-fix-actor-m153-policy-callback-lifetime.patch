-                                            : *policy_checker),
       delegate_(std::move(delegate)),
       ui_weak_ptr_factory_(ui_event_dispatcher_.get()) {
   CHECK(policy_checker);
diff --git a/chrome/browser/actor/actor_task.h b/chrome/browser/actor/actor_task.h
index b79b661a7736694eaf57e47aa34586465ff1193d..47b843684ea35764b902e15935dd657e622bc92c 100644
--- a/chrome/browser/actor/actor_task.h
+++ b/chrome/browser/actor/actor_task.h
@@ -449,6 +449,12 @@ class ActorTask : public base::SupportsUserData {
 
   std::unique_ptr<ActionTrackerForMetrics> action_tracker_for_metrics_;
 
+  // The checker is either owned by the client or by this task.
+  // Declared before policy_checker_ so a task-specific checker remains alive
+  // for the full lifetime of the raw reference and execution engine below.
+  std::unique_ptr<EnterprisePolicyChecker> owned_policy_checker_;
+  const raw_ref<const EnterprisePolicyChecker> policy_checker_;
+
   // This is used by and should be kept above `execution_engine_`.
   std::unique_ptr<ui::UiEventDispatcher> ui_event_dispatcher_;
 
@@ -535,12 +541,6 @@ class ActorTask : public base::SupportsUserData {
 
   std::optional<InterruptReason> interrupt_reason_;
 
-  // The checker is either owned by the client or by this task.
-  // Declared before policy_checker_ so a task-specific checker remains alive
-  // for the full lifetime of the raw reference below.
-  std::unique_ptr<EnterprisePolicyChecker> owned_policy_checker_;
-  const raw_ref<const EnterprisePolicyChecker> policy_checker_;
-
   // Delegate for task-related events.
   base::WeakPtr<ActorTaskDelegate> delegate_;
 
