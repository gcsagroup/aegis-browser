index f1961e0d90..8c93df3ca8 100644
--- a/chrome/browser/actor/actor_keyed_service.cc
+++ b/chrome/browser/actor/actor_keyed_service.cc
@@ -420,9 +420,10 @@ TaskId ActorKeyedService::CreateTaskWithOptions(
     webui::mojom::TaskOptionsPtr options,
     base::WeakPtr<ActorTaskDelegate> delegate,
     std::optional<glic::mojom::InvocationSource> initial_invocation_source) {
-  return CreateTaskImpl(ui::NewUiEventDispatcher(GetActorUiStateManager(), journal_.is_private()),
-                        source_info, policy_checker, nullptr, std::move(options),
-                        std::move(delegate), initial_invocation_source);
