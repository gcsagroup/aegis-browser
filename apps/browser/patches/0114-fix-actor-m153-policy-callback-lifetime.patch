+  // The checker is either owned by the client or by this task.
+  // Declared before policy_checker_ so a task-specific checker remains alive
+  // for the full lifetime of the raw reference and execution engine below.
+  std::unique_ptr<EnterprisePolicyChecker> owned_policy_checker_;
+  const raw_ref<const EnterprisePolicyChecker> policy_checker_;
+
   // The engine responsible for actually processing and invoking a list of
