diff --git a/chrome/browser/actor/actor_keyed_service.cc b/chrome/browser/actor/actor_keyed_service.cc
index cfae9343eddccc3fa1786098576768256ddc8487..fd3052491a59d7aea6a45515cb23dac087cb5af3 100644
--- a/chrome/browser/actor/actor_keyed_service.cc
+++ b/chrome/browser/actor/actor_keyed_service.cc
@@ -520,7 +520,8 @@ TaskId ActorKeyedService::CreateTaskWithOptions(
     std::optional<glic::mojom::InvocationSource> initial_invocation_source,
     AllowedSchemes allowed_schemes) {
   CHECK(ui_state_manager);
-  return CreateTaskImpl(ui::NewUiEventDispatcher(ui_state_manager, journal_.is_private()), source_info,
+  return CreateTaskImpl(
+      ui::NewUiEventDispatcher(ui_state_manager, journal_.is_private()), source_info,
                         policy_checker, nullptr, std::move(options),
                         std::move(delegate), ui_state_manager,
                         initial_invocation_source, allowed_schemes);
@@ -535,7 +536,8 @@ TaskId ActorKeyedService::CreateTaskWithOwnedPolicyChecker(
   auto* ui_state_manager = actor_ui_state_manager_.get();
   CHECK(ui_state_manager);
   const EnterprisePolicyChecker* policy_checker_ptr = policy_checker.get();
-  return CreateTaskImpl(ui::NewUiEventDispatcher(ui_state_manager, journal_.is_private()),
+  return CreateTaskImpl(
+      ui::NewUiEventDispatcher(ui_state_manager, journal_.is_private()),
                         source_info, policy_checker_ptr,
                         std::move(policy_checker), std::move(options),
                         std::move(delegate), ui_state_manager, std::nullopt,
diff --git a/chrome/browser/actor/actor_task.cc b/chrome/browser/actor/actor_task.cc
