+void AegisInstallUi::ShowProgress(aegis_installer::Progress progress) {
+  using aegis_installer::Phase;
+  if (complete_ ||
+      static_cast<unsigned>(progress.phase) >
+          static_cast<unsigned>(Phase::kRollingBack) ||
+      progress.percent < -1 || progress.percent > 99)
+    return;
+  // 同一阶段不倒退；阶段变化会更换文字及分母，不能把它冒充整次安装百分比。
+  if (progress.phase == phase_ && progress.percent >= 0 && percent_ >= 0 &&
+      progress.percent < percent_)
+    return;
+  phase_ = progress.phase;
+  percent_ = progress.percent;
+  const wchar_t* label = L"正在准备";
+  switch (phase_) {
+    case Phase::kPreparing:
+      break;
+    case Phase::kDecompressing:
+      label = L"正在解压";
+      break;
+    case Phase::kUnpacking:
+      label = L"正在展开文件";
+      break;
+    case Phase::kInstalling:
+      label = L"正在安装";
+      break;
+    case Phase::kConfiguring:
+      label = L"正在配置";
+      break;
+    case Phase::kFinishing:
+      label = L"正在完成安装";
+      break;
+    case Phase::kRollingBack:
+      label = L"正在回滚";
+      break;
+  }
+  wchar_t value[80] = {};
+  if (percent_ >= 0) {
+    DWORD_PTR arguments[] = {reinterpret_cast<DWORD_PTR>(label),
+                             static_cast<DWORD_PTR>(percent_)};
+    ::FormatMessage(FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY,
+                    L"%1!s!  %2!u!%%", 0, 0, value,
+                    sizeof(value) / sizeof(value[0]),
+                    reinterpret_cast<va_list*>(arguments));
+  }
+  ::SetWindowText(status_, value[0] ? value : label);
+  LONG_PTR style = ::GetWindowLongPtr(progress_, GWL_STYLE);
+  ::SetWindowLongPtr(progress_, GWL_STYLE,
+                     percent_ < 0 ? style | PBS_MARQUEE : style & ~PBS_MARQUEE);
+  if (percent_ >= 0)
+    ::SendMessage(progress_, PBM_SETPOS, percent_, 0);
+  UpdateAppearance();
