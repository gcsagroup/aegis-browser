+  static SRes Look(ILookInStreamPtr stream, const void** buffer, size_t* size) {
+    return ILookInStream_Look(Owner(stream).source_, buffer, size);
+  }
+  static SRes Skip(ILookInStreamPtr stream, size_t size) {
+    auto& self = Owner(stream);
