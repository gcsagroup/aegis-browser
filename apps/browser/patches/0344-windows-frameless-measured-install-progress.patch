 void InstallerState::SetStage(InstallerStage stage) const {
+  using aegis_installer::Phase;
+  switch (stage) {
+    case UNCOMPRESSING:
+      progress_phase_ = Phase::kDecompressing;
+      break;
+    case UNPACKING:
+      progress_phase_ = Phase::kUnpacking;
+      break;
+    case EXECUTING:
+      progress_phase_ = Phase::kInstalling;
+      break;
+    case COPYING_PREFERENCES_FILE:
+    case CREATING_SHORTCUTS:
+    case REGISTERING_CHROME:
+      progress_phase_ = Phase::kConfiguring;
+      break;
+    case REMOVING_OLD_VERSIONS:
+    case FINISHING:
+      progress_phase_ = Phase::kFinishing;
+      break;
+    case ROLLINGBACK:
+      progress_phase_ = Phase::kRollingBack;
+      break;
+    default:
+      progress_phase_ = Phase::kPreparing;
+      break;
+  }
+  // 保留上游更新器兼容字段，但 Aegis UI 不使用其按阶段估算的百分比。
+  progress_channel_.Write(progress_phase_, -1);
   GoogleUpdateSettings::SetProgress(system_install(), state_key_,
                                     progress_calculator_.Calculate(stage));
 }
 
+void InstallerState::ReportUnpackProgress(uint64_t completed,
+                                          uint64_t total) const {
+  if (progress_phase_ != aegis_installer::Phase::kDecompressing &&
+      progress_phase_ != aegis_installer::Phase::kUnpacking)
+    return;
+  if (!total || completed > total)
+    return;
+  int percent =
+      static_cast<int>(100.0 * static_cast<double>(completed) / total);
+  progress_channel_.Write(progress_phase_, percent < 99 ? percent : 99);
+}
+
+void InstallerState::ReportInstallProgress(size_t completed,
+                                           size_t total) const {
+  if (progress_phase_ != aegis_installer::Phase::kInstalling || !total ||
+      completed > total)
+    return;
+  int percent =
+      static_cast<int>(100.0 * static_cast<double>(completed) / total);
+  progress_channel_.Write(progress_phase_, percent < 99 ? percent : 99);
+}
