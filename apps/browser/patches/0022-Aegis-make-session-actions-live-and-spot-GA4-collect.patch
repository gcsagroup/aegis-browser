     return;
   }
   const fallback: SummarizeResult =
       await sendWithPromise('summarizeActiveTab');
-  showResult(formatSummary(fallback));
+  showResult(
+      piiLine(snapshot.textSample, localeCode().startsWith('zh')) + '\n' +
+      formatSummary(fallback));
 }
 
