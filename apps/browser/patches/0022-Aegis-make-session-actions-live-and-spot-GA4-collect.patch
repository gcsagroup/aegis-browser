 }
 
+function kindLabel(kind: string, zh: boolean): string {
+  if (kind === 'cookie') {
+    return 'Cookie';
+  }
+  if (kind === 'bounce') {
+    return zh ? '跳转' : 'Bounce';
+  }
+  if (kind === 'block') {
+    return zh ? '拦截' : 'Block';
+  }
+  return zh ? '参数' : 'Param';
+}
