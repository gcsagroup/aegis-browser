 }
 
+// Resolving a deictic page reference belongs to the browser, not the model.
+// This keeps common commands reliable and prevents an intent router from
+// turning "this page" into a browser-metadata or web-search task.
+bool GoalRefersToCurrentPage(std::string_view goal) {
+  const std::string lower_goal = base::ToLowerASCII(goal);
+  constexpr std::string_view kCurrentPageReferences[] = {
+      "当前页",       "当前页面",    "当前网页",  "这个页面",
+      "这个网页",     "本页面",      "本网页",    "页面内容",
+      "网页内容",     "this page",   "current page",
+      "page content", "the page content"};
+  return std::ranges::any_of(kCurrentPageReferences,
+                             [&lower_goal](std::string_view reference) {
+                               return lower_goal.find(reference) !=
+                                      std::string::npos;
+                             });
+}
+
 std::optional<GURL> ExplicitUrlFromGoal(std::string_view goal) {
   const std::string lower_goal = base::ToLowerASCII(goal);
   const size_t https = lower_goal.find("https://");
@@ -453,10 +470,14 @@ void AegisAgentPageHandler::CreateTask(
     last_error_ = "Configure a valid Agent model provider before planning";
   } else {
     const std::optional<GURL> explicit_url = ExplicitUrlFromGoal(goal);
-    const bool browser_only =
+    const bool use_current_page =
         !requested_origins && !explicit_url &&
+        GoalRefersToCurrentPage(goal);
+    const bool browser_only =
+        !requested_origins && !explicit_url && !use_current_page &&
         !WorkflowNeedsWebTarget(*converted_workflow);
-    if (!requested_origins && !explicit_url && !browser_only) {
+    if (!requested_origins && !explicit_url && !use_current_page &&
+        !browser_only) {
       service_->RouteGoal(
           goal, *converted_workflow,
           base::BindOnce(&AegisAgentPageHandler::OnGoalRouted,
@@ -466,7 +487,7 @@ void AegisAgentPageHandler::CreateTask(
     }
     CreateResolvedTask(goal, *converted_mode, *converted_workflow,
                        std::move(requested_origins), explicit_url,
-                       browser_only, std::move(callback));
+                       browser_only, use_current_page, std::move(callback));
     return;
   }
   std::move(callback).Run(BuildSnapshot());
@@ -506,7 +527,8 @@ void AegisAgentPageHandler::OnGoalRouted(
   }
   CreateResolvedTask(std::move(goal), mode, route->workflow,
