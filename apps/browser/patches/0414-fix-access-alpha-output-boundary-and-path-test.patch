diff --git a/chrome/browser/aegis/access/verify_no_alpha_access_resources.py b/chrome/browser/aegis/access/verify_no_alpha_access_resources.py
new file mode 100644
index 0000000000000000000000000000000000000000..602b4f2aef99dec4b97015cafb334c9e3c3c059a
--- /dev/null
+++ b/chrome/browser/aegis/access/verify_no_alpha_access_resources.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""Reject stale private Alpha assets in a reused normal build output."""
+
+import argparse
+from pathlib import Path
+
+
+def verify(output: Path) -> None:
+    candidates = [output / "AegisAlphaAccess"]
+    candidates.extend(output.glob("*.framework/Resources/AegisAlphaAccess"))
+    candidates.extend(output.glob(
+        "*.app/Contents/Frameworks/*.framework/Resources/AegisAlphaAccess"))
+    if any(path.exists() for path in candidates):
+        raise ValueError("Normal output contains Alpha test assets")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", required=True, type=Path)
+    parser.add_argument("--stamp", required=True, type=Path)
+    args = parser.parse_args()
+    try:
+        verify(args.output_dir)
+    except ValueError:
+        parser.exit(1, "Normal output contains Alpha test assets; use a normal output directory.\n")
+    args.stamp.parent.mkdir(parents=True, exist_ok=True)
+    args.stamp.write_text("Alpha test resources absent\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/chrome/browser/aegis/access/verify_no_alpha_access_resources_test.py b/chrome/browser/aegis/access/verify_no_alpha_access_resources_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..b0c9b1703ac2e8c73608a0d67e51bc9fb2c8b527
--- /dev/null
+++ b/chrome/browser/aegis/access/verify_no_alpha_access_resources_test.py
@@ -0,0 +1,29 @@
+from pathlib import Path
+import tempfile
+import unittest
+
+from verify_no_alpha_access_resources import verify
+
+
+class NormalResourceBoundaryTest(unittest.TestCase):
+    def test_clean_normal_output_is_accepted(self):
+        with tempfile.TemporaryDirectory() as folder:
+            verify(Path(folder))
+
+    def test_stale_alpha_assets_are_rejected_and_preserved(self):
+        for relative in ("AegisAlphaAccess",
+                "Browser.framework/Resources/AegisAlphaAccess",
+                "Browser.app/Contents/Frameworks/Browser.framework/Resources/AegisAlphaAccess"):
+            with self.subTest(relative=relative), tempfile.TemporaryDirectory() as folder:
+                root = Path(folder)
+                assets = root / relative
+                assets.mkdir(parents=True)
+                fixture = assets / "node.json"
+                fixture.write_text("private fixture")
+                with self.assertRaises(ValueError):
+                    verify(root)
+                self.assertEqual(fixture.read_text(), "private fixture")
+
+
+if __name__ == "__main__":
+    unittest.main()
