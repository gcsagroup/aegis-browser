diff --git a/chrome/browser/aegis/access/access_site_dev_allow_block_panel.h b/chrome/browser/aegis/access/access_site_dev_allow_block_panel.h
new file mode 100644
index 0000000000000000000000000000000000000000..0a57a693ad9b6e5c6f207bdbcd717a7fdc9bdfa0
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_dev_allow_block_panel.h
@@ -0,0 +1,102 @@
+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_DEV_ALLOW_BLOCK_PANEL_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_DEV_ALLOW_BLOCK_PANEL_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/aegis/access/access_site_intent.h"
+#include "components/version_info/channel.h"
+#include "url/gurl.h"
+
+namespace aegis::access {
+
+// P-mac-4: DEV/Alpha debug panel for explicit-host ALLOW / BLOCK.
+// Beta/Release must not register this panel or a general Access rule editor.
+
+enum class AccessDevAllowBlockChannelAdmission {
+  kAdmitted,
+  kNotAdmitted,
+};
+
+// DEV / Canary / Unknown (local developer builds) admit the panel.
+// Beta / Stable never register it.
+AccessDevAllowBlockChannelAdmission AccessDevAllowBlockPanelAdmissionFor(
+    version_info::Channel channel);
+
+bool IsAccessDevAllowBlockPanelAdmitted(version_info::Channel channel);
+
+// Hard rule for this feat: never register a general rule editor entry.
+// Beta/Release stay false; DEV panel is host ALLOW/BLOCK only.
+bool IsGeneralAccessRuleEditorRegistered(version_info::Channel channel);
+
+enum class AccessDevAllowBlockAction {
+  kAllow,
+  kBlock,
+  kOff,
+};
+
+enum class AccessDevAllowBlockApplyStatus {
+  kApplied,
+  kChannelNotAdmitted,
+  kInvalidHost,
+};
+
+struct AccessDevAllowBlockApplyResult {
+  AccessDevAllowBlockApplyStatus status =
+      AccessDevAllowBlockApplyStatus::kInvalidHost;
+  std::optional<AccessSiteHost> host;
+  AccessSiteIntent intent = AccessSiteIntent::kOff;
+};
+
+// Applies product intent for an explicit host when the channel admits the
+// panel. Never invents DIRECT success for allow/block. Does not publish/ACK
+// (session finalize stays on the product toggle / P-mac-3 path).
+AccessDevAllowBlockApplyResult ApplyAccessDevAllowBlock(
+    AccessSiteIntentStore* store,
+    version_info::Channel channel,
+    std::string_view raw_host,
+    AccessDevAllowBlockAction action);
+
+enum class AccessDevAllowBlockStatusId {
+  kPanelNotRegistered,
+  kNoTrustedHost,
+  kOff,
+  kAllowProxyIntent,
+  kBlockLocalRefuse,
+};
+
+struct AccessDevAllowBlockPanelSnapshot {
+  // False on Beta/Release — UI must not render the section.
+  bool panel_registered = false;
+  // Always false: this feat is not a general rule editor.
+  bool general_rule_editor_registered = false;
+  bool has_explicit_host = false;
+  AccessSiteHost host;
+  AccessSiteIntent intent = AccessSiteIntent::kOff;
+  AccessDevAllowBlockStatusId status_id =
+      AccessDevAllowBlockStatusId::kPanelNotRegistered;
+};
+
+// Presentation for the DEV panel. Host comes from a trusted committed URL or
+// an already-canonical explicit host string.
+AccessDevAllowBlockPanelSnapshot BuildAccessDevAllowBlockPanelSnapshot(
+    version_info::Channel channel,
+    const AccessSiteIntentStore& store,
+    const GURL& committed_url);
+
+AccessDevAllowBlockPanelSnapshot BuildAccessDevAllowBlockPanelSnapshotForHost(
+    version_info::Channel channel,
+    const AccessSiteIntentStore& store,
+    std::string_view raw_host);
+
+std::string_view AccessDevAllowBlockActionToString(
+    AccessDevAllowBlockAction action);
+std::string_view AccessDevAllowBlockApplyStatusToString(
+    AccessDevAllowBlockApplyStatus status);
+
+}  // namespace aegis::access
+
+#endif  // CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_DEV_ALLOW_BLOCK_PANEL_H_
diff --git a/chrome/browser/aegis/access/access_site_dev_allow_block_panel.cc b/chrome/browser/aegis/access/access_site_dev_allow_block_panel.cc
new file mode 100644
index 0000000000000000000000000000000000000000..2e905fc85b54d4a9ee6d501185f7522e627487ba
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_dev_allow_block_panel.cc
@@ -0,0 +1,164 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_dev_allow_block_panel.h"
+
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
+
+namespace aegis::access {
+namespace {
+
+AccessSiteIntent IntentForAction(AccessDevAllowBlockAction action) {
+  switch (action) {
+    case AccessDevAllowBlockAction::kAllow:
+      return AccessSiteIntent::kAllow;
+    case AccessDevAllowBlockAction::kBlock:
+      return AccessSiteIntent::kBlock;
+    case AccessDevAllowBlockAction::kOff:
+      return AccessSiteIntent::kOff;
+  }
+  return AccessSiteIntent::kOff;
+}
+
+AccessDevAllowBlockStatusId StatusForIntent(AccessSiteIntent intent) {
+  switch (intent) {
+    case AccessSiteIntent::kAllow:
+      return AccessDevAllowBlockStatusId::kAllowProxyIntent;
+    case AccessSiteIntent::kBlock:
+      return AccessDevAllowBlockStatusId::kBlockLocalRefuse;
+    case AccessSiteIntent::kOff:
+      return AccessDevAllowBlockStatusId::kOff;
+  }
+  return AccessDevAllowBlockStatusId::kOff;
+}
+
+AccessDevAllowBlockPanelSnapshot SnapshotForResolvedHost(
+    version_info::Channel channel,
+    const AccessSiteIntentStore& store,
+    const AccessSiteHostResult& host_result) {
+  AccessDevAllowBlockPanelSnapshot snapshot;
+  snapshot.general_rule_editor_registered =
+      IsGeneralAccessRuleEditorRegistered(channel);
+  if (!IsAccessDevAllowBlockPanelAdmitted(channel)) {
+    snapshot.panel_registered = false;
+    snapshot.status_id = AccessDevAllowBlockStatusId::kPanelNotRegistered;
+    return snapshot;
+  }
+  snapshot.panel_registered = true;
+  if (host_result.status != AccessSiteHostStatus::kOk || !host_result.host) {
+    snapshot.status_id = AccessDevAllowBlockStatusId::kNoTrustedHost;
+    return snapshot;
+  }
+  snapshot.has_explicit_host = true;
+  snapshot.host = *host_result.host;
+  snapshot.intent = store.Get(snapshot.host);
+  snapshot.status_id = StatusForIntent(snapshot.intent);
+  return snapshot;
+}
+
+}  // namespace
+
+AccessDevAllowBlockChannelAdmission AccessDevAllowBlockPanelAdmissionFor(
+    version_info::Channel channel) {
+  switch (channel) {
+    case version_info::Channel::DEV:
+    case version_info::Channel::CANARY:
+    case version_info::Channel::UNKNOWN:
+      return AccessDevAllowBlockChannelAdmission::kAdmitted;
+    case version_info::Channel::BETA:
+    case version_info::Channel::STABLE:
+      return AccessDevAllowBlockChannelAdmission::kNotAdmitted;
+  }
+  return AccessDevAllowBlockChannelAdmission::kNotAdmitted;
+}
+
+bool IsAccessDevAllowBlockPanelAdmitted(version_info::Channel channel) {
+  return AccessDevAllowBlockPanelAdmissionFor(channel) ==
+         AccessDevAllowBlockChannelAdmission::kAdmitted;
+}
+
+bool IsGeneralAccessRuleEditorRegistered(version_info::Channel channel) {
+  // P-mac-4 deliberately does not register a general rule editor on any
+  // channel. Beta/Release must stay without that entry.
+  (void)channel;
+  return false;
+}
+
+AccessDevAllowBlockApplyResult ApplyAccessDevAllowBlock(
+    AccessSiteIntentStore* store,
+    version_info::Channel channel,
+    std::string_view raw_host,
+    AccessDevAllowBlockAction action) {
+  AccessDevAllowBlockApplyResult result;
+  if (!store) {
+    result.status = AccessDevAllowBlockApplyStatus::kInvalidHost;
+    return result;
+  }
+  if (!IsAccessDevAllowBlockPanelAdmitted(channel)) {
+    result.status = AccessDevAllowBlockApplyStatus::kChannelNotAdmitted;
+    return result;
+  }
+
+  AccessSiteHostResult host_result = NormalizeAccessSiteHost(raw_host);
+  if (host_result.status != AccessSiteHostStatus::kOk || !host_result.host) {
+    // Already-canonical exact hosts are also accepted.
+    host_result = MakeAccessSiteHost(raw_host);
+  }
+  if (host_result.status != AccessSiteHostStatus::kOk || !host_result.host) {
+    result.status = AccessDevAllowBlockApplyStatus::kInvalidHost;
+    return result;
+  }
+
+  const AccessSiteIntent intent = IntentForAction(action);
+  store->Set(*host_result.host, intent);
+  result.status = AccessDevAllowBlockApplyStatus::kApplied;
+  result.host = *host_result.host;
+  result.intent = intent;
+  return result;
+}
+
+AccessDevAllowBlockPanelSnapshot BuildAccessDevAllowBlockPanelSnapshot(
+    version_info::Channel channel,
+    const AccessSiteIntentStore& store,
+    const GURL& committed_url) {
+  return SnapshotForResolvedHost(channel, store,
+                                 ResolveTrustedNavigationHost(committed_url));
+}
+
+AccessDevAllowBlockPanelSnapshot BuildAccessDevAllowBlockPanelSnapshotForHost(
+    version_info::Channel channel,
+    const AccessSiteIntentStore& store,
+    std::string_view raw_host) {
+  AccessSiteHostResult host_result = NormalizeAccessSiteHost(raw_host);
+  if (host_result.status != AccessSiteHostStatus::kOk || !host_result.host) {
+    host_result = MakeAccessSiteHost(raw_host);
+  }
+  return SnapshotForResolvedHost(channel, store, host_result);
+}
+
+std::string_view AccessDevAllowBlockActionToString(
+    AccessDevAllowBlockAction action) {
+  switch (action) {
+    case AccessDevAllowBlockAction::kAllow:
+      return "allow";
+    case AccessDevAllowBlockAction::kBlock:
+      return "block";
+    case AccessDevAllowBlockAction::kOff:
+      return "off";
+  }
+  return "off";
+}
+
+std::string_view AccessDevAllowBlockApplyStatusToString(
+    AccessDevAllowBlockApplyStatus status) {
+  switch (status) {
+    case AccessDevAllowBlockApplyStatus::kApplied:
+      return "applied";
+    case AccessDevAllowBlockApplyStatus::kChannelNotAdmitted:
+      return "channel_not_admitted";
+    case AccessDevAllowBlockApplyStatus::kInvalidHost:
+      return "invalid_host";
+  }
+  return "invalid_host";
+}
+
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_site_dev_allow_block_panel_unittest.cc b/chrome/browser/aegis/access/access_site_dev_allow_block_panel_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c40b28a3b1fd17949cdb27a6d3a2d17b528cb968
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_dev_allow_block_panel_unittest.cc
@@ -0,0 +1,162 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_dev_allow_block_panel.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+
+namespace aegis::access {
+namespace {
+
+TEST(AccessSiteDevAllowBlockPanelTest, AdmitsDevCanaryUnknownOnly) {
+  EXPECT_TRUE(
+      IsAccessDevAllowBlockPanelAdmitted(version_info::Channel::DEV));
+  EXPECT_TRUE(
+      IsAccessDevAllowBlockPanelAdmitted(version_info::Channel::CANARY));
+  EXPECT_TRUE(
+      IsAccessDevAllowBlockPanelAdmitted(version_info::Channel::UNKNOWN));
+  EXPECT_FALSE(
+      IsAccessDevAllowBlockPanelAdmitted(version_info::Channel::BETA));
+  EXPECT_FALSE(
+      IsAccessDevAllowBlockPanelAdmitted(version_info::Channel::STABLE));
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest,
+     NeverRegistersGeneralRuleEditorOnAnyChannel) {
+  for (version_info::Channel channel :
+       {version_info::Channel::UNKNOWN, version_info::Channel::CANARY,
+        version_info::Channel::DEV, version_info::Channel::BETA,
+        version_info::Channel::STABLE}) {
+    EXPECT_FALSE(IsGeneralAccessRuleEditorRegistered(channel));
+  }
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, BetaReleaseRefuseApply) {
+  AccessSiteIntentStore store;
+  auto blocked = ApplyAccessDevAllowBlock(
+      &store, version_info::Channel::BETA, "news.example",
+      AccessDevAllowBlockAction::kAllow);
+  EXPECT_EQ(blocked.status,
+            AccessDevAllowBlockApplyStatus::kChannelNotAdmitted);
+  EXPECT_TRUE(store.All().empty());
+
+  auto stable = ApplyAccessDevAllowBlock(
+      &store, version_info::Channel::STABLE, "news.example",
+      AccessDevAllowBlockAction::kBlock);
+  EXPECT_EQ(stable.status,
+            AccessDevAllowBlockApplyStatus::kChannelNotAdmitted);
+  EXPECT_TRUE(store.All().empty());
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, DevAppliesAllowBlockOffOnExplicitHost) {
+  AccessSiteIntentStore store;
+  auto allow = ApplyAccessDevAllowBlock(
+      &store, version_info::Channel::DEV, "https://NEWS.Example/path",
+      AccessDevAllowBlockAction::kAllow);
+  ASSERT_EQ(allow.status, AccessDevAllowBlockApplyStatus::kApplied);
+  ASSERT_TRUE(allow.host);
+  EXPECT_EQ(allow.host->value, "news.example");
+  EXPECT_EQ(allow.intent, AccessSiteIntent::kAllow);
+  EXPECT_EQ(store.Get(*allow.host), AccessSiteIntent::kAllow);
+
+  auto block = ApplyAccessDevAllowBlock(&store, version_info::Channel::DEV,
+                                        "news.example",
+                                        AccessDevAllowBlockAction::kBlock);
+  ASSERT_EQ(block.status, AccessDevAllowBlockApplyStatus::kApplied);
+  EXPECT_EQ(block.intent, AccessSiteIntent::kBlock);
+  EXPECT_EQ(store.Get(*block.host), AccessSiteIntent::kBlock);
+  // Block remains product-local refuse — never mapped to ordinary DIRECT here.
+  EXPECT_EQ(OrdinaryAccessModeForIntent(AccessSiteIntent::kBlock),
+            std::nullopt);
+
+  auto off = ApplyAccessDevAllowBlock(&store, version_info::Channel::CANARY,
+                                      "news.example",
+                                      AccessDevAllowBlockAction::kOff);
+  ASSERT_EQ(off.status, AccessDevAllowBlockApplyStatus::kApplied);
+  EXPECT_EQ(off.intent, AccessSiteIntent::kOff);
+  EXPECT_EQ(store.Get(*off.host), AccessSiteIntent::kOff);
+  EXPECT_TRUE(store.All().empty());
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, RejectsInvalidHost) {
+  AccessSiteIntentStore store;
+  auto empty = ApplyAccessDevAllowBlock(&store, version_info::Channel::DEV, "",
+                                        AccessDevAllowBlockAction::kAllow);
+  EXPECT_EQ(empty.status, AccessDevAllowBlockApplyStatus::kInvalidHost);
+
+  auto bad = ApplyAccessDevAllowBlock(&store, version_info::Channel::DEV,
+                                      "not a host",
+                                      AccessDevAllowBlockAction::kBlock);
+  EXPECT_EQ(bad.status, AccessDevAllowBlockApplyStatus::kInvalidHost);
+  EXPECT_TRUE(store.All().empty());
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, SnapshotHidesPanelOnBetaRelease) {
+  AccessSiteIntentStore store;
+  const GURL url("https://news.example/story");
+  auto beta = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::BETA, store, url);
+  EXPECT_FALSE(beta.panel_registered);
+  EXPECT_FALSE(beta.general_rule_editor_registered);
+  EXPECT_FALSE(beta.has_explicit_host);
+  EXPECT_EQ(beta.status_id, AccessDevAllowBlockStatusId::kPanelNotRegistered);
+
+  auto stable = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::STABLE, store, url);
+  EXPECT_FALSE(stable.panel_registered);
+  EXPECT_EQ(stable.status_id, AccessDevAllowBlockStatusId::kPanelNotRegistered);
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, SnapshotShowsAllowBlockForTrustedHost) {
+  AccessSiteIntentStore store;
+  const GURL url("https://news.example/story");
+  auto idle = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::DEV, store, url);
+  EXPECT_TRUE(idle.panel_registered);
+  EXPECT_FALSE(idle.general_rule_editor_registered);
+  ASSERT_TRUE(idle.has_explicit_host);
+  EXPECT_EQ(idle.host.value, "news.example");
+  EXPECT_EQ(idle.status_id, AccessDevAllowBlockStatusId::kOff);
+
+  ASSERT_EQ(ApplyAccessDevAllowBlock(&store, version_info::Channel::DEV,
+                                     "news.example",
+                                     AccessDevAllowBlockAction::kAllow)
+                .status,
+            AccessDevAllowBlockApplyStatus::kApplied);
+  auto allow = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::DEV, store, url);
+  EXPECT_EQ(allow.status_id, AccessDevAllowBlockStatusId::kAllowProxyIntent);
+
+  ASSERT_EQ(ApplyAccessDevAllowBlock(&store, version_info::Channel::DEV,
+                                     "news.example",
+                                     AccessDevAllowBlockAction::kBlock)
+                .status,
+            AccessDevAllowBlockApplyStatus::kApplied);
+  auto block = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::DEV, store, url);
+  EXPECT_EQ(block.status_id, AccessDevAllowBlockStatusId::kBlockLocalRefuse);
+
+  auto internal = BuildAccessDevAllowBlockPanelSnapshot(
+      version_info::Channel::DEV, store, GURL("chrome://settings"));
+  EXPECT_TRUE(internal.panel_registered);
+  EXPECT_FALSE(internal.has_explicit_host);
+  EXPECT_EQ(internal.status_id, AccessDevAllowBlockStatusId::kNoTrustedHost);
+}
+
+TEST(AccessSiteDevAllowBlockPanelTest, ExplicitHostSnapshotIndependentOfUrl) {
+  AccessSiteIntentStore store;
+  ASSERT_EQ(ApplyAccessDevAllowBlock(&store, version_info::Channel::UNKNOWN,
+                                     "blocked.example",
+                                     AccessDevAllowBlockAction::kBlock)
+                .status,
+            AccessDevAllowBlockApplyStatus::kApplied);
+  auto snap = BuildAccessDevAllowBlockPanelSnapshotForHost(
+      version_info::Channel::UNKNOWN, store, "blocked.example");
+  EXPECT_TRUE(snap.panel_registered);
+  ASSERT_TRUE(snap.has_explicit_host);
+  EXPECT_EQ(snap.host.value, "blocked.example");
+  EXPECT_EQ(snap.status_id, AccessDevAllowBlockStatusId::kBlockLocalRefuse);
+}
+
+}  // namespace
+}  // namespace aegis::access
