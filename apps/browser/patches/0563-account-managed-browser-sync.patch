diff --git a/chrome/browser/ui/webui/aegis/link_background_sync.cc b/chrome/browser/ui/webui/aegis/link_background_sync.cc
new file mode 100644
index 0000000000000000000000000000000000000000..a1c867716aaac9349ed10ca70ed832ed21e4337c
--- /dev/null
+++ b/chrome/browser/ui/webui/aegis/link_background_sync.cc
@@ -0,0 +1,92 @@
+// 后台与账号页运行相同的同步协议。每轮释放隐藏文档，退出或销毁 Profile
+// 时停止调度。
+#include "chrome/browser/ui/webui/aegis/link_background_sync.h"
+
+#include "base/functional/bind.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/scoped_observation.h"
+#include "base/supports_user_data.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/profiles/profile_observer.h"
+#include "chrome/common/aegis/link_account.h"
+#include "components/prefs/pref_change_registrar.h"
+#include "components/prefs/pref_service.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/web_contents.h"
+
+namespace aegis::link {
+namespace {
+const char kSchedulerKey = 0;
+class Scheduler : public base::SupportsUserData::Data, public ProfileObserver {
+ public:
+  explicit Scheduler(Profile* profile) : profile_(profile) {
+    observation_.Observe(profile);
+    prefs_.Init(profile->GetPrefs());
+    prefs_.Add(kEmail,
+               base::BindRepeating(&Scheduler::Schedule, weak_.GetWeakPtr()));
+    Schedule();
+  }
+
+  void Finish(content::WebContents* source) {
+    if (source != document_.get()) {
+      return;
+    }
+    // 延迟到当前桥接回调返回，避免在 WebUI 消息处理过程中销毁它自身。
+    timer_.Start(FROM_HERE, base::TimeDelta(), this, &Scheduler::Rest);
+  }
+
+ private:
+  void Schedule() {
+    timer_.Start(FROM_HERE, base::TimeDelta(), this, &Scheduler::Run);
+  }
+  void Rest() {
+    document_.reset();
+    if (!profile_->GetPrefs()->GetString(kEmail).empty()) {
+      timer_.Start(FROM_HERE, base::Minutes(2), this, &Scheduler::Run);
+    }
+  }
+  void Run() {
+    document_.reset();
+    if (profile_->GetPrefs()->GetString(kEmail).empty()) {
+      return;
+    }
+    content::WebContents::CreateParams params(profile_);
+    params.initially_hidden = true;
+    document_ = content::WebContents::Create(params);
+    document_->GetController().LoadURL(GURL(kBackgroundPage),
+                                       content::Referrer(),
+                                       ui::PAGE_TRANSITION_AUTO_TOPLEVEL, {});
+    // 网络中断或渲染进程退出时释放本轮并重试，页面自身不持有长期计时器。
+    timer_.Start(FROM_HERE, base::Minutes(2), this, &Scheduler::Rest);
+  }
+  void OnProfileWillBeDestroyed(Profile* profile) override {
+    weak_.InvalidateWeakPtrs();
+    timer_.Stop();
+    prefs_.RemoveAll();
+    document_.reset();
+    observation_.Reset();
+  }
+  const raw_ptr<Profile> profile_;
+  base::ScopedObservation<Profile, ProfileObserver> observation_{this};
+  PrefChangeRegistrar prefs_;
+  base::OneShotTimer timer_;
+  std::unique_ptr<content::WebContents> document_;
+  base::WeakPtrFactory<Scheduler> weak_{this};
+};
+}  // namespace
+void StartBackgroundSync(Profile* profile) {
+  if (profile->IsRegularProfile() && !profile->IsOffTheRecord() &&
+      !profile->GetUserData(&kSchedulerKey)) {
+    profile->SetUserData(&kSchedulerKey, std::make_unique<Scheduler>(profile));
+  }
+}
+void FinishBackgroundSync(Profile* profile, content::WebContents* source) {
+  if (auto* scheduler =
+          static_cast<Scheduler*>(profile->GetUserData(&kSchedulerKey))) {
+    scheduler->Finish(source);
+  }
+}
+}  // namespace aegis::link
diff --git a/chrome/browser/ui/webui/aegis/link_background_sync.h b/chrome/browser/ui/webui/aegis/link_background_sync.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec7e5c9363556aaabea516f57044c5905aebe975
--- /dev/null
+++ b/chrome/browser/ui/webui/aegis/link_background_sync.h
@@ -0,0 +1,14 @@
+// 普通桌面资料的后台账号同步，使用该 Profile 自己的 Cookie 和浏览器存储。
+#ifndef CHROME_BROWSER_UI_WEBUI_AEGIS_LINK_BACKGROUND_SYNC_H_
+#define CHROME_BROWSER_UI_WEBUI_AEGIS_LINK_BACKGROUND_SYNC_H_
+class Profile;
+namespace content {
+class WebContents;
+}
+namespace aegis::link {
+// 每个普通 Profile 安装一次调度器，已登录时才打开一次性同步文档。
+void StartBackgroundSync(Profile* profile);
+// 只有调度器创建的文档可以结束本轮，普通账号页不能关闭其他页面。
+void FinishBackgroundSync(Profile* profile, content::WebContents* source);
+}  // namespace aegis::link
+#endif
diff --git a/chrome/browser/ui/webui/aegis/link_browser_login.cc b/chrome/browser/ui/webui/aegis/link_browser_login.cc
new file mode 100644
index 0000000000000000000000000000000000000000..adaf5ac50fd445982f67b550f06dd6dd441bf9b9
--- /dev/null
+++ b/chrome/browser/ui/webui/aegis/link_browser_login.cc
@@ -0,0 +1,103 @@
+// 跟踪一次浏览器账号登录，不改变整个 Profile 的密码管理器设置。
+#include "chrome/browser/ui/webui/aegis/link_browser_login.h"
+
+#include "base/functional/bind.h"
+#include "base/task/single_thread_task_runner.h"
+#include "chrome/browser/ui/webui/aegis/link_first_run_choice.h"
+#include "chrome/browser/ui/webui/aegis/link_portal_origin.h"
+#include "chrome/common/aegis/link_account.h"
+#include "content/public/browser/navigation_controller.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/origin.h"
+
+namespace {
+GURL Portal() {
+  return GURL(AEGIS_LINK_PORTAL_ORIGIN);
+}
+// 只有从原生登录按钮开始的本次标签页导航可以返回账号页。普通网页不能发起特权导航。
+class LoginReturn : public content::WebContentsObserver,
+                    public content::WebContentsUserData<LoginReturn> {
+ public:
+  void Begin() {
+    waiting_ = true;
+    opening_login_ = true;
+    submitted_here_ = false;
+    web_contents()->GetController().LoadURL(
+        Portal().Resolve("/login?next=/account"), content::Referrer(),
+        ui::PAGE_TRANSITION_AUTO_BOOKMARK, {});
+  }
+  void DidFinishNavigation(content::NavigationHandle* nav) override {
+    if (!nav->IsInPrimaryMainFrame() || !nav->HasCommitted()) {
+      return;
+    }
+    const auto& url = nav->GetURL();
+    if (opening_login_) {
+      opening_login_ = false;
+      submitted_here_ = !nav->IsErrorPage() &&
+                        url == Portal().Resolve("/login?next=/account");
+    }
+    // SPA 切到 /account
+    // 后密码管理器可能才收到提交结果，保留到原生账号页完成返回。
+    const bool login_page =
+        url::Origin::Create(url) == url::Origin::Create(Portal()) &&
+        (url.path() == "/login" || url.path() == "/login/success");
+    if (!login_page && url != Portal().Resolve("/account") &&
+        url.GetWithoutRef() != GURL(aegis::link::kPage)) {
+      submitted_here_ = false;
+    }
+    if (!waiting_ || nav->IsErrorPage()) {
+      return;
+    }
+    if (nav->GetURL() != Portal().Resolve("/account")) {
+      return;
+    }
+    waiting_ = false;
+    // 同文档 SPA 登录回跳也会到这里。延迟导航避免在提交回调内重入。
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<content::WebContents> tab) {
+                         if (tab && tab->GetLastCommittedURL() ==
+                                        Portal().Resolve("/account")) {
+                           tab->GetController().LoadURL(
+                               GURL(aegis::link::FirstRunChoice::From(tab.get())
+                                        ? aegis::link::kWelcomePage
+                                        : aegis::link::kPage),
+                               content::Referrer(),
+                               ui::PAGE_TRANSITION_AUTO_BOOKMARK, {});
+                         }
+                       },
+                       web_contents()->GetWeakPtr()));
+  }
+
+  bool Matches(const GURL& form) const {
+    return submitted_here_ && form.path() == "/login" &&
+           url::Origin::Create(form) == url::Origin::Create(Portal());
+  }
+
+ private:
+  friend class content::WebContentsUserData<LoginReturn>;
+  explicit LoginReturn(content::WebContents* tab)
+      : content::WebContentsObserver(tab),
+        content::WebContentsUserData<LoginReturn>(*tab) {}
+  bool waiting_ = false;
+  bool opening_login_ = false;
+  bool submitted_here_ = false;
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+WEB_CONTENTS_USER_DATA_KEY_IMPL(LoginReturn);
+
+}  // namespace
+
+namespace aegis::link {
+void BeginBrowserLogin(content::WebContents* tab) {
+  LoginReturn::CreateForWebContents(tab);
+  LoginReturn::FromWebContents(tab)->Begin();
+}
+bool IsBrowserLoginCredential(content::WebContents* tab, const GURL& form) {
+  auto* login = LoginReturn::FromWebContents(tab);
+  return login && login->Matches(form);
+}
+}  // namespace aegis::link
