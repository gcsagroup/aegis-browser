From 94d8a208bbcb66c0804e3b661c194930d685af8f Mon Sep 17 00:00:00 2001
From: Aegis Browser <devnull@localhost>
Date: Sun, 15 Nov 2026 00:19:29 +0800
Subject: [PATCH] fix(access): preserve settings refresh event handling

---
 .../aegis_page/access_account_usage.ts        | 24 ++++++++++++-------
 .../settings/aegis_page/aegis_page.ts         |  4 +++-
 2 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/chrome/browser/resources/settings/aegis_page/access_account_usage.ts b/chrome/browser/resources/settings/aegis_page/access_account_usage.ts
index 638eacfe2581f2e196e14714589cdaa102de8ef0..c8714f9de7302ab0f9459b8697308eba140d6621 100644
--- a/chrome/browser/resources/settings/aegis_page/access_account_usage.ts
+++ b/chrome/browser/resources/settings/aegis_page/access_account_usage.ts
@@ -29,16 +29,16 @@ export function formatUsageBytes(raw: string|null): string {
   if (raw === null || !/^(0|[1-9]\d*)$/.test(raw)) return '—';
   const bytes = BigInt(raw);
   if (bytes > 18446744073709551615n) return '—';
-  const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB'];
   let divisor = 1n;
-  let unit = 0;
-  while (unit < units.length - 1 && bytes / divisor >= 1024n) {
+  let unit = 'B';
+  for (const nextUnit of ['KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB']) {
+    if (bytes / divisor < 1024n) break;
     divisor *= 1024n;
-    ++unit;
+    unit = nextUnit;
   }
-  if (!unit) return `${raw} B`;
+  if (unit === 'B') return `${raw} B`;
   const fraction = ((bytes % divisor) * 100n / divisor).toString().padStart(2, '0');
-  return `${bytes / divisor}.${fraction} ${units[unit]} (${raw} B)`;
+  return `${bytes / divisor}.${fraction} ${unit} (${raw} B)`;
 }
 
 export function usageFreshness(
@@ -90,6 +90,11 @@ export class AccessUsageRefresh {
     if (this.visible_ && !this.isVisible_()) this.setVisible(false);
     return this.visible_ && generation === this.generation_;
   }
+  private refreshNewGeneration_(generation: number): void {
+    if (generation !== this.generation_ && this.current_(this.generation_)) {
+      void this.refresh();
+    }
+  }
   setVisible(visible: boolean) {
     if (visible === this.visible_) return;
     this.visible_ = visible;
@@ -126,7 +131,7 @@ export class AccessUsageRefresh {
       }
     } finally {
       this.inFlight_ = false;
-      if (this.visible_ && generation !== this.generation_) void this.refresh();
+      this.refreshNewGeneration_(generation);
     }
   }
 }
@@ -231,7 +236,7 @@ export function startAccessUsage(
   let visible = false;
   let manual = false;
   const button = root.querySelector<HTMLButtonElement>('[data-usage="refresh"]');
-  const onRefresh = async () => {
+  const queryUsage = async () => {
     if (!visibleNow() || manual) return;
     manual = true;
     if (button) button.disabled = true;
@@ -245,6 +250,9 @@ export function startAccessUsage(
       if (visibleNow()) void refresh.refresh();
     }
   };
+  const onRefresh = () => {
+    void queryUsage();
+  };
   button?.addEventListener('click', onRefresh);
   const tick = () => {
     const next = visibleNow();
diff --git a/chrome/browser/resources/settings/aegis_page/aegis_page.ts b/chrome/browser/resources/settings/aegis_page/aegis_page.ts
index 153d5e1242ad597cd9a5d37929ddc08091c72526..d0b5c054744a5b2477abc89f15a21b094dd73c7e 100644
--- a/chrome/browser/resources/settings/aegis_page/aegis_page.ts
+++ b/chrome/browser/resources/settings/aegis_page/aegis_page.ts
@@ -76,7 +76,9 @@ export class SettingsAegisPageElement extends PolymerElement {
           () => this.isConnected && this.mode === 'home' &&
               usage.checkVisibility({checkVisibilityCSS: true}));
       // </if>
-      void this.initialize_().catch(error => this.message_(String(error)));
+      void this.initialize_().catch(error => {
+        this.message_(String(error));
+      });
     });
   }
   override disconnectedCallback() {
