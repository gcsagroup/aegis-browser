From c179a67cb74698979e7c191f2caa710149cd7f99 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 11 Nov 2026 22:58:04 +0800
Subject: [PATCH] test(access): reproduce unresponsive core session-ending
 deadline

---
 .../access_local_core_manager_unittest.cc     | 67 +++++++++++++++++++
 .../access/access_local_core_test_child.cc    | 20 ++++++
 2 files changed, 87 insertions(+)

diff --git a/chrome/browser/aegis/access/access_local_core_manager_unittest.cc b/chrome/browser/aegis/access/access_local_core_manager_unittest.cc
index 9271bee64864ebaea15f40ee8f3a28397d8478c6..2bacc92a4d4900a184a54a13179b69c04fc037e1 100644
--- a/chrome/browser/aegis/access/access_local_core_manager_unittest.cc
+++ b/chrome/browser/aegis/access/access_local_core_manager_unittest.cc
@@ -184,6 +184,63 @@ class AccessLocalCoreFaultTest : public AccessLocalCoreManagerTest {
     EXPECT_TRUE(result.registration_id.empty());
     EXPECT_FALSE(result.error.empty());
   }
+  enum class StopInFlight { kNone, kExplicitStop, kDestruction };
+  void CheckUnresponsiveSessionEnding(StopInFlight in_flight) {
+    auto manager = std::make_unique<AccessLocalCoreManager>(Input("ignore-term"));
+    base::test::TestFuture<AccessLocalCoreReady> prepared;
+    manager->Prepare(prepared.GetCallback());
+    base::test::TestFuture<void> tunnel;
+    base::RepeatingTimer observation;
+    observation.Start(FROM_HERE, base::Milliseconds(10),
+        base::BindLambdaForTesting([&] {
+      auto state = State();
+      if (state && state->FindString("phase") &&
+          *state->FindString("phase") == "authenticated-tunnel-held") {
+        observation.Stop();
+        tunnel.SetValue();
+      }
+    }));
+    ASSERT_TRUE(tunnel.Wait());
+    const auto state = State();
+    ASSERT_TRUE(state);
+    const auto child_pid = state->FindInt("pid");
+    const auto* directory = state->FindString("configDirectory");
+    ASSERT_TRUE(child_pid);
+    ASSERT_TRUE(directory);
+    const base::FilePath private_directory(*directory);
+    ASSERT_TRUE(base::PathExists(private_directory));
+    base::test::TestFuture<void> ordinary_stop;
+    if (in_flight != StopInFlight::kNone) {
+      if (in_flight == StopInFlight::kDestruction) manager.reset();
+      else manager->Stop(ordinary_stop.GetCallback());
+      // Confirm StopChild is already inside its termination wait, including
+      // service destruction, before requesting the session-ending rundown.
+      ASSERT_TRUE(base::test::RunUntil([&] {
+        std::string marker;
+        return base::ReadFileToString(state_.AddExtensionASCII("sigterm"), &marker) &&
+               !marker.empty();
+      }));
+      EXPECT_FALSE(ordinary_stop.IsReady());
+    }
+    auto stopped = std::make_shared<base::WaitableEvent>();
+    AccessLocalCoreManager::StopAllForSessionEnding(base::BindOnce(
+        [](std::shared_ptr<base::WaitableEvent> event) { event->Signal(); }, stopped));
+    bool completed;
+    {
+      base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
+      completed = stopped->TimedWait(base::Seconds(5));
+      if (!completed) {
+        // Preserve a behavioral RED without leaving the deliberately stubborn
+        // fixture alive or waiting for the ordinary 60-second grace period.
+        kill(*child_pid, SIGKILL);
+        EXPECT_TRUE(stopped->TimedWait(base::Seconds(5)));
+      }
+    }
+    EXPECT_TRUE(completed) << "Owned core exceeded the session-ending deadline";
+    EXPECT_EQ(kill(*child_pid, 0), -1);
+    EXPECT_EQ(errno, ESRCH);
+    EXPECT_FALSE(base::PathExists(private_directory));
+  }
   base::ScopedTempDir directory_;
   base::FilePath binary_, state_;
   std::string pin_;
@@ -339,6 +396,16 @@ TEST_F(AccessLocalCoreFaultTest, StalledAuthenticatedTunnelTimesOut) {
   ASSERT_TRUE(state);
   EXPECT_EQ(*state->FindString("phase"), "authenticated-tunnel-held");
 }
+
+TEST_F(AccessLocalCoreFaultTest, SessionEndingEscalatesUnresponsiveChild) {
+  CheckUnresponsiveSessionEnding(StopInFlight::kNone);
+}
+TEST_F(AccessLocalCoreFaultTest, SessionEndingInterruptsUnresponsiveOrdinaryStop) {
+  CheckUnresponsiveSessionEnding(StopInFlight::kExplicitStop);
+}
+TEST_F(AccessLocalCoreFaultTest, SessionEndingInterruptsUnresponsiveDestruction) {
+  CheckUnresponsiveSessionEnding(StopInFlight::kDestruction);
+}
 #endif
 }  // namespace
 }  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_local_core_test_child.cc b/chrome/browser/aegis/access/access_local_core_test_child.cc
index 0dcb2adab361d650e9fdaa1d8c3644fa30d5bd15..0e908679beac7f9a902f6d0efc075401ede0c09e 100644
--- a/chrome/browser/aegis/access/access_local_core_test_child.cc
+++ b/chrome/browser/aegis/access/access_local_core_test_child.cc
@@ -23,10 +23,20 @@
 #include "base/values.h"
 
 namespace {
+int termination_marker_fd = -1;
+void IgnoreTermination(int) {
+  // Only async-signal-safe operations here. The marker proves that production
+  // Stop has already sent SIGTERM before a later session-ending request.
+  constexpr char marker = 'x';
+  const auto written = write(termination_marker_fd, &marker, 1);
+  (void)written;
+}
 void Record(const base::FilePath& path, const char* phase, int requests) {
   std::string json;
+  const auto args = base::CommandLine::ForCurrentProcess()->GetArgs();
   if (!base::JSONWriter::Write(base::DictValue()
           .Set("phase", phase).Set("pid", static_cast<int>(getpid()))
+          .Set("configDirectory", base::FilePath(args.back()).DirName().value())
           .Set("requests", requests), &json)) return;
   base::File file(path, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
   if (file.IsValid() && base::SetPosixFilePermissions(path, 0600))
@@ -73,6 +83,16 @@ int main(int argc, const char* argv[]) {
   if (!user || !password) return 3;
   const std::string credential = base::Base64Encode(*user + ":" + *password);
   const base::FilePath state_path(*state);
+  base::File termination_marker;
+  if (*mode == "ignore-term") {
+    const auto marker_path = state_path.AddExtensionASCII("sigterm");
+    termination_marker.Initialize(marker_path,
+        base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE);
+    if (!termination_marker.IsValid() ||
+        !base::SetPosixFilePermissions(marker_path, 0600)) return 5;
+    termination_marker_fd = termination_marker.GetPlatformFile();
+    signal(SIGTERM, IgnoreTermination);
+  }
   signal(SIGPIPE, SIG_IGN);
   base::ScopedFD listener(socket(AF_INET, SOCK_STREAM, 0));
   if (!listener.is_valid()) return 5;
