+TEST_F(NetworkServiceProxyDelegateTest,
+       AegisSelectionGenerationIsMonotonicWithinEachProxyGroup) {
+  auto config = mojom::CustomProxyConfig::New();
+  auto delegate = CreateDelegate(std::move(config));
+  auto metadata = [](const std::string& operation_id,
+                     uint64_t operation_sequence,
+                     const std::string& proxy_group_id,
+                     uint64_t selection_generation) {
+    auto value = mojom::AegisAccessPolicyPublicationMetadata::New();
+    value->operation_id = operation_id;
+    value->operation_sequence = operation_sequence;
+    value->policy_generation = operation_sequence;
+    value->proxy_group_id = proxy_group_id;
+    value->selection_generation = selection_generation;
+    value->network_epoch = 9;
+    value->channel = 0;
+    value->profile_token = "profile-token";
+    value->storage_partition_token = "partition-token";
+    return value;
+  };
+
+  EXPECT_TRUE(PublishAegisAccessPolicy(
+      metadata("group-a-2", 50, "group-a", 2)));
+  EXPECT_TRUE(PublishAegisAccessPolicy(
+      metadata("group-b-1", 51, "group-b", 1)));
+  EXPECT_FALSE(PublishAegisAccessPolicy(
+      metadata("group-a-stale", 52, "group-a", 1)));
+  EXPECT_TRUE(PublishAegisAccessPolicy(
+      metadata("group-a-3", 52, "group-a", 3)));
+  EXPECT_TRUE(
+      PublishAegisAccessPolicy(metadata("direct", 53, "", 0)));
+  EXPECT_FALSE(PublishAegisAccessPolicy(
+      metadata("missing-group", 54, "", 1)));
+  EXPECT_FALSE(PublishAegisAccessPolicy(
+      metadata("direct-with-group", 54, "group-a", 0)));
+}
