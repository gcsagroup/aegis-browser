+  test::PermissionRequestManagerTestApi api(manager);
+  auto* frame = contents->GetPrimaryMainFrame();
+  api.SetOrigin(frame->GetLastCommittedOrigin().GetURL());
+  api.AddSimpleRequest(frame, permissions::RequestType::kMicStream,
+                       /*user_gesture=*/false);
