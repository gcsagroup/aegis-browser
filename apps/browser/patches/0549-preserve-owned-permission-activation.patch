+IN_PROC_BROWSER_TEST_F(OmniboxAimPopupFullWebUIBrowserTest,
+                       PermissionDismissalReleasesNonActivatableFullPopup) {
+  ASSERT_NO_FATAL_FAILURE(ShowUnfocusedFullPopupWithMicrophonePrompt());
+
+  auto* controller = location_bar()->GetOmniboxController();
+  auto* state = controller->popup_state_manager();
+  auto* presenter = location_bar()->GetOmniboxPopupView()->presenter();
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* manager =
+      permissions::PermissionRequestManager::FromWebContents(contents);
+  ASSERT_TRUE(manager->GetPromptBubbleViewBoundsInScreen().has_value());
+
+  auto* widget = presenter->GetWidget();
+  ASSERT_TRUE(widget);
+  widget->widget_delegate()->SetCanActivate(false);
+  controller->edit_model()->OnSetFocus(/*control_down=*/false);
+
+  ASSERT_EQ(presenter->GetWidget(), widget);
+  ASSERT_TRUE(widget->IsVisible());
+  ASSERT_FALSE(widget->IsActive());
+  ASSERT_FALSE(widget->CanActivate());
+  ASSERT_TRUE(controller->edit_model()->has_focus());
+  ASSERT_EQ(state->popup_state(), OmniboxPopupState::kFull);
+  ASSERT_TRUE(presenter->IsPermissionPromptPreventingClose());
+
+  manager->Dismiss(/*prompt_options=*/std::monostate());
+  EXPECT_FALSE(manager->IsRequestInProgress());
+  ASSERT_TRUE(presenter->IsShown());
+  ASSERT_TRUE(presenter->GetWidget());
+  EXPECT_EQ(state->popup_state(), OmniboxPopupState::kFull);
+  EXPECT_FALSE(presenter->GetWidget()->IsActive());
+  EXPECT_FALSE(presenter->IsPermissionPromptPreventingClose());
+}
