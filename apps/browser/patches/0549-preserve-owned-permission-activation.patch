+  ASSERT_TRUE(presenter->IsShown());
+  ASSERT_TRUE(presenter->GetWidget());
+  EXPECT_FALSE(presenter->GetWidget()->IsActive());
+  EXPECT_FALSE(location_bar()->GetWidget()->GetTopLevelWidget()->IsActive());
+  EXPECT_EQ(state->popup_state(), OmniboxPopupState::kFull);
+  EXPECT_TRUE(presenter->IsPermissionPromptPreventingClose());
+  EXPECT_TRUE(controller->edit_model()->has_focus());
+
+  manager->Dismiss(/*prompt_options=*/std::monostate());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return !manager->IsRequestInProgress() && presenter->GetWidget() &&
+           presenter->GetWidget()->IsActive() &&
+           presenter->GetWebUIContent()->HasFocus() &&
+           !presenter->IsPermissionPromptPreventingClose();
