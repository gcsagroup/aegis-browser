+.toggle { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 8px 0; }
+input:not([type=checkbox]), select, textarea { font: inherit; max-width: 100%; padding: 9px 11px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: inherit; }
+textarea { display: block; width: 100%; resize: vertical; }
+#source { font: 13px/1.6 ui-monospace, monospace; tab-size: 2; }
+input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--accent); vertical-align: middle; }
+button, .file, summary { font: inherit; cursor: pointer; }
+button, .file { padding: 8px 14px; min-height: 36px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); color: var(--accent); }
+button:hover, .file:hover { background: light-dark(#f1f3f4, #303134); }
+button:disabled { opacity: .5; cursor: default; }
+button.primary { background: var(--accent); color: light-dark(#fff, #183153); border-color: transparent; }
+button.danger { color: light-dark(#b3261e, #f2b8b5); }
+:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+.file { position: relative; display: inline-flex; align-items: center; }
+.file input { position: absolute; inset: 0; opacity: 0; width: 100%; cursor: pointer; }
+.file:focus-within { outline: 2px solid var(--accent); outline-offset: 3px; }
+#notice { white-space: pre-wrap; padding: 10px 0; margin: 0; min-height: 34px; color: var(--muted); }
