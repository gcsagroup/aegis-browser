+* { box-sizing: border-box; }
+body { margin: 0; padding: 24px; }
+#enhancement-root { max-width: 960px; margin: auto; }
+h1 { font-size: 24px; font-weight: 500; margin: 16px 0; }
+h2 { font-size: 17px; font-weight: 600; margin: 0; }
+h3 { font-size: 15px; }
