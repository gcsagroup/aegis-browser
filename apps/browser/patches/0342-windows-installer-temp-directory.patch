-// Creates and returns a temporary directory in |work_dir| that can be used to
-// extract mini_installer payload. |work_dir| ends with a path separator.
-// Returns true if |work_dir| is available for use, or false in case of error
-// (indicated by |exit_code|).
-bool GetWorkDir(HMODULE module,
-                PathString* work_dir,
-                ProcessExitResult* exit_code) {
+// 只在 Windows 指定的临时目录下创建独占子目录；目录不可用时失败，
+// 不回退到安装包所在目录，也不在当前目录留下解压文件。
+bool GetWorkDir(PathString* work_dir, ProcessExitResult* exit_code) {
+  work_dir->clear();
   PathString base_path;
-
-  // Create a directory next to the current module.
-  return GetModuleDir(module, &base_path) &&
-         CreateWorkDir(base_path.get(), work_dir, exit_code);
+  // 新系统优先使用按进程权限选择目录的 API（SYSTEM 使用受保护的 SystemTemp）。
+  // 动态解析保持旧 Windows 10 兼容；仅在 API 不存在时使用 GetTempPathW。
+  const auto get_temp_path2 = reinterpret_cast<decltype(&::GetTempPathW)>(
+      ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"), "GetTempPath2W"));
+  const auto get_temp_path = get_temp_path2 ? get_temp_path2 : &::GetTempPathW;
+  const DWORD length =
+      get_temp_path(static_cast<DWORD>(base_path.capacity()), base_path.get());
+  if (!length || length >= base_path.capacity()) {
+    *exit_code = ProcessExitResult(
+        UNABLE_TO_GET_WORK_DIRECTORY,
+        length ? ERROR_INSUFFICIENT_BUFFER : ::GetLastError());
+    return false;
+  }
+  // Windows API 不检查目录存在性；先拒绝不存在的路径和普通文件，
+  // 可写性由带原有私有 ACL 的原子 CreateDirectory 操作实际验证。
+  const DWORD attributes = ::GetFileAttributesW(base_path.get());
+  if (attributes == INVALID_FILE_ATTRIBUTES ||
+      !(attributes & FILE_ATTRIBUTE_DIRECTORY)) {
+    *exit_code = ProcessExitResult(UNABLE_TO_GET_WORK_DIRECTORY,
+                                   attributes == INVALID_FILE_ATTRIBUTES
+                                       ? ::GetLastError()
+                                       : ERROR_DIRECTORY);
+    return false;
+  }
+  if (!CreateWorkDir(base_path.get(), work_dir, exit_code)) {
+    work_dir->clear();
+    return false;
+  }
+  return true;
 }
 
 ProcessExitResult WMain(HMODULE module) {
@@ -731,7 +735,7 @@ ProcessExitResult WMain(HMODULE module) {
 
   // First get a path where we can extract payload
   PathString base_path;
-  if (!GetWorkDir(module, &base_path, &exit_code)) {
+  if (!GetWorkDir(&base_path, &exit_code)) {
     ui.Finish(exit_code.exit_code);
     return exit_code;
   }
