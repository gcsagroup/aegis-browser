-TEST(MiniInstallerTest, GetModuleDir) {
+// 当前目录与安装包位置不参与选择；空格/中文路径、并发独立目录和私有 ACL
+// 均须保留。
+TEST(MiniInstallerTest, WorkDirUsesWindowsTempAndPrivateAcl) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const auto temp = root.GetPath().Append(FILE_PATH_LITERAL("安装 临时目录"));
+  ASSERT_TRUE(base::CreateDirectory(temp));
+  const auto unrelated = temp.Append(FILE_PATH_LITERAL("keep.txt"));
+  ASSERT_TRUE(base::WriteFile(unrelated, "keep"));
+  ScopedInstallerTempEnvironment environment(temp.AsUTF8Unsafe());
+  PathString first, second;
+  ProcessExitResult result(UNABLE_TO_GET_WORK_DIRECTORY);
+  ASSERT_TRUE(GetWorkDir(&first, &result));
+  EXPECT_TRUE(result.IsSuccess());
+  ASSERT_TRUE(GetWorkDir(&second, &result));
+  const base::FilePath first_path =
+      base::FilePath(first.get()).StripTrailingSeparators();
+  const base::FilePath second_path =
+      base::FilePath(second.get()).StripTrailingSeparators();
+  EXPECT_EQ(first_path.DirName(), temp);
+  EXPECT_EQ(second_path.DirName(), temp);
+  EXPECT_NE(first_path, second_path);
+  EXPECT_TRUE(base::DirectoryExists(first_path));
+  EXPECT_TRUE(base::DirectoryExists(second_path));
+
+  PSECURITY_DESCRIPTOR descriptor = nullptr;
+  PACL dacl = nullptr;
+  ASSERT_EQ(static_cast<DWORD>(ERROR_SUCCESS),
+            ::GetNamedSecurityInfoW(first.get(), SE_FILE_OBJECT,
+                                    DACL_SECURITY_INFORMATION, nullptr, nullptr,
+                                    &dacl, nullptr, &descriptor));
+  SECURITY_DESCRIPTOR_CONTROL control = 0;
+  DWORD revision = 0;
+  EXPECT_TRUE(::GetSecurityDescriptorControl(descriptor, &control, &revision));
+  EXPECT_TRUE(control & SE_DACL_PROTECTED);
+  EXPECT_NE(nullptr, dacl);
+  ::LocalFree(descriptor);
+
+  // 使用安装器既有删除原语，只清理本次独占目录；共享临时根及其他文件必须保留。
+  int attempts = 0;
+  EXPECT_TRUE(DeleteWithRetry(first.get(), attempts));
+  EXPECT_TRUE(DeleteWithRetry(second.get(), attempts));
+  EXPECT_FALSE(base::PathExists(first_path));
+  EXPECT_FALSE(base::PathExists(second_path));
+  EXPECT_TRUE(base::DirectoryExists(temp));
+  EXPECT_TRUE(base::PathExists(unrelated));
+}
+
+TEST(MiniInstallerTest, WorkDirRejectsMissingTempDirectory) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const auto missing = root.GetPath().Append(FILE_PATH_LITERAL("missing"));
+  ScopedInstallerTempEnvironment environment(missing.AsUTF8Unsafe());
   PathString directory;
+  ASSERT_TRUE(directory.assign(L"stale"));
+  ProcessExitResult result(SUCCESS_EXIT_CODE);
+  EXPECT_FALSE(GetWorkDir(&directory, &result));
+  EXPECT_EQ(UNABLE_TO_GET_WORK_DIRECTORY, result.exit_code);
+  EXPECT_NE(static_cast<DWORD>(ERROR_SUCCESS), result.windows_error);
+  EXPECT_TRUE(directory.empty());
+  EXPECT_FALSE(base::PathExists(missing));
+}
 
-  ASSERT_TRUE(GetModuleDir(/*module=*/nullptr, &directory));
-  ASSERT_NE(directory.length(), 0U);
-  EXPECT_LT(directory.length(), directory.capacity());
-  EXPECT_EQ(UNSAFE_TODO(directory.get()[directory.length() - 1]), L'\\');
+TEST(MiniInstallerTest, WorkDirRejectsFileAsTempDirectory) {
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const auto file = root.GetPath().Append(FILE_PATH_LITERAL("not-a-directory"));
+  ASSERT_TRUE(base::WriteFile(file, "keep"));
+  ScopedInstallerTempEnvironment environment(file.AsUTF8Unsafe());
+  PathString directory;
+  ProcessExitResult result(SUCCESS_EXIT_CODE);
+  EXPECT_FALSE(GetWorkDir(&directory, &result));
+  EXPECT_EQ(UNABLE_TO_GET_WORK_DIRECTORY, result.exit_code);
+  EXPECT_TRUE(directory.empty());
+  std::string contents;
+  ASSERT_TRUE(base::ReadFileToString(file, &contents));
+  EXPECT_EQ("keep", contents);
+}
+
+TEST(MiniInstallerTest, WorkDirRejectsTempPathWithoutRoomForChild) {
+  // 使用真实存在的长目录验证子目录容量；Windows 会忽略某些无效的超长环境值，
+  // 不能把无效 TMP 等同于 API 返回超长路径。失败不得截断路径或在其他位置创建目录。
+  base::ScopedTempDir root;
+  ASSERT_TRUE(root.CreateUniqueTempDir());
+  const auto prefix_length = root.GetPath().value().length() + 1;
+  ASSERT_LT(prefix_length, static_cast<size_t>(MAX_PATH - 14));
+  const auto temp = root.GetPath().Append(
+      std::wstring(MAX_PATH - 14 - prefix_length, L'x'));
+  ASSERT_TRUE(base::CreateDirectory(temp));
+  ScopedInstallerTempEnvironment environment(temp.AsUTF8Unsafe());
+  PathString directory;
+  ProcessExitResult result(SUCCESS_EXIT_CODE);
+  const bool created = GetWorkDir(&directory, &result);
+  EXPECT_FALSE(created);
+  EXPECT_EQ(PATH_STRING_OVERFLOW, result.exit_code);
+  EXPECT_TRUE(directory.empty());
+  if (created) {
+    // 断言失败时也回收本夹具创建的空目录，避免测试本身留下残留。
+    int attempts = 0;
+    EXPECT_TRUE(DeleteWithRetry(directory.get(), attempts));
+  }
+  EXPECT_TRUE(base::DirectoryExists(temp));
 }
 
