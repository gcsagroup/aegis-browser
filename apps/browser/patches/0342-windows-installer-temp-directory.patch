+// 测试只修改自身进程环境；SYSTEM 和普通用户均定向到夹具创建的私有目录。
+class ScopedInstallerTempEnvironment {
+ public:
+  explicit ScopedInstallerTempEnvironment(const std::string& path)
+      : tmp_("TMP", path),
+        temp_("TEMP", path),
+        system_temp_("SystemTemp", path) {}
+
+ private:
+  base::ScopedEnvironmentVariableOverride tmp_;
+  base::ScopedEnvironmentVariableOverride temp_;
+  base::ScopedEnvironmentVariableOverride system_temp_;
+};
