 .../enhancements/enhancement_browsertest.cc   | 259 +++++++++++++++++-
 2 files changed, 262 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/aegis/BUILD.gn b/chrome/browser/aegis/BUILD.gn
