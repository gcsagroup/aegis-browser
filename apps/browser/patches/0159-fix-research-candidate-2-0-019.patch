+  result.value.Remove("untrusted");
+  EXPECT_FALSE(AgentResearchContentHash(result));
+  result.value.Set("untrusted", true);
+  result.ok = false;
+  EXPECT_FALSE(AgentResearchContentHash(result));
+}
