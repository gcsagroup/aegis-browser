+  AgentToolResult result;
+  result.ok = true;
+  result.value.Set("tab_id", id);
+  result.value.Set("untrusted", true);
+  result.value.Set("captured_at_ms", "1789530000000");
+  result.value.Set("title", "测试文章");
+  result.value.Set(
