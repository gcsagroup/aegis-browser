+const base::DictValue* AegisAgentService::GetResearchRecord(
+    const std::string& id) const {
+  if (auto it = research_results_.find(id); it != research_results_.end()) {
+    return &it->second;
+  }
+  if (auto it = saved_research_.find(id); it != saved_research_.end()) {
+    return &it->second;
+  }
+  return nullptr;
+}
