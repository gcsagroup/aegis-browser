+void GitHubUpdate::OnSaved(base::FilePath path) {
+  busy_ = false;
+  downloaded_file_ = path;
+  Report(path.empty() ? State::kError : State::kReady,
+         path.empty()
+             ? "安装包校验、系统安全检查或保存失败，未保留更新包。"
+             : "新版 " + asset_.version +
+                   " 已下载并通过 SHA-256 校验。请退出浏览器后打开安装包：" +
+                   path.AsUTF8Unsafe());
