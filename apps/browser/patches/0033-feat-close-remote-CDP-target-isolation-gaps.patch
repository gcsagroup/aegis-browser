+  if (!agent_host) {
+    return WeakDocumentPtr();
+  }
+  auto grant = http_created_initial_documents_.find(agent_host->GetId());
+  if (grant == http_created_initial_documents_.end()) {
+    return WeakDocumentPtr();
+  }
+
+  WeakDocumentPtr granted_document = std::move(grant->second);
+  http_created_initial_documents_.erase(grant);
+  if (agent_host->GetURLForRemoteDebugging().spec() != url::kAboutBlankURL) {
+    return WeakDocumentPtr();
+  }
+
+  RenderFrameHost* granted_frame = granted_document.AsRenderFrameHostIfValid();
+  RenderFrameHost* current_frame =
+      agent_host->GetDocumentForRemoteDebugging().AsRenderFrameHostIfValid();
+  return granted_frame && granted_frame == current_frame ? granted_document
+                                                         : WeakDocumentPtr();
+}
+
+void DevToolsHttpHandler::PruneHttpCreatedInitialDocumentGrants() {
+  for (auto grant = http_created_initial_documents_.begin();
+       grant != http_created_initial_documents_.end();) {
+    scoped_refptr<DevToolsAgentHost> agent_host =
+        DevToolsAgentHost::GetForId(grant->first);
+    RenderFrameHost* granted_frame = grant->second.AsRenderFrameHostIfValid();
+    RenderFrameHost* current_frame =
+        agent_host ? agent_host->GetDocumentForRemoteDebugging()
+                         .AsRenderFrameHostIfValid()
+                   : nullptr;
+    if (!agent_host || !granted_frame || granted_frame != current_frame ||
+        agent_host->GetURLForRemoteDebugging().spec() != url::kAboutBlankURL) {
+      grant = http_created_initial_documents_.erase(grant);
+    } else {
+      ++grant;
+    }
+  }
 }
 
