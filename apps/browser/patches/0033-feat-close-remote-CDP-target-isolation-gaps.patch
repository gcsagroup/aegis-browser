+      "Shared storage tracking is not available to remote debugging clients",
+      *error()->FindString("message"));
+
+  const base::DictValue* history_result = SendSessionCommand(
+      "Page.getNavigationHistory", base::DictValue(), *session_id, true);
+  ASSERT_TRUE(history_result);
+  const base::ListValue* entries = history_result->FindList("entries");
+  ASSERT_TRUE(entries);
+  for (const base::Value& entry : *entries) {
+    const std::string* url = entry.GetDict().FindString("url");
+    ASSERT_TRUE(url);
+    EXPECT_NE(chrome::kChromeUIAegisURL, *url);
+  }
+
+  EXPECT_FALSE(SendSessionCommand(
+      "Page.navigateToHistoryEntry",
+      base::DictValue().Set("entryId", internal_entry_id), *session_id, true));
+  ASSERT_TRUE(error());
+  EXPECT_EQ("Navigation is not allowed for this remote debugging client",
+            *error()->FindString("message"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(public_url, target_contents->GetLastCommittedURL());
+
+  EXPECT_FALSE(SendSessionCommand(
+      "Page.navigate", base::DictValue().Set("url", chrome::kChromeUIAegisURL),
+      *session_id, true));
+  ASSERT_TRUE(error());
+  EXPECT_EQ("Navigation is not allowed for this remote debugging client",
