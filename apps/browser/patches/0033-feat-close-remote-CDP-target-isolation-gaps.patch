+bool DevToolsAgentHostImpl::IsRemoteDebuggingTargetOperationAllowed(
+    DevToolsAgentHost* target,
+    DevToolsAgentHostClient* client,
+    DevToolsManagerDelegate* delegate,
+    DevToolsManagerDelegate::RemoteDebuggingTargetOperation operation,
+    bool allow_creation_claim) {
+  if (!target) {
+    return false;
+  }
+  if (client && !client->IsRemoteDebuggingClient()) {
+    return true;
+  }
+
+  auto allow_target = [client, delegate](
+                          DevToolsAgentHost* target,
+                          DevToolsManagerDelegate::
+                              RemoteDebuggingTargetOperation target_operation,
+                          bool target_allow_creation_claim) {
+    if (target->IsRemoteDeviceTarget()) {
+      return false;
+    }
+    const GURL target_url = target->GetURLForRemoteDebugging();
+    const bool is_initial_blank_target =
+        client && target_url.spec() == url::kAboutBlankURL &&
+        (target->GetType() == DevToolsAgentHost::kTypePage ||
+         target->GetType() == DevToolsAgentHost::kTypeTab);
+    const WeakDocumentPtr target_document =
+        is_initial_blank_target ? target->GetDocumentForRemoteDebugging()
+                                : WeakDocumentPtr();
+    const bool creation_in_progress =
+        client && client->IsRemoteDebuggingTargetCreationInProgress();
+    if (target_allow_creation_claim && is_initial_blank_target &&
+        target_operation ==
+            DevToolsManagerDelegate::RemoteDebuggingTargetOperation::kAttach &&
+        creation_in_progress) {
+      client->RegisterRemoteDebuggingTarget(target->GetId(), target_document);
+    }
+    if (is_initial_blank_target &&
+        client->OwnsRemoteDebuggingTarget(target->GetId(), target_document) &&
+        (!creation_in_progress ||
+         target_operation == DevToolsManagerDelegate::
+                                 RemoteDebuggingTargetOperation::kAttach) &&
+        target_operation !=
+            DevToolsManagerDelegate::RemoteDebuggingTargetOperation::
+                kExposeDevToolsProtocol &&
+        target_operation != DevToolsManagerDelegate::
+                                RemoteDebuggingTargetOperation::kOpenDevTools) {
+      return true;
+    }
+    return !delegate || delegate->AllowRemoteDebuggingTargetOperation(
+                            target_operation, target->GetType(), target_url);
+  };
+
+  if (!allow_target(target, operation, allow_creation_claim)) {
+    return false;
+  }
+
+  std::set<std::string> visited_target_ids{target->GetId()};
+  std::string parent_id = target->GetParentId();
+  while (!parent_id.empty()) {
+    if (!visited_target_ids.insert(parent_id).second) {
+      return false;
+    }
+    scoped_refptr<DevToolsAgentHost> parent =
+        DevToolsAgentHost::GetForId(parent_id);
+    if (!parent ||
+        !allow_target(
+            parent.get(),
+            DevToolsManagerDelegate::RemoteDebuggingTargetOperation::kEnumerate,
+            /*target_allow_creation_claim=*/false)) {
+      return false;
+    }
+    parent_id = parent->GetParentId();
+  }
+  return true;
+}
