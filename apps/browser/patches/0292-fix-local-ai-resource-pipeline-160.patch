---
 chrome/browser/resources/aegis_agent/BUILD.gn | 38 ++++++++++++-------
 .../ui/webui/help/aegis_github_update.h       |  4 +-
 2 files changed, 26 insertions(+), 16 deletions(-)

diff --git a/chrome/browser/resources/aegis_agent/BUILD.gn b/chrome/browser/resources/aegis_agent/BUILD.gn
index 0f01a70edeeafce521758d1fc879b4f3b0e7de86..54d0565ca66287b3c15cb9961f6af4c2854e4af6 100644
--- a/chrome/browser/resources/aegis_agent/BUILD.gn
+++ b/chrome/browser/resources/aegis_agent/BUILD.gn
@@ -2,20 +2,11 @@
 
 import("//ui/webui/resources/tools/build_webui.gni")
 
-build_webui("build") {
-  grd_prefix = "aegis_agent"
-  ts_composite = true
-  ts_deps = [
-    "//ui/webui/resources/js:build_ts",
-    "//ui/webui/resources/mojo:build_ts",
-  ]
-  mojo_files_deps =
-      [ "//chrome/browser/ui/webui/aegis_agent:mojo_bindings_ts__generator" ]
-  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/aegis_agent/aegis_agent.mojom-webui.ts" ]
-  static_files = [
-    "agent.css",
-    "agent.html",
-    "product_logo.svg",
+generate_grd("local_ai_resources") {
+  grd_prefix = "aegis_agent_local"
+  out_grd = "$target_gen_dir/local_ai_resources.grdp"
+  input_files_base_dir = rebase_path(".", "//")
+  input_files = [
     "local_ai/NOTICE.txt",
     "local_ai/asset_manifest.json",
     "local_ai/bergamot/LICENSE",
@@ -39,6 +30,25 @@ build_webui("build") {
     "local_ai/vendor/ort.js",
     "local_ai/worker.js",
   ]
+}
+
+build_webui("build") {
+  extra_grdp_deps = [ ":local_ai_resources" ]
+  extra_grdp_files = [ "$target_gen_dir/local_ai_resources.grdp" ]
+  grd_prefix = "aegis_agent"
+  ts_composite = true
+  ts_deps = [
+    "//ui/webui/resources/js:build_ts",
+    "//ui/webui/resources/mojo:build_ts",
+  ]
+  mojo_files_deps =
+      [ "//chrome/browser/ui/webui/aegis_agent:mojo_bindings_ts__generator" ]
+  mojo_files = [ "$root_gen_dir/chrome/browser/ui/webui/aegis_agent/aegis_agent.mojom-webui.ts" ]
+  static_files = [
+    "agent.css",
+    "agent.html",
+    "product_logo.svg",
+  ]
   ts_files = [
     "agent.ts",
     "reading_workspace.ts",
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 3b5a05b752d491f34f4302b9368d4dd3bc1a9296..016e24b3bd8acc4af57e1f4900764843cdad127c 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -21,8 +21,8 @@ class SimpleURLLoader;
 
 namespace aegis {
 // 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.40。
-inline constexpr char kProductVersion[] = "3.1.0.159";
-inline constexpr char kProductVersionLabel[] = "Ver 3.1 (159)";
+inline constexpr char kProductVersion[] = "3.1.0.160";
+inline constexpr char kProductVersionLabel[] = "Ver 3.1 (160)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
 inline constexpr char kReleasePage[] =
