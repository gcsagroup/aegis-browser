+++ b/chrome/browser/aegis/BUILD.gn
@@ -523,6 +523,10 @@ test("aegis_browser_unittests") {
       "//content/test:test_support",
     ]
   }
+  if (is_win) {
+    # 测试进程中的媒体路由也需要安装器本地化资源。
+    deps += [ "//chrome/installer/util:strings" ]
+  }
   if (is_mac) {
     sources += [
       "aegis_torrent_client_unittest.cc",
diff --git a/chrome/browser/aegis/enhancements/enhancement_browsertest.cc b/chrome/browser/aegis/enhancements/enhancement_browsertest.cc
index 4d3aa2342e310c53f048c200f412a1c4e02bd00a..286cd358ff28c3637726ed530f2f6c0b7b58d040 100644
--- a/chrome/browser/aegis/enhancements/enhancement_browsertest.cc
+++ b/chrome/browser/aegis/enhancements/enhancement_browsertest.cc
@@ -62,6 +62,11 @@ class EnhancementBrowserTest : public InProcessBrowserTest {
     store_ = EnhancementStore::Get(browser()->GetProfile());
     ASSERT_TRUE(base::test::RunUntil([&] { return store_->ready(); }));
   }
+  void TearDownOnMainThread() override {
+    // Profile 随浏览器关闭而销毁，测试夹具必须提前释放对其存储的引用。
+    store_ = nullptr;
+    InProcessBrowserTest::TearDownOnMainThread();
+  }
   content::WebContents* contents() {
     return browser()->tab_strip_model()->GetActiveWebContents();
   }
diff --git a/chrome/browser/aegis/enhancements/enhancement_store.cc b/chrome/browser/aegis/enhancements/enhancement_store.cc
index f5322dbadac78aa435d1633fb4f14032c5b868a5..52410a7cd8d59d9768ae571795c6437555d5e310 100644
--- a/chrome/browser/aegis/enhancements/enhancement_store.cc
+++ b/chrome/browser/aegis/enhancements/enhancement_store.cc
@@ -422,7 +422,8 @@ void EnhancementStore::Commit(base::DictValue state,
             if (self)
               self->RunNext();
           },
-          weak_.GetWeakPtr(), std::move(state), std::move(*json), policy,
+          // 两个回调都需要完整内容，避免参数求值顺序导致提前移走字符串。
+          weak_.GetWeakPtr(), std::move(state), *json, policy,
           std::move(done)));
 }
 void EnhancementStore::RunNext() {
diff --git a/chrome/browser/aegis/enhancements/enhancement_store_unittest.cc b/chrome/browser/aegis/enhancements/enhancement_store_unittest.cc
index e538030ab8794973deef34330ad11370454c315f..1f61d6d73678bc5d1d17889ae5c99e9f9091f865 100644
--- a/chrome/browser/aegis/enhancements/enhancement_store_unittest.cc
+++ b/chrome/browser/aegis/enhancements/enhancement_store_unittest.cc
@@ -76,6 +76,12 @@ TEST_F(EnhancementStoreTest, PersistenceDraftVersionAndRollback) {
                               .Set("source", Script("document.title='first';"))
                               .Set("world", "isolated")),
             "");
+  // 成功回调必须对应已落盘的完整配置，不能只更新内存。
+  std::string persisted;
+  ASSERT_TRUE(base::ReadFileToString(path, &persisted));
+  auto persisted_state = base::JSONReader::ReadDict(persisted, base::JSON_PARSE_RFC);
+  ASSERT_TRUE(persisted_state);
+  EXPECT_EQ(*persisted_state, store.state());
   const auto& first = store.state().FindList("scripts")->front().GetDict();
   const auto id = EnhancementField(first, "id");
   EXPECT_EQ(first.FindBool("enabled"), false);
