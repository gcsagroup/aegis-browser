diff --git a/chrome/browser/aegis/BUILD.gn b/chrome/browser/aegis/BUILD.gn
index fb8233cbc2ed31036f4d001239678ea8dd94fdd8..0746f08ea0d9ebeb297d27051c3cb631a1258863 100644
