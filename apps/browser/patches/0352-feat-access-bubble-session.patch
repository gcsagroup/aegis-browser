new file mode 100644
index 0000000000000000000000000000000000000000..6250fe4acb6ac9454efbf8263c672d9653c9a5fb
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_session.h
@@ -0,0 +1,147 @@
+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_SESSION_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_SESSION_H_
+
+#include <map>
+#include <string>
+#include <string_view>
+
+#include "chrome/browser/aegis/access/access_site_intent.h"
+#include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
+#include "components/aegis_access/request_ownership_registry.h"
+
+namespace aegis::access {
+
+// Readable fail-closed errors for bubble → publish/ACK (P-mac-3).
+// Callers must surface ReadableMessage(); never treat these as DIRECT success.
+enum class AccessSiteProxySessionError {
+  kOk,
+  kInvalidHost,
+  kLocalProxyUnavailable,
+  kLocalProxyNotReady,
+  kMissingOwner,
+  kMissingCoordinator,
+  kMissingStore,
+  kMissingProxyGroup,
+  kPrepareFailed,
+  kPublishFailed,
+  kAckFailed,
+  kMutationFailed,
+  kServiceUnavailable,
+  kBusy,
+  kDirectFallbackNotAdmitted,
+  kTearDownFailed,
+};
+
+std::string_view AccessSiteProxySessionErrorToString(
+    AccessSiteProxySessionError error);
+std::string AccessSiteProxySessionErrorReadableMessage(
+    AccessSiteProxySessionError error,
+    std::string_view detail = {});
+
+enum class AccessSiteProxySessionPhase {
+  kIdle,
+  kPreparingCandidate,
+  kPublishing,
+  kAwaitingAck,
+  kReady,
+  kUnavailable,
+};
+
+std::string_view AccessSiteProxySessionPhaseToString(
+    AccessSiteProxySessionPhase phase);
+
+struct AccessSiteProxySessionSnapshot {
+  AccessSiteHost host;
+  AccessSiteIntent intent = AccessSiteIntent::kOff;
+  AccessSiteProxySessionPhase phase = AccessSiteProxySessionPhase::kIdle;
+  AccessSiteConnectionState connection = AccessSiteConnectionState::kIdle;
+  std::string failure_reason;
+  uint64_t policy_generation = 0;
+};
+
+struct AccessSiteProxyLocalProxyReadyInfo {
+  OwnershipKey owner;
+  std::string proxy_group_id;
+};
+
+struct AccessSiteProxySessionPublicationInfo {
+  uint64_t policy_generation = 0;
+};
+
+// Injectable PrepareCandidate → Publish → ACK (+ local proxy readiness) seam.
+// Production hosts wire AccessServiceCoordinator + localhost proxy selection.
+// Unit tests supply doubles. Implementations must never report DIRECT success
+// on the allow path.
+class AccessSiteProxySessionOrchestrating {
+ public:
+  virtual ~AccessSiteProxySessionOrchestrating() = default;
+
+  // Confirms a published loopback proxy endpoint is ready for this host.
+  virtual AccessSiteProxySessionError EnsureLocalProxyReady(
+      const AccessSiteHost& host,
+      AccessSiteProxyLocalProxyReadyInfo* out) = 0;
+
+  // Runs PrepareCandidate → Publish → wait ACK for an ordinary mutation.
+  virtual AccessSiteProxySessionError PublishAndAcknowledge(
+      const SiteGroupMutationRequest& request,
+      const aegis_access::RequestCancellationSelector& selector,
+      AccessSiteProxySessionPublicationInfo* out) = 0;
+
+  // Best-effort tear-down of a previously published host selection.
+  virtual AccessSiteProxySessionError TearDownPublishedHost(
+      const AccessSiteHost& host) = 0;
+};
+
+// Per-host product session controller: intent stays distinct from connection.
+// enable: local-proxy ready → Prepare/Publish/ACK → ready
+// disable: local intent commit always; service may be unavailable
+class AccessSiteProxySessionController {
+ public:
+  explicit AccessSiteProxySessionController(
+      AccessSiteProxySessionOrchestrating* orchestrator);
+
+  AccessSiteIntentStore& intent_store() { return intent_store_; }
+  const AccessSiteIntentStore& intent_store() const { return intent_store_; }
+
+  AccessSiteProxySessionSnapshot SnapshotFor(const AccessSiteHost& host) const;
+
+  // Allow path. On failure: intent remains allow, connection=unavailable,
+  // failure_reason is set; never claims ready via DIRECT.
+  AccessSiteProxySessionSnapshot Enable(const AccessSiteHost& host);
+
+  // Off path. Local intent/off + idle always commit even when publication
+  // tear-down fails (failure_reason may note the service issue).
+  AccessSiteProxySessionSnapshot Disable(const AccessSiteHost& host);
+
+ private:
+  AccessSiteProxySessionSnapshot Write(
+      AccessSiteProxySessionSnapshot snapshot);
+  AccessSiteProxySessionSnapshot MarkUnavailable(
+      const AccessSiteHost& host,
+      AccessSiteIntent intent,
+      AccessSiteProxySessionError error,
+      std::string_view detail = {});
+
+  AccessSiteProxySessionOrchestrating* const orchestrator_;
+  AccessSiteIntentStore intent_store_;
+  std::map<AccessSiteHost, AccessSiteProxySessionSnapshot> snapshots_;
+};
+
+// Builds ordinary mutation + cancellation selector inputs for bubble sessions.
+struct AccessSiteProxySessionMutationPlan {
+  AccessSiteIntentMutationResult mutation;
+  aegis_access::RequestCancellationSelector selector;
+};
+
+AccessSiteProxySessionMutationPlan BuildSiteProxySessionMutationPlan(
+    const AccessSiteHost& host,
+    AccessSiteIntent intent,
+    const OwnershipKey& owner,
+    std::string_view proxy_group_id,
+    std::string_view operation_suffix);
+
+}  // namespace aegis::access
+
+#endif  // CHROME_BROWSER_AEGIS_ACCESS_ACCESS_SITE_PROXY_SESSION_H_
diff --git a/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc b/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..9a19d8794fda34668a65f5854027b87792b8ee7f
--- /dev/null
+++ b/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc
@@ -0,0 +1,182 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/aegis/access/access_site_proxy_session.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis::access {
+namespace {
+
+OwnershipKey TestOwner() {
+  return {ChannelNamespace::kDev, "profile-token", "partition-token"};
+}
+
+AccessSiteHost Host(std::string_view value) {
+  const auto result = MakeAccessSiteHost(value);
+  EXPECT_EQ(result.status, AccessSiteHostStatus::kOk);
+  return *result.host;
+}
+
+class FakeOrchestrator : public AccessSiteProxySessionOrchestrating {
+ public:
+  enum class Stage {
+    kEnsure,
+    kPublish,
+    kTearDown,
+  };
+
+  bool local_proxy_ready = true;
+  bool admit_direct_fallback = false;
+  std::optional<Stage> fail_at;
+  AccessSiteProxySessionError ensure_error =
+      AccessSiteProxySessionError::kLocalProxyNotReady;
+  AccessSiteProxySessionError publish_error =
+      AccessSiteProxySessionError::kPublishFailed;
+  int ensure_count = 0;
+  int publish_count = 0;
+  int tear_down_count = 0;
+  uint64_t next_generation = 7;
+  std::optional<AccessSiteHost> last_torn_down;
+
+  AccessSiteProxySessionError EnsureLocalProxyReady(
+      const AccessSiteHost& host,
+      AccessSiteProxyLocalProxyReadyInfo* out) override {
+    ++ensure_count;
+    EXPECT_TRUE(out);
+    if (fail_at == Stage::kEnsure || !local_proxy_ready) {
+      return ensure_error;
+    }
+    out->owner = TestOwner();
+    out->proxy_group_id = "proxy-group";
+    (void)host;
+    return AccessSiteProxySessionError::kOk;
+  }
+
+  AccessSiteProxySessionError PublishAndAcknowledge(
+      const SiteGroupMutationRequest& request,
+      const aegis_access::RequestCancellationSelector& selector,
+      AccessSiteProxySessionPublicationInfo* out) override {
+    ++publish_count;
+    EXPECT_TRUE(out);
+    EXPECT_EQ(selector.exact_host, request.candidate_group.canonical_host);
+    if (admit_direct_fallback) {
+      return AccessSiteProxySessionError::kDirectFallbackNotAdmitted;
+    }
+    if (fail_at == Stage::kPublish) {
+      return publish_error;
+    }
+    out->policy_generation = next_generation++;
+    return AccessSiteProxySessionError::kOk;
+  }
+
+  AccessSiteProxySessionError TearDownPublishedHost(
+      const AccessSiteHost& host) override {
+    ++tear_down_count;
+    last_torn_down = host;
+    if (fail_at == Stage::kTearDown) {
+      return AccessSiteProxySessionError::kTearDownFailed;
+    }
+    return AccessSiteProxySessionError::kOk;
+  }
+};
+
+TEST(AccessSiteProxySessionTest, EnableRunsPreparePublishAckReady) {
+  FakeOrchestrator orchestrator;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("www.example.com");
+
+  const auto snap = controller.Enable(host);
+
+  EXPECT_EQ(snap.intent, AccessSiteIntent::kAllow);
+  EXPECT_EQ(snap.phase, AccessSiteProxySessionPhase::kReady);
+  EXPECT_EQ(snap.connection, AccessSiteConnectionState::kReady);
+  EXPECT_TRUE(snap.failure_reason.empty());
+  EXPECT_EQ(snap.policy_generation, 7u);
+  EXPECT_EQ(orchestrator.ensure_count, 1);
+  EXPECT_EQ(orchestrator.publish_count, 1);
+  EXPECT_EQ(controller.intent_store().Get(host), AccessSiteIntent::kAllow);
+}
+
+TEST(AccessSiteProxySessionTest, DisableCommitsLocallyEvenWhenServiceDown) {
+  FakeOrchestrator orchestrator;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("www.example.com");
+  ASSERT_EQ(controller.Enable(host).phase, AccessSiteProxySessionPhase::kReady);
+
+  orchestrator.local_proxy_ready = false;
+  orchestrator.ensure_error = AccessSiteProxySessionError::kServiceUnavailable;
+  const auto snap = controller.Disable(host);
+
+  EXPECT_EQ(snap.intent, AccessSiteIntent::kOff);
+  EXPECT_EQ(snap.phase, AccessSiteProxySessionPhase::kIdle);
+  EXPECT_EQ(snap.connection, AccessSiteConnectionState::kIdle);
+  EXPECT_EQ(controller.intent_store().Get(host), AccessSiteIntent::kOff);
+  // Tear-down still attempted when ensure cannot publish DIRECT.
+  EXPECT_GE(orchestrator.tear_down_count, 1);
+}
+
+TEST(AccessSiteProxySessionTest, EnableWithoutLocalProxyFailsClosedReadable) {
+  FakeOrchestrator orchestrator;
+  orchestrator.local_proxy_ready = false;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("www.example.com");
+
+  const auto snap = controller.Enable(host);
+
+  EXPECT_EQ(snap.intent, AccessSiteIntent::kAllow);
+  EXPECT_EQ(snap.phase, AccessSiteProxySessionPhase::kUnavailable);
+  EXPECT_EQ(snap.connection, AccessSiteConnectionState::kUnavailable);
+  EXPECT_FALSE(snap.failure_reason.empty());
+  EXPECT_EQ(snap.failure_reason.find("Direct success"), std::string::npos);
+  EXPECT_EQ(orchestrator.publish_count, 0);
+}
+
+TEST(AccessSiteProxySessionTest, PublishFailureDoesNotClaimReady) {
+  FakeOrchestrator orchestrator;
+  orchestrator.fail_at = FakeOrchestrator::Stage::kPublish;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("news.example");
+
+  const auto snap = controller.Enable(host);
+
+  EXPECT_EQ(snap.phase, AccessSiteProxySessionPhase::kUnavailable);
+  EXPECT_EQ(snap.connection, AccessSiteConnectionState::kUnavailable);
+  EXPECT_NE(snap.failure_reason.find("publish"), std::string::npos);
+  EXPECT_EQ(orchestrator.tear_down_count, 1);
+}
+
+TEST(AccessSiteProxySessionTest, DirectFallbackRejectedOnAllowPath) {
+  FakeOrchestrator orchestrator;
+  orchestrator.admit_direct_fallback = true;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("www.example.com");
+
+  const auto snap = controller.Enable(host);
+
+  EXPECT_EQ(snap.phase, AccessSiteProxySessionPhase::kUnavailable);
+  EXPECT_EQ(
+      snap.failure_reason,
+      AccessSiteProxySessionErrorReadableMessage(
+          AccessSiteProxySessionError::kDirectFallbackNotAdmitted));
+}
+
+TEST(AccessSiteProxySessionTest, BuildsOrdinaryAllowAndOffMutationPlans) {
+  const AccessSiteHost host = Host("news.example");
+  auto allow = BuildSiteProxySessionMutationPlan(
+      host, AccessSiteIntent::kAllow, TestOwner(), "proxy-group", "on");
+  EXPECT_EQ(allow.mutation.status, AccessSiteIntentMutationStatus::kReady);
+  ASSERT_TRUE(allow.mutation.request);
+  EXPECT_EQ(allow.mutation.request->candidate_members[0].mode,
+            AccessMode::kProxy);
+  EXPECT_EQ(allow.selector.exact_host, "news.example");
+
+  auto off = BuildSiteProxySessionMutationPlan(
+      host, AccessSiteIntent::kOff, TestOwner(), "", "off");
+  EXPECT_EQ(off.mutation.status, AccessSiteIntentMutationStatus::kReady);
+  ASSERT_TRUE(off.mutation.request);
+  EXPECT_EQ(off.mutation.request->candidate_members[0].mode,
+            AccessMode::kDirect);
+}
+
