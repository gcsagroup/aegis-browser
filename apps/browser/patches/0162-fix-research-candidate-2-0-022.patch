---
 .../aegis/agent/aegis_agent_service.cc        | 21 ++++++++++---------
 .../ui/webui/help/aegis_github_update.h       |  6 +++---
 2 files changed, 14 insertions(+), 13 deletions(-)

diff --git a/chrome/browser/aegis/agent/aegis_agent_service.cc b/chrome/browser/aegis/agent/aegis_agent_service.cc
index 8464a2bb5c..2b7884ff0d 100644
--- a/chrome/browser/aegis/agent/aegis_agent_service.cc
+++ b/chrome/browser/aegis/agent/aegis_agent_service.cc
@@ -1894,16 +1894,6 @@ void AegisAgentService::OnRuntimeFreshObservation(const std::string& task_id,
     runtime.last_tab_id = *tab_id;
   }
   runtime.previous_result = CloneToolResult(result);
-  if (attempted_call.tool_name == "download.find_official" ||
-      attempted_call.tool_name == "download.start" ||
-      attempted_call.tool_name == "download.verify") {
-    // 结果格式已通过原生核验时，未满足完成条件的回执仍可说明失败原因。
-    runtime.download_history.push_back({.tool_name = attempted_call.tool_name,
-                                        .result = CloneToolResult(result)});
-    if (runtime.download_history.size() > kMaxRuntimeEvidenceItems) {
-      runtime.download_history.erase(runtime.download_history.begin());
-    }
-  }
 
   runtime.evidence_history.push_back(
       {.tool_name = "page.observe", .result = CloneToolResult(result)});
@@ -2493,6 +2483,17 @@ void AegisAgentService::OnRuntimeToolResult(const std::string& task_id,
 
   runtime.pending_action.reset();
   runtime.previous_result = CloneToolResult(result);
+  if (attempted_call.tool_name == "download.find_official" ||
+      attempted_call.tool_name == "download.start" ||
+      attempted_call.tool_name == "download.verify") {
+    // 结果格式已通过原生核验时，未满足完成条件的回执仍可说明失败原因。
+    runtime.download_history.push_back({.tool_name = attempted_call.tool_name,
+                                        .result = CloneToolResult(result)});
+    if (runtime.download_history.size() > kMaxRuntimeEvidenceItems) {
+      runtime.download_history.erase(runtime.download_history.begin());
+    }
+  }
+
   if (result.ok) {
     runtime.evidence_history.push_back({.tool_name = attempted_call.tool_name,
                                         .result = CloneToolResult(result)});
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index 5bd66f95c3..2c755ca13b 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -20,9 +20,9 @@ class SimpleURLLoader;
 }  // namespace network
 
 namespace aegis {
-// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.21。
-inline constexpr char kProductVersion[] = "2.0.0.21";
-inline constexpr char kProductVersionLabel[] = "Ver 2.0 (021)";
+// 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.22。
+inline constexpr char kProductVersion[] = "2.0.0.22";
+inline constexpr char kProductVersionLabel[] = "Ver 2.0 (022)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
 inline constexpr char kReleasePage[] =
