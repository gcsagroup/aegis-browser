-// Verifies that if prompt creation returns `nullptr`, the presenter flag is
-// reset.
+// An embedded microphone prompt cannot open while another tab-modal UI owns
+// the tab. Observe the presenter's lock inside prompt creation and after it.
 IN_PROC_BROWSER_TEST_F(
     OmniboxAimPopupBrowserTest,
     PermissionPromptCreationResetsLockIfPromptCreationFails) {
   ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/empty.html")));
+  ASSERT_TRUE(ShowPopupAndGetWebUIContent());
+  auto* presenter = location_bar()->GetOmniboxPopupAimPresenter();
+  ASSERT_TRUE(presenter->IsShown());
+  ASSERT_FALSE(presenter->IsPermissionPromptPreventingClose());
+
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* tab = tabs::TabInterface::GetFromContents(contents);
+  auto modal = tab->ShowModalUI();
+  ASSERT_FALSE(tab->CanShowModalUI());
+
+  class EmbeddedMicDelegate : public TestPermissionPromptDelegate {
+   public:
+    using TestPermissionPromptDelegate::TestPermissionPromptDelegate;
+    MOCK_METHOD(permissions::EmbeddedPermissionPromptFlowModel*,
+                GetEmbeddedPromptFlowModel,
+                (),
+                (const, override));
+  };
+  EmbeddedMicDelegate delegate(
+      contents, std::make_unique<permissions::MockPermissionRequest>(
+                    GURL(permissions::MockPermissionRequest::kDefaultOrigin),
+                    permissions::RequestType::kMicStream,
+                    /*embedded_permission_element_initiated=*/true));
+  EXPECT_CALL(delegate, GetEmbeddedPromptFlowModel()).WillOnce([&] {
+    EXPECT_TRUE(presenter->IsPermissionPromptPreventingClose());
+    return nullptr;
+  });
+  EXPECT_FALSE(CreatePermissionPrompt(contents, &delegate));
+  EXPECT_FALSE(presenter->IsPermissionPromptPreventingClose());
+}
+
+IN_PROC_BROWSER_TEST_F(
