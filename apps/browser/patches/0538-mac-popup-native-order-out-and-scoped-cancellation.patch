 }
 
+#if BUILDFLAG(IS_MAC)
+IN_PROC_BROWSER_TEST_P(OmniboxPopupVisibilityBrowserTest,
+                       NativeOrderOutPreservesPopupOwnership) {
+  ASSERT_TRUE(ui_test_utils::BringBrowserWindowToFront(browser()));
+  auto* bar = BrowserView::GetBrowserViewForBrowser(browser())
+                  ->toolbar()
+                  ->location_bar_view();
+  auto* controller = bar->GetOmniboxController();
+  auto* aim = bar->GetOmniboxPopupAimPresenter();
+  ASSERT_TRUE(aim);
+  ASSERT_TRUE(aim->GetWebUIContent());
+  auto* contents = aim->GetWebUIContent()->GetWrappedWebContents();
+  ASSERT_TRUE(contents);
+  ASSERT_TRUE(content::WaitForLoadStop(contents));
+  content::SimulateEndOfPaintHoldingOnPrimaryMainFrame(contents);
+  controller->popup_state_manager()->SetPopupState(OmniboxPopupState::kAim);
+  // IsShown() includes a pending first frame. Wait until the presenter has
+  // actually issued its show and AppKit reports that native window visible.
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return aim->HasOpenWidget() && aim->GetWidget()->IsVisible() &&
+           !bar->in_popup_state_transition();
+  }));
+
+  // Keep the popup logically open across focus loss while the native window
+  // is ordered out independently of the presenter.
+  bar->SetPermissionPromptShowing(true);
+  ASSERT_TRUE(aim->IsPermissionPromptPreventingClose());
+  const auto widget = aim->GetWidget()->GetWeakPtr();
+  widget->Hide();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return !widget || !widget->IsVisible(); }));
+  ASSERT_TRUE(aim->HasOpenWidget());
+  EXPECT_EQ(aim->GetWidget(), widget.get());
+  EXPECT_FALSE(aim->IsShown());
+  EXPECT_TRUE(controller->IsPopupOpen());
+
+  aim->SetPermissionPromptShowing(false);
+  controller->popup_state_manager()->SetPopupState(OmniboxPopupState::kNone);
+  EXPECT_FALSE(controller->IsPopupOpen());
+  EXPECT_FALSE(aim->HasOpenWidget());
+  EXPECT_FALSE(aim->GetWidget());
+}
+#endif  // BUILDFLAG(IS_MAC)
+
 INSTANTIATE_TEST_SUITE_P(AllPopupModes,
                          OmniboxPopupVisibilityBrowserTest,
                          testing::Bool());
