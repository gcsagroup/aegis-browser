+++ b/chrome/browser/aegis/access/access_proxying_url_loader_factory_browsertest.cc
@@ -2963,6 +2963,9 @@ IN_PROC_BROWSER_TEST_F(AccessProxyingURLLoaderFactoryBrowserTest,
   auto* dispatch_state =
       AccessRequestDispatchState::GetOrCreate(browser()->GetProfile());
   ASSERT_NE(dispatch_state, nullptr);
+  // Other page requests may also be registered for this profile.
+  const size_t ownership_before = dispatch_state->ownership().size();
+  ASSERT_GE(ownership_before, 1u);
   const AccessBlockAndCancelResult result =
       dispatch_state->InstallBlockBarrierAndCancelMatching(
           {"block-browser-0136", 1, std::move(selector)});
@@ -2972,7 +2975,7 @@ IN_PROC_BROWSER_TEST_F(AccessProxyingURLLoaderFactoryBrowserTest,
             aegis_access::RequestOwnershipStatus::kOk);
   EXPECT_EQ(result.matched_requests, 1u);
   EXPECT_EQ(result.terminated_requests, 1u);
-  EXPECT_EQ(dispatch_state->ownership().size(), 0u);
+  EXPECT_EQ(dispatch_state->ownership().size(), ownership_before - 1u);
 
   EXPECT_TRUE(base::test::RunUntil(
       [&] { return PendingFetchState() == "blocked"; }));
diff --git a/chrome/browser/ui/views/location_bar/location_bar_view.cc b/chrome/browser/ui/views/location_bar/location_bar_view.cc
index 5a4f8681856d82278a33dc77e344be2ec0b74771..9b1e2e529e6e9c03175ad5d3f3159533eb24c40c 100644
--- a/chrome/browser/ui/views/location_bar/location_bar_view.cc
+++ b/chrome/browser/ui/views/location_bar/location_bar_view.cc
@@ -2070,11 +2070,19 @@ void LocationBarView::ValidatePopupState(OmniboxPopupState state) {
           << ": classic=" << classic_is_open << " aim=" << aim_is_shown;
       break;
     }
-    case OmniboxPopupState::kAim:
-      DCHECK(!classic_is_open && aim_is_shown)
+    case OmniboxPopupState::kAim: {
+      // AppKit can leave the native child window hidden even after a fullscreen
+      // request has been declined. The presenter still owns that open widget
+      // until it receives a close or the model dismisses it.
+      const bool aim_is_open =
+          aim_is_shown ||
+          (BUILDFLAG(IS_MAC) && omnibox_popup_aim_presenter_ &&
+           omnibox_popup_aim_presenter_->HasOpenWidget());
+      DCHECK(!classic_is_open && aim_is_open)
           << "Widget state mismatch in kAim: classic=" << classic_is_open
           << " aim=" << aim_is_shown;
       break;
+    }
   }
 }
 
