     // If external code already hid the widget (e.g. ash on a user switch), then
     // we need to destroy the widget to prevent the external code from
     // re-showing the widget.
-    const bool hidden_externally = is_open_ && !widget_->IsVisible();
+    const bool hidden_externally = HasOpenWidget() && !widget_->IsVisible();
     is_open_ = false;
     widget_->Hide();
     if (auto* content = GetWebUIContent()) {
@@ -350,6 +350,10 @@ bool OmniboxPopupPresenterBase::IsShown() const {
   return is_deferred_ || (widget_ && widget_->IsVisible());
 }
 
+bool OmniboxPopupPresenterBase::HasOpenWidget() const {
+  return is_open_ && widget_;
+}
