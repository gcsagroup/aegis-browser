+std::string LocalizedAegisText(std::string_view english,
+                               std::string_view simplified,
+                               std::string_view traditional) {
+  const std::string locale =
+      g_browser_process ? g_browser_process->GetApplicationLocale() : "en";
+  if (base::StartsWith(locale, "zh-TW") || base::StartsWith(locale, "zh-HK") ||
+      base::StartsWith(locale, "zh-Hant")) {
+    return std::string(traditional);
+  }
+  return base::StartsWith(locale, "zh") ? std::string(simplified)
+                                        : std::string(english);
+}
+
+std::u16string AegisContextMenuLabel() {
+  return base::UTF8ToUTF16(
+      LocalizedAegisText("Send to Aegis", "交给 Aegis", "交給 Aegis"));
+}
+
+bool LooksLikeDownloadLink(const content::ContextMenuParams& params) {
+  if (!params.suggested_filename.empty()) {
+    return true;
+  }
+  const std::string path = base::ToLowerASCII(params.link_url.path());
+  constexpr std::string_view kDownloadSuffixes[] = {
+      ".dmg", ".pkg", ".zip", ".tar", ".gz",  ".xz", ".7z",
+      ".exe", ".msi", ".deb", ".rpm", ".apk", ".pdf"};
+  return std::ranges::any_of(kDownloadSuffixes, [&](std::string_view suffix) {
+    return base::EndsWith(path, suffix);
+  });
+}
