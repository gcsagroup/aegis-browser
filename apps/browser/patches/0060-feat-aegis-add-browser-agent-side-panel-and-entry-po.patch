+void RenderViewContextMenu::AppendAegisAgentItem() {
+  Profile* profile = GetProfile();
+  const GURL page_url = source_web_contents_->GetLastCommittedURL();
+  if (!profile || !profile->IsRegularProfile() || !GetBrowser() ||
+      !page_url.SchemeIsHTTPOrHTTPS() ||
+      !base::FeatureList::IsEnabled(aegis::features::kAegisAgent) ||
+      !profile->GetPrefs()->GetBoolean(aegis::prefs::kAgentEnabled)) {
+    return;
+  }
+  const size_t count = menu_model_.GetItemCount();
+  if (count > 0 &&
+      menu_model_.GetTypeAt(count - 1) != ui::MenuModel::TYPE_SEPARATOR) {
+    menu_model_.AddSeparator(ui::NORMAL_SEPARATOR);
+  }
+  menu_model_.AddItem(IDC_CONTENT_CONTEXT_SEND_TO_AEGIS_AGENT,
+                      AegisContextMenuLabel());
+}
+
+void RenderViewContextMenu::ExecuteAegisAgentContext() {
+  Profile* profile = GetProfile();
+  BrowserWindowInterface* browser = GetBrowser();
+  tabs::TabInterface* tab =
+      tabs::TabInterface::MaybeGetFromContents(source_web_contents_);
+  aegis::agent::AegisAgentService* service =
+      profile ? aegis::agent::AegisAgentServiceFactory::GetForProfile(profile)
+              : nullptr;
+  if (!profile || !profile->IsRegularProfile() || !browser || !tab ||
+      !service || !service->IsEnabled()) {
+    return;
+  }
+
+  const std::string page_origin =
+      url::Origin::Create(source_web_contents_->GetLastCommittedURL())
+          .Serialize();
+  aegis::agent::AgentInvocationContext context;
+  context.tab_id = tab->GetHandle().raw_value();
+
+  if (!params_.selection_text.empty()) {
+    const std::u16string selected = params_.selection_text.substr(
+        0, std::min<size_t>(params_.selection_text.size(), 768u));
+    const std::string selected_utf8 = base::UTF16ToUTF8(selected);
+    context.kind = "selection";
+    context.display =
+        base::StrCat({LocalizedAegisText("Selection", "选中文本", "選取文字"),
+                      " · ", page_origin});
+    context.suggested_goal = base::StrCat(
+        {LocalizedAegisText("Research this selected text and cite sources: ",
+                            "研究这段选中文本并标注来源：",
+                            "研究這段選取文字並標註來源："),
+         selected_utf8});
+  } else if (params_.link_url.SchemeIsHTTPOrHTTPS()) {
+    const bool download = LooksLikeDownloadLink(params_);
+    const std::string target_origin =
+        url::Origin::Create(params_.link_url).Serialize();
+    const std::u16string link_text = params_.link_text.substr(
+        0, std::min<size_t>(params_.link_text.size(), 256u));
+    const std::string link_text_utf8 = base::UTF16ToUTF8(link_text);
+    context.kind = download ? "download" : "link";
+    context.display =
+        base::StrCat({LocalizedAegisText(download ? "Download link" : "Link",
+                                         download ? "下载链接" : "链接",
+                                         download ? "下載連結" : "連結"),
+                      " · ", target_origin});
+    context.suggested_goal = base::StrCat(
+        {LocalizedAegisText(
+             download
+                 ? "Verify this download link and find the official source: "
+                 : "Inspect this link and explain the safest next action: ",
+             download ? "验证这个下载链接并查找官方来源："
+                      : "检查这个链接并说明最安全的下一步：",
+             download ? "驗證這個下載連結並尋找官方來源："
+                      : "檢查這個連結並說明最安全的下一步："),
+         link_text_utf8.empty() ? target_origin : link_text_utf8, " · ",
+         target_origin});
+  } else {
+    context.kind = "page";
+    context.display =
+        base::StrCat({LocalizedAegisText("Page", "当前页面", "目前頁面"), " · ",
+                      page_origin});
+    context.suggested_goal =
+        LocalizedAegisText("Analyze this page and propose a verifiable plan.",
+                           "分析当前页面并给出可验证的执行计划。",
+                           "分析目前頁面並提出可驗證的執行計畫。");
+  }
+
+  if (!service->SetPendingInvocationContext(std::move(context))) {
+    return;
+  }
+  SidePanelUI* side_panel = browser->GetFeatures().side_panel_ui();
+  if (side_panel) {
+    side_panel->Show(SidePanelEntryId::kAegisAgent,
+                     SidePanelOpenTrigger::kAegisAgent);
+  }
+}
