+                new LoadUrlParams(url.build().toString(), PageTransition.AUTO_TOPLEVEL);
+        getTabCreator(/* incognito= */ false)
+                .createNewTab(params, TabLaunchType.FROM_CHROME_UI, getActivityTab());
+    }
