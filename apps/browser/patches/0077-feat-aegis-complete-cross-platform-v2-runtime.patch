diff --git a/chrome/android/java/src/org/chromium/chrome/browser/aegis/AegisAgentBottomSheetCoordinator.java b/chrome/android/java/src/org/chromium/chrome/browser/aegis/AegisAgentBottomSheetCoordinator.java
new file mode 100644
index 0000000000..18ee2a0eeb
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/aegis/AegisAgentBottomSheetCoordinator.java
@@ -0,0 +1,156 @@
+// Copyright 2026 GCSA
+
+package org.chromium.chrome.browser.aegis;
+
+import android.content.Context;
+import android.content.res.Resources;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.EditText;
+import android.widget.ScrollView;
+
+import androidx.annotation.StringRes;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetContent;
+import org.chromium.components.browser_ui.bottomsheet.BottomSheetController;
+
+/** Native, novice-friendly entry composer for Aegis Browser Agent. */
+@NullMarked
+public final class AegisAgentBottomSheetCoordinator {
+    /** Opens the full Agent workspace with an optional goal. */
+    public interface Launcher {
+        void launch(String goal, boolean autoStart);
+    }
+
+    /**
+     * Shows the native task composer.
+     *
+     * @param currentPage Whether this entry was invoked for the visible HTTP(S) page.
+     */
+    public static boolean show(
+            Context context,
+            BottomSheetController controller,
+            boolean currentPage,
+            Launcher launcher) {
+        View view =
+                LayoutInflater.from(context)
+                        .inflate(R.layout.aegis_agent_bottom_sheet, /* root= */ null);
+        ScrollView scrollView = view.findViewById(R.id.aegis_agent_sheet_scroll_view);
+        EditText goal = view.findViewById(R.id.aegis_agent_sheet_goal);
+        if (currentPage) {
+            goal.setText(R.string.aegis_agent_current_page_default_goal);
+            goal.setSelection(goal.length());
+        }
+
+        bindPreset(view, goal, R.id.aegis_agent_quick_summary, R.string.aegis_agent_goal_summary);
+        bindPreset(
+                view, goal, R.id.aegis_agent_quick_bookmarks, R.string.aegis_agent_goal_bookmarks);
+        bindPreset(view, goal, R.id.aegis_agent_quick_download, R.string.aegis_agent_goal_download);
+        bindPreset(view, goal, R.id.aegis_agent_quick_compare, R.string.aegis_agent_goal_compare);
+
+        SheetContent content = new SheetContent(view, scrollView);
+        view.findViewById(R.id.aegis_agent_sheet_start)
+                .setOnClickListener(
+                        ignored -> {
+                            String requestedGoal = goal.getText().toString().trim();
+                            if (requestedGoal.isEmpty()) {
+                                goal.setError(
+                                        context.getString(R.string.aegis_agent_goal_required));
+                                goal.requestFocus();
+                                return;
+                            }
+                            controller.hideContent(content, /* animate= */ true);
+                            launcher.launch(requestedGoal, /* autoStart= */ true);
+                        });
+        view.findViewById(R.id.aegis_agent_sheet_open_center)
+                .setOnClickListener(
+                        ignored -> {
+                            controller.hideContent(content, /* animate= */ true);
+                            launcher.launch(/* goal= */ "", /* autoStart= */ false);
+                        });
+        return controller.requestShowContent(content, /* animate= */ true);
+    }
+
+    private static void bindPreset(
+            View view, EditText goal, int buttonId, @StringRes int goalStringId) {
+        view.findViewById(buttonId)
+                .setOnClickListener(
+                        ignored -> {
+                            goal.setText(goalStringId);
+                            goal.setSelection(goal.length());
+                        });
+    }
+
+    private static final class SheetContent implements BottomSheetContent {
+        private final View mView;
+        private final ScrollView mScrollView;
+
+        SheetContent(View view, ScrollView scrollView) {
+            mView = view;
+            mScrollView = scrollView;
+        }
+
+        @Override
+        public View getContentView() {
+            return mView;
+        }
+
+        @Override
+        public @Nullable View getToolbarView() {
+            return null;
+        }
+
+        @Override
+        public int getVerticalScrollOffset() {
+            return mScrollView.getScrollY();
+        }
+
+        @Override
+        public void destroy() {}
+
+        @Override
+        public int getPriority() {
+            return ContentPriority.HIGH;
+        }
+
+        @Override
+        public float getFullHeightRatio() {
+            return HeightMode.WRAP_CONTENT;
+        }
+
+        @Override
+        public float getHalfHeightRatio() {
+            return HeightMode.DISABLED;
+        }
+
+        @Override
+        public boolean swipeToDismissEnabled() {
+            return true;
+        }
+
+        @Override
+        public String getSheetContentDescription(Context context) {
+            return context.getString(R.string.aegis_agent_sheet_content_description);
+        }
+
+        @Override
+        public @StringRes int getSheetClosedAccessibilityStringId() {
+            return R.string.aegis_agent_sheet_closed;
+        }
+
+        @Override
+        public @StringRes int getSheetHalfHeightAccessibilityStringId() {
+            return Resources.ID_NULL;
