+        if (tab && tab->GetHandle().raw_value() == invocation->tab_id &&
+            tab->GetURL().SchemeIsHTTPOrHTTPS()) {
+          return tab;
+        }
+      }
+    }
+  }
+  tabs::TabInterface* active = tabs->GetActiveTab();
+  if (active && active->GetURL().SchemeIsHTTPOrHTTPS()) {
+    return active;
+  }
+  // On Android the Agent is a full-page WebUI tab. Preserve the public tab
+  // the user came from so commands such as "summarize this page" keep their
+  // natural meaning after opening the Agent.
+  for (int index = tabs->GetTabCount() - 1; index >= 0; --index) {
+    tabs::TabInterface* tab = tabs->GetTab(index);
+    if (tab && tab->GetURL().SchemeIsHTTPOrHTTPS()) {
+      return tab;
+    }
+  }
+  return active;
