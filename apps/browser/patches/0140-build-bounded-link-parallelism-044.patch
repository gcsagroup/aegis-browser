diff --git a/chrome/BUILD.gn b/chrome/BUILD.gn
index 14e23ea503fbae07e1f283886a490b8b0229361e..d3e4003be353f7c7bac626aef95080f3c0548fe3 100644
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -1397,11 +1397,11 @@ if (is_win) {
     }
   }
 
-  # 独立验收目录的链接资源限制，不改变代码优化等级或系统上限。
+  # 本机验收将链接并行限制为4，不改变代码优化等级或系统上限。
   config("aegis_acceptance_link_limits") {
     ldflags = [
-      "-Wl,--thinlto-jobs=1",
-      "-Wl,--threads=1",
+      "-Wl,--thinlto-jobs=4",
+      "-Wl,--threads=4",
     ]
   }
 
