+void NetworkContext::InstallAegisAccessSnapshot(
+    mojom::AegisAccessSnapshotPtr snapshot,
+    InstallAegisAccessSnapshotCallback callback) {
+  auto ack = mojom::AegisAccessSnapshotAck::New();
+  ack->owner = snapshot->owner.Clone();
+  ack->incarnation = snapshot->incarnation;
+  ack->sequence = snapshot->sequence;
+  ack->common_generations = snapshot->common_generations.Clone();
+  if (!aegis_access_state_) {
+    aegis_access_state_ = std::make_unique<AccessNetworkContextState>(
+        this, &cors_origin_access_list_);
+  }
+  ack->accepted = aegis_access_state_->Install(*snapshot);
+  for (const auto& endpoint : snapshot->endpoints) {
+    ack->registrations.push_back(mojom::AegisAccessRegistrationAck::New(
+        endpoint->proxy_group_id, endpoint->registration_id,
+        endpoint->selection_generation));
+  }
+  std::move(callback).Run(std::move(ack));
+}
+void NetworkContext::BeginAegisAccessRestore(
+    mojom::AegisAccessOwnerPtr owner, const std::string& incarnation,
+    BeginAegisAccessRestoreCallback callback) {
+  using Channel = aegis_access::ChannelNamespace;
+  Channel channel = Channel::kInvalid;
+  switch (owner->channel) {
+    case mojom::AegisAccessChannel::kDev: channel = Channel::kDev; break;
+    case mojom::AegisAccessChannel::kAlpha: channel = Channel::kAlpha; break;
+    case mojom::AegisAccessChannel::kBeta: channel = Channel::kBeta; break;
+    case mojom::AegisAccessChannel::kRelease: channel = Channel::kRelease; break;
+  }
+  std::move(callback).Run(aegis_access_state_ &&
+      aegis_access_state_->EnterRestoring(
+          {channel, owner->profile_token, owner->storage_partition_token},
+          incarnation));
+}
+void NetworkContext::CreateAegisAccessURLLoaderFactory(
+    mojo::PendingReceiver<mojom::AegisAccessURLLoaderFactory> receiver,
+    mojom::URLLoaderFactoryParamsPtr params,
+    mojom::AegisAccessFactoryBindingPtr binding,
+    CreateAegisAccessURLLoaderFactoryCallback callback) {
+  if (!aegis_access_state_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  auto scheduler = base::MakeRefCounted<ResourceSchedulerClient>(
+      ResourceScheduler::ClientId::Create(),
+      IsBrowserInitiated(params->process_id.is_browser()),
+      resource_scheduler_.get(),
+      url_request_context_->network_quality_estimator());
+  std::move(callback).Run(aegis_access_state_->CreateFactory(std::move(params),
+      std::move(scheduler), std::move(binding), std::move(receiver)));
+}
