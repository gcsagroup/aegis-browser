index 6c35ef4c43..35047074f0 100644
--- a/chrome/browser/actor/site_policy.cc
+++ b/chrome/browser/actor/site_policy.cc
@@ -142,8 +142,24 @@ void MayActOnUrlInternal(
     const EnterprisePolicyChecker& policy_checker,
     bool apply_sensitive_origin_check,
     std::unique_ptr<DecisionWrapper> decision_wrapper) {
-  if ((net::IsLocalhost(url) && url.SchemeIsHTTPOrHTTPS()) ||
-      url.IsAboutBlank()) {
+  if (url.IsAboutBlank()) {
+    decision_wrapper->Accept();
+    return;
+  }
+
+  // 客户端的显式阻止是授权边界，不是提示性安全信号。必须先执行该检查，
+  // 再允许 localhost、测试开关或静态白名单提前放行；Aegis 等受限客户端
+  // 正是通过该检查器约束已批准来源。
+  const EnterprisePolicyChecker::UrlBlockReason enterprise_reason =
+      policy_checker.Evaluate(url);
+  if (enterprise_reason ==
+      EnterprisePolicyChecker::UrlBlockReason::kExplicitlyBlocked) {
+    decision_wrapper->Reject("Enterprise policy block",
+                             MayActOnUrlBlockReason::kEnterprisePolicy);
+    return;
+  }
+
+  if (net::IsLocalhost(url) && url.SchemeIsHTTPOrHTTPS()) {
     decision_wrapper->Accept();
     return;
   }
