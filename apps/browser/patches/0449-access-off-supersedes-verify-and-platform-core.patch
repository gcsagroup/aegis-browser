diff --git a/chrome/browser/aegis/access/access_local_core_manager_unavailable.cc b/chrome/browser/aegis/access/access_local_core_manager_unavailable.cc
new file mode 100644
index 0000000000000000000000000000000000000000..629de43150123e89598a1024a2853d0ab97a5d84
--- /dev/null
+++ b/chrome/browser/aegis/access/access_local_core_manager_unavailable.cc
@@ -0,0 +1,42 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/aegis/access/access_local_core_manager.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace aegis::access {
+
+std::optional<AccessLocalCoreInput> ResolveAccessLocalCoreInput() {
+  return std::nullopt;
+}
+
+// Complete the private type for the empty SequenceBound. Unsupported builds
+// create neither a worker thread nor a child process.
+class AccessLocalCoreManager::Worker {};
+
+AccessLocalCoreManager::AccessLocalCoreManager(AccessLocalCoreInput) {}
+AccessLocalCoreManager::~AccessLocalCoreManager() = default;
+
+void AccessLocalCoreManager::Prepare(
+    base::OnceCallback<void(AccessLocalCoreReady)> completion) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(std::move(completion), AccessLocalCoreReady{
+          .error = "The local proxy is unavailable on this platform."}));
+}
+
+void AccessLocalCoreManager::Verify(
+    base::OnceCallback<void(AccessLocalCoreReady)> completion) {
+  Prepare(std::move(completion));
+}
+
+void AccessLocalCoreManager::Stop(base::OnceClosure completion) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, std::move(completion));
+}
+
+void AccessLocalCoreManager::SetStoppedCallback(
+    base::RepeatingCallback<void(std::string)>) {}
+
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_local_core_manager_unavailable_unittest.cc b/chrome/browser/aegis/access/access_local_core_manager_unavailable_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f8c51b2e83b47c2bd1f4d0db72d8cad90353d6ea
--- /dev/null
+++ b/chrome/browser/aegis/access/access_local_core_manager_unavailable_unittest.cc
@@ -0,0 +1,44 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/aegis/access/access_local_core_manager.h"
+
+#include "base/command_line.h"
+#include "base/test/scoped_command_line.h"
+#include "base/test/task_environment.h"
+#include "base/test/test_future.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis::access {
+namespace {
+
+TEST(AccessLocalCoreUnavailableTest, CannotResolveEvenExplicitPrivateBinding) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchASCII(
+      "aegis-access-dev-core-manifest", "unavailable-manifest");
+  command.GetProcessCommandLine()->AppendSwitchASCII(
+      "aegis-access-dev-node-config", "unavailable-node");
+  EXPECT_FALSE(ResolveAccessLocalCoreInput());
+}
+
+TEST(AccessLocalCoreUnavailableTest, AsyncPrepareVerifyAndStopNeverExposeEndpoint) {
+  base::test::TaskEnvironment environment;
+  AccessLocalCoreManager manager({});
+  for (bool verify : {false, true}) {
+    base::test::TestFuture<AccessLocalCoreReady> future;
+    if (verify) manager.Verify(future.GetCallback());
+    else manager.Prepare(future.GetCallback());
+    EXPECT_FALSE(future.IsReady());
+    const auto& ready = future.Get();
+    EXPECT_FALSE(ready.ready);
+    EXPECT_EQ(ready.port, 0);
+    EXPECT_TRUE(ready.registration_id.empty());
+    EXPECT_FALSE(ready.local_credentials);
+    EXPECT_FALSE(ready.error.empty());
+  }
+  base::test::TestFuture<void> stopped;
+  manager.Stop(stopped.GetCallback());
+  EXPECT_FALSE(stopped.IsReady());
+  EXPECT_TRUE(stopped.Wait());
+}
+
+}  // namespace
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
index 37df60a62083bc231b9d6efe04bf8005defa78a0..77fc6adb6ddf3e8e396a9c23230c5dfc61b6249d 100644
--- a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
+++ b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.cc
@@ -187,6 +187,15 @@ bool AccessSiteProxyBubbleController::RequestHostProxySession(
     host_states_[host].connection = AccessSiteConnectionState::kUnavailable;
     return false;
   }
+  base::OnceCallback<void(bool)> superseded_retry;
+  if (publication_in_flight_ && !enabled && verifying_host_ == host) {
+    // The ON transaction is already committed. Its connectivity recheck may
+    // finish later, but a newer OFF owns both the choice and the retry now.
+    verifying_host_.reset();
+    ++committed_verification_attempt_;
+    publication_in_flight_ = false;
+    superseded_retry = std::move(retry_completion_);
+  }
   if (publication_in_flight_ || (enabled && restoring_core_)) {
     host_states_[host].failure_reason = AccessSiteProxySessionErrorReadableMessage(
         AccessSiteProxySessionError::kBusy);
@@ -199,6 +208,7 @@ bool AccessSiteProxyBubbleController::RequestHostProxySession(
     host_states_[host].connection = AccessSiteConnectionState::kConnecting;
     host_states_[host].failure_reason.clear();
     BeginDisablePublication(host);
+    if (superseded_retry) std::move(superseded_retry).Run(false);
     return true;
   }
 
@@ -389,7 +399,10 @@ bool AccessSiteProxyBubbleController::RegisterPreparedCore(
   return true;
 }
 void AccessSiteProxyBubbleController::OnCommittedCoreVerified(
-    AccessSiteHost host, AccessLocalCoreReady result) {
+    AccessSiteHost host, uint64_t attempt, AccessLocalCoreReady result) {
+  if (attempt != committed_verification_attempt_ || verifying_host_ != host)
+    return;
+  verifying_host_.reset();
   if (!result.ready) {
     OnLocalCoreStopped(core_registration_);
     FailCorePreparation(host, std::move(result.error));
@@ -809,9 +822,10 @@ void AccessSiteProxyBubbleController::OnPublicationComplete(
   if (enabling) {
     if (result.status == AccessMutationTransactionStatus::kCommitted) {
       publication_in_flight_ = true;
+      verifying_host_ = host;
       local_core_->Verify(base::BindOnce(
           &AccessSiteProxyBubbleController::OnCommittedCoreVerified,
-          weak_factory_.GetWeakPtr(), host));
+          weak_factory_.GetWeakPtr(), host, ++committed_verification_attempt_));
       return;
     }
     // Preserve the last committed choice; preparation is not a commit.
diff --git a/chrome/browser/aegis/access/access_site_proxy_bubble_controller.h b/chrome/browser/aegis/access/access_site_proxy_bubble_controller.h
