+bool HostMatchesDomain(std::string_view host, std::string_view domain) {
+  if (domain.empty()) {
+    return true;
+  }
+  return host == domain ||
+         base::EndsWith(host, std::string(".") + std::string(domain),
+                        base::CompareCase::SENSITIVE);
