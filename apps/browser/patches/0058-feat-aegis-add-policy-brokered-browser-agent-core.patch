+class AegisAgentBrowserTest : public InProcessBrowserTest {
+ public:
+  AegisAgentBrowserTest() {
+    features_.InitWithFeatures(
+        {features::kAegisAgent, features::kAegisAgentPageActions,
+         features::kAegisAgentBrowserTools, features::kAegisAgentWebMcp,
+         features::kAegisAgentWorkflows},
