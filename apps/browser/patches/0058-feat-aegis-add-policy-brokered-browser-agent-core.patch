+bool AegisAgentService::SetPlanReady(const std::string& task_id) {
+  if (!plans_.contains(task_id)) {
+    return false;
+  }
+  return Transition(task_id, AgentTaskState::kAwaitingTaskConsent,
+                    "plan validated");
+}
