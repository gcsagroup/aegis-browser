+              if (Date.now() >= deadline) {
+                resolve(false);
+                return;
+              }
+              setTimeout(poll, 10);
+            };
+            poll();
+          })
+        )JS")
+                        .ExtractBool());
+        EXPECT_TRUE(base::test::RunUntil([&]() {
+          const std::vector<AgentMonitorDefinition> monitors =
