+// static
+AegisAgentServiceFactory* AegisAgentServiceFactory::GetInstance() {
+  static base::NoDestructor<AegisAgentServiceFactory> factory{
+      base::PassKey<AegisAgentServiceFactory>()};
+  return factory.get();
