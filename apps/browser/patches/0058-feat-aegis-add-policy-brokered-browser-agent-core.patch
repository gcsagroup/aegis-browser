+  ASSERT_TRUE(task.TransitionTo(AgentTaskState::kCompleted, "test"));
+  ASSERT_TRUE(store.SaveTask(task, "Completed monitor owner", false));
+  EXPECT_TRUE(store.LoadUnfinishedTasks().empty());
+
+  AgentMonitorDefinition monitor;
