+bool ContainsAny(std::string_view haystack,
+                 std::initializer_list<std::string_view> needles) {
+  return std::ranges::any_of(needles, [haystack](std::string_view needle) {
+    return haystack.find(needle) != std::string_view::npos;
+  });
+}
