+AgentModelDestination AegisAgentService::ConfiguredModelDestination() const {
+  const PrefService* prefs = profile_ ? profile_->GetPrefs() : nullptr;
+  const ModelProvider provider =
+      prefs ? ParseModelProvider(prefs->GetString(aegis::prefs::kModelProvider))
+                  .value_or(ModelProvider::kOpenAI)
+            : ModelProvider::kOpenAI;
+  const std::string endpoint = NormalizeAgentModelBaseUrl(
+      provider, prefs ? prefs->GetString(aegis::prefs::kModelBaseUrl)
+                      : std::string_view());
+  const std::string configured_model =
+      prefs ? prefs->GetString(aegis::prefs::kModelName) : std::string();
+  const std::string model = IsValidModelName(provider, configured_model)
+                                ? configured_model
+                                : std::string(DefaultModelName(provider));
+  return {.kind = IsLocalModelEndpoint(provider, GURL(endpoint))
+                      ? AgentModelDestination::Kind::kLoopback
+                      : AgentModelDestination::Kind::kCloud,
+          .provider = std::string(ModelProviderId(provider)),
+          .endpoint = endpoint,
+          .model = model};
+}
