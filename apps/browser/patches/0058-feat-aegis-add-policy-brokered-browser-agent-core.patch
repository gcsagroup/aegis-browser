+AegisAgentService* AegisAgentServiceFactory::GetForProfile(Profile* profile) {
+  if (!profile) {
+    return nullptr;
+  }
+  return static_cast<AegisAgentService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, /*create=*/true));
+}
