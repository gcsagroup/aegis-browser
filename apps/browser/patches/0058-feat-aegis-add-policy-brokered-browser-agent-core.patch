+SidePanelEntry* AgentEntry(Browser* browser) {
+  SidePanelRegistry* registry = SidePanelRegistry::From(browser);
+  return registry ? registry->GetEntryForKey(
+                        SidePanelEntry::Key(SidePanelEntry::Id::kAegisAgent))
+                  : nullptr;
