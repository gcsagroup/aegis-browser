diff --git a/chrome/browser/aegis/agent/agent_scope_fuzzer.cc b/chrome/browser/aegis/agent/agent_scope_fuzzer.cc
new file mode 100644
index 0000000000..f89866f267
--- /dev/null
+++ b/chrome/browser/aegis/agent/agent_scope_fuzzer.cc
@@ -0,0 +1,27 @@
+// Copyright 2026 GCSA
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "chrome/browser/aegis/agent/agent_task_store.h"
+#include "chrome/browser/aegis/agent/agent_tool_registry.h"
+
+namespace aegis::agent {
+
+extern "C" int LLVMFuzzerTestOneInput(const uint8_t* data, size_t size) {
+  constexpr size_t kMaxInputBytes = 128 * 1024;
+  if (!data || size == 0 || size > kMaxInputBytes) {
+    return 0;
+  }
+  const std::string input(reinterpret_cast<const char*>(data), size);
+  std::optional<AgentTaskScope> scope = AgentTaskStore::DeserializeScope(input);
+  if (scope) {
+    AgentToolRegistry registry;
+    registry.ModelToolsForScope(*scope);
+  }
+  return 0;
+}
+
+}  // namespace aegis::agent
