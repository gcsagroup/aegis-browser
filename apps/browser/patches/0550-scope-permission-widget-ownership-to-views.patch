 namespace {
 
-bool ManagerHasActivePromptWidget(
-    const permissions::PermissionRequestManager* manager) {
-  const auto* prompt = manager ? manager->GetCurrentPrompt() : nullptr;
-  return prompt && prompt->HasActivePromptWidget();
+const content::WebContents* GetWebContentsWithCurrentPrompt(
+    permissions::PermissionRequestManager* manager) {
+  return manager && manager->GetCurrentPrompt()
+             ? manager->GetAssociatedWebContents()
+             : nullptr;
 }
 
 std::string_view CreationReasonToString(
@@ -96,8 +97,8 @@ class OmniboxPopupPresenterBase::RequestingPromptObservation
 
   bool IsLocked() const { return observation_.IsObserving(); }
 
-  bool HasActivePromptWidget() const {
-    return ManagerHasActivePromptWidget(observation_.GetSource());
+  permissions::PermissionRequestManager* GetLockedManager() {
+    return observation_.GetSource();
   }
 
   void Reset() {
@@ -955,9 +956,41 @@ bool OmniboxPopupPresenterBase::IsPermissionPromptPreventingClose() const {
           requesting_prompt_observation_->IsLocked());
 }
 
-bool OmniboxPopupPresenterBase::HasActivePermissionPromptWidget() const {
-  return (is_prompt_showing_ &&
-          ManagerHasActivePromptWidget(permission_observation_.GetSource())) ||
-         (requesting_prompt_observation_ &&
-          requesting_prompt_observation_->HasActivePromptWidget());
+bool OmniboxPopupPresenterBase::HasActivePermissionPromptWidget(
+    const views::Widget* browser_widget) {
+  if (!browser_widget) {
+    return false;
+  }
+
+  const auto* popup_contents =
+      is_prompt_showing_
+          ? GetWebContentsWithCurrentPrompt(
+                permission_observation_.GetSource())
+          : nullptr;
+  const auto* requesting_contents =
+      requesting_prompt_observation_
+          ? GetWebContentsWithCurrentPrompt(
+                requesting_prompt_observation_->GetLockedManager())
+          : nullptr;
+  if (!popup_contents && !requesting_contents) {
+    return false;
+  }
+
+  // Owned widgets include permission bubbles nested under a content scrim.
+  for (const views::Widget* widget :
+       views::Widget::GetAllOwnedWidgets(browser_widget->GetNativeView())) {
+    if (widget->IsClosed() || !widget->IsVisible() || !widget->IsActive()) {
+      continue;
+    }
+    // For a bubble, the root contents are the non-client frame.
+    const auto* prompt_view = views::AsViewClass<PermissionPromptBaseView>(
+        widget->GetClientContentsView());
+    const auto* prompt_contents =
+        prompt_view ? prompt_view->web_contents() : nullptr;
+    if (prompt_contents && (prompt_contents == popup_contents ||
+                            prompt_contents == requesting_contents)) {
+      return true;
+    }
+  }
+  return false;
 }
