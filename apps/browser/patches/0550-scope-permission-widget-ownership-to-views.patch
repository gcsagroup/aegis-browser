 void OmniboxPopupFullPresenter::BlurIfBrowserOrPopupInactive() {
   // The permission manager has installed the prompt by the time this task
-  // runs. A widget owned by that prompt can be the destination of the handoff.
-  if (!IsBrowserOrPopupActive() && !HasActivePermissionPromptWidget()) {
+  // runs, so its browser-owned widget can hold activation.
+  if (!IsBrowserOrPopupActive() &&
+      !HasActivePermissionPromptWidget(GetBrowserWidget())) {
     BlurForWindowDeactivation();
   }
 }
