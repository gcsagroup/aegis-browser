--- a/services/network/network_context.cc
+++ b/services/network/network_context.cc
@@ -993,6 +993,7 @@ void NetworkContext::CreateNetLogEntriesForActiveWebSockets(
 
 NetworkContext::~NetworkContext() {
   is_destructing_ = true;
+  aegis_access_context_receivers_.Clear();
   aegis_access_state_.reset();
 
   // Clear pending HttpCacheDataRemovers and counters explicitly to cancel
@@ -1150,6 +1151,28 @@ void NetworkContext::CreateURLLoaderFactory(
                          std::move(resource_scheduler_client));
 }
 
+void NetworkContext::BindAegisAccessContext(
+    mojo::PendingReceiver<mojom::AegisAccessContext> receiver,
+    BindAegisAccessContextCallback callback) {
+  aegis_access_context_receivers_.Add(this, std::move(receiver));
+  std::move(callback).Run(aegis_access_incarnation_);
+}
+void NetworkContext::InstallSnapshot(mojom::AegisAccessSnapshotPtr snapshot,
+                                    InstallSnapshotCallback callback) {
+  InstallAegisAccessSnapshot(std::move(snapshot), std::move(callback));
+}
+void NetworkContext::BeginRestore(mojom::AegisAccessOwnerPtr owner,
+    const std::string& incarnation, BeginRestoreCallback callback) {
+  BeginAegisAccessRestore(std::move(owner), incarnation, std::move(callback));
+}
+void NetworkContext::CreateFactory(
+    mojo::PendingReceiver<mojom::AegisAccessURLLoaderFactory> receiver,
+    mojom::URLLoaderFactoryParamsPtr params,
+    mojom::AegisAccessFactoryBindingPtr binding, CreateFactoryCallback callback) {
+  CreateAegisAccessURLLoaderFactory(std::move(receiver), std::move(params),
+                                   std::move(binding), std::move(callback));
+}
+
 void NetworkContext::InstallAegisAccessSnapshot(
     mojom::AegisAccessSnapshotPtr snapshot,
     InstallAegisAccessSnapshotCallback callback) {
@@ -1162,7 +1185,8 @@ void NetworkContext::InstallAegisAccessSnapshot(
     aegis_access_state_ = std::make_unique<AccessNetworkContextState>(
         this, &cors_origin_access_list_);
   }
-  ack->accepted = aegis_access_state_->Install(*snapshot);
+  ack->accepted = snapshot->incarnation == aegis_access_incarnation_ &&
