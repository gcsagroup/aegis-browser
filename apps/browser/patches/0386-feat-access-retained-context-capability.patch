@@ -1178,6 +1191,9 @@ class COMPONENT_EXPORT(NETWORK_SERVICE) NetworkContext
 
   // Explicitly destroyed at the start of ~NetworkContext, before its loaders'
   // dependent Context services. Null until the first complete installation.
