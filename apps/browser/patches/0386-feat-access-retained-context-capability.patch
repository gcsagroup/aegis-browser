+      base::UnguessableToken::Create().ToString();
+  mojo::ReceiverSet<mojom::AegisAccessContext> aegis_access_context_receivers_;
   std::unique_ptr<AccessNetworkContextState> aegis_access_state_;
 
   // Keep track of the existing `ConnectionChangeNotifiers`. These will be later
diff --git a/services/network/public/mojom/network_context.mojom b/services/network/public/mojom/network_context.mojom
index 711d7f50384fa5e7ba1eb6fcce9f366835bb8530..605177b8fe7a33bc5aab587fbe545e43252e9d36 100644
--- a/services/network/public/mojom/network_context.mojom
+++ b/services/network/public/mojom/network_context.mojom
@@ -1971,4 +1971,19 @@ interface NetworkContext {
       URLLoaderFactoryParams params, AegisAccessFactoryBinding binding)
       => (bool created);
 
+  // Retains this exact Context for delayed Browser document binding, without
+  // retaining a raw client-side NetworkContext proxy across service resets.
+  [AllowedContext=sandbox.mojom.Context.kBrowser]
+  BindAegisAccessContext(pending_receiver<AegisAccessContext> receiver)
+      => (string incarnation);
+
+};
+
+// Browser retains this private capability; a Context reset closes every pipe.
+interface AegisAccessContext {
+  InstallSnapshot(AegisAccessSnapshot snapshot) => (AegisAccessSnapshotAck ack);
+  BeginRestore(AegisAccessOwner owner, string incarnation) => (bool restoring);
+  CreateFactory(pending_receiver<AegisAccessURLLoaderFactory> receiver,
+                URLLoaderFactoryParams params, AegisAccessFactoryBinding binding)
+      => (bool created);
 };
