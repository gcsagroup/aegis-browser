@@ -0,0 +1,176 @@
+// Copyright 2026 GCSA
+
+#include "chrome/common/aegis/aegis_block_reporter.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/barrier_closure.h"
+#include "base/functional/bind.h"
+#include "base/location.h"
