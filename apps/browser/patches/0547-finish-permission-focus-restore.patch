 }
 
 void OmniboxPopupPresenterBase::RestoreFocusAfterPermissionPromptDismissed() {
-  // Passive suggestions don't take focus and never receive a widget activation
-  // callback. Another prompt can also still own the popup.
-  if (!widget_ || !IsShown() || !ShouldReceiveFocus() || is_prompt_showing_ ||
-      (requesting_prompt_observation_ &&
-       requesting_prompt_observation_->IsLocked())) {
+  if (is_prompt_showing_ || (requesting_prompt_observation_ &&
+                             requesting_prompt_observation_->IsLocked())) {
+    return;
+  }
+  // Passive suggestions and an unfocused Full WebUI popup do not take focus
+  // after a dismissal, so there will be no activation to finish the restore.
+  if (!widget_ || !IsShown() ||
+      !ShouldRestoreFocusAfterPermissionPromptDismissed()) {
+    FinishPermissionPromptFocusRestore();
     return;
   }
   is_handling_prompt_dismissal_ = !widget_->IsActive();
@@ -925,10 +929,15 @@ void OmniboxPopupPresenterBase::OnPermissionRequestManagerDestructed() {
   is_handling_prompt_dismissal_ = false;
 }
 
-void OmniboxPopupPresenterBase::OnWidgetActivated() {
+void OmniboxPopupPresenterBase::FinishPermissionPromptFocusRestore() {
   is_handling_prompt_dismissal_ = false;
 }
 
+bool OmniboxPopupPresenterBase::
+    ShouldRestoreFocusAfterPermissionPromptDismissed() const {
+  return ShouldReceiveFocus();
+}
