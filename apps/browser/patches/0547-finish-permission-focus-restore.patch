+++ b/chrome/browser/ui/views/omnibox/omnibox_aim_popup_browsertest.cc
@@ -995,6 +995,57 @@ IN_PROC_BROWSER_TEST_F(OmniboxAimPopupFullWebUIBrowserTest,
             OmniboxPopupState::kAim);
 }
 
+IN_PROC_BROWSER_TEST_F(OmniboxAimPopupFullWebUIBrowserTest,
+                       PermissionDismissalAllowsUnfocusedFullPopupToClose) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      browser(), embedded_test_server()->GetURL("/empty.html")));
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return location_bar()->IsFullWebUiOmniboxReady(); }));
+
+  auto* controller = location_bar()->GetOmniboxController();
+  auto* state = controller->popup_state_manager();
+  auto* presenter = location_bar()->GetOmniboxPopupView()->presenter();
+  ASSERT_TRUE(presenter);
+  ASSERT_FALSE(controller->edit_model()->has_focus());
+  // Full WebUI also shows an inactive popup when restoring an unfocused draft.
+  state->SetPopupState(OmniboxPopupState::kFull);
+  presenter->Show();
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return presenter->GetWidget() && presenter->GetWidget()->IsVisible() &&
+           !location_bar()->in_popup_state_transition();
+  }));
+  ASSERT_FALSE(presenter->GetWidget()->IsActive());
+  ASSERT_FALSE(controller->edit_model()->has_focus());
+
+  auto* contents = browser()->GetTabStripModel()->GetActiveWebContents();
+  auto* manager =
+      permissions::PermissionRequestManager::FromWebContents(contents);
+  ASSERT_TRUE(manager);
+  manager->AddRequest(
+      contents->GetPrimaryMainFrame(),
+      std::make_unique<permissions::MockPermissionRequest>(
+          contents->GetLastCommittedURL().DeprecatedGetOriginAsURL(),
+          permissions::RequestType::kMicStream));
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return manager->GetCurrentPrompt() &&
+           presenter->IsPermissionPromptPreventingClose();
+  }));
+
+  auto* closer = controller->client()->GetOmniboxPopupCloser();
+  ASSERT_TRUE(closer);
+  closer->CloseWithReason(omnibox::PopupCloseReason::kBlur);
+  ASSERT_EQ(state->popup_state(), OmniboxPopupState::kFull);
+  manager->Dismiss(/*prompt_options=*/std::monostate());
+  ASSERT_TRUE(
+      base::test::RunUntil([&] { return !manager->IsRequestInProgress(); }));
+  ASSERT_TRUE(presenter->IsShown());
+  EXPECT_FALSE(presenter->GetWidget()->IsActive());
+  EXPECT_FALSE(presenter->IsPermissionPromptPreventingClose());
+  closer->CloseWithReason(omnibox::PopupCloseReason::kBlur);
+  EXPECT_EQ(state->popup_state(), OmniboxPopupState::kNone);
+}
+
 // Verifies that when the Omnibox popup is closed, creating a permission prompt
 // does NOT set permission prompt showing on the presenter.
 IN_PROC_BROWSER_TEST_F(OmniboxAimPopupBrowserTest,
