Subject: [PATCH] fix(mac): validate pinned GCSA distribution signing category

---
 base/mac/process_requirement.cc               |  9 +++
 chrome/browser/aegis/BUILD.gn                 |  5 +-
 .../aegis/aegis_mac_signing_unittest.cc       | 76 +++++++++++++++++++
 .../ui/webui/help/aegis_github_update.h       |  4 +-
 4 files changed, 91 insertions(+), 3 deletions(-)
 create mode 100644 chrome/browser/aegis/aegis_mac_signing_unittest.cc

diff --git a/base/mac/process_requirement.cc b/base/mac/process_requirement.cc
index 188023e09b744c46ceb3c2a05bd9a9cb07f3053b..8caec397ac543778abe506089433d26cf59267e7 100644
--- a/base/mac/process_requirement.cc
+++ b/base/mac/process_requirement.cc
@@ -60,6 +60,13 @@ namespace {
 // Requirements derived from the designated requirements described in TN3127:
 // Inside Code Signing: Requirements
 // (https://developer.apple.com/documentation/technotes/tn3127-inside-code-signing-requirements).
+// GCSA 的固定 Apple Distribution 证书在 macOS 上归为 Enterprise。
+// 仅接受指定证书和 Apple 信任链，不扩大为任意企业签名。
+constexpr std::string_view kGcsaDistributionRequirement =
+    "(anchor apple generic and certificate leaf = "
+    "H\"7C33B517942161311A087CE893D2F1CE9B204B44\" and "
+    "certificate leaf[subject.OU] = \"R3JK7R29AC\")";
+
 constexpr std::string_view kAnyDeveloperIdRequirement =
     "(anchor apple generic and certificate "
     "1[field.1.2.840.113635.100.6.2.6] exists and certificate "
@@ -200,6 +207,8 @@ std::string RequirementStringForValidationCategory(
   CHECK_NE(category, ValidationCategory::None);
 
   switch (category) {
+    case ValidationCategory::Enterprise:
+      return std::string(kGcsaDistributionRequirement);
     case ValidationCategory::DeveloperId:
       return std::string(kAnyDeveloperIdRequirement);
     case ValidationCategory::AppStore:
