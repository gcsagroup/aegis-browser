From cbd8901f367c50fa9c54144b7ed44b07be7bb50d Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Tue, 10 Nov 2026 17:29:04 +0800
Subject: [PATCH] feat(access): publish freshly versioned restored policy and
 capture native common tuple

---
 .../access_published_request_runtime.cc       | 56 +++++++++++++------
 .../access/access_published_request_runtime.h | 15 +++++
 ...cess_published_request_runtime_unittest.cc | 37 ++++++++++++
 3 files changed, 92 insertions(+), 16 deletions(-)

diff --git a/chrome/browser/aegis/access/access_published_request_runtime.cc b/chrome/browser/aegis/access/access_published_request_runtime.cc
index 9a47c1831983419992df3616af979357c218812f..38e561edf9c14b233d5baae01669e809472c1bbd 100644
--- a/chrome/browser/aegis/access/access_published_request_runtime.cc
+++ b/chrome/browser/aegis/access/access_published_request_runtime.cc
@@ -123,27 +123,31 @@ AccessPublishedRequestRuntime::PublishPolicySnapshot(
     return PublicationResult(AccessPolicyPublicationStatus::kInvalidSnapshot);
   }
 
-  AccessNetworkContextTransport* transport =
-      AccessNetworkContextTransport::Get(profile_);
-  if (!transport) {
-    return PublicationResult(AccessPolicyPublicationStatus::kMissingTransport);
-  }
-  if (!transport->OwnsConfiguredPartition(candidate.value->owner)) {
-    return PublicationResult(
-        AccessPolicyPublicationStatus::kOwnershipMismatch);
-  }
+  return PublishRestoredPolicyCandidate({candidate.value->owner,
+      candidate.value->committed_policy_generation, candidate.value->rules});
+}
 
-  aegis_access::PublishedAccessPolicySnapshot snapshot{
-      candidate.value->owner,
-      candidate.value->committed_policy_generation,
-      candidate.value->rules,
-  };
+AccessPolicyPublicationResult
+AccessPublishedRequestRuntime::PublishRestoredPolicyCandidate(
+    const aegis_access::PublishedAccessPolicySnapshot& candidate) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (candidate.policy_generation == 0 ||
+      aegis_access::ValidateAccessPolicySnapshot(candidate) !=
+          aegis_access::PolicyMatchReason::kNone) {
+    return PublicationResult(AccessPolicyPublicationStatus::kInvalidSnapshot);
+  }
+  auto* transport = AccessNetworkContextTransport::Get(profile_);
+  if (!transport)
+    return PublicationResult(AccessPolicyPublicationStatus::kMissingTransport);
+  if (!transport->OwnsConfiguredPartition(candidate.owner))
+    return PublicationResult(AccessPolicyPublicationStatus::kOwnershipMismatch);
+  aegis_access::PublishedAccessPolicySnapshot snapshot = candidate;
   auto it = policy_snapshots_.find(snapshot.owner.storage_partition_token);
   if (it == policy_snapshots_.end()) {
     policy_snapshots_.emplace(snapshot.owner.storage_partition_token,
                               std::move(snapshot));
     return PublicationResult(AccessPolicyPublicationStatus::kPublished,
-                             candidate.value->committed_policy_generation);
+                             candidate.policy_generation);
   }
 
   if (it->second.owner != snapshot.owner) {
@@ -195,6 +199,26 @@ aegis_access::RequestGenerationTupleBuildResult
 AccessPublishedRequestRuntime::CaptureProxyGenerationTupleOnUiThread(
     const aegis_access::OwnershipKey& owner,
     const std::string& proxy_group_id) const {
+  return aegis_access::BuildCompleteRequestGenerationTuple(
+      CaptureGenerationSources(owner, proxy_group_id));
+}
+
+std::optional<aegis_access::GenerationTuple>
+AccessPublishedRequestRuntime::CaptureCommonGenerationTupleOnUiThread(
+    const aegis_access::OwnershipKey& owner) const {
+  const auto input = CaptureGenerationSources(owner, {});
+  if (!aegis_access::IsCompleteOwner(owner) || input.policy_generation == 0 ||
+      input.identity_generation == 0 || input.network_epoch == 0 ||
+      input.base_proxy_config_generation == 0) return std::nullopt;
+  return aegis_access::GenerationTuple{input.policy_generation,
+      input.identity_generation, 0, input.network_epoch,
+      input.base_proxy_config_generation};
+}
+
+aegis_access::RequestGenerationTupleInput
+AccessPublishedRequestRuntime::CaptureGenerationSources(
+    const aegis_access::OwnershipKey& owner,
+    const std::string& proxy_group_id) const {
   DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
   aegis_access::RequestGenerationTupleInput input;
   input.request_owner = owner;
@@ -228,7 +252,7 @@ AccessPublishedRequestRuntime::CaptureProxyGenerationTupleOnUiThread(
         network_service->GetAegisBaseProxyConfigGeneration();
   }
 
-  return aegis_access::BuildCompleteRequestGenerationTuple(input);
+  return input;
 }
 
 }  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_published_request_runtime.h b/chrome/browser/aegis/access/access_published_request_runtime.h
index 48be85326f7401666a4fc34c147e65636d6ec298..741cc8d029c89996fe91f680594ac4c4a8d17fad 100644
--- a/chrome/browser/aegis/access/access_published_request_runtime.h
+++ b/chrome/browser/aegis/access/access_published_request_runtime.h
@@ -66,6 +66,17 @@ class AccessPublishedRequestRuntime : public base::SupportsUserData::Data {
   AccessPolicyPublicationResult PublishPreparedPolicyCandidate(
       const StoredPolicySnapshot& candidate);
 
+  // Accepts committed rule contents with a freshly reserved publication
+  // version. The Store reservation is durable; this only updates Browser
+  // memory and does not imply Network ACK or connection readiness.
+  AccessPolicyPublicationResult PublishRestoredPolicyCandidate(
+      const aegis_access::PublishedAccessPolicySnapshot& candidate);
+
+  // Native decisions use the same live common counters, with selection zero.
+  std::optional<aegis_access::GenerationTuple>
+  CaptureCommonGenerationTupleOnUiThread(
+      const aegis_access::OwnershipKey& owner) const;
+
   // Restores the pre-mutation runtime snapshot only when the currently
   // published value is still the exact PREPARED candidate. This prevents a
   // delayed failure path from overwriting a newer publication.
@@ -91,6 +102,10 @@ class AccessPublishedRequestRuntime : public base::SupportsUserData::Data {
   AccessPolicyPublicationResult PublishPolicySnapshot(
       const StoredPolicySnapshot& stored);
 
+  aegis_access::RequestGenerationTupleInput CaptureGenerationSources(
+      const aegis_access::OwnershipKey& owner,
+      const std::string& proxy_group_id) const;
+
   const raw_ptr<Profile> profile_;
   std::map<std::string, aegis_access::PublishedAccessPolicySnapshot>
       policy_snapshots_;
diff --git a/chrome/browser/aegis/access/access_published_request_runtime_unittest.cc b/chrome/browser/aegis/access/access_published_request_runtime_unittest.cc
index bcb20edc379796a61fdc143d020c7fab313bd5e2..64efba866f86ac952b4f76ea7b87f01e8c6203e1 100644
--- a/chrome/browser/aegis/access/access_published_request_runtime_unittest.cc
+++ b/chrome/browser/aegis/access/access_published_request_runtime_unittest.cc
@@ -43,6 +43,43 @@ class AccessPublishedRequestRuntimeTest : public testing::Test {
   std::optional<aegis_access::OwnershipKey> owner_;
 };
 
+TEST_F(AccessPublishedRequestRuntimeTest, RestorationUsesFreshVersionForCommittedContents) {
+  aegis_access::PublishedAccessPolicySnapshot initial{*owner_, 1, {}};
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate(initial).status,
+            AccessPolicyPublicationStatus::kPublished);
+  aegis_access::AccessPolicyRule rule{"rule", *owner_, aegis_access::PolicyScope::kProfile,
+      {}, "example.test", false, {aegis_access::RequestScheme::kHttps},
+      {aegis_access::PortScope::kAllBrowserPermitted, {}},
+      aegis_access::AccessMode::kProxy, "group",
+      aegis_access::ProtectionOverride::kNone, 1, 2};
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate({*owner_, 2, {rule}}).status,
+            AccessPolicyPublicationStatus::kPublished);
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate(initial).status,
+            AccessPolicyPublicationStatus::kStaleGeneration);
+  initial.policy_generation = 3;
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate(initial).status,
+            AccessPolicyPublicationStatus::kPublished);
+  ASSERT_TRUE(runtime_->GetPublishedPolicySnapshot(*owner_));
+  EXPECT_TRUE(runtime_->GetPublishedPolicySnapshot(*owner_)->rules.empty());
+  EXPECT_EQ(runtime_->GetPublishedPolicySnapshot(*owner_)->policy_generation, 3u);
+}
+TEST_F(AccessPublishedRequestRuntimeTest, RestorationDoesNotBypassOwnerOrPolicyValidation) {
+  auto foreign = *owner_;
+  foreign.profile_token = "foreign";
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate({foreign, 1, {}}).status,
+            AccessPolicyPublicationStatus::kOwnershipMismatch);
+  EXPECT_EQ(runtime_->PublishRestoredPolicyCandidate({*owner_, 0, {}}).status,
+            AccessPolicyPublicationStatus::kInvalidSnapshot);
+  EXPECT_EQ(runtime_->GetPublishedPolicySnapshot(*owner_), nullptr);
+}
+
+TEST_F(AccessPublishedRequestRuntimeTest, NativeCommonTupleDoesNotInventIdentityOrPublication) {
+  EXPECT_FALSE(runtime_->CaptureCommonGenerationTupleOnUiThread(*owner_));
+  ASSERT_EQ(runtime_->PublishRestoredPolicyCandidate({*owner_, 1, {}}).status,
+            AccessPolicyPublicationStatus::kPublished);
+  EXPECT_FALSE(runtime_->CaptureCommonGenerationTupleOnUiThread(*owner_));
+}
+
 TEST_F(AccessPublishedRequestRuntimeTest, PublishesCommittedSnapshotInMemory) {
   const auto published = runtime_->PublishCommittedPolicySnapshot(Snapshot(1));
   EXPECT_EQ(published.status, AccessPolicyPublicationStatus::kPublished);
-- 
