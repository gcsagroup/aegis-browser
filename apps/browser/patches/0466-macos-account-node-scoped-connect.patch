+  EXPECT_NE(b, resolve("https://b.example/"));
+  SetConfig(config({"a.example", "b.example"}, "lease-2"));
+  EXPECT_FALSE(header(a));
+  const auto renewed = resolve("https://a.example/");
+  EXPECT_EQ(header(renewed), "lease-2");
+  SetConfig(config({"a.example", "b.example"}, "lease-2", "https://node2.test"));
+  EXPECT_FALSE(header(renewed));
+  const auto moved = resolve("https://a.example/");
+  EXPECT_EQ(header(moved), "lease-2");
+  SetConfig(config({}));
+  EXPECT_FALSE(header(moved));
+}
