+++ b/chrome/browser/aegis/access/access_account_mac.mm
@@ -149,6 +149,7 @@ @interface AegisAccountTransfer : NSObject <NSURLSessionDataDelegate>
 @property(nonatomic, copy) NSDictionary* binding;
