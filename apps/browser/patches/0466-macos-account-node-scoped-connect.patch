+TEST_F(AccountWebTransportTest, ConfigAckDropsOnlySelectedPendingAndLiveQuicSessions) {
+  base::test::ScopedFeatureList features(features::kLocalNetworkAccessChecksWebTransport);
+  class HeldPermission : public TestURLLoaderNetworkObserver {
+   public:
+    void OnLocalNetworkAccessPermissionRequired(mojom::TransportType,
+        mojom::IPAddressSpace, OnLocalNetworkAccessPermissionRequiredCallback reply) override {
+      pending.SetValue(std::move(reply));
+    }
+    base::test::TestFuture<OnLocalNetworkAccessPermissionRequiredCallback> pending;
+  } permission;
+  GURL active = GetURL("/echo");
+  GURL::Replacements host;
+  host.SetHostStr("other.example.com");
+  GURL other = active.ReplaceComponents(host);
+  host.SetHostStr("test.example.com.");
+  GURL dotted = active.ReplaceComponents(host);
+  auto connect = [&](const GURL& url) {
+    base::test::TestFuture<void> ready;
+    mojo::PendingRemote<mojom::WebTransportHandshakeClient> remote;
+    TestHandshakeClient client(remote.InitWithNewPipeAndPassReceiver(), ready.GetCallback());
+    CreateWebTransport(url, origin(), std::move(remote));
+    EXPECT_TRUE(ready.Wait());
+    EXPECT_TRUE(client.has_seen_connection_establishment());
+    return mojo::Remote<mojom::WebTransport>(client.PassTransport());
+  };
+  auto selected_session = connect(active);
+  auto other_session = connect(other);
+  ASSERT_TRUE(selected_session && other_session);
+  base::test::TestFuture<void> pending_done;
+  mojo::PendingRemote<mojom::WebTransportHandshakeClient> remote;
+  TestHandshakeClient pending(remote.InitWithNewPipeAndPassReceiver(), pending_done.GetCallback());
+  CreateWebTransport(dotted, origin(), net::NetworkAnonymizationKey(), {}, {},
+      std::move(remote), permission.Bind(), ClientSecurityStateBuilder().WithIsSecureContext(true)
+          .WithLocalNetworkAccessRequestPolicy(mojom::LocalNetworkAccessRequestPolicy::kPermissionBlock)
+          .WithIPAddressSpace(mojom::IPAddressSpace::kPublic).Build());
+  auto grant = permission.pending.Take();
+  ASSERT_EQ(3u, network_context().NumOpenWebTransports());
+  InstallAccountBlock();
+  EXPECT_EQ(1u, network_context().NumOpenWebTransports());
+  std::move(grant).Run(mojom::LocalNetworkAccessResult::kGranted);
+  ASSERT_TRUE(pending_done.Wait());
+  EXPECT_FALSE(pending.has_seen_connection_establishment());
+  selected_session.FlushForTesting();
+  EXPECT_FALSE(selected_session.is_connected());
+  base::test::TestFuture<mojom::WebTransportStatsPtr> stats;
+  other_session->GetStats(stats.GetCallback());
+  EXPECT_TRUE(stats.Get());
+  base::test::TestFuture<void> denied;
+  mojo::PendingRemote<mojom::WebTransportHandshakeClient> late;
+  TestHandshakeClient late_client(late.InitWithNewPipeAndPassReceiver(), denied.GetCallback());
+  CreateWebTransport(active, origin(), std::move(late));
+  ASSERT_TRUE(denied.Wait());
+  EXPECT_TRUE(late_client.has_seen_handshake_failure());
+  EXPECT_EQ(1u, network_context().NumOpenWebTransports());
+}
