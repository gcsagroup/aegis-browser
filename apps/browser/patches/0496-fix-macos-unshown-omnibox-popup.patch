 .../omnibox_popup_visibility_browsertest.cc   | 91 +++++++++++++++++++
 components/omnibox/common/omnibox_features.cc |  2 +-
 3 files changed, 96 insertions(+), 1 deletion(-)
 create mode 100644 chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc

diff --git a/chrome/browser/ui/views/omnibox/BUILD.gn b/chrome/browser/ui/views/omnibox/BUILD.gn
index 8fa8ab9a1e05273acbf211a3f4d5eeebdb887a00..9577223e801f034d8177fe7e0c0120aa693c18ad 100644
--- a/chrome/browser/ui/views/omnibox/BUILD.gn
+++ b/chrome/browser/ui/views/omnibox/BUILD.gn
@@ -268,6 +268,10 @@ source_set("browser_tests") {
     "omnibox_suggestion_button_row_browsertest.cc",
   ]
 
+  if (is_mac) {
+    sources += [ "omnibox_popup_visibility_browsertest.cc" ]
+  }
+
   configs += [ "//build/config/compiler:no_exit_time_destructors" ]
 
   deps = [
diff --git a/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc b/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..aee0b252564684e283b94148ad78d3e7c2a0172b
--- /dev/null
+++ b/chrome/browser/ui/views/omnibox/omnibox_popup_visibility_browsertest.cc
@@ -0,0 +1,91 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "base/test/scoped_feature_list.h"
+#include "chrome/browser/ui/omnibox/omnibox_next_features.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "chrome/browser/ui/views/location_bar/location_bar_view.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_popup_aim_presenter.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_popup_presenter.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_popup_view_webui.h"
+#include "chrome/browser/ui/views/omnibox/omnibox_popup_webui_base_content.h"
+#include "chrome/browser/ui/views/toolbar/toolbar_view.h"
+#include "chrome/test/base/in_process_browser_test.h"
+#include "components/omnibox/common/omnibox_features.h"
+#include "content/public/browser/visibility.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/test/browser_test.h"
+#include "content/public/test/browser_test_utils.h"
+
+class OmniboxPopupVisibilityBrowserTest
+    : public InProcessBrowserTest,
+      public testing::WithParamInterface<bool> {
+ public:
+  OmniboxPopupVisibilityBrowserTest() {
+    if (GetParam()) {
+      feature_list_.InitWithFeatures(
+          {omnibox::internal::kWebUIOmniboxPopup,
+           omnibox::internal::kWebUIOmniboxAimPopup,
+           omnibox::kWebUIOmniboxFullPopup},
+          {});
+    } else {
+      feature_list_.InitWithFeatures(
+          {omnibox::internal::kWebUIOmniboxPopup,
+           omnibox::internal::kWebUIOmniboxAimPopup},
+          {omnibox::kWebUIOmniboxFullPopup});
+    }
+  }
+
+ private:
+  base::test::ScopedFeatureList feature_list_;
+};
+
+IN_PROC_BROWSER_TEST_P(OmniboxPopupVisibilityBrowserTest,
+                       UnshownContentsStayHiddenAndPopupCanReopen) {
+  auto* location_bar = BrowserView::GetBrowserViewForBrowser(browser())
+                           ->toolbar()
+                           ->location_bar_view();
+  ASSERT_TRUE(location_bar);
+  auto* popup_view = static_cast<OmniboxPopupViewWebUI*>(
+      location_bar->GetOmniboxPopupView());
+  ASSERT_TRUE(popup_view);
+  auto* regular = popup_view->presenter();
+  auto* aim = location_bar->GetOmniboxPopupAimPresenter();
+  ASSERT_TRUE(regular);
+  ASSERT_TRUE(aim);
+  ASSERT_TRUE(regular->GetWebUIContent());
+  ASSERT_TRUE(aim->GetWebUIContent());
+  auto* regular_contents = regular->GetWebUIContent()->GetWrappedWebContents();
+  auto* aim_contents = aim->GetWebUIContent()->GetWrappedWebContents();
+  ASSERT_TRUE(regular_contents);
+  ASSERT_TRUE(aim_contents);
+  ASSERT_TRUE(content::WaitForLoadStop(regular_contents));
+  ASSERT_TRUE(content::WaitForLoadStop(aim_contents));
+
+  // Attaching a pre-warmed view to the browser must not make its hidden
+  // renderer submit frames that have no visible native popup to present them.
+  EXPECT_EQ(regular->IsShown() ? content::Visibility::VISIBLE
+                             : content::Visibility::HIDDEN,
+            regular_contents->GetVisibility());
+  EXPECT_FALSE(aim->IsShown());
+  EXPECT_EQ(content::Visibility::HIDDEN, aim_contents->GetVisibility());
+
+  regular->Hide();
+  EXPECT_EQ(content::Visibility::HIDDEN, regular_contents->GetVisibility());
+
+  for (int show = 0; show < 2; ++show) {
+    regular->Show();
+    EXPECT_TRUE(regular->IsShown());
+    EXPECT_EQ(content::Visibility::VISIBLE, regular_contents->GetVisibility());
+    EXPECT_EQ(content::Visibility::HIDDEN, aim_contents->GetVisibility());
+
+    regular->Hide();
+    EXPECT_FALSE(regular->IsShown());
+    EXPECT_EQ(content::Visibility::HIDDEN, regular_contents->GetVisibility());
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(AllPopupModes,
+                         OmniboxPopupVisibilityBrowserTest,
+                         testing::Bool());
diff --git a/components/omnibox/common/omnibox_features.cc b/components/omnibox/common/omnibox_features.cc
index 9a23299ac34649da94b1cd80e60b53e99c63d50b..b68d781557da682442733ad546f87fde112f5f17 100644
--- a/components/omnibox/common/omnibox_features.cc
+++ b/components/omnibox/common/omnibox_features.cc
@@ -281,7 +281,7 @@ BASE_FEATURE(kOmniboxFullWebUISizeWebViewToPreferredHeight, DISABLED);
 // When enabled, the Omnibox WebUI popup presenter will explicitly hide the
 // widget upon creation, preventing pre-warmed child widgets from inheriting
 // parent window visibility and locking compositor frames.
-BASE_FEATURE(kOmniboxWebUIPopupHideOnCreation, DISABLED);
+BASE_FEATURE(kOmniboxWebUIPopupHideOnCreation, enable_if(BUILDFLAG(IS_MAC)));
 
 // When enabled, a WebUI omnibox popup destroys its widget when it is hidden
 // and builds a fresh one on the next show, so the new native window has no
