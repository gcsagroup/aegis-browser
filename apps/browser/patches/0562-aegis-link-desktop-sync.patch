diff --git a/chrome/browser/resources/aegis_link/portal.js b/chrome/browser/resources/aegis_link/portal.js
new file mode 100644
index 0000000000000000000000000000000000000000..1b5b232fbd3c0fd038e92ae29cdc0e5dd94c11dc
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/portal.js
@@ -0,0 +1,59 @@
+// API 请求在用户授权的门户标签页的隔离脚本环境内执行。扩展不申请 Cookie 权限，
+// 不接收会话 Cookie 或 CSRF，账号、站点和具体 API 均在请求发出前核对。
+export async function portalRequest(
+  tabId,
+  origin,
+  collection,
+  accountId = "",
+  update = null,
+) {
+  const [reply] = await globalThis.chrome.scripting.executeScript({
+    target: { tabId },
+    world: "ISOLATED",
+    args: [origin, collection, accountId, update],
+    func: async (trustedOrigin, kind, expectedUser, change) => {
+      if (location.origin !== trustedOrigin || window.top !== window)
+        return { error: "origin" };
+      const options = {
+        credentials: "same-origin",
+        cache: "no-store",
+        redirect: "error",
+      };
+      const session = await fetch("/api/v1/auth/session", options);
+      if (!session.ok) return { error: session.status === 401 ? "signin" : "network" };
+      const { data } = await session.json();
+      const user = data?.principal;
+      if (user?.kind !== "user" || !user.id || (expectedUser && user.id !== expectedUser))
+        return { error: "account" };
+      if (kind === null) return { id: user.id, email: user.email };
+      if (!["bookmarks", "preferences"].includes(kind)) return { error: "invalid" };
+      const result = await fetch(
+        "/api/v1/me/browser-sync/" + kind,
+        change
+          ? {
+              ...options,
+              method: "PUT",
+              headers: {
+                "Content-Type": "application/json",
+                "X-CSRF-Token": data.csrf_token,
+              },
+              body: JSON.stringify(change),
+            }
+          : options,
+      );
+      if (!result.ok)
+        return {
+          error:
+            result.status === 409
+              ? "conflict"
+              : result.status === 401
+                ? "signin"
+                : "network",
+        };
+      return (await result.json()).data;
+    },
+  });
+  if (!reply?.result || reply.result.error)
+    throw new Error(reply?.result?.error || "network");
+  return reply.result;
+}
diff --git a/chrome/browser/resources/aegis_link/profile.js b/chrome/browser/resources/aegis_link/profile.js
new file mode 100644
index 0000000000000000000000000000000000000000..b1a52cc1665cf2be7fc07f87f3b4c4f094206d2e
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/profile.js
@@ -0,0 +1,161 @@
+// 仅同步本账号专属书签文件夹与 Chromium 的两项字号设置。文件夹引用按门户和账号分开持久化。
+// 还原书签先构建临时树，确认旧树未被同时编辑后再切换引用，写入失败时旧内容仍然可用。
+export function validateTree(items, level = 0, budget = { left: 10000 }) {
+  if (!Array.isArray(items) || level > 40) throw new Error("invalid");
+  return items.map((item) => {
+    if (
+      --budget.left < 0 ||
+      !item ||
+      typeof item.title !== "string" ||
+      item.title.length > 8192
+    )
+      throw new Error("invalid");
+    if (Array.isArray(item.children) && item.url === undefined) {
+      return {
+        title: item.title,
+        children: validateTree(item.children, level + 1, budget),
+      };
+    }
+    if (
+      typeof item.url !== "string" ||
+      item.url.length > 32768 ||
+      item.children !== undefined
+    )
+      throw new Error("invalid");
+    const url = new URL(item.url);
+    if (!["https:", "http:"].includes(url.protocol) || url.username || url.password)
+      throw new Error("url");
+    return { title: item.title, url: item.url };
+  });
+}
+
+export function validatePreferences(value) {
+  if (
+    ![value?.defaultSize, value?.minimumSize].every(
+      (n) => Number.isInteger(n) && n >= 0 && n <= 100,
+    ) ||
+    value.defaultSize < 1
+  )
+    throw new Error("invalid");
+  return { defaultSize: value.defaultSize, minimumSize: value.minimumSize };
+}
+
+async function subtree(id) {
+  const [folder] = await globalThis.chrome.bookmarks.getSubTree(id);
+  if (!folder || !Array.isArray(folder.children)) throw new Error("folder");
+  return validateTree(folder.children);
+}
+
+async function folder(name, key) {
+  const id = Object.values(await globalThis.chrome.storage.local.get(key))[0];
+  if (id) {
+    const existing = await globalThis.chrome.bookmarks.get(id).catch(() => []);
+    if (existing[0] && !existing[0].url) return existing[0];
+  }
+  const [tree] = await globalThis.chrome.bookmarks.getTree();
+  const parent =
+    tree.children.find((n) => n.folderType === "bookmarks-bar") ||
+    tree.children.find((n) => !n.unmodifiable);
+  if (!parent) throw new Error("folder");
+  const created = await globalThis.chrome.bookmarks.create({
+    parentId: parent.id,
+    title: name,
+  });
+  await globalThis.chrome.storage.local.set({ [key]: created.id });
+  return created;
+}
+
+async function fill(parentId, items) {
+  try {
+    for (const item of items) {
+      const node = await globalThis.chrome.bookmarks.create({
+        parentId,
+        title: item.title,
+        ...(item.url ? { url: item.url } : {}),
+      });
+      if (item.children) await fill(node.id, item.children);
+    }
+  } catch (error) {
+    // 写入失败时由上层移除暂存树，同时向用户报告本地书签错误。
+    throw new Error("folder", { cause: error });
+  }
+}
+
+/** 获取本账号同步范围的一致性比较值，普通书签栏及其他门户账号的目录不参与。 */
+export async function profileStore(collection, binding, email) {
+  if (collection === "preferences") {
+    return {
+      async read() {
+        const [a, b] = await Promise.all([
+          globalThis.chrome.fontSettings.getDefaultFontSize({}),
+          globalThis.chrome.fontSettings.getMinimumFontSize({}),
+        ]);
+        return validatePreferences({
+          defaultSize: a.pixelSize,
+          minimumSize: b.pixelSize,
+        });
+      },
+      async apply(data, before) {
+        const next = validatePreferences(data);
+        const current = await this.read();
+        if (
+          current.defaultSize !== before.defaultSize ||
+          current.minimumSize !== before.minimumSize
+        )
+          throw new Error("conflict");
+        // 两个 Chromium 设置没有事务；次项写入失败时还原本次修改的首项。
+        await globalThis.chrome.fontSettings.setDefaultFontSize({
+          pixelSize: next.defaultSize,
+        });
+        try {
+          await globalThis.chrome.fontSettings.setMinimumFontSize({
+            pixelSize: next.minimumSize,
+          });
+          const actual = await this.read();
+          if (
+            actual.defaultSize !== next.defaultSize ||
+            actual.minimumSize !== next.minimumSize
+          )
+            throw new Error("settings");
+        } catch (error) {
+          await globalThis.chrome.fontSettings.setDefaultFontSize({
+            pixelSize: before.defaultSize,
+          });
+          await globalThis.chrome.fontSettings.setMinimumFontSize({
+            pixelSize: before.minimumSize,
+          });
+          throw new Error("settings", { cause: error });
+        }
+      },
+    };
+  }
+  const key = "folder:" + binding;
+  const name = "Aegis Link · " + email;
+  const original = await folder(name, key);
+  return {
+    read: () => subtree(original.id),
+    async apply(data, before, keepCopy) {
+      const items = validateTree(data);
+      const staged = await globalThis.chrome.bookmarks.create({
+        parentId: original.parentId,
+        title: name + " (…)",
+      });
+      let installed = false;
+      try {
+        await fill(staged.id, items);
+        if (JSON.stringify(await subtree(original.id)) !== JSON.stringify(before))
+          throw new Error("conflict");
+        await globalThis.chrome.bookmarks.update(staged.id, { title: name });
+        await globalThis.chrome.storage.local.set({ [key]: staged.id });
+        installed = true;
+        if (keepCopy)
+          await globalThis.chrome.bookmarks.update(original.id, {
+            title: name + " · " + new Date().toISOString(),
+          });
+        else await globalThis.chrome.bookmarks.removeTree(original.id);
+      } finally {
+        if (!installed) await globalThis.chrome.bookmarks.removeTree(staged.id);
+      }
+    },
+  };
+}
diff --git a/chrome/browser/resources/aegis_link/sync.js b/chrome/browser/resources/aegis_link/sync.js
new file mode 100644
index 0000000000000000000000000000000000000000..23daa39e9a434ba376df9b26da3679c01242e211
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/sync.js
@@ -0,0 +1,49 @@
+// 同步状态按设备、站点、用户和集合隔离。服务端版本与本地摘要共同识别并发修改。
+import { fingerprint, seal, unseal } from "./codec.js";
+import { profileStore } from "./profile.js";
+import { portalRequest } from "./portal.js";
+
+/** 首次双端均有资料或离线修改冲突时，交由本人明确选择。对旧版本的上传由服务端拒绝。 */
+export async function synchronize(tabId, origin, user, kind, password, choose) {
+  const binding = JSON.stringify(["aegis-link-v1", origin, user.id, kind]);
+  return navigator.locks.request(binding, async () => {
+    const store = await profileStore(kind, binding, user.email);
+    const current = await store.read(),
+      local = await fingerprint(current);
+    const key = "revision:" + binding,
+      previous = Object.values(await globalThis.chrome.storage.local.get(key))[0];
+    const remote = await portalRequest(tabId, origin, kind, user.id);
+    let version = remote.version,
+      digest = local;
+    let action = "upload";
+    if (version !== "0") {
+      // 即使只是上传，也用用户输入的口令解开现有资料，避免输错口令后重加密覆盖云端。
+      const cloud = await unseal(remote.envelope, password, binding);
+      const cloudHash = await fingerprint(cloud);
+      if (cloudHash === local) action = "same";
+      else if (previous?.version === version) action = "upload";
+      else if (
+        previous?.digest === local ||
+        (!previous && kind === "bookmarks" && !current.length)
+      )
+        action = "download";
+      else action = await choose(kind);
+      if (action === "download" || action === "restore") {
+        if ((await fingerprint(await store.read())) !== local)
+          throw new Error("conflict");
+        await store.apply(cloud, current, action === "restore");
+        digest = cloudHash;
+      }
+    }
+    if (action === "upload") {
+      const envelope = await seal(current, password, binding);
+      const saved = await portalRequest(tabId, origin, kind, user.id, {
+        expected_version: version,
+        envelope,
+      });
+      version = saved.version;
+    }
+    await globalThis.chrome.storage.local.set({ [key]: { version, digest } });
+    return action;
+  });
+}
