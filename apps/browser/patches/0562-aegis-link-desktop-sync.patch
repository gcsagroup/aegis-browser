+<!doctype html>
+<!-- 浏览器内置登录页。访客先选择登录或继续浏览，同步操作只在门户确认会话后出现。 -->
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Aegis Browser</title>
+    <link rel="stylesheet" href="account.css" />
+    <script type="module" src="account.js"></script>
+  </head>
+  <body>
+    <main aria-labelledby="heading">
+      <img class="brand" src="product_logo.svg" alt="" width="72" height="72" />
+      <h1 id="heading">Aegis Browser</h1>
+      <p id="identity" hidden></p>
+      <section id="welcome" hidden>
+        <div class="benefits">
+          <article>
+            <span aria-hidden="true">▤</span>
+            <h2 data-copy="bookmarks"></h2>
+            <p data-copy="bookmarkHint"></p>
+          </article>
+          <article>
+            <span aria-hidden="true">Aa</span>
+            <h2 data-copy="fonts"></h2>
+            <p data-copy="fontHint"></p>
+          </article>
+          <article>
+            <span aria-hidden="true">◇</span>
+            <h2 data-copy="privacy"></h2>
+            <p data-copy="privacyHint"></p>
+          </article>
+        </div>
+        <div class="actions">
+          <button id="login" data-copy="signIn"></button
+          ><button class="secondary" id="skip" data-copy="skip"></button>
+        </div>
+      </section>
+      <form id="sync" hidden>
+        <fieldset>
+          <legend data-copy="choose"></legend>
+          <label
+            ><input id="bookmarks" type="checkbox" checked /><span
+              data-copy="bookmarks"
+            ></span></label
+          ><label
+            ><input id="preferences" type="checkbox" /><span data-copy="fonts"></span
+          ></label>
+        </fieldset>
+        <label class="pass" for="pass" data-copy="pass"></label
+        ><input
+          id="pass"
+          type="password"
+          minlength="12"
+          required
+          autocomplete="off"
+          aria-describedby="passHint"
+        /><small id="passHint" data-copy="passHint"></small>
+        <div class="actions">
+          <button id="run" data-copy="sync"></button
+          ><button
+            class="secondary"
+            type="button"
+            id="logout"
+            data-copy="logout"
+          ></button>
+        </div>
+      </form>
+      <p role="status" id="status"></p>
+      <button class="secondary" id="retry" data-copy="retry" hidden></button>
+    </main>
+    <dialog id="decision">
+      <h2 data-copy="conflictTitle"></h2>
+      <p id="subject"></p>
+      <form method="dialog" class="actions">
+        <button value="upload" data-copy="local"></button
+        ><button value="restore" class="secondary" data-copy="cloud"></button
+        ><button value="cancel" class="secondary" data-copy="cancel"></button>
+      </form>
+    </dialog>
+  </body>
+</html>
diff --git a/chrome/browser/resources/aegis/account.js b/chrome/browser/resources/aegis/account.js
new file mode 100644
index 0000000000000000000000000000000000000000..d48b7da938262a558b129fd8badf622ea82a8fb9
--- /dev/null
+++ b/chrome/browser/resources/aegis/account.js
@@ -0,0 +1,151 @@
+// WebUI 只调用本机编译的账号消息；门户地址、Cookie 和 CSRF 均由浏览器进程处理。
+import { sendWithPromise } from "chrome://resources/js/cr.js";
+import { synchronize } from "./account_sync.js";
+const zh = navigator.language.startsWith("zh");
+const words = {
+  heading: ["Sign in to Aegis Browser", "登录 Aegis Browser"],
+  signed: ["Your Aegis Browser", "你的 Aegis Browser"],
+  bookmarks: ["Bookmarks", "书签"],
+  bookmarkHint: [
+    "Take your Aegis Link folder to another device.",
+    "在其他设备上打开同一份 Aegis Link 书签。",
+  ],
+  fonts: ["Font sizes", "阅读字号"],
+  fontHint: [
+    "Use your preferred font sizes across devices.",
+    "在不同设备上使用习惯的字号。",
+  ],
+  privacy: ["Encrypted sync", "加密同步"],
+  privacyHint: [
+    "Only your sync passphrase unlocks your data.",
+    "只有持有同步口令才能解开资料。",
+  ],
+  signIn: ["Sign in", "登录"],
+  skip: ["Continue without signing in", "保持未登录状态"],
+  logout: ["Sign out", "退出账号"],
+  choose: ["Sync on this device", "在此设备同步"],
+  pass: ["Sync passphrase", "同步口令"],
+  passHint: [
+    "Use the same passphrase of 12 or more characters on both devices.",
+    "请在两台设备使用相同的同步口令，至少 12 个字符。",
+  ],
+  sync: ["Sync now", "立即同步"],
+  done: ["Synced", "已同步"],
+  retry: ["Retry", "重试"],
+  conflictTitle: ["Both copies have changes", "两台设备的资料都发生了变化"],
+  local: ["Use this device", "使用本机副本"],
+  cloud: ["Use cloud copy", "使用云端副本"],
+  cancel: ["Cancel", "取消"],
+  network: ["Cannot reach the account service. Try again.", "无法连接账号服务，请重试。"],
+  unlock: ["Incorrect sync passphrase.", "同步口令无法解开云端副本。"],
+  conflict: ["Data changed. Sync again to compare.", "资料已变更，请重新同步。"],
+  account: ["Your account changed. Sign in again.", "账号已变更，请重新登录。"],
+  invalid: ["Unsupported data in this collection.", "资料格式不受支持。"],
+  limit: ["This collection is too large.", "同步资料超出上限。"],
+  folder: ["Bookmarks are unavailable. Try again.", "书签暂不可用，请重试。"],
+  settings: ["Your administrator manages these font settings.", "这些字号由管理员管理。"],
+  none: ["Select what to sync.", "请选择同步内容。"],
+  working: ["Syncing…", "正在同步…"],
+};
+const tr = (key) => (words[key] || words.network)[zh ? 1 : 0];
+const el = (id) => document.getElementById(id);
+const call = (action, input = {}) => sendWithPromise("aegisLinkAccount", action, input);
+const welcomeWindow = await call("isWelcomeWindow");
+let user,
+  busy = false;
+document.documentElement.lang = zh ? "zh-CN" : "en";
+document
+  .querySelectorAll("[data-copy]")
+  .forEach((node) => (node.textContent = tr(node.dataset.copy)));
+function show(account) {
+  if (user?.id !== account?.id) el("pass").value = "";
+  user = account;
+  el("heading").textContent = tr(welcomeWindow ? "heading" : "signed");
+  document.querySelector(".benefits").hidden = !welcomeWindow;
+  el("skip").hidden = !welcomeWindow;
+  el("identity").hidden = !user;
+  el("identity").textContent = user?.email || "";
+  el("sync").hidden = !user;
+  el("welcome").hidden = !!user;
+}
+async function refresh() {
+  if (busy) return;
+  busy = true;
+  el("retry").hidden = true;
+  try {
+    show(await call("session"));
+    el("status").textContent = "";
+  } catch (error) {
+    if (error === "signin" && location.hash === "#signin") {
+      await call("login");
+      return;
+    }
+    show(null);
+    el("status").textContent = error === "signin" ? "" : tr(error);
+    el("retry").hidden = error === "signin";
+  } finally {
+    busy = false;
+  }
+}
+el("login").onclick = () => call("login");
+el("skip").onclick = () => call("skip");
+el("retry").onclick = refresh;
+el("logout").onclick = async () => {
+  if (busy) return;
+  try {
+    await call("logout");
+    show(null);
+    el("status").textContent = "";
+  } catch (error) {
+    el("status").textContent = tr(error);
+  }
+};
+async function choose(kind) {
+  const dialog = el("decision");
+  el("subject").textContent = tr(kind === "preferences" ? "fonts" : "bookmarks");
+  dialog.returnValue = "cancel";
+  const closed = new Promise((resolve) =>
+    dialog.addEventListener("close", () => resolve(dialog.returnValue), { once: true }),
+  );
+  dialog.showModal();
+  const value = await closed;
+  if (!["restore", "upload"].includes(value)) throw new Error("cancelled");
+  return value;
+}
+el("sync").onsubmit = async (event) => {
+  event.preventDefault();
+  if (busy || !user) return;
+  const selected = ["bookmarks", "preferences"].filter((k) => el(k).checked);
+  if (!selected.length) {
+    el("status").textContent = tr("none");
+    return;
+  }
+  busy = true;
+  el("run").disabled = true;
+  el("logout").disabled = true;
+  try {
+    const current = await call("session");
+    if (current.id !== user.id) {
+      show(current);
+      throw new Error("account");
+    }
+    el("status").textContent = tr("working");
+    for (const kind of selected)
+      await synchronize(call, current, kind, el("pass").value, choose);
+    el("status").textContent = tr("done");
+  } catch (error) {
+    const key = error?.message || error;
+    if (key === "signin") show(null);
+    el("status").textContent = key === "cancelled" ? "" : tr(key);
+  } finally {
+    el("pass").value = "";
+    busy = false;
+    el("run").disabled = false;
+    el("logout").disabled = false;
+  }
+};
+document.addEventListener("visibilitychange", () => {
+  if (!document.hidden && !el("decision").open) void refresh();
+});
+show(null);
+void refresh();
diff --git a/chrome/browser/resources/aegis/account_crypto.js b/chrome/browser/resources/aegis/account_crypto.js
new file mode 100644
index 0000000000000000000000000000000000000000..9a38cf291eddd8d7194a2188436be38f498d14d7
--- /dev/null
+++ b/chrome/browser/resources/aegis/account_crypto.js
@@ -0,0 +1,86 @@
+// 同步协议 v1：PBKDF2-SHA256 与 AES-GCM，盐和随机 nonce 随密文发送。
+// 附加认证数据绑定门户、用户和集合，跨账号复制密文不能还原为有效的本地资料。
+const encoder = new TextEncoder();
+const decoder = new TextDecoder("utf-8", { fatal: true });
+export const maxEnvelope = 2 * 1024 * 1024;
+
+function toBase64(bytes) {
+  let binary = "";
+  for (let i = 0; i < bytes.length; i += 8192) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + 8192));
+  }
+  return btoa(binary);
+}
+
+async function keyFor(password, salt) {
+  const input = await crypto.subtle.importKey(
+    "raw",
+    encoder.encode(password),
+    "PBKDF2",
+    false,
+    ["deriveKey"],
+  );
+  return crypto.subtle.deriveKey(
+    { name: "PBKDF2", salt, iterations: 600000, hash: "SHA-256" },
+    input,
+    { name: "AES-GCM", length: 256 },
+    false,
+    ["encrypt", "decrypt"],
+  );
+}
+
+/** 将已验证的同步资料封装为门户可保存的标准 Base64。 */
+export async function seal(data, password, binding) {
+  const plain = encoder.encode(JSON.stringify(data));
+  if (plain.length + 45 > maxEnvelope) throw new Error("limit");
+  const out = new Uint8Array(45 + plain.length);
+  out[0] = 1;
+  const salt = crypto.getRandomValues(out.subarray(1, 17));
+  const iv = crypto.getRandomValues(out.subarray(17, 29));
+  const key = await keyFor(password, salt);
+  out.set(
+    new Uint8Array(
+      await crypto.subtle.encrypt(
+        { name: "AES-GCM", iv, additionalData: encoder.encode(binding) },
+        key,
+        plain,
+      ),
+    ),
+    29,
+  );
+  return toBase64(out);
+}
+
+/** 在任何本地写入前验证信封版本、大小与认证标签。 */
+export async function unseal(encoded, password, binding) {
+  if (typeof encoded !== "string" || encoded.length > 4 * Math.ceil(maxEnvelope / 3))
+    throw new Error("limit");
+  const bytes = Uint8Array.from(atob(encoded), (c) => c.charCodeAt(0));
+  if (bytes.length < 46 || bytes.length > maxEnvelope || bytes[0] !== 1)
+    throw new Error("invalid");
+  const key = await keyFor(password, bytes.subarray(1, 17));
+  let plaintext;
+  try {
+    plaintext = await crypto.subtle.decrypt(
+      {
+        name: "AES-GCM",
+        iv: bytes.subarray(17, 29),
+        additionalData: encoder.encode(binding),
+      },
+      key,
+      bytes.subarray(29),
+    );
+  } catch {
+    throw new Error("unlock");
+  }
+  return JSON.parse(decoder.decode(plaintext));
+}
+
+/** 比较本地内容，无变更时不重写密文，双方均有修改时由用户选择保留哪一份。 */
+export async function fingerprint(data) {
+  return toBase64(
+    new Uint8Array(
+      await crypto.subtle.digest("SHA-256", encoder.encode(JSON.stringify(data))),
+    ),
+  );
+}
diff --git a/chrome/browser/resources/aegis/account_sync.js b/chrome/browser/resources/aegis/account_sync.js
new file mode 100644
index 0000000000000000000000000000000000000000..243ebfa0b00034c893b943e319decfcd1e41938f
--- /dev/null
+++ b/chrome/browser/resources/aegis/account_sync.js
@@ -0,0 +1,55 @@
+// 同步状态按设备、站点、用户和集合隔离。服务端版本与本地摘要共同识别并发修改。
+import { fingerprint, seal, unseal } from "./account_crypto.js";
+
+/** 首次双端均有资料或离线修改冲突时，交由本人明确选择。对旧版本的上传由服务端拒绝。 */
+export async function synchronize(call, user, kind, password, choose) {
+  const binding = JSON.stringify(["aegis-link-v1", user.origin, user.id, kind]);
+  return navigator.locks.request(binding, async () => {
+    const input = { account: user.id, collection: kind };
+    const readLocal = () => call("profile", input);
+    const current = await readLocal(),
+      local = await fingerprint(current);
+    const key = "revision:" + binding,
+      previous = JSON.parse(localStorage.getItem(key) || "null");
+    const remote = await call("read", input);
+    let version = remote.version,
+      digest = local;
+    let action = "upload";
+    if (version !== "0") {
+      // 即使只是上传，也用用户输入的口令解开现有资料，避免输错口令后重加密覆盖云端。
+      const cloud = await unseal(remote.envelope, password, binding);
+      const cloudHash = await fingerprint(cloud);
+      if (cloudHash === local) action = "same";
+      else if (previous?.version === version) action = "upload";
+      else if (
+        previous?.digest === local ||
+        (!previous && kind === "bookmarks" && !current.length)
+      )
+        action = "download";
+      else action = await choose(kind);
+      if (action === "download" || action === "restore") {
+        if ((await fingerprint(await readLocal())) !== local) throw new Error("conflict");
+        await call("profile", {
+          ...input,
+          value: cloud,
+          before: current,
+          backup: action === "restore",
+        });
+        digest = cloudHash;
+      }
+    }
+    if (action === "upload") {
+      const envelope = await seal(current, password, binding);
+      const saved = await call("write", {
+        ...input,
+        change: {
+          expected_version: version,
+          envelope,
+        },
+      });
+      version = saved.version;
+    }
+    localStorage.setItem(key, JSON.stringify({ version, digest }));
+    return action;
+  });
+}
