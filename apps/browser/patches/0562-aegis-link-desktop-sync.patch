diff --git a/chrome/browser/resources/aegis_link/account.css b/chrome/browser/resources/aegis_link/account.css
new file mode 100644
index 0000000000000000000000000000000000000000..eebddb028e1b70903309c00b8011d18a16cbc1fd
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/account.css
@@ -0,0 +1,75 @@
+/* 使用浏览器系统色，账号操作在浅色、暗色和强制颜色模式下保持可读。 */
+:root {
+  color-scheme: light dark;
+  font:
+    16px/1.55 system-ui,
+    sans-serif;
+  color: CanvasText;
+  background: Canvas;
+}
+* {
+  box-sizing: border-box;
+}
+main {
+  max-width: 34rem;
+  margin: clamp(2rem, 8vh, 6rem) auto;
+  padding: 0 1.25rem;
+}
+h1 {
+  font-size: 2rem;
+  margin: 0 0 1.25rem;
+}
+h2 {
+  font-size: 1.2rem;
+  margin: 1.8rem 0 1rem;
+}
+form,
+fieldset {
+  display: grid;
+  gap: 0.65rem;
+}
+fieldset {
+  margin: 0 0 0.6rem;
+  border: 0;
+  padding: 0;
+}
+legend {
+  margin-bottom: 0.45rem;
+}
+label:has(input) {
+  display: flex;
+  gap: 0.5rem;
+  align-items: center;
+}
+input:not([type="checkbox"]) {
+  width: 100%;
+  font: inherit;
+  border: 1px solid GrayText;
+  border-radius: 0.4rem;
+  padding: 0.5rem 0.7rem;
+}
+button {
+  justify-self: start;
+  font: inherit;
+  cursor: pointer;
+  padding: 0.45rem 0.85rem;
+  border-radius: 0.4rem;
+  border: 1px solid GrayText;
+}
+#run {
+  background: Highlight;
+  color: HighlightText;
+  border-color: Highlight;
+}
+small {
+  color: GrayText;
+}
+dialog {
+  max-width: min(30rem, 90vw);
+  padding: 1.4rem;
+  border: 1px solid GrayText;
+  border-radius: 0.6rem;
+}
+dialog h2 {
+  margin: 0;
+}
diff --git a/chrome/browser/resources/aegis_link/account.html b/chrome/browser/resources/aegis_link/account.html
new file mode 100644
index 0000000000000000000000000000000000000000..614ad92c3458977b7ac28c8931a32c3fe97de4fa
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/account.html
@@ -0,0 +1,65 @@
+<!doctype html>
+<!-- 浏览器内部的同步操作页。同步口令仅在本页内存中使用。 -->
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <title>Aegis Link</title>
+    <link rel="stylesheet" href="account.css" />
+  </head>
+  <body>
+    <main>
+      <h1>Aegis Link</h1>
+      <form id="connection">
+        <label for="site" data-text="site">Portal address</label>
+        <input type="url" id="site" required placeholder="https://" autocomplete="url" />
+        <button data-text="login">Open portal to sign in</button>
+      </form>
+      <section>
+        <h2 data-text="sync">Sync</h2>
+        <form id="sync">
+          <fieldset>
+            <legend data-text="what">Data to sync</legend>
+            <label
+              ><input type="checkbox" id="bookmarks" checked /><span data-text="bookmarks"
+                >Aegis Link bookmark folder</span
+              ></label
+            >
+            <label
+              ><input type="checkbox" id="preferences" /><span data-text="preferences"
+                >Default and minimum font sizes</span
+              ></label
+            >
+          </fieldset>
+          <label for="pass" data-text="pass">Sync passphrase</label>
+          <input
+            id="pass"
+            type="password"
+            minlength="12"
+            required
+            autocomplete="off"
+            aria-describedby="hint"
+          />
+          <small id="hint" data-text="hint"
+            >Use the same passphrase on each device. It cannot be recovered by the
+            portal.</small
+          >
+          <button id="run" data-text="now">Sync now</button>
+        </form>
+      </section>
+      <p role="status" aria-live="polite" id="status"></p>
+      <dialog id="decision">
+        <form method="dialog">
+          <h2 id="subject"></h2>
+          <p data-text="changed">
+            Both this profile and the cloud have data. Choose which copy to keep.
+          </p>
+          <button value="cancel" data-text="cancel">Cancel</button>
+          <button value="restore" data-text="cloud">Use cloud copy</button>
+          <button value="upload" data-text="local">Use this device</button>
+        </form>
+      </dialog>
+    </main>
+    <script type="module" src="account.js"></script>
+  </body>
+</html>
diff --git a/chrome/browser/resources/aegis_link/account.js b/chrome/browser/resources/aegis_link/account.js
new file mode 100644
index 0000000000000000000000000000000000000000..217ed0255b22c2eb5093fcdf4075d119af6cb802
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/account.js
@@ -0,0 +1,142 @@
+// 普通浏览器配置文件才提供同步；账号沿用门户自己的登录流程。站点权限仅在用户选择该站时申请。
+import { portalOrigin } from "./codec.js";
+import { portalRequest } from "./portal.js";
+import { synchronize } from "./sync.js";
+
+const labels = {
+  site: ["Portal address", "门户地址"],
+  login: ["Open portal to sign in", "打开门户登录"],
+  sync: ["Sync", "同步"],
+  what: ["Data to sync", "同步内容"],
+  bookmarks: ["Aegis Link bookmark folder", "Aegis Link 书签文件夹"],
+  preferences: ["Default and minimum font sizes", "默认字号和最小字号"],
+  pass: ["Sync passphrase", "同步口令"],
+  hint: [
+    "Use the same passphrase (12 characters or more) on each device. The portal cannot recover it.",
+    "每台设备使用相同的同步口令，至少 12 个字符。门户无法找回此口令。",
+  ],
+  now: ["Sync now", "立即同步"],
+  cancel: ["Cancel", "取消"],
+  cloud: ["Use cloud copy", "使用云端副本"],
+  local: ["Use this device", "使用本机副本"],
+  changed: [
+    "Both copies have data. Choose which copy to keep.",
+    "本机和云端均有数据，请选择要保留的副本。",
+  ],
+  opened: [
+    "Sign in on the portal tab, then return here.",
+    "请在门户标签页登录后回到这里。",
+  ],
+  done: ["Synced", "已同步"],
+  running: ["Syncing…", "正在同步…"],
+  signin: ["Open the portal and sign in first.", "请先打开门户并登录。"],
+  network: [
+    "Cannot reach the portal. Check its address and try again.",
+    "无法访问门户，请检查地址后重试。",
+  ],
+  origin: [
+    "Use an HTTPS portal address, or a local development address.",
+    "请输入 HTTPS 门户地址或本机开发地址。",
+  ],
+  account: ["The signed-in account changed. Try again.", "当前登录账号已变更，请重试。"],
+  unlock: [
+    "The passphrase could not unlock this cloud copy.",
+    "同步口令无法解开这份云端副本。",
+  ],
+  conflict: [
+    "Data changed during sync. Try again to compare the latest copies.",
+    "同步期间数据已变化，请重试以比较最新副本。",
+  ],
+  limit: ["This collection exceeds the 2 MiB limit.", "此集合超过 2 MiB 限制。"],
+  invalid: ["The sync data format is invalid.", "同步资料格式无效。"],
+  folder: ["Bookmark folder unavailable.", "无法访问书签文件夹。"],
+  url: [
+    "Only HTTP and HTTPS bookmarks without embedded credentials are supported.",
+    "仅支持未嵌入凭据的 HTTP 和 HTTPS 书签。",
+  ],
+  choose: ["Select data to sync.", "请选择同步内容。"],
+  denied: ["Portal access was not granted.", "未获得该门户的访问权限。"],
+  settings: [
+    "These font settings could not be changed. Check your browser policies.",
+    "无法更改字号，请检查浏览器管理策略。",
+  ],
+  cancelled: ["Sync cancelled.", "本次同步已取消。"],
+};
+const language = navigator.language.startsWith("zh") ? 1 : 0;
+const messages = new Map(Object.entries(labels));
+const text = (key) => {
+  const [english, chinese] = messages.get(key) ?? labels.network;
+  return language ? chinese : english;
+};
+const el = (id) => document.getElementById(id);
+const status = (value) => {
+  el("status").textContent = value;
+};
+document.documentElement.lang = language ? "zh-CN" : "en";
+document.querySelectorAll("[data-text]").forEach((node) => {
+  node.textContent = text(node.dataset.text);
+});
+const saved = await globalThis.chrome.storage.local.get(["portal", "kinds"]);
+el("site").value = saved.portal || "";
+if (saved.kinds)
+  for (const kind of ["bookmarks", "preferences"])
+    el(kind).checked = saved.kinds.includes(kind);
+
+function originAndPermission() {
+  const origin = portalOrigin(el("site").value.trim());
+  const permission = { origins: [origin + "/*"] };
+  return { origin, permission };
+}
+el("connection").onsubmit = async (e) => {
+  e.preventDefault();
+  try {
+    const { origin, permission } = originAndPermission();
+    if (!(await globalThis.chrome.permissions.request(permission)))
+      throw new Error("denied");
+    await globalThis.chrome.storage.local.set({ portal: origin });
+    await globalThis.chrome.tabs.create({ url: origin + "/account" });
+    status(text("opened"));
+  } catch (err) {
+    status(text(err.message));
+  }
+};
+async function choose(kind) {
+  const dialog = el("decision");
+  el("subject").textContent = text(kind);
+  dialog.returnValue = "cancel";
+  const choice = new Promise((resolve) =>
+    dialog.addEventListener("close", () => resolve(dialog.returnValue), { once: true }),
+  );
+  dialog.showModal();
+  const answer = await choice;
+  if (!["restore", "upload"].includes(answer)) throw new Error("cancelled");
+  return answer;
+}
+el("sync").onsubmit = async (e) => {
+  e.preventDefault();
+  if (el("run").disabled) return;
+  el("run").disabled = true;
+  const pass = el("pass").value;
+  try {
+    const { origin, permission } = originAndPermission();
+    if (!(await globalThis.chrome.permissions.contains(permission)))
+      throw new Error("signin");
+    const kinds = ["bookmarks", "preferences"].filter((k) => el(k).checked);
+    if (!kinds.length) throw new Error("choose");
+    const tabs = await globalThis.chrome.tabs.query({ url: origin + "/*" });
+    const tab = tabs.find(
+      (t) => !t.incognito && t.url && new URL(t.url).origin === origin,
+    );
+    if (!tab) throw new Error("signin");
+    const user = await portalRequest(tab.id, origin, null);
+    status(text("running") + " " + user.email);
+    await globalThis.chrome.storage.local.set({ kinds });
+    for (const kind of kinds) await synchronize(tab.id, origin, user, kind, pass, choose);
+    status(text("done") + " · " + user.email + " · " + kinds.map(text).join(" / "));
+    el("pass").value = "";
+  } catch (err) {
+    status(text(err.message));
+  } finally {
+    el("run").disabled = false;
+  }
+};
diff --git a/chrome/browser/resources/aegis_link/codec.js b/chrome/browser/resources/aegis_link/codec.js
new file mode 100644
index 0000000000000000000000000000000000000000..29915c1e5e7c0370ed161e4541dccab908aeee2a
--- /dev/null
+++ b/chrome/browser/resources/aegis_link/codec.js
@@ -0,0 +1,102 @@
+// 同步协议 v1：PBKDF2-SHA256 与 AES-GCM，盐和随机 nonce 随密文发送。
+// 附加认证数据绑定门户、用户和集合，跨账号复制密文不能还原为有效的本地资料。
+const encoder = new TextEncoder();
+const decoder = new TextDecoder("utf-8", { fatal: true });
+export const maxEnvelope = 2 * 1024 * 1024;
+
+export function portalOrigin(raw) {
+  const url = new URL(raw);
+  const local = ["127.0.0.1", "localhost"].includes(url.hostname);
+  if (
+    url.username ||
+    url.password ||
+    url.search ||
+    url.hash ||
+    url.pathname !== "/" ||
+    (url.protocol !== "https:" && !(url.protocol === "http:" && local))
+  ) {
+    throw new Error("origin");
+  }
+  return url.origin;
+}
+
+function toBase64(bytes) {
+  let binary = "";
+  for (let i = 0; i < bytes.length; i += 8192) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + 8192));
+  }
+  return btoa(binary);
+}
+
+async function keyFor(password, salt) {
+  const input = await crypto.subtle.importKey(
+    "raw",
+    encoder.encode(password),
+    "PBKDF2",
+    false,
+    ["deriveKey"],
+  );
+  return crypto.subtle.deriveKey(
+    { name: "PBKDF2", salt, iterations: 600000, hash: "SHA-256" },
+    input,
+    { name: "AES-GCM", length: 256 },
+    false,
+    ["encrypt", "decrypt"],
+  );
+}
+
+/** 将已验证的同步资料封装为门户可保存的标准 Base64。 */
+export async function seal(data, password, binding) {
+  const plain = encoder.encode(JSON.stringify(data));
+  if (plain.length + 45 > maxEnvelope) throw new Error("limit");
+  const out = new Uint8Array(45 + plain.length);
+  out[0] = 1;
+  const salt = crypto.getRandomValues(out.subarray(1, 17));
+  const iv = crypto.getRandomValues(out.subarray(17, 29));
+  const key = await keyFor(password, salt);
+  out.set(
+    new Uint8Array(
+      await crypto.subtle.encrypt(
+        { name: "AES-GCM", iv, additionalData: encoder.encode(binding) },
+        key,
+        plain,
+      ),
+    ),
+    29,
+  );
+  return toBase64(out);
+}
+
+/** 在任何本地写入前验证信封版本、大小与认证标签。 */
+export async function unseal(encoded, password, binding) {
+  if (typeof encoded !== "string" || encoded.length > 4 * Math.ceil(maxEnvelope / 3))
+    throw new Error("limit");
+  const bytes = Uint8Array.from(atob(encoded), (c) => c.charCodeAt(0));
+  if (bytes.length < 46 || bytes.length > maxEnvelope || bytes[0] !== 1)
+    throw new Error("invalid");
+  const key = await keyFor(password, bytes.subarray(1, 17));
+  let plaintext;
+  try {
+    plaintext = await crypto.subtle.decrypt(
+      {
+        name: "AES-GCM",
+        iv: bytes.subarray(17, 29),
+        additionalData: encoder.encode(binding),
+      },
+      key,
+      bytes.subarray(29),
+    );
+  } catch {
+    throw new Error("unlock");
+  }
+  return JSON.parse(decoder.decode(plaintext));
+}
+
+/** 比较本地内容，无变更时不重写密文，双方均有修改时由用户选择保留哪一份。 */
+export async function fingerprint(data) {
+  return toBase64(
+    new Uint8Array(
+      await crypto.subtle.digest("SHA-256", encoder.encode(JSON.stringify(data))),
+    ),
+  );
+}
