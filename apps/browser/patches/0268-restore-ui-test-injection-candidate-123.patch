diff --git a/chrome/browser/actor/actor_keyed_service.cc b/chrome/browser/actor/actor_keyed_service.cc
index fd3052491a59d7aea6a45515cb23dac087cb5af3..cc46ae1beb87661c448276a58c4b23b63ca859a4 100644
--- a/chrome/browser/actor/actor_keyed_service.cc
+++ b/chrome/browser/actor/actor_keyed_service.cc
@@ -507,7 +507,7 @@ TaskId ActorKeyedService::CreateTask(
     AllowedSchemes allowed_schemes) {
   return CreateTaskWithOptions(
       source_info, policy_checker, /*options=*/nullptr,
-      /*delegate=*/nullptr, actor_ui_state_manager_.get(),
+      /*delegate=*/nullptr, GetTaskUiStateManager(),
       /*initial_invocation_source=*/std::nullopt, allowed_schemes);
 }
 
@@ -533,7 +533,7 @@ TaskId ActorKeyedService::CreateTaskWithOwnedPolicyChecker(
     webui::mojom::TaskOptionsPtr options,
     base::WeakPtr<ActorTaskDelegate> delegate) {
   CHECK(policy_checker);
-  auto* ui_state_manager = actor_ui_state_manager_.get();
+  auto* ui_state_manager = GetTaskUiStateManager();
   CHECK(ui_state_manager);
   const EnterprisePolicyChecker* policy_checker_ptr = policy_checker.get();
   return CreateTaskImpl(
@@ -554,7 +554,7 @@ TaskId ActorKeyedService::CreateTaskForTesting(
     AllowedSchemes allowed_schemes) {
   return CreateTaskImpl(std::move(ui_event_dispatcher), source_info,
                         policy_checker, nullptr, std::move(options),
-                        std::move(delegate), actor_ui_state_manager_.get(),
+                        std::move(delegate), GetTaskUiStateManager(),
                         initial_invocation_source, allowed_schemes);
 }
 
@@ -907,6 +907,19 @@ ActorSurfaceRegistry& ActorKeyedService::GetSurfaceRegistry() {
   return *surface_registry_;
 }
 
+void ActorKeyedService::SetActorUiStateManagerForTesting(
+    std::unique_ptr<ui::ActorUiStateManagerInterface> manager) {
+  CHECK(manager);
+  CHECK(active_tasks_.empty());
+  actor_ui_state_manager_for_testing_ = std::move(manager);
+}
+
+ActorUiStateManagerInterface* ActorKeyedService::GetTaskUiStateManager() {
+  return actor_ui_state_manager_for_testing_
+             ? actor_ui_state_manager_for_testing_.get()
+             : actor_ui_state_manager_.get();
+}
+
 ui::ActorUiStateManager* ActorKeyedService::GetActorUiStateManager(
     base::PassKey<ui::ActorUiStateManager>) {
   return actor_ui_state_manager_.get();
