 #include "base/test/scoped_command_line.h"
@@ -162,6 +163,33 @@ TEST_F(AegisActorRuntimeTest, CreatesAegisTaskWithoutGlicRuntime) {
   EXPECT_TRUE(checker_destroyed);
 }
 
+TEST_F(ActorKeyedServiceTest, InjectsUiStateManagerBeforeTaskCreation) {
+  auto* actor_service = ActorKeyedService::Get(profile());
+  auto manager = BuildUiStateManagerMock();
+  auto* manager_ptr = manager.get();
+  actor_service->SetActorUiStateManagerForTesting(std::move(manager));
+  EXPECT_EQ(actor_service->GetActorUiStateManager(), manager_ptr);
+  const TaskId id = actor_service->CreateTask(TestTaskSourceInfo(),
+                                            NoEnterprisePolicyChecker());
+  EXPECT_NE(actor_service->GetTask(id), nullptr);
+}
+
+using ActorKeyedServiceDeathTest = ActorKeyedServiceTest;
+
+TEST_F(ActorKeyedServiceDeathTest, RejectsNullUiStateManager) {
+  EXPECT_CHECK_DEATH(ActorKeyedService::Get(profile())
+                        ->SetActorUiStateManagerForTesting(nullptr));
+}
+
+TEST_F(ActorKeyedServiceDeathTest, RejectsUiStateManagerReplacementWithTask) {
+  auto* actor_service = ActorKeyedService::Get(profile());
+  actor_service->CreateTaskWithOptions(
+      TestTaskSourceInfo(), NoEnterprisePolicyChecker(), /*options=*/nullptr,
+      /*delegate=*/nullptr, ui_state_manager());
+  EXPECT_CHECK_DEATH(actor_service->SetActorUiStateManagerForTesting(
+      BuildUiStateManagerMock()));
+}
+
 // Adds a task to ActorKeyedService
 TEST_F(ActorKeyedServiceTest, AddActiveTask) {
   auto* actor_service = ActorKeyedService::Get(profile());
