+  void SetActorUiStateManagerForTesting(
+      std::unique_ptr<ui::ActorUiStateManagerInterface> manager);
+  ui::ActorUiStateManagerInterface* GetActorUiStateManagerForTesting() {
+    return GetTaskUiStateManager();
+  }
