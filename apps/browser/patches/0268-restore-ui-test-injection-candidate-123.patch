 }
 
+void ActorKeyedService::SetActorUiStateManagerForTesting(
+    std::unique_ptr<ui::ActorUiStateManagerInterface> manager) {
+  CHECK(manager);
+  CHECK(active_tasks_.empty());
+  actor_ui_state_manager_for_testing_ = std::move(manager);
+}
+
+ActorUiStateManagerInterface* ActorKeyedService::GetTaskUiStateManager() {
+  return actor_ui_state_manager_for_testing_
+             ? actor_ui_state_manager_for_testing_.get()
+             : actor_ui_state_manager_.get();
+}
+
 ui::ActorUiStateManager* ActorKeyedService::GetActorUiStateManager(
     base::PassKey<ui::ActorUiStateManager>) {
   return actor_ui_state_manager_.get();
