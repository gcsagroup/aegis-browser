+TEST_F(ActorKeyedServiceTest, OwnsTaskSpecificPolicyCheckerUntilTaskDeletion) {
+  bool checker_destroyed = false;
+  auto* actor_service = ActorKeyedService::Get(profile());
+  TaskId id = actor_service->CreateTaskWithOwnedPolicyChecker(
+      TaskSourceInfo(TaskSourceInfo::Client::kAegis, "aegis-task"),
+      std::make_unique<OwnedPolicyChecker>(&checker_destroyed), nullptr,
+      nullptr);
+  EXPECT_FALSE(checker_destroyed);
+  actor_service->StopTask(id, ActorTask::StoppedReason::kTaskComplete);
+  EXPECT_FALSE(checker_destroyed);
+  WaitForPostedTask();
+  EXPECT_TRUE(checker_destroyed);
+}
