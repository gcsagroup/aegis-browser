+class AegisActorRuntimeTest : public testing::Test {
+ public:
+  AegisActorRuntimeTest()
+      : task_environment_(base::test::TaskEnvironment::TimeSource::MOCK_TIME),
+        testing_profile_manager_(TestingBrowserProcess::GetGlobal()) {
+    scoped_feature_list_.InitWithFeatures({aegis::features::kAegisAgent},
+                                          {features::kGlicActor});
+  }
+
+  void SetUp() override {
+    ASSERT_TRUE(testing_profile_manager_.SetUp());
+    profile_ = testing_profile_manager_.CreateTestingProfile("aegis-profile");
+  }
+
+ protected:
+  raw_ptr<TestingProfile> profile_ = nullptr;
+
+ private:
+  base::test::ScopedFeatureList scoped_feature_list_;
+  content::BrowserTaskEnvironment task_environment_;
+  TestingProfileManager testing_profile_manager_;
+};
+
+TEST_F(AegisActorRuntimeTest, CreatesAegisTaskWithoutGlicRuntime) {
+  EXPECT_TRUE(IsActorRuntimeEnabled());
+  ActorKeyedService* actor_service = ActorKeyedService::Get(profile_);
+  ASSERT_TRUE(actor_service);
+
+  bool checker_destroyed = false;
+  TaskId id = actor_service->CreateTaskWithOwnedPolicyChecker(
+      TaskSourceInfo(TaskSourceInfo::Client::kAegis, "aegis-only-task"),
+      std::make_unique<OwnedPolicyChecker>(&checker_destroyed), nullptr,
+      nullptr);
+  EXPECT_FALSE(id.is_null());
+  ASSERT_TRUE(actor_service->GetTask(id));
+  EXPECT_EQ(actor_service->GetTask(id)->source_info().type,
+            TaskSourceInfo::Client::kAegis);
+  actor_service->StopTask(id, ActorTask::StoppedReason::kTaskComplete);
+  WaitForPostedTask();
+  EXPECT_TRUE(checker_destroyed);
+}
