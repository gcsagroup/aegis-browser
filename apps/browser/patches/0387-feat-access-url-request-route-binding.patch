+void URLRequest::SetAccessProxyRoute(scoped_refptr<AccessProxyRoute> route) {
+  CHECK(!is_pending_ || is_redirecting_);
+  access_proxy_route_ = std::move(route);
+  access_route_requires_confirmation_ = false;
+}
+
 void URLRequest::SetLoadFlags(int flags) {
   if ((load_flags() & LOAD_IGNORE_LIMITS) != (flags & LOAD_IGNORE_LIMITS)) {
     DCHECK(!job_.get());
@@ -909,6 +917,9 @@ int URLRequest::NotifyConnected(const TransportInfo& info,
