+    access_route_requires_confirmation_ = true;
+  }
   OnCallToDelegate(NetLogEventType::URL_REQUEST_DELEGATE_RECEIVED_REDIRECT);
 
   // When notifying the URLRequest::Delegate, it can destroy the request,
