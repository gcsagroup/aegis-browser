 #include <optional>
 
+#include "base/memory/raw_ptr.h"
 #include "chrome/browser/aegis/access/access_site_intent.h"
 #include "chrome/browser/aegis/access/access_site_proxy_bubble_model.h"
 #include "components/aegis_access/access_route_types.h"
@@ -103,6 +104,8 @@ class AccessSiteProxySessionOrchestrating {
       AccessSiteProxyLocalProxyReadyInfo* out) = 0;
 
   // Runs PrepareCandidate → Publish → wait ACK for an ordinary mutation.
+  // On failure, rolls back the candidate while preserving the last committed
+  // selection. The caller must not tear down that selection during recovery.
   virtual AccessSiteProxySessionError PublishAndAcknowledge(
       const SiteGroupMutationRequest& request,
       const aegis_access::RequestCancellationSelector& selector,
@@ -120,6 +123,7 @@ class AccessSiteProxySessionController {
  public:
   explicit AccessSiteProxySessionController(
       AccessSiteProxySessionOrchestrating* orchestrator);
+  ~AccessSiteProxySessionController();
 
   AccessSiteIntentStore& intent_store() { return intent_store_; }
   const AccessSiteIntentStore& intent_store() const { return intent_store_; }
@@ -163,7 +167,7 @@ class AccessSiteProxySessionController {
       const AccessSiteHost& host,
       std::string_view operation_suffix);
 
-  AccessSiteProxySessionOrchestrating* const orchestrator_;
+  const raw_ptr<AccessSiteProxySessionOrchestrating> orchestrator_;
   AccessSiteIntentStore intent_store_;
   std::map<AccessSiteHost, AccessSiteProxySessionSnapshot> snapshots_;
 };
diff --git a/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc b/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc
index 8a4116af54f76a756aee50336e8692851c0a12b6..f38f750bb830a7e4720250c32b67a1de643690a2 100644
--- a/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc
+++ b/chrome/browser/aegis/access/access_site_proxy_session_unittest.cc
@@ -319,6 +319,31 @@ TEST(AccessSiteProxySessionTest, RecoverFromFaultRestoresReadyViaProxy) {
   EXPECT_NE(plan.action, aegis_access::RouteAction::kPreserveNative);
 }
 
+TEST(AccessSiteProxySessionTest,
+     FailedRecoveryDoesNotTearDownCommittedProxySelection) {
+  FakeOrchestrator orchestrator;
+  AccessSiteProxySessionController controller(&orchestrator);
+  const AccessSiteHost host = Host("www.example.com");
+  ASSERT_EQ(controller.Enable(host).phase, AccessSiteProxySessionPhase::kReady);
+  controller.NotifyRuntimeFault(host, AccessSiteProxyFaultMode::kFailClosed);
+  const int prior_teardowns = orchestrator.tear_down_count;
+
+  orchestrator.fail_at = FakeOrchestrator::Stage::kPublish;
+  orchestrator.publish_error = AccessSiteProxySessionError::kAckFailed;
+  const auto failed = controller.RecoverFromFault(host);
+
+  EXPECT_EQ(failed.intent, AccessSiteIntent::kAllow);
+  EXPECT_EQ(failed.phase, AccessSiteProxySessionPhase::kUnavailable);
+  EXPECT_EQ(failed.policy_generation, 7u);
+  EXPECT_EQ(orchestrator.tear_down_count, prior_teardowns);
+  EXPECT_EQ(controller.RecoverFromFault(host).policy_generation, 7u);
+  EXPECT_EQ(orchestrator.tear_down_count, prior_teardowns);
+  const auto route =
+      PlanSiteProxySessionRequestRoute(failed, HealthyRouteContext(7));
+  EXPECT_EQ(route.action, aegis_access::RouteAction::kFail);
+  EXPECT_NE(route.action, aegis_access::RouteAction::kPreserveNative);
+}
+
 TEST(AccessSiteProxySessionTest,
      NetworkServiceRestartRebuildsProxyWithoutDirect) {
   FakeOrchestrator orchestrator;
