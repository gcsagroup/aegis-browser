From 845cc6f858186062978c3583c240765210078594 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Fri, 13 Nov 2026 21:05:15 +0800
Subject: [PATCH] fix(access-log): use bounded Chromium file reads for
 diagnostics
---

diff --git a/chrome/browser/aegis/access/access_core_log_disk_unittest.cc b/chrome/browser/aegis/access/access_core_log_disk_unittest.cc
index a96e97eac7da51e4390248a0b429122fd222a15e..c8bf790beb5675433e82f47dde7664a8b6246789 100644
--- a/chrome/browser/aegis/access/access_core_log_disk_unittest.cc
+++ b/chrome/browser/aegis/access/access_core_log_disk_unittest.cc
@@ -4,6 +4,7 @@
 #include <unistd.h>
 
 #include <array>
+#include <cerrno>
 
 #include "base/files/file_util.h"
 #include "base/files/scoped_temp_dir.h"
@@ -114,7 +115,8 @@ TEST_F(AccessCoreLogDiskTest, ClearSnapshotsThePipeBeforeTheNextRead) {
   auto store = Open();
   base::ScopedFD reader, writer;
   ASSERT_TRUE(base::CreatePipe(&reader, &writer, /*non_blocking=*/true));
-  const auto original_epoch = store->RegisterPipe(reader.get());
+  base::File file(std::move(reader));
+  const auto original_epoch = store->RegisterPipe(file.GetPlatformFile());
   std::array<char, 64> buffer;
   auto write_record = [&](std::string_view text) {
     ASSERT_EQ(::write(writer.get(), text.data(), text.size()),
@@ -122,22 +124,29 @@ TEST_F(AccessCoreLogDiskTest, ClearSnapshotsThePipeBeforeTheNextRead) {
   };
   store->Clear();
   write_record("fresh\n");
-  const auto idle = store->ReadPipe(reader.get(), buffer);
-  ASSERT_EQ(idle.count, 6);
+  const auto idle = store->ReadPipe(file, buffer);
+  ASSERT_EQ(idle.count, 6u);
   EXPECT_EQ(idle.clear_epoch, original_epoch + 1);
   EXPECT_EQ(idle.clear_prefix, 0u);
-  EXPECT_EQ(std::string_view(buffer.data(), idle.count), "fresh\n");
+  EXPECT_EQ(std::string_view(buffer.data(), *idle.count), "fresh\n");
 
   write_record("stale\n");
   store->Clear();
   write_record("first after clear\n");
-  const auto buffered = store->ReadPipe(reader.get(), buffer);
+  const auto buffered = store->ReadPipe(file, buffer);
   EXPECT_EQ(buffered.clear_epoch, original_epoch + 2);
   EXPECT_EQ(buffered.clear_prefix, 6u);
-  ASSERT_EQ(buffered.count, 24);
-  EXPECT_EQ(std::string_view(buffer.data(), buffered.count),
+  ASSERT_EQ(buffered.count, 24u);
+  EXPECT_EQ(std::string_view(buffer.data(), *buffered.count),
             "stale\nfirst after clear\n");
-  store->UnregisterPipe(reader.get());
+  const auto empty = store->ReadPipe(file, buffer);
+  EXPECT_FALSE(empty.count);
+  EXPECT_EQ(empty.error, EAGAIN);
+  writer.reset();
+  const auto eof = store->ReadPipe(file, buffer);
+  EXPECT_EQ(eof.count, 0u);
+  EXPECT_EQ(eof.error, 0);
+  store->UnregisterPipe(file.GetPlatformFile());
 }
 
 TEST_F(AccessCoreLogDiskTest, RefiltersQueuedAndLoadedHistoryForNewCredentials) {
diff --git a/chrome/browser/aegis/access/access_core_log_store.cc b/chrome/browser/aegis/access/access_core_log_store.cc
index f34a1c6f9756db81a241feecaee97702b330b3d5..8bf538af897c04d7785d1efec4bde4fbbaebd1c7 100644
--- a/chrome/browser/aegis/access/access_core_log_store.cc
+++ b/chrome/browser/aegis/access/access_core_log_store.cc
@@ -103,13 +103,15 @@ void AccessCoreLogStore::UnregisterPipe(int fd) {
 }
 
 AccessCoreLogStore::PipeRead AccessCoreLogStore::ReadPipe(
-    int fd,
+    base::File& file,
     base::span<char> buffer) {
   base::AutoLock guard(lock_);
-  auto pipe = pipes_.find(fd);
+  auto pipe = pipes_.find(file.GetPlatformFile());
   CHECK(pipe != pipes_.end());
-  const auto count = HANDLE_EINTR(read(fd, buffer.data(), buffer.size()));
-  return {count, count < 0 ? errno : 0, clear_epoch_, pipe->second};
+  // One bounded, nonblocking read. The same lock protects the Clear snapshot.
+  const auto count =
+      file.ReadAtCurrentPosNoBestEffort(base::as_writable_byte_span(buffer));
+  return {count, count ? 0 : errno, clear_epoch_, pipe->second};
 }
 
 namespace {
diff --git a/chrome/browser/aegis/access/access_core_log_store.h b/chrome/browser/aegis/access/access_core_log_store.h
index 665ab5e1c0fa1924578d7edcc9059bf5796e1286..fe1bdb5955f0fd2c3942e3789c12aa248a1a0c90 100644
--- a/chrome/browser/aegis/access/access_core_log_store.h
+++ b/chrome/browser/aegis/access/access_core_log_store.h
@@ -4,12 +4,11 @@
 
 #include "build/build_config.h"
 #if BUILDFLAG(IS_MAC)
-#include <sys/types.h>
-
 #include <map>
 #include <optional>
 
 #include "base/containers/span.h"
+#include "base/files/file.h"
 #include "base/functional/callback.h"
 #include "base/task/sequenced_task_runner.h"
 #include "chrome/browser/aegis/access/access_core_log_disk.h"
@@ -34,14 +33,14 @@ class AccessCoreLogStore
   static void FlushAllForSessionEnding(base::OnceClosure completion);
   DiskStatus disk_status();
   struct PipeRead {
-    ssize_t count;
+    std::optional<size_t> count;
     int error;
     uint64_t clear_epoch;
     std::optional<size_t> clear_prefix;
   };
   uint64_t RegisterPipe(int fd);
   void UnregisterPipe(int fd);
-  PipeRead ReadPipe(int fd, base::span<char> buffer);
+  PipeRead ReadPipe(base::File& file, base::span<char> buffer);
 #endif
   void SetLevel(std::string_view level);
   std::string Level() {
diff --git a/chrome/browser/aegis/access/access_local_core_manager.cc b/chrome/browser/aegis/access/access_local_core_manager.cc
index 56a5a07114a14fc3d12960fa53500f658058aa99..e511fbb4fde0260aa29669c1cc61f54ed0e4d1bf 100644
--- a/chrome/browser/aegis/access/access_local_core_manager.cc
+++ b/chrome/browser/aegis/access/access_local_core_manager.cc
@@ -360,16 +360,18 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
     base::File null_output(base::FilePath("/dev/null"),
                            base::File::FLAG_OPEN | base::File::FLAG_WRITE);
     if (!null_output.IsValid()) return false;
-    base::ScopedFD write_end;
+    base::ScopedFD read_end, write_end;
     int output = null_output.GetPlatformFile();
     auto create_log_pipe = input_.create_log_pipe_for_testing
                                ? input_.create_log_pipe_for_testing : &base::CreatePipe;
-    if (level != "none" && create_log_pipe(&log_read_, &write_end, /*non_blocking=*/true)) {
+    if (level != "none" && create_log_pipe(&read_end, &write_end, /*non_blocking=*/true)) {
       // Diagnostic capture is optional; a failed pipe keeps /dev/null.
+      log_read_ = base::File(std::move(read_end));
       output = write_end.get();
-      log_clear_epoch_ = input_.log_store->RegisterPipe(log_read_.get());
+      log_clear_epoch_ = input_.log_store->RegisterPipe(log_read_.GetPlatformFile());
       log_watch_ = base::FileDescriptorWatcher::WatchReadable(
-          log_read_.get(), base::BindRepeating(&Worker::DrainLog, base::Unretained(this)));
+          log_read_.GetPlatformFile(),
+          base::BindRepeating(&Worker::DrainLog, base::Unretained(this)));
     }
     options.fds_to_remap = {{output, STDOUT_FILENO}, {output, STDERR_FILENO}};
     process_ = base::LaunchProcess(command, options);
@@ -377,9 +379,9 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
   }
   void DrainLog() {
     std::array<char, 4096> chunk;
-    for (int i = 0; i < 16 && log_read_.is_valid(); ++i) {
+    for (int i = 0; i < 16 && log_read_.IsValid(); ++i) {
       const auto [count, error, epoch, prefix] =
-          input_.log_store->ReadPipe(log_read_.get(), chunk);
+          input_.log_store->ReadPipe(log_read_, chunk);
       if (epoch != log_clear_epoch_) {
         log_clear_epoch_ = epoch;
         framer_.DiscardPartial();
@@ -391,11 +393,11 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
         discard_bytes_ = 0;
         return;
       }
-      if (count <= 0) {
+      if (!count || *count == 0) {
         CloseLogPipe();
         break;
       }
-      std::string_view bytes(chunk.data(), count);
+      std::string_view bytes(chunk.data(), *count);
       const size_t discard = discard_until_empty_
                                  ? bytes.size() : std::min(discard_bytes_, bytes.size());
       if (discard) {
@@ -411,9 +413,9 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
   }
   void CloseLogPipe() {
     log_watch_.reset();
-    if (log_read_.is_valid()) {
-      input_.log_store->UnregisterPipe(log_read_.get());
-      log_read_.reset();
+    if (log_read_.IsValid()) {
+      input_.log_store->UnregisterPipe(log_read_.GetPlatformFile());
+      log_read_.Close();
     }
   }
   void StartProbe() {
@@ -544,7 +546,7 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
 
   AccessLocalCoreInput input_;
   std::shared_ptr<ShutdownHandle> shutdown_;
-  base::ScopedFD log_read_;
+  base::File log_read_;
   std::unique_ptr<base::FileDescriptorWatcher::Controller> log_watch_;
   CoreLogFramer framer_;
   uint64_t log_generation_ = 0;
