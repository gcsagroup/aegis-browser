@@ -170,8 +176,35 @@ int GetParallelRequestCountConfig() {
   std::string finch_value = base::GetFieldTrialParamValueByFeature(
       features::kParallelDownloading, kParallelRequestCountFinchKey);
   int result;
-  return base::StringToInt(finch_value, &result) ? result
-                                                 : kParallelRequestCount;
+  result =
+      base::StringToInt(finch_value, &result) ? result : kParallelRequestCount;
+
+  // Keep desktop acceleration bounded. Resource-state checks happen only
+  // when a parallel job is configured, so they add no polling load.
+  result = std::clamp(result, 1, 6);
+  if (net::NetworkChangeNotifier::GetConnectionCost() ==
+      net::NetworkChangeNotifier::CONNECTION_COST_METERED) {
+    return 1;
+  }
+
+  base::PowerMonitor* power_monitor = base::PowerMonitor::GetInstance();
+  if (!power_monitor->IsInitialized()) {
+    return result;
+  }
+
+  using ThermalState = base::PowerThermalObserver::DeviceThermalState;
+  switch (power_monitor->GetCurrentThermalState()) {
+    case ThermalState::kSerious:
+    case ThermalState::kCritical:
+      return 1;
+    case ThermalState::kFair:
+      result = std::min(result, 2);
+      break;
+    case ThermalState::kUnknown:
+    case ThermalState::kNominal:
+      break;
+  }
+  return power_monitor->IsOnBatteryPower() ? std::min(result, 2) : result;
