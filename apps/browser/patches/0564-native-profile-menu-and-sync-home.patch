+  void RequestNow() {
+    if (document_) {
+      queued_ = true;
+    } else {
+      Schedule();
+    }
+  }
+
  private:
   void Schedule() {
     timer_.Start(FROM_HERE, base::TimeDelta(), this, &Scheduler::Run);
   }
   void Rest() {
     document_.reset();
+    if (queued_) {
+      Schedule();
+      return;
+    }
