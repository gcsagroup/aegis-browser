+std::u16string AegisAccountName(Profile& profile) {
+  const auto* prefs = profile.GetPrefs();
+  const auto& name = prefs->GetString(aegis::link::kDisplayName);
+  const auto& email = prefs->GetString(aegis::link::kEmail);
+  return base::UTF8ToUTF16(name.empty() ? email.substr(0, email.find('@')) : name);
