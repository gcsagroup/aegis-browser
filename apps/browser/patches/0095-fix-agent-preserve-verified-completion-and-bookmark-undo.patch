+    plan.scope.allowed_data_classes.insert(undo_descriptor->data_class);
+  }
   if (!plan.scope.IsValid() || !plan.scope.IsNoBroaderThan(maximum_scope)) {
     *error = "browser could not bind the plan to its approved scope";
     return std::nullopt;
