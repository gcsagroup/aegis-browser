   }
 };
 
+IN_PROC_BROWSER_TEST_F(DevToolsRemoteServerInfobarBrowserTest,
+                      LocalizedLabelsDoNotBlockUIThread) {
+  // Windows 旧实现会在这里重新读取语言资源并触发线程限制检查。
+  const base::ScopedDisallowBlocking disallow_blocking;
+  const std::string& locale = g_browser_process->GetApplicationLocale();
+  DevToolsRemoteServerInfobarDelegate delegate;
+  EXPECT_EQ(aegis::CdpInfobarMessage(locale), delegate.GetMessageText());
+  EXPECT_EQ(aegis::CdpInfobarButton(locale),
+            delegate.GetButtonLabel(ConfirmInfoBarDelegate::BUTTON_OK));
+}
+
+IN_PROC_BROWSER_TEST_F(DevToolsRemoteServerInfobarBrowserTest,
+                      AegisInternalPagesUseCachedLocale) {
+  for (const char* url : {"chrome://aegis/", "chrome://settings/security"}) {
+    ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL(url)));
+    content::WebContents* contents =
+        browser()->tab_strip_model()->GetActiveWebContents();
+    EXPECT_FALSE(contents->IsCrashed());
+    EXPECT_EQ("complete", content::EvalJs(contents, "document.readyState"));
+  }
+}
+
