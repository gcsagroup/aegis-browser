@@ -718,7 +718,8 @@ IN_PROC_BROWSER_TEST_F(AegisRemoteDevToolsProtocolTest,
                                      .Set("flatten", true),
                                  *tab_session_id, true));
   base::DictValue attached_page = WaitForMatchingNotification(
-      "Target.attachedToTarget", base::BindRepeating([](const auto& params) {
+      "Target.attachedToTarget",
+      base::BindRepeating([](const base::DictValue& params) {
         const std::string* type =
             params.FindStringByDottedPath("targetInfo.type");
         return type && *type == "page";
