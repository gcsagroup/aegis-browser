From 281427ac39e685f8755395bfe20afde685b8dbe0 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Tue, 10 Nov 2026 21:42:06 +0800
Subject: [PATCH] chore(access): distinguish retry ticket and pending entry
 admission
---

diff --git a/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc b/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc
index 0315d727ad80777e09fb4cc86e777c457de07347..a7ac89f886a95e18a4e4100aac6058755cef82ae 100644
--- a/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc
+++ b/chrome/browser/aegis/access/access_navigation_retry_tab_helper.cc
@@ -64,6 +64,8 @@ bool AccessNavigationRetryTabHelper::RequestProxyRetry(
     base::OnceCallback<void(bool)> completion) {
   auto ticket = FailureForRetry();
   VLOG(1) << "Aegis proxy retry request: ticket=" << ticket.has_value()
+          << " remembered_ticket=" << state_.Capture().has_value()
+          << " pending_entry=" << !!web_contents()->GetController().GetPendingEntry()
           << " handler=" << !!proxy_retry_handler_
           << " preparing=" << proxy_preparation_pending_;
   if (!ticket || !proxy_retry_handler_ || proxy_preparation_pending_) {
@@ -93,6 +95,7 @@ void AccessNavigationRetryTabHelper::OnProxyPrepared(
 void AccessNavigationRetryTabHelper::DidStartNavigation(
     content::NavigationHandle* navigation) {
   if (navigation->IsInPrimaryMainFrame()) {
+    VLOG(1) << "Aegis proxy retry start: id=" << navigation->GetNavigationId();
     proxy_preparation_pending_ = false;
     weak_factory_.InvalidateWeakPtrs();
     state_.BeginNavigation(navigation->GetNavigationId());
