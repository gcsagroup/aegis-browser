+void ChromeContentBrowserClient::OnWebSocketConnectionInitiated(
+    content::RenderFrameHost* frame,
+    const GURL& url) {
+  if (!frame) {
+    return;
+  }
+  content::RenderFrameHost* main_frame = frame->GetOutermostMainFrame();
+  if (!main_frame) {
+    return;
+  }
+  const GURL& page_url = main_frame->GetLastCommittedURL();
+  if (!page_url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  Profile* profile = Profile::FromBrowserContext(frame->GetBrowserContext());
+  PrefService* prefs = profile ? profile->GetPrefs() : nullptr;
+  if (!prefs || !aegis::features::IsMinerGuardGloballyEnabled(
+                    prefs->GetBoolean(aegis::prefs::kMinerGuardEnabled))) {
+    return;
+  }
+  const std::string display_domain(page_url.host());
+  const std::string site_key = aegis::SiteKeyForHost(display_domain);
+  const int64_t now = (base::Time::Now() - base::Time::UnixEpoch()).InSeconds();
+  if (aegis::IsSitePaused(prefs->GetString(aegis::prefs::kPausedSites),
+                          site_key, now)) {
+    return;
+  }
+
+  aegis::MinerRuntimeSignals signals;
+  signals.websocket = true;
+  signals.mining_endpoint = aegis::MiningEndpointIndicator(url).has_value();
+  aegis::MinerGuardReporter::ReportSignals(
+      main_frame->GetReportingSource().ToString(), site_key, display_domain,
+      signals);
+}
