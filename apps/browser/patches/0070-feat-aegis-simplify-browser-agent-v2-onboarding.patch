+bool ActorUiStateManager::IsAegisTask(TaskId task_id) const {
+  if (aegis_tasks_.contains(task_id)) {
+    return true;
+  }
+  const ActorTask* task = actor_service_->GetTask(task_id);
+  return task &&
+         task->source_info().type == TaskSourceInfo::Client::kAegis;
+}
+
 UiTabState ActorUiStateManager::GetActorControlledUiTabState(TaskId task_id) {
+  UiTabState state = kDefaultActorState;
   switch (GetDuration(task_id)) {
     case ActorTask::TaskDuration::kDefault:
-      return kDefaultActorState;
+      break;
     case ActorTask::TaskDuration::kTransient: {
       auto it = transient_task_timers_.find(task_id);
       if (it != transient_task_timers_.end() && !it->second->IsRunning()) {
-        return kDefaultActorState;
+        state = kDefaultActorState;
+        break;
       }
-      return kTransientActorState;
+      state = kTransientActorState;
+      break;
     }
   }
-  NOTREACHED();
+  // The standard tab indicator is branded for Glic/Gemini. Aegis tasks keep
+  // the execution border and handoff control, while their status is shown in
+  // the Aegis side panel.
+  if (IsAegisTask(task_id)) {
+    state.tab_indicator = TabIndicatorStatus::kNone;
+  }
+  return state;
 }
 
