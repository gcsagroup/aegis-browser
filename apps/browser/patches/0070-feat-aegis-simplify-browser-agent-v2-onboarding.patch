+TEST_F(ActorUiStateManagerTest, AegisTaskSkipsGeminiProfileTaskCallbacks) {
+  int state_callback_count = 0;
+  int stopped_callback_count = 0;
+  std::vector<base::CallbackListSubscription> subscriptions;
+  subscriptions.push_back(
+      actor_ui_state_manager()->RegisterActorTaskStateChange(
+          base::BindLambdaForTesting([&](TaskId) { state_callback_count++; })));
+  subscriptions.push_back(actor_ui_state_manager()->RegisterActorTaskStopped(
+      base::BindLambdaForTesting(
+          [&](TaskId) { stopped_callback_count++; })));
+
+  TaskId task_id = actor_keyed_service()->CreateAegisTaskForTesting();
+  actor_ui_state_manager()->OnUiEvent(StartTask(task_id));
+  actor_ui_state_manager()->OnUiEvent(
+      TaskStateChanged(task_id, ActorTask::State::kActing));
+  task_environment().FastForwardBy(kProfileScopedUiUpdateDebounceDelay);
+
+  EXPECT_EQ(state_callback_count, 0);
+  StopActorTask(task_id);
+  EXPECT_EQ(stopped_callback_count, 0);
+  EXPECT_EQ(actor_ui_state_manager()->GetActorTaskState(task_id),
+            std::nullopt);
+  EXPECT_EQ(actor_ui_state_manager()->GetInactiveTaskCount(), 0u);
+}
