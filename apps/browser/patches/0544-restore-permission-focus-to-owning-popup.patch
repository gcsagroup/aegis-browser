+++ b/chrome/browser/ui/views/omnibox/omnibox_popup_presenter_base.cc
@@ -886,17 +886,17 @@ void OmniboxPopupPresenterBase::HandlePermissionPromptDismissal() {
 }
 
 void OmniboxPopupPresenterBase::RestoreFocusAfterPermissionPromptDismissed() {
-  // Another prompt can still own the popup, or it can be hidden by teardown.
-  if (!IsShown() || is_prompt_showing_ ||
+  // Passive suggestions don't take focus and never receive a widget activation
+  // callback. Another prompt can also still own the popup.
+  if (!widget_ || !IsShown() || !ShouldReceiveFocus() || is_prompt_showing_ ||
       (requesting_prompt_observation_ &&
        requesting_prompt_observation_->IsLocked())) {
     return;
   }
-  is_handling_prompt_dismissal_ = true;
-  if (location_bar()) {
-    location_bar()->FocusLocation(/*is_user_initiated=*/false,
-                                  /*clear_focus_if_failed=*/false);
-  }
+  is_handling_prompt_dismissal_ = !widget_->IsActive();
+  // Focus this popup directly. Focusing the location bar can open Full WebUI
+  // over an AIM popup that owned the permission lock.
+  RequestFocus();
 }
 
 void OmniboxPopupPresenterBase::OnPromptAdded() {
