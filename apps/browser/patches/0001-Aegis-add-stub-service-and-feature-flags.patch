 chrome/browser/chrome_browser_main.cc |  5 ++++
 chrome/common/aegis/BUILD.gn          | 10 ++++++++
 chrome/common/aegis/features.cc       | 14 +++++++++++
 chrome/common/aegis/features.h        | 19 ++++++++++++++
 8 files changed, 133 insertions(+)
