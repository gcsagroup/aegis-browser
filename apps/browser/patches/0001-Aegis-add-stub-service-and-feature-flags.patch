diff --git a/chrome/browser/aegis/aegis_service.cc b/chrome/browser/aegis/aegis_service.cc
new file mode 100644
index 0000000000..6e2ccb30ce
--- /dev/null
+++ b/chrome/browser/aegis/aegis_service.cc
@@ -0,0 +1,35 @@
+// Copyright 2026 GCSA
+// Intended path: chrome/browser/aegis/aegis_service.cc
+
+#include "chrome/browser/aegis/aegis_service.h"
+
+#include "base/logging.h"
+#include "base/memory/singleton.h"
+#include "chrome/common/aegis/features.h"
+
+namespace aegis {
+
+// static
+AegisService* AegisService::GetInstance() {
+  return base::Singleton<AegisService>::get();
+}
+
+AegisService::AegisService() = default;
+AegisService::~AegisService() = default;
+
+void AegisService::InitializeForProfile(Profile* profile) {
+  if (!IsEnabled()) {
+    VLOG(1) << "Aegis disabled by feature flag";
+    return;
+  }
+  initialized_ = true;
+  LOG(INFO) << "GCSA-aegis initialized for profile";
+  // TODO(aegis): register URLLoaderThrottle factory, cookie observer, WebUI.
+  (void)profile;
+}
+
+bool AegisService::IsEnabled() const {
+  return base::FeatureList::IsEnabled(features::kAegisEnabled);
+}
+
+}  // namespace aegis
diff --git a/chrome/browser/aegis/aegis_service.h b/chrome/browser/aegis/aegis_service.h
new file mode 100644
index 0000000000..fb76c457df
--- /dev/null
+++ b/chrome/browser/aegis/aegis_service.h
@@ -0,0 +1,36 @@
+// Copyright 2026 GCSA
+// Intended path: chrome/browser/aegis/aegis_service.h
+// Browser-process service that will host NetPolicy / StoragePolicy bridges.
+
+#ifndef CHROME_BROWSER_AEGIS_AEGIS_SERVICE_H_
+#define CHROME_BROWSER_AEGIS_AEGIS_SERVICE_H_
+
+#include "base/memory/singleton.h"
+
+class Profile;
+
+namespace aegis {
+
+class AegisService {
+ public:
+  static AegisService* GetInstance();
+
+  AegisService(const AegisService&) = delete;
+  AegisService& operator=(const AegisService&) = delete;
+
+  // Called from browser startup once Profile is ready.
+  void InitializeForProfile(Profile* profile);
+
+  bool IsEnabled() const;
+
+ private:
+  friend struct base::DefaultSingletonTraits<AegisService>;
+  AegisService();
+  ~AegisService();
+
+  bool initialized_ = false;
+};
+
+}  // namespace aegis
+
+#endif  // CHROME_BROWSER_AEGIS_AEGIS_SERVICE_H_
diff --git a/chrome/browser/chrome_browser_main.cc b/chrome/browser/chrome_browser_main.cc
index a32949ed04..1565069ff7 100644
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/chrome_browser_main.h"
+#include "chrome/browser/aegis/aegis_service.h"
 
 #include <memory>
 #include <string>
@@ -1906,6 +1907,10 @@ int ChromeBrowserMainParts::PreMainMessageLoopRunImpl() {
   // Call `PostProfileInit()`and set it up for profiles created later.
   profile_init_manager_ = std::make_unique<ProfileInitManager>(this, profile);
 
+  if (profile) {
+    aegis::AegisService::GetInstance()->InitializeForProfile(profile);
+  }
+
 #if !BUILDFLAG(IS_ANDROID) && !BUILDFLAG(IS_CHROMEOS)
   // Execute first run specific code after the PrefService has been initialized
   // and preferences have been registered since some of the import code depends
