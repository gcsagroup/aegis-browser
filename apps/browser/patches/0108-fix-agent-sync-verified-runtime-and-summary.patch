+  }
+  EXPECT_EQ(task.network_requests_used(),
+            500 + scope->budgets.max_model_calls);
+  EXPECT_FALSE(task.ConsumeNetworkRequest());
+  EXPECT_FALSE(task.ConsumeModelCall());
