+base::DictValue BookmarkPreviewEvidence(const AgentToolResult& result) {
+  base::DictValue preview;
+  preview.Set("bookmark_preview_valid", false);
+  const auto& value = result.value;
+  const auto count = value.FindInt("move_count");
