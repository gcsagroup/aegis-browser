+      selected_ids->clear();
+    if (scenario == 4)
+      invalid.arguments.Set("scope_resolved", "true");
+    if (scenario == 5)
+      invalid.arguments.Set("scope_resolved", false);
+    if (scenario == 6)
+      invalid.arguments.Set("issues", "无");
+    if (scenario == 7)
+      invalid.arguments.Set("extra", true);
