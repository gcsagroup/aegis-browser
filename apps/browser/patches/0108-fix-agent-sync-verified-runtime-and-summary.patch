+  PrefService* prefs = browser()->profile()->GetPrefs();
+  prefs->SetString(aegis::prefs::kModelProvider, "openai");
+  prefs->SetString(aegis::prefs::kModelBaseUrl, kModelBase);
+  prefs->SetString(aegis::prefs::kModelName, "fixture-model");
