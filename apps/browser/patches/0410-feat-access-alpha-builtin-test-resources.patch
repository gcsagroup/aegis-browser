 namespace {
+TEST(AccessLocalCoreInputTest, BuildControlsPrivateInputSource) {
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  base::ScopedPathOverride resources(base::DIR_ASSETS, directory.GetPath());
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitchPath(
+      "aegis-access-dev-core-manifest", directory.GetPath().AppendASCII("dev-manifest"));
+  command.GetProcessCommandLine()->AppendSwitchPath(
+      "aegis-access-dev-node-config", directory.GetPath().AppendASCII("dev-node"));
+  const auto input = ResolveAccessLocalCoreInput();
+  ASSERT_TRUE(input);
+#if BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
+  EXPECT_EQ(input->source, AccessLocalCoreSource::kAlphaBundle);
+  EXPECT_EQ(input->manifest, directory.GetPath().AppendASCII(
+      "AegisAlphaAccess/core-manifest.json"));
+  EXPECT_EQ(input->node_config, directory.GetPath().AppendASCII(
+      "AegisAlphaAccess/node.json"));
+#else
+  EXPECT_EQ(input->source, AccessLocalCoreSource::kDevFiles);
+  EXPECT_EQ(input->manifest, directory.GetPath().AppendASCII("dev-manifest"));
+  EXPECT_EQ(input->node_config, directory.GetPath().AppendASCII("dev-node"));
+#endif
+}
