 # Copyright 2026 GCSA
 # Intended path: chrome/browser/aegis/access/BUILD.gn
 
+import("//build/buildflag_header.gni")
+import("//chrome/browser/aegis/access/alpha_access.gni")
 import("//testing/test.gni")
 
+buildflag_header("access_buildflags") {
+  header = "access_buildflags.h"
+  flags = [ "AEGIS_ALPHA_TEST_NODE_ENABLED=$aegis_alpha_test_node_enabled" ]
+}
+
+if (aegis_alpha_test_node_enabled) {
+  action("alpha_access_resource_files") {
+    script = "prepare_alpha_access_resources.py"
+    inputs = [
+      "$aegis_alpha_test_resources_dir/core-manifest.json",
+      "$aegis_alpha_test_resources_dir/node.json",
+      "$aegis_alpha_test_resources_dir/xray",
+    ]
+    outputs = [
+      "$root_out_dir/AegisAlphaAccess/core-manifest.json",
+      "$root_out_dir/AegisAlphaAccess/node.json",
+      "$root_out_dir/AegisAlphaAccess/xray",
+    ]
+    args = [
+      "--channel",
+      "alpha",
+      "--source-dir",
+      rebase_path(aegis_alpha_test_resources_dir, root_build_dir),
+      "--output-dir",
+      rebase_path("$root_out_dir/AegisAlphaAccess", root_build_dir),
+    ]
+  }
+
+  bundle_data("alpha_access_bundle_data") {
+    sources = get_target_outputs(":alpha_access_resource_files")
+    outputs =
+        [ "{{bundle_resources_dir}}/AegisAlphaAccess/{{source_file_part}}" ]
+    deps = [ ":alpha_access_resource_files" ]
+  }
+}
+
