+++ b/chrome/browser/ui/BUILD.gn
@@ -296,7 +296,6 @@ if (!is_android) {
     sources = [ "browser_actions.cc" ]
     public_deps = [ "//base" ]
     deps = [
-      "//chrome/common/aegis",
       ":browser_actions",
       ":browser_command_controller",
       ":browser_commands",
@@ -1344,7 +1343,7 @@ if (!is_android) {
       "//cc/paint",
       "//chrome/app:command_ids",
       "//chrome/browser/profiles:profile",
-      "//chrome/browser/ui/browser_window/public",
+      "//chrome/browser/ui/browser_window",
       "//chrome/browser/ui/tabs:tab_strip",
       "//chrome/common",
       "//components/input",
@@ -1354,6 +1353,7 @@ if (!is_android) {
     ]
   }
 }
+
 # Browser is the desktop implementation of BrowserWindowInterface. It is
 # deliberately kept out of reach of new code: features must go through
 # BrowserWindowInterface instead. The visibility list below is intentionally
diff --git a/chrome/browser/ui/tabs/BUILD.gn b/chrome/browser/ui/tabs/BUILD.gn
index 78f1d93ceb24b76cc4483d1844457f168df1fb4e..be8d237d05cce7642b22e556b27fdca15688f7f8 100644
--- a/chrome/browser/ui/tabs/BUILD.gn
+++ b/chrome/browser/ui/tabs/BUILD.gn
@@ -544,6 +544,7 @@ if (!is_android) {
     }
 
     deps = [
+      "//chrome/browser/aegis",
       "//chrome/browser/ui:aegis_mouse_gesture_tab_helper",
       ":tab_group",
       ":tab_model",
diff --git a/chrome/browser/ui/toolbar/pinned_toolbar/BUILD.gn b/chrome/browser/ui/toolbar/pinned_toolbar/BUILD.gn
index 1f7f09745e57e1fb114b6b162606d4c0a0ea7fd3..2641909c049cf027b10935bcb15dee5ee443122f 100644
--- a/chrome/browser/ui/toolbar/pinned_toolbar/BUILD.gn
+++ b/chrome/browser/ui/toolbar/pinned_toolbar/BUILD.gn
@@ -55,7 +55,6 @@ source_set("impl") {
   }
 
   if (!is_android) {
-    deps += [ "//chrome/common/aegis" ]
   }
 }
 
