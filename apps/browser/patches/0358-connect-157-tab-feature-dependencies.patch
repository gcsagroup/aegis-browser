+++ b/chrome/browser/android/BUILD.gn
@@ -155,6 +155,7 @@ source_set("tabs_impl") {
   sources = [ "tab_features.cc" ]
 
   deps = [
+    "//chrome/browser/aegis",
     ":media_state_observer",
     ":oom_intervention",
     ":persisted_tab_data",
diff --git a/chrome/browser/renderer_context_menu/BUILD.gn b/chrome/browser/renderer_context_menu/BUILD.gn
index 2f0393a0b9e8f990cc7cb216aac5ec04eb0f2bb1..e78c2c99a9f0c444efd57ca1191272705783fd06 100644
--- a/chrome/browser/renderer_context_menu/BUILD.gn
+++ b/chrome/browser/renderer_context_menu/BUILD.gn
@@ -113,7 +113,6 @@ source_set("impl") {
     ]
 
     deps += [
-      "//chrome/browser/aegis",
       "//chrome/app:command_ids",
       "//chrome/app:generated_resources",
       "//chrome/browser:browser_features",
diff --git a/chrome/browser/ui/BUILD.gn b/chrome/browser/ui/BUILD.gn
index 325f867008f1b603d2d10fe573b3190369188c2b..5a6e29a6fdb70386ba3666d56bb4e30e9167abe8 100644
