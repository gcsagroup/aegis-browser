diff --git a/chrome/browser/android/BUILD.gn b/chrome/browser/android/BUILD.gn
index 058b8e23f8a087f2784c0c552f1f8f728cbd1e17..2680ccf698a652d54ced948f27b9ed383dfaa6b6 100644
