+  test('RestoresInputFocusAfterVoiceModeEnds', async () => {
+    const originalWindowProxy = WindowProxy.getInstance();
+    const speech = new EventTarget() as unknown as SpeechRecognition & {
+      onend?: (event: Event) => void,
+    };
+    let recognizing = false;
+    speech.start = () => {
+      recognizing = true;
+    };
+    speech.abort = () => {
+      if (recognizing) {
+        recognizing = false;
+        queueMicrotask(() => speech.onend?.(new Event('end')));
+      }
+    };
+    WindowProxy.setInstance(Object.assign(new WindowProxy(), {
+      hasWebkitSpeechRecognition: () => true,
+      createSpeechRecognition: () => speech,
+    }));
+    testProxy.handler.setPromiseResolveFor<'getInputState'>('getInputState', {
+      state: {
+        ...createDefaultInputState(),
+        allowedInputTypes: [InputType.kBrowserTab],
+      },
+    });
+
+    const app = document.createElement('omnibox-aim-app');
+    try {
+      document.body.appendChild(app);
+      const composebox = app.$.composebox;
+      composebox.setBaseSearchboxLayoutModeForTesting('TallBottomContext');
+      await microtasksFinished();
+
+      const inputHost = composebox.getInputElement();
+      const input = inputHost.inputElement;
+      const microphone = composebox.shadowRoot.querySelector<HTMLElement>(
+          '#voiceSearchButton');
+      assertTrue(!!microphone, 'The microphone button must be rendered');
+      assertTrue(microphone.checkVisibility());
+      assertTrue(input.checkVisibility());
+      assertTrue(document.hasFocus(), 'The AIM test page must have focus');
+      microphone.focus();
+      assertEquals(microphone, composebox.shadowRoot.activeElement);
+      microphone.click();
+      await microtasksFinished();
+
+      assertTrue(recognizing, 'The microphone button must start recognition');
+      assertTrue(composebox.inVoiceSearchMode);
+      assertFalse(input.checkVisibility(), 'Voice mode must hide the input');
+      assertNotEquals(input, inputHost.shadowRoot.activeElement);
+
+      const voiceSearch =
+          composebox.shadowRoot.querySelector<ComposeboxVoiceSearchElement>(
+              '#voiceSearch');
+      assertTrue(!!voiceSearch);
+      testProxy.page.onPermissionPromptChanged(true, {width: 250, height: 220});
+      await testProxy.page.$.flushForTesting();
+      assertTrue(voiceSearch.isPermissionPromptOpen);
+      testProxy.page.onPermissionPromptChanged(false, {width: 0, height: 0});
+      await testProxy.page.$.flushForTesting();
+      assertFalse(voiceSearch.isPermissionPromptOpen);
+      await voiceSearch.updateComplete;
+
+      const closeButton =
+          voiceSearch.shadowRoot.querySelector<HTMLElement>('#closeButton');
+      assertTrue(!!closeButton, 'The voice close button must be rendered');
+      assertTrue(closeButton.checkVisibility());
+      closeButton.focus();
+      assertEquals(closeButton, voiceSearch.shadowRoot.activeElement);
+
+      page.focusInput();
+      await page.$.flushForTesting();
+      assertTrue(document.hasFocus(), 'The AIM test page must stay focused');
+      assertTrue(composebox.inVoiceSearchMode);
+      assertFalse(input.checkVisibility());
+      assertNotEquals(input, inputHost.shadowRoot.activeElement);
+      assertEquals(closeButton, voiceSearch.shadowRoot.activeElement);
+
+      closeButton.click();
+      await microtasksFinished();
+      assertFalse(recognizing, 'The voice close button must end recognition');
+      assertFalse(composebox.inVoiceSearchMode);
+      assertTrue(input.checkVisibility());
+      assertTrue(document.hasFocus(), 'The AIM test page must stay focused');
+      assertEquals(
+          input, inputHost.shadowRoot.activeElement,
+          'The browser focus request must reach the input after voice mode');
+    } finally {
+      app.remove();
+      WindowProxy.setInstance(originalWindowProxy);
+    }
+  });
