diff --git a/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
index ae026a7273..2c93e793f3 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AboutChromeSettings.java
@@ -97,7 +97,7 @@ public class AboutChromeSettings extends ChromeBaseSettingsFragment
         try {
             PackageInfo product = context.getPackageManager().getPackageInfo(context.getPackageName(), 0);
             if (product.versionName != null) {
-                version = product.versionName + " · Chromium " + version;
+                version = product.versionName + " · Chromium " + VersionInfo.getProductVersion();
             }
         } catch (NameNotFoundException ignored) {
             // 保留原内核信息，避免关于页因包信息异常崩溃。
diff --git a/chrome/browser/aegis/agent/aegis_agent_service_unittest.cc b/chrome/browser/aegis/agent/aegis_agent_service_unittest.cc
