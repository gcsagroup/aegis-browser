From 92a55508d36bef8db7e7da803ad987d28b59d85c Mon Sep 17 00:00:00 2001
From: Aegis Browser <devnull@localhost>
Date: Mon, 16 Nov 2026 02:40:58 +0800
Subject: [PATCH] fix(macOS): handle ignored buttons retained by AppKit

Use the AX tree leaf rules for an ignored button that AppKit can still query. Preserve unignored descendants and exercise the live Cocoa wrapper across the state change.
---
 .../platform/browser_accessibility_mac.mm     | 10 ++++--
 .../browser_accessibility_mac_unittest.mm     | 31 +++++++++++++++++++
 2 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/ui/accessibility/platform/browser_accessibility_mac.mm b/ui/accessibility/platform/browser_accessibility_mac.mm
index c69a53c42beeb3d94f141f92d94f6cddc170297e..31cecb7c32138577f00a9ffe9bef3298660f24c8 100644
--- a/ui/accessibility/platform/browser_accessibility_mac.mm
+++ b/ui/accessibility/platform/browser_accessibility_mac.mm
@@ -205,6 +205,13 @@ bool HasOnlyPresentationalButtonDescendants(
 }
 
 bool BrowserAccessibilityMac::IsLeaf() const {
+  const bool is_button = GetRole() == ax::mojom::Role::kButton;
+  if (is_button && IsIgnored()) {
+    // AppKit can still query a wrapper after the button becomes ignored.
+    // The AX tree's leaf rules keep unignored descendants exposed.
+    return node()->IsLeaf();
+  }
+
   if (BrowserAccessibility::IsLeaf()) {
     return true;
   }
@@ -213,8 +220,7 @@ bool HasOnlyPresentationalButtonDescendants(
   // non-presentational descendants are detected and treated, and whether this
   // behavior should be platform-agnostic, once the standards discussion is
   // resolved.
-  return GetRole() == ax::mojom::Role::kButton &&
-         HasOnlyPresentationalButtonDescendants(*this);
+  return is_button && HasOnlyPresentationalButtonDescendants(*this);
 }
 
 BrowserAccessibility* BrowserAccessibilityMac::PlatformGetFirstChild() const {
diff --git a/ui/accessibility/platform/browser_accessibility_mac_unittest.mm b/ui/accessibility/platform/browser_accessibility_mac_unittest.mm
index c7c50a7f5bf24790e3cbad6448fa25d240785dea..627236d7812b51df0bec914de178dfde9efd32ec 100644
--- a/ui/accessibility/platform/browser_accessibility_mac_unittest.mm
+++ b/ui/accessibility/platform/browser_accessibility_mac_unittest.mm
@@ -331,6 +331,37 @@ void SetRootValue(std::string value) {
   const base::test::SingleThreadTaskEnvironment task_environment_;
 };
 
+TEST_F(BrowserAccessibilityMacTest, RetainedButtonCanExposeChildrenWhenIgnored) {
+  AXNodeData button = manager_->GetFromID(1001)->GetData();
+  AXNodeData link;
+  link.id = 1003;
+  link.role = ax::mojom::Role::kLink;
+  link.SetName("Link");
+  link.AddState(ax::mojom::State::kFocusable);
+  button.child_ids.push_back(link.id);
+
+  AXTreeUpdate update;
+  update.nodes = {button, link};
+  ASSERT_TRUE(manager_->ax_tree()->Unserialize(update));
+
+  BrowserAccessibility* ax_button = manager_->GetFromID(button.id);
+  BrowserAccessibilityCocoa* retained_button =
+      ObjCCastStrict<BrowserAccessibilityCocoa>(
+          ax_button->GetNativeViewAccessible().Get());
+  id cocoa_link =
+      manager_->GetFromID(link.id)->GetNativeViewAccessible().Get();
+  ASSERT_NSEQ(@[ cocoa_link ], [retained_button accessibilityChildren]);
+
+  // AppKit can still query an element retained before the tree changed.
+  button.AddState(ax::mojom::State::kIgnored);
+  update.nodes = {button};
+  ASSERT_TRUE(manager_->ax_tree()->Unserialize(update));
+  ASSERT_TRUE(ax_button->IsIgnored());
+  EXPECT_NSEQ(@[ cocoa_link ], [retained_button accessibilityChildren]);
+  ASSERT_EQ(2u, [accessibility_ accessibilityChildren].count);
+  EXPECT_NSEQ(cocoa_link, [accessibility_ accessibilityChildren][0]);
+}
+
 // Standard hit test.
 TEST_F(BrowserAccessibilityMacTest, HitTestTest) {
   BrowserAccessibilityCocoa* firstChild =
