diff --git a/chrome/browser/resources/aegis_agent/local_ai_client.ts b/chrome/browser/resources/aegis_agent/local_ai_client.ts
index 03106928688ac0865cd3f84b18cae129cb11461a..9480ba20876d9e5f92d9dc7f3e79b99d7c41771d 100644
--- a/chrome/browser/resources/aegis_agent/local_ai_client.ts
+++ b/chrome/browser/resources/aegis_agent/local_ai_client.ts
@@ -25,19 +25,26 @@ export class LocalAiClient {
       this.reject = reject;
       const worker = new Worker(getTrustedScriptURL`./local_ai/worker.js` as string, {type: 'module'});
       this.worker = worker;
-      this.timer = window.setTimeout(() => this.cancel('runtime_timeout'), request['op'] === 'download' ? 600000 : 180000);
+      const timer = window.setTimeout(() => {
+        if (this.worker === worker) this.cancel('runtime_timeout');
+      }, request['op'] === 'download' ? 600000 : 180000);
+      this.timer = timer;
       const finish = () => {
-        window.clearTimeout(this.timer);
+        window.clearTimeout(timer);
         worker.terminate();
         if (this.worker === worker) { this.worker = null; this.reject = null; }
       };
       worker.onmessage = ({data}: MessageEvent<{progress?: string, error?: string, result?: LocalAiResult}>) => {
+        if (this.worker !== worker) return;
         if (data.progress) { progress(data.progress); return; }
         finish();
         if (data.error || !data.result) reject(new Error(data.error || 'invalid_result'));
         else resolve(data.result);
       };
-      worker.onerror = () => { finish(); reject(new Error('runtime_unavailable')); };
+      worker.onerror = () => {
+        if (this.worker !== worker) return;
+        finish(); reject(new Error('runtime_unavailable'));
+      };
       worker.postMessage(request);
     });
   }
diff --git a/chrome/browser/resources/aegis_agent/reading_workspace.ts b/chrome/browser/resources/aegis_agent/reading_workspace.ts
