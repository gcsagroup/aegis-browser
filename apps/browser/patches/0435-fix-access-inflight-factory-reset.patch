From f063081aa42b5ed04878ba41c9a0b83898d1aced Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 11 Nov 2026 08:26:19 +0800
Subject: [PATCH] fix(access): retain in-flight loaders when resetting private
 factories

---
 .../network/aegis/access_network_context_state.cc     | 11 ++++++++---
 .../aegis/access_private_url_loader_factory.cc        |  6 ++++++
 .../network/aegis/access_private_url_loader_factory.h |  1 +
 3 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/services/network/aegis/access_network_context_state.cc b/services/network/aegis/access_network_context_state.cc
index bc56c3279796768f7157597c6a4be209ce8afd62..2d880acf8ad2b11778bed66ac008a9207e4743bd 100644
--- a/services/network/aegis/access_network_context_state.cc
+++ b/services/network/aegis/access_network_context_state.cc
@@ -1,5 +1,6 @@
 // Copyright 2026 GCSA
 #include "services/network/aegis/access_network_context_state.h"
+#include <vector>
 #include "base/check.h"
 #include "base/functional/bind.h"
 #include "services/network/public/mojom/network_context.mojom.h"
@@ -33,9 +34,13 @@ AccessNetworkContextState::~AccessNetworkContextState() {
 void AccessNetworkContextState::ResetFactories() {
   // Match NetworkContext's original factory contract, including extension
   // service-worker factories that must survive webRequest-triggered resets.
-  std::erase_if(factories_, [](const auto& factory) {
-    return !factory->ignore_factory_reset();
-  });
+  // ClearBindings() may synchronously remove an idle factory. Match the
+  // original NetworkContext iteration without invalidating this set's cursor.
+  std::vector<AccessPrivateURLLoaderFactory*> reset;
+  for (const auto& factory : factories_) {
+    if (!factory->ignore_factory_reset()) reset.push_back(factory.get());
+  }
+  for (auto* factory : reset) factory->ClearBindings();
 }
 bool AccessNetworkContextState::Install(
     const mojom::AegisAccessSnapshot& snapshot) {
diff --git a/services/network/aegis/access_private_url_loader_factory.cc b/services/network/aegis/access_private_url_loader_factory.cc
index 515931824e7162a13372b81794e4bc2b85c58266..b694791450b088d1c57c983361ac4c1de807bd69 100644
--- a/services/network/aegis/access_private_url_loader_factory.cc
+++ b/services/network/aegis/access_private_url_loader_factory.cc
@@ -210,6 +210,12 @@ void AccessPrivateURLLoaderFactory::Clone(
     mojo::PendingReceiver<mojom::AegisAccessURLLoaderFactory> receiver) {
   receivers_.Add(this, std::move(receiver));
 }
+void AccessPrivateURLLoaderFactory::ClearBindings() {
+  receivers_.Clear();
+  // Active facades and CORS loaders retain this factory until their normal
+  // completion/cancellation path; only admission through old receivers ends.
+  cors_factory_->DeleteIfNeeded();
+}
 bool AccessPrivateURLLoaderFactory::HasAdditionalReferences() const {
   return !receivers_.empty() || !requests_.empty();
 }
diff --git a/services/network/aegis/access_private_url_loader_factory.h b/services/network/aegis/access_private_url_loader_factory.h
index 9f6fc2dc465d5c9543eaea16f6f2b9f7c93e44e6..7619789af98710b4ca32db4d7279b038b44f3f5f 100644
--- a/services/network/aegis/access_private_url_loader_factory.h
+++ b/services/network/aegis/access_private_url_loader_factory.h
@@ -51,6 +51,7 @@ class COMPONENT_EXPORT(NETWORK_SERVICE) AccessPrivateURLLoaderFactory final
   bool HasAdditionalReferences() const override;
   void DestroyURLLoaderFactory(cors::CorsURLLoaderFactory* factory) override;
   bool ignore_factory_reset() const { return ignore_factory_reset_; }
+  void ClearBindings();
 
  private:
   class Request;
-- 
