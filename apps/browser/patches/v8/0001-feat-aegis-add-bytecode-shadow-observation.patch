+// Copyright 2026 GCSA
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/interpreter/aegis-bytecode-shadow.h"
+
+#include <array>
+
+#include "src/base/vector.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace v8 {
+namespace internal {
+namespace interpreter {
+namespace {
+
+TEST(AegisBytecodeShadowTest, SignatureIsDeterministicAndOrderSensitive) {
+  constexpr std::array<uint8_t, 4> kFirst = {1, 4, 9, 16};
+  constexpr std::array<uint8_t, 4> kSame = {1, 4, 9, 16};
+  constexpr std::array<uint8_t, 4> kReordered = {1, 9, 4, 16};
+  EXPECT_EQ(AegisOpcodeSequenceSignature(base::VectorOf(kFirst)),
+            AegisOpcodeSequenceSignature(base::VectorOf(kSame)));
+  EXPECT_NE(AegisOpcodeSequenceSignature(base::VectorOf(kFirst)),
+            AegisOpcodeSequenceSignature(base::VectorOf(kReordered)));
+}
+
+TEST(AegisBytecodeShadowTest, SignatureSeparatesDifferentLengths) {
+  constexpr std::array<uint8_t, 2> kShort = {7, 8};
+  constexpr std::array<uint8_t, 3> kLong = {7, 8, 0};
+  EXPECT_NE(AegisOpcodeSequenceSignature(base::VectorOf(kShort)),
+            AegisOpcodeSequenceSignature(base::VectorOf(kLong)));
+}
+
+TEST(AegisBytecodeShadowTest, EmptySequenceStillHasVersionedSignature) {
+  EXPECT_NE(0u, AegisOpcodeSequenceSignature(base::Vector<const uint8_t>()));
+}
+
+}  // namespace
+}  // namespace interpreter
+}  // namespace internal
+}  // namespace v8
