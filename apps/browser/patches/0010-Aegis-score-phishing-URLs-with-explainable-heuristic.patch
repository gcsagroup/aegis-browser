+std::u16string ReasonLabel(const PhishReason& reason, bool zh) {
+  if (reason.code == "seed_host") {
+    return zh ? u"匹配内置钓鱼种子规则" : u"Matches a built-in phishing seed";
+  }
+  if (reason.code == "insecure_http") {
+    return zh ? u"未使用 HTTPS" : u"Not using HTTPS";
+  }
+  if (reason.code == "ip_hostname") {
+    return zh ? u"使用 IP 地址作为主机名" : u"Hostname is an IP address";
+  }
+  if (reason.code == "punycode_host") {
+    return zh ? u"国际化域名（Punycode）" : u"Punycode / IDN hostname";
+  }
+  if (reason.code == "deep_subdomain") {
+    return zh ? u"过深的子域名" : u"Unusually deep subdomain";
+  }
+  if (reason.code == "suspicious_tld") {
+    return zh ? u"高风险顶级域" : u"High-risk top-level domain";
+  }
+  if (reason.code == "brand_spoof_host") {
+    return zh ? u"主机名仿冒品牌" : u"Brand spoof in hostname";
+  }
+  if (reason.code == "at_symbol_trick") {
+    return zh ? u"URL 含 @ 欺骗" : u"@ trick in the URL";
+  }
+  if (reason.code == "invalid_url") {
+    return zh ? u"无效地址" : u"Invalid URL";
+  }
+  return base::UTF8ToUTF16(reason.code);
+}
+
+std::u16string FormatReasons(const PhishAssessment& assessment, bool zh) {
+  std::u16string text;
+  for (const PhishReason& reason : assessment.reasons) {
+    if (!text.empty()) {
+      text += u"<br>";
+    }
+    text += u"• ";
+    text += ReasonLabel(reason, zh);
+    if (!reason.detail.empty()) {
+      text += u" (";
+      text += base::UTF8ToUTF16(reason.detail);
+      text += u")";
+    }
+  }
+  return text;
+}
+
 }  // namespace
 
