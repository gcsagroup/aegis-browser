   load_time_data.Set("primaryButtonText",
                      zh ? u"返回安全页面" : u"Back to safety");
   load_time_data.Set("proceedButtonText",
@@ -126,7 +181,6 @@ void AegisPhishBlockingPage::PopulateValuesForSharedHTML(
