---
 chrome/browser/aegis/agent/agent_core_unittest.cc  | 9 +++++++++
 chrome/browser/aegis/agent/agent_task.cc           | 2 +-
 chrome/browser/ui/webui/help/aegis_github_update.h | 4 ++--
 3 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/aegis/agent/agent_core_unittest.cc b/chrome/browser/aegis/agent/agent_core_unittest.cc
index bc680858fb..ab63bc1fac 100644
--- a/chrome/browser/aegis/agent/agent_core_unittest.cc
+++ b/chrome/browser/aegis/agent/agent_core_unittest.cc
@@ -235,6 +235,15 @@ TEST(AegisAgentTaskTest, EnforcesTransitionsTerminalStateAndBudgets) {
   EXPECT_TRUE(task.TransitionTo(AgentTaskState::kCompleted, "done"));
   EXPECT_FALSE(task.TransitionTo(AgentTaskState::kRunning, "reopen"));
   EXPECT_EQ(task.events().size(), 5u);
+  AgentTask invalidated("invalidated-before-consent", "当前页面操作",
+                        AgentMode::kAct, TestScope());
+  ASSERT_TRUE(invalidated.TransitionTo(AgentTaskState::kPlanning, "制定计划"));
+  ASSERT_TRUE(invalidated.TransitionTo(AgentTaskState::kAwaitingTaskConsent,
+                                       "等待授权"));
+  EXPECT_TRUE(invalidated.TransitionTo(AgentTaskState::kFailed,
+                                       "原页面绑定已失效"));
+  EXPECT_FALSE(invalidated.TransitionTo(AgentTaskState::kRunning,
+                                        "不得重开失败任务"));
 }
 
 TEST(AegisAgentTaskTest, RecordsTimelineFactWithoutChangingState) {
diff --git a/chrome/browser/aegis/agent/agent_task.cc b/chrome/browser/aegis/agent/agent_task.cc
index b50916692b..fe7234c205 100644
--- a/chrome/browser/aegis/agent/agent_task.cc
+++ b/chrome/browser/aegis/agent/agent_task.cc
@@ -205,7 +205,7 @@ bool AgentTask::IsAllowedTransition(AgentTaskState from, AgentTaskState to) {
              to == State::kCancelled;
     case State::kAwaitingTaskConsent:
       return to == State::kRunning || to == State::kCancelled ||
-             to == State::kExpired;
+             to == State::kExpired || to == State::kFailed;
     case State::kRunning:
     case State::kReflecting:
       return to == State::kRunning || to == State::kReflecting ||
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
index c652b8326a..2d84b010fb 100644
--- a/chrome/browser/ui/webui/help/aegis_github_update.h
+++ b/chrome/browser/ui/webui/help/aegis_github_update.h
@@ -21,8 +21,8 @@ class SimpleURLLoader;
 
