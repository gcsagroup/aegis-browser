+  scoped_refptr<content::DevToolsAgentHost> internal_target =
+      content::DevToolsAgentHost::GetOrCreateFor(internal_contents);
+  const std::string internal_target_id = internal_target->GetId();
+
+  AttachToBrowserTarget();
+
+  const base::DictValue* targets_result = SendCommandSync("Target.getTargets");
+  ASSERT_TRUE(targets_result);
+  const base::ListValue* target_infos = targets_result->FindList("targetInfos");
+  ASSERT_TRUE(target_infos);
+  bool found_http_target = false;
+  bool found_internal_target = false;
+  for (const base::Value& target_info : *target_infos) {
+    const std::string* target_id = target_info.GetDict().FindString("targetId");
+    ASSERT_TRUE(target_id);
+    found_http_target |= *target_id == http_target_id;
+    found_internal_target |= *target_id == internal_target_id;
