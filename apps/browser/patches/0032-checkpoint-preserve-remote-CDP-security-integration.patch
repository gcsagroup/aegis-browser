+  ASSERT_TRUE(
+      content::NavigateToURL(target_contents, GURL(chrome::kChromeUIAegisURL)));
+
+  base::DictValue destroyed = WaitForMatchingNotification(
+      "Target.targetDestroyed",
+      base::BindRepeating(
+          [](const std::string& expected_target_id,
+             const base::DictValue& params) {
+            const std::string* target_id = params.FindString("targetId");
+            return target_id && *target_id == expected_target_id;
+          },
+          target_id));
+  EXPECT_EQ(target_id, *destroyed.FindString("targetId"));
+
+  base::DictValue detached = WaitForMatchingNotification(
+      "Target.detachedFromTarget",
+      base::BindRepeating(
+          [](const std::string& expected_session_id,
+             const base::DictValue& params) {
+            const std::string* session_id = params.FindString("sessionId");
+            return session_id && *session_id == expected_session_id;
+          },
+          attached_session_id));
