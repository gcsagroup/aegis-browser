+
+  const base::DictValue* targets_result = SendCommandSync("Target.getTargets");
+  ASSERT_TRUE(targets_result);
+  const base::ListValue* target_infos = targets_result->FindList("targetInfos");
+  ASSERT_TRUE(target_infos);
+  for (const base::Value& target_info : *target_infos) {
+    const std::string* current_target_id =
+        target_info.GetDict().FindString("targetId");
+    ASSERT_TRUE(current_target_id);
+    EXPECT_NE(target_id, *current_target_id);
+  }
+}
