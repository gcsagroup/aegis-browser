+  scoped_refptr<DevToolsAgentHost> target = DevToolsAgentHost::Forward(
+      target_id, std::make_unique<PolicyTestExternalAgentDelegate>(
+                     DevToolsAgentHost::kTypePage, GURL("chrome://aegis"),
+                     &attach_count, &activate_count, &close_count));
+  const auto upgrade_headers = std::map<std::string, std::string>{
+      {"connection", "upgrade"}, {"upgrade", "websocket"}};
+  std::string denied_body;
+  auto request = RunRequestUntilCompletion(
+      base::StringPrintf("http://127.0.0.1:%d/devtools/page/%s", port,
+                         target_id.c_str()),
+      upgrade_headers, &denied_body);
+  EXPECT_EQ(404, request->GetResponseCode());
+  EXPECT_EQ(0, attach_count);
+
+  target = nullptr;
+  std::string missing_body;
+  request = RunRequestUntilCompletion(
+      base::StringPrintf("http://127.0.0.1:%d/devtools/page/%s", port,
+                         target_id.c_str()),
+      upgrade_headers, &missing_body);
+  EXPECT_EQ(404, request->GetResponseCode());
+  EXPECT_EQ(missing_body, denied_body);
+
+  target = DevToolsAgentHost::Forward(
+      target_id,
+      std::make_unique<PolicyTestExternalAgentDelegate>(
+          DevToolsAgentHost::kTypePage, GURL("https://example.test/public"),
+          &attach_count, &activate_count, &close_count));
+  request = RunRequestUntilCompletion(
+      base::StringPrintf("http://127.0.0.1:%d/devtools/page/%s", port,
+                         target_id.c_str()),
+      upgrade_headers);
+  EXPECT_EQ(500, request->GetResponseCode());
+  EXPECT_EQ(1, attach_count);
+
+  StopServer();
+}
