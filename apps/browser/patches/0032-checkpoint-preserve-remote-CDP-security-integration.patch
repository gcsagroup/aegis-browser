+  scoped_refptr<content::DevToolsAgentHost> target =
+      content::DevToolsAgentHost::GetOrCreateFor(target_contents);
+  const std::string target_id = target->GetId();
+
+  AttachToBrowserTarget();
+
+  ASSERT_TRUE(SendCommandSync("Target.setDiscoverTargets",
+                              base::DictValue().Set("discover", true)));
+  const base::DictValue* attach_result = SendCommandSync(
+      "Target.attachToTarget",
+      base::DictValue().Set("targetId", target_id).Set("flatten", true));
+  ASSERT_TRUE(attach_result);
+  const std::string* session_id = attach_result->FindString("sessionId");
+  ASSERT_TRUE(session_id);
+  const std::string attached_session_id = *session_id;
+  ClearNotifications();
