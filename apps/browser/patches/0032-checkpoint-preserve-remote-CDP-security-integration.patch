   const GURL url_copy = url;
   raw->CollectAegisPageSignals(base::BindOnce(
       [](std::unique_ptr<mojo::AssociatedRemote<
              chrome::mojom::ChromeRenderFrame>> keep_alive,
-         base::WeakPtr<PhishTabHelper> self, const GURL& url,
+         base::WeakPtr<PhishTabHelper> self,
+         content::WeakDocumentPtr source_document, const GURL& url,
          int32_t password_fields, int32_t forms, const std::string& title,
          const std::string& text_sample) {
         if (!self) {
           return;
         }
-        self->checking_ = false;
-        self->OnPageSignals(url, password_fields, forms, title, text_sample);
+        self->OnPageSignalsCollected(std::move(source_document), url,
+                                     password_fields, forms, title,
+                                     text_sample);
       },
-      std::move(client), weak_factory_.GetWeakPtr(), url_copy));
+      std::move(client), weak_factory_.GetWeakPtr(), std::move(source_document),
+      url_copy));
+}
+
+void PhishTabHelper::InvalidatePageSignalCheck() {
+  checking_ = false;
+  checking_document_ = content::WeakDocumentPtr();
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+void PhishTabHelper::OnPageSignalsCollected(
+    content::WeakDocumentPtr source_document,
+    const GURL& url,
+    int32_t password_fields,
+    int32_t forms,
+    const std::string& title,
+    const std::string& text_sample) {
+  content::RenderFrameHost* source_frame =
+      source_document.AsRenderFrameHostIfValid();
+  if (!checking_ || !source_frame ||
+      checking_document_.AsRenderFrameHostIfValid() != source_frame) {
+    return;
+  }
+
+  checking_ = false;
+  checking_document_ = content::WeakDocumentPtr();
+  OnPageSignals(std::move(source_document), url, password_fields, forms, title,
+                text_sample);
 }
 
