+
+bool RenderFrameDevToolsAgentHost::ShouldAllowSessionForNavigation(
+    const GURL& url,
+    bool is_webui,
+    DevToolsSession* session) {
+  if (!session->GetClient()->MayAttachToURL(url, is_webui)) {
+    return false;
+  }
+  if (!session->GetClient()->IsRemoteDebuggingClient()) {
+    return true;
+  }
+  DevToolsManagerDelegate* delegate =
+      DevToolsManager::GetInstance()->delegate();
+  DevToolsAgentHost* agent_host = session->GetAgentHost();
+  return !delegate ||
+         (agent_host && delegate->AllowRemoteDebuggingTargetOperation(
+                            DevToolsManagerDelegate::
+                                RemoteDebuggingTargetOperation::kNavigate,
+                            agent_host->GetType(), url));
 }
 
