+namespace {
+
+constexpr size_t kAegisFarblingSecretSize = 32;
+
+std::vector<uint8_t> LoadOrCreateAegisFarblingSecret(Profile* profile) {
+  if (profile->IsOffTheRecord() || profile->IsGuestSession()) {
+    return base::RandBytesAsVector(kAegisFarblingSecretSize);
+  }
+
+  PrefService* prefs = profile->GetPrefs();
+  const std::optional<std::vector<uint8_t>> decoded = base::Base64Decode(
+      prefs->GetString(aegis::prefs::kFingerprintFarblingSecret));
+  if (decoded && decoded->size() == kAegisFarblingSecretSize) {
+    return *decoded;
+  }
+
+  std::vector<uint8_t> secret =
+      base::RandBytesAsVector(kAegisFarblingSecretSize);
+  prefs->SetString(aegis::prefs::kFingerprintFarblingSecret,
+                   base::Base64Encode(secret));
+  return secret;
+}
+
+}  // namespace
+
 RendererUpdater::RendererUpdater(Profile* profile)
     : profile_(profile),
       is_off_the_record_(profile_->IsOffTheRecord()),
-      original_profile_(profile->GetOriginalProfile())
