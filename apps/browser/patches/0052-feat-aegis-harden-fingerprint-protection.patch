diff --git a/third_party/blink/renderer/modules/webaudio/audio_buffer_test.cc b/third_party/blink/renderer/modules/webaudio/audio_buffer_test.cc
new file mode 100644
index 0000000000..82b2b63ca8
--- /dev/null
+++ b/third_party/blink/renderer/modules/webaudio/audio_buffer_test.cc
@@ -0,0 +1,84 @@
+// Copyright 2026 GCSA
+
+#include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
+
+#include <array>
+#include <string_view>
+
+#include "base/containers/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/aegis/fingerprint_guard.h"
+#include "third_party/blink/renderer/bindings/core/v8/v8_binding_for_testing.h"
+#include "third_party/blink/renderer/platform/testing/task_environment.h"
+#include "third_party/blink/renderer/platform/weborigin/kurl.h"
+
+namespace blink {
+namespace {
+
+class AudioBufferFarblingTest : public testing::Test {
+ protected:
+  void SetProtectionEnabled(bool enabled) {
+    std::array<uint8_t, aegis::kFarblingSecretSize> secret;
+    for (size_t i = 0; i < secret.size(); ++i) {
+      secret[i] = static_cast<uint8_t>(i);
+    }
+    aegis::SetFingerprintGuardConfiguration(enabled, base::span(secret),
+                                            std::string_view());
+  }
+
+  void TearDown() override {
+    aegis::SetFingerprintGuardConfiguration(false, base::span<const uint8_t>(),
+                                            std::string_view());
+  }
+
+ private:
+  test::TaskEnvironment task_environment_;
+};
+
+TEST_F(AudioBufferFarblingTest, DisabledReadDoesNotBlockLaterFarbling) {
+  V8TestingScope scope(KURL("https://audio.example.test/"));
+  AudioBuffer* buffer = AudioBuffer::Create(1, 4, 48000);
+  ASSERT_TRUE(buffer);
+  const std::array<float, 4> original = {0.25f, 0.5f, 0.75f, 1.0f};
+  buffer->getChannelData(0)->AsSpan().copy_from(original);
+
+  SetProtectionEnabled(false);
+  auto disabled_data =
+      buffer->getChannelData(0, scope.GetExceptionState())->AsSpan();
+  EXPECT_TRUE(disabled_data == base::span(original));
+
+  SetProtectionEnabled(true);
+  auto enabled_data =
+      buffer->getChannelData(0, scope.GetExceptionState())->AsSpan();
+  EXPECT_NE(enabled_data[0], original[0]);
+}
+
+TEST_F(AudioBufferFarblingTest, PartialWritePreservesExactScriptInput) {
+  V8TestingScope scope(KURL("https://audio.example.test/"));
+  AudioBuffer* buffer = AudioBuffer::Create(1, 4, 48000);
+  ASSERT_TRUE(buffer);
+  const std::array<float, 4> original = {0.25f, 0.5f, 0.75f, 1.0f};
+  buffer->getChannelData(0)->AsSpan().copy_from(original);
+  SetProtectionEnabled(true);
+
+  auto first_read =
+      buffer->getChannelData(0, scope.GetExceptionState())->AsSpan();
+  std::array<float, 4> first_farbled;
+  base::span(first_farbled).copy_from(first_read);
+
+  DOMFloat32Array* source = DOMFloat32Array::Create(1);
+  ASSERT_TRUE(source);
+  source->AsSpan()[0] = original[1];
+  buffer->copyToChannel(NotShared<DOMFloat32Array>(source), 0, 1,
+                        scope.GetExceptionState());
+
+  auto second_read =
+      buffer->getChannelData(0, scope.GetExceptionState())->AsSpan();
+  EXPECT_FLOAT_EQ(second_read[0], first_farbled[0]);
+  EXPECT_FLOAT_EQ(second_read[1], original[1]);
+  EXPECT_FLOAT_EQ(second_read[2], first_farbled[2]);
+  EXPECT_FLOAT_EQ(second_read[3], first_farbled[3]);
+}
+
+}  // namespace
+}  // namespace blink
