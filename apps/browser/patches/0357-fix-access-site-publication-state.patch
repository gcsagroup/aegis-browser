+TEST_F(AccessMutationTransactionTest, BubbleOnOffOnUsesCommittedRevision) {
+  ConfigurePrimaryProxyGroup();
+  auto* bubble = AccessSiteProxyBubbleController::GetOrCreate(profile_.get());
+  const AccessSiteHost host{"news.example"};
+  uint64_t previous_generation = 0;
+  for (bool enabled : {true, false, true}) {
+    ASSERT_TRUE(bubble->RequestHostProxySession(host, enabled));
+    task_environment_.RunUntilIdle();
+    ASSERT_TRUE(client_->reply);
+    const auto before_ack = bubble->state_revision();
+    std::move(client_->reply).Run(true);
+    task_environment_.RunUntilIdle();
+    EXPECT_GT(bubble->state_revision(), before_ack);
+    const auto state = bubble->SnapshotForCommittedUrl(GURL("https://news.example"));
+    EXPECT_EQ(state.connection, enabled ? AccessSiteConnectionState::kReady
+                                       : AccessSiteConnectionState::kIdle);
+    EXPECT_TRUE(state.failure_reason.empty());
+    const auto stored = coordinator_->ReadCommittedSnapshot(owner_.storage_partition_token);
+    ASSERT_TRUE(stored.value);
+    EXPECT_GT(stored.value->policy_generation, previous_generation);
+    previous_generation = stored.value->policy_generation;
+  }
+}
+
+TEST_F(AccessMutationTransactionTest, BubbleFailedAckCanRetryAndRecoveryRepublishes) {
+  ConfigurePrimaryProxyGroup();
+  auto* bubble = AccessSiteProxyBubbleController::GetOrCreate(profile_.get());
+  const AccessSiteHost host{"news.example"};
+  ASSERT_TRUE(bubble->RequestHostProxySession(host, true));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(client_->reply);
+  std::move(client_->reply).Run(false);
+  task_environment_.RunUntilIdle();
+  EXPECT_TRUE(coordinator_->has_retained_store());
+  EXPECT_EQ(bubble->SnapshotForCommittedUrl(GURL("https://news.example")).connection,
+            AccessSiteConnectionState::kUnavailable);
+  for (int recovery = 0; recovery != 2; ++recovery) {
+    ASSERT_TRUE(bubble->RecoverHostProxySession(host));
+    task_environment_.RunUntilIdle();
+    // An old committed journal must not turn a new recovery into ready.
+    ASSERT_TRUE(client_->reply);
+    EXPECT_EQ(bubble->SnapshotForCommittedUrl(GURL("https://news.example")).connection,
+              AccessSiteConnectionState::kConnecting);
+    std::move(client_->reply).Run(true);
+    task_environment_.RunUntilIdle();
+    EXPECT_EQ(bubble->SnapshotForCommittedUrl(GURL("https://news.example")).connection,
+              AccessSiteConnectionState::kReady);
+  }
+}
+
+TEST_F(AccessMutationTransactionTest, BubbleReusesStoreRetainedAfterPrepareFailure) {
+  ConfigurePrimaryProxyGroup();
+  auto invalid = Mutation();
+  invalid.expected_revision = 99;
+  base::test::TestFuture<AccessMutationTransactionResult> rejected;
+  coordinator_->CommitSiteGroupMutation(OpenStore(), invalid, Selector(), rejected.GetCallback());
+  ASSERT_TRUE(rejected.Wait());
+  ASSERT_EQ(rejected.Get().status, AccessMutationTransactionStatus::kPrepareFailed);
+  ASSERT_TRUE(coordinator_->has_retained_store());
+  auto* bubble = AccessSiteProxyBubbleController::GetOrCreate(profile_.get());
+  ASSERT_TRUE(bubble->RequestHostProxySession({"news.example"}, true));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(client_->reply);
+  std::move(client_->reply).Run(true);
+  task_environment_.RunUntilIdle();
+  EXPECT_EQ(bubble->SnapshotForCommittedUrl(GURL("https://news.example")).connection,
+            AccessSiteConnectionState::kReady);
+}
+
+TEST_F(AccessMutationTransactionTest, BubbleCanDisableAfterEndpointIsUnavailable) {
+  ConfigurePrimaryProxyGroup();
+  auto* bubble = AccessSiteProxyBubbleController::GetOrCreate(profile_.get());
+  ASSERT_TRUE(bubble->RequestHostProxySession({"news.example"}, true));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(client_->reply);
+  std::move(client_->reply).Run(true);
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(transport_->ClearProxySelection({}));
+  ASSERT_TRUE(bubble->RequestHostProxySession({"news.example"}, false));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(client_->reply);
+  std::move(client_->reply).Run(true);
+  task_environment_.RunUntilIdle();
+  const auto state = bubble->SnapshotForCommittedUrl(GURL("https://news.example"));
+  EXPECT_EQ(state.intent, AccessSiteIntent::kOff);
+  EXPECT_TRUE(state.failure_reason.empty());
+  const auto stored = coordinator_->ReadCommittedSnapshot(owner_.storage_partition_token);
+  ASSERT_TRUE(stored.value);
+  ASSERT_EQ(stored.value->site_groups.size(), 1u);
+  EXPECT_EQ(stored.value->site_groups[0].members[0].policy.mode, AccessMode::kDirect);
+}
+
+TEST_F(AccessMutationTransactionTest, BubbleHostFailuresAreIndependent) {
+  auto* bubble = AccessSiteProxyBubbleController::GetOrCreate(profile_.get());
+  ASSERT_TRUE(bubble->RequestHostProxySession({"news.example"}, true));
+  const auto failed = bubble->SnapshotForCommittedUrl(GURL("https://news.example"));
+  ASSERT_EQ(failed.connection, AccessSiteConnectionState::kUnavailable);
+  ASSERT_FALSE(failed.failure_reason.empty());
+  EXPECT_EQ(failed.intent, AccessSiteIntent::kOff);
+  ASSERT_TRUE(bubble->RequestHostProxySession({"other.example"}, false));
+  task_environment_.RunUntilIdle();
+  ASSERT_TRUE(client_->reply);
+  std::move(client_->reply).Run(true);
+  task_environment_.RunUntilIdle();
+  const auto still_failed = bubble->SnapshotForCommittedUrl(GURL("https://news.example"));
+  EXPECT_EQ(still_failed.connection, failed.connection);
+  EXPECT_EQ(still_failed.failure_reason, failed.failure_reason);
+  EXPECT_EQ(bubble->SnapshotForCommittedUrl(GURL("https://other.example")).connection,
+            AccessSiteConnectionState::kIdle);
+}
