 5 files changed, 79 insertions(+), 12 deletions(-)

diff --git a/chrome/browser/resources/aegis_agent/agent.css b/chrome/browser/resources/aegis_agent/agent.css
index 73194f33d65f00497b577eb21ccb9b1679b669a7..0938005f2761c5ee0a41bc341cdbad7451f6a6de 100644
--- a/chrome/browser/resources/aegis_agent/agent.css
+++ b/chrome/browser/resources/aegis_agent/agent.css
@@ -1071,7 +1071,12 @@ body.reading-workspace-only main > #reading-ai-settings[open] { display:block !i
 body[data-mobile-settings] main > :not(.hero, .mobile-settings-back) { display: none !important; }
 
 body[data-mobile-settings='reading'] main > #reading-ai-settings,
-body[data-mobile-settings='experiments'] main > #reading-research-settings { display: block !important; }
+body[data-mobile-settings='experiments'] main > #reading-research-settings,
+body[data-mobile-settings='workspace'] main > #reading-view,
+body[data-mobile-settings='workspace'] main > #reading-ai-settings[open] { display: block !important; }
+
+body[data-mobile-settings='workspace'] .hero,
+body[data-mobile-settings='workspace'] .mobile-settings-back { display: flex !important; }
 
 body[data-mobile-settings] .hero { align-items: flex-start; }
 
@@ -1082,7 +1087,8 @@ body[data-mobile-settings] .hero .status { display: none; }
 body[data-mobile-settings] details.card { min-width: 0; }
 
 body[data-mobile-settings] details.card > label { display: flex;
- align-items: flex-start;
+ align-items: center;
+ min-height: 48px;
  gap: 12px; }
 
 body[data-mobile-settings] details.card > label > input[type='checkbox'] { flex: none;
@@ -1100,6 +1106,26 @@ body.mobile-agent-shell {
   --shadow: none;
  background: var(--bg);
 }
+
+/* Android 即使接入鼠标或手写笔，也保持可读字号和完整触控面积。 */
+body.mobile-agent-shell label,
+body.mobile-agent-shell summary,
+body.mobile-agent-shell .hero p {
+  font-size: 14px;
+  line-height: 1.5;
+}
+
+body.mobile-agent-shell summary {
+  min-height: 48px;
+  padding-block: 12px;
+}
+
+body.mobile-agent-shell button,
+body.mobile-agent-shell input:not([type='checkbox']),
+body.mobile-agent-shell select {
+  min-height: 48px;
+  font-size: 16px;
+}
 @media (prefers-color-scheme: dark) {
   body.mobile-agent-shell {
     --bg: #202124;
diff --git a/chrome/browser/resources/aegis_agent/mobile_settings.ts b/chrome/browser/resources/aegis_agent/mobile_settings.ts
index b96b3861c9341cb9015d9dbf4458d05d7dbcebb9..bae8da173e0dcd950503a131d13e39d39aedbf54 100644
--- a/chrome/browser/resources/aegis_agent/mobile_settings.ts
+++ b/chrome/browser/resources/aegis_agent/mobile_settings.ts
@@ -23,8 +23,19 @@ export function initializeMobileAgentSettings(
   main.prepend(back);
   if (params.get('view') === 'reading') {
     document.getElementById('goal')?.removeAttribute('autofocus');
+    // 设置内的阅读入口只呈现阅读操作，不混入任务、模型和自动化导航。
+    document.body.dataset['mobileSettings'] = 'workspace';
+    const title = document.getElementById('title');
+    const subtitle = document.getElementById('subtitle');
+    if (!title || !subtitle) throw Error('缺少阅读工作区标题区域');
+    const workspaceTitle = text('阅读工作区', 'Reading workspace', '閱讀工作區');
+    title.textContent = workspaceTitle;
+    document.title = workspaceTitle;
+    subtitle.textContent = text(
+        '整理网页、阅读资料和批注。', 'Organize pages, reading material and notes.', '整理網頁、閱讀資料和批註。');
     showReading();
     void refresh();
+    return;
   }
   if (section !== 'reading' && section !== 'experiments') return;
   document.getElementById('goal')?.removeAttribute('autofocus');
