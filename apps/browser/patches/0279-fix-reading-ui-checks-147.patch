diff --git a/chrome/browser/resources/aegis_agent/agent.css b/chrome/browser/resources/aegis_agent/agent.css
index 2b9bb49c7dc7844c9d74df886ecc4604c2e25dc5..daed0fffaaef1d428512c7bf52f82dea5d502872 100644
--- a/chrome/browser/resources/aegis_agent/agent.css
+++ b/chrome/browser/resources/aegis_agent/agent.css
@@ -792,17 +792,71 @@ summary {
 }
 
 /* 阅读资料的原文保留换行，窄侧栏自动转为单列。 */
-.reading-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-block: 12px; }
-.reading-entry { border-top: 1px solid var(--border-color, #8886); padding-block: 12px; }
-.reading-editor { display: grid; gap: 10px; overflow-wrap: anywhere; }
-.reading-editor label { display: grid; gap: 6px; white-space: pre-wrap; }
-.reading-editor pre { white-space: pre-wrap; font: inherit; max-height: 320px; overflow: auto; }
-.reading-pairs { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
-#reading-tabs label { display: flex; gap: 8px; align-items: start; }
-#reading-tabs span { white-space: pre-wrap; overflow-wrap: anywhere; }
-#reading-tabs { max-height: 260px; overflow: auto; }
-#reading-search { width: 100%; box-sizing: border-box; }
+.reading-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  margin-block: 12px;
+}
+
+.reading-entry {
+  border-top: 1px solid var(--border-color, #8886);
+  padding-block: 12px;
+}
+
+.reading-editor {
+  display: grid;
+  gap: 10px;
+  overflow-wrap: anywhere;
+}
+
+.reading-editor label {
+  display: grid;
+  gap: 6px;
+  white-space: pre-wrap;
+}
+
+.reading-editor pre {
+  white-space: pre-wrap;
+  font: inherit;
+  max-height: 320px;
+  overflow: auto;
+}
+
+.reading-pairs {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+  gap: 12px;
+}
+
+#reading-tabs label {
+  display: flex;
+  gap: 8px;
+  align-items: start;
+}
+
+#reading-tabs span {
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+#reading-tabs {
+  max-height: 260px;
+  overflow: auto;
+}
+
+#reading-search {
+  width: 100%;
+  box-sizing: border-box;
+}
+
 @media (max-width: 480px) {
-  .reading-pairs { grid-template-columns: minmax(0, 1fr); }
-  .reading-pairs h4 { display: none; }
+  .reading-pairs {
+    grid-template-columns: minmax(0, 1fr);
+  }
+
+  .reading-pairs h4 {
+    display: none;
+  }
+
 }
diff --git a/chrome/browser/resources/aegis_agent/reading_workspace.ts b/chrome/browser/resources/aegis_agent/reading_workspace.ts
index 28d2f2d9b10113c766f7b6c9b3fa52ecb321a45c..3cf6210e2760d871f95f1585f02b7ef98f0f8081 100644
