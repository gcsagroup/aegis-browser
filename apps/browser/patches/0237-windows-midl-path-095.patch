diff --git a/build/toolchain/win/midl.py b/build/toolchain/win/midl.py
index 370e5addb5..8a53225c09 100644
--- a/build/toolchain/win/midl.py
+++ b/build/toolchain/win/midl.py
@@ -343,6 +343,18 @@ def uuid5_substitutions(dynamic_guids):
             dynamic_guids[key] = str(uuid.uuid5(uuid.UUID(key), name)).upper()
 
 
+def normalize_dynamic_idl_comment(path, generated_idl, original_idl):
+    """只还原动态 GUID 暂存路径的编译器注释，保留接口和代理正文。"""
+    with open(path, 'rb') as f:
+        contents = f.read()
+    prefix = b'/* Compiler settings for '
+    pattern = rb'(?m)^' + re.escape(prefix + generated_idl.encode('utf-8') + b':')
+    contents = re.sub(pattern, lambda _: prefix + original_idl.encode('utf-8') + b':',
+                      contents, count=1)
+    with open(path, 'wb') as f:
+        f.write(contents)
+
+
 def main(
     arch,
     gendir,
@@ -500,6 +512,13 @@ def main(
     if returncode != 0:
         return returncode
 
+    if idl_template:
+        # 暂存 IDL 的路径不是接口变化；类型库及其余字节仍严格比较。
+        for name in (h, iid, proxy):
+            if name:
+                normalize_dynamic_idl_comment(
+                    os.path.join(midl_output_dir, name), idl, idl_template)
+
     # Now compare the output in midl_output_dir to the copied-over outputs.
     _, mismatch, errors = filecmp.cmpfiles(
         midl_output_dir, outdir, common_files
