diff --git a/chrome/browser/aegis/access/verify_access_build_identity.py b/chrome/browser/aegis/access/verify_access_build_identity.py
new file mode 100644
index 0000000000000000000000000000000000000000..a443fe6356938d871262d3e21a7aeb97b0afedcf
--- /dev/null
+++ b/chrome/browser/aegis/access/verify_access_build_identity.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+# Copyright 2026 GCSA
+"""Validate native Access flags against the macOS app's channel metadata."""
+import argparse
+import plistlib
+from pathlib import Path
+
+
+def chromium_channel(branded, metadata):
+    # chrome/common/channel_info_mac.mm ignores Keystone when unbranded.
+    if not branded or metadata.get("KSProductID") is None:
+        return "unknown"
+    tag = metadata.get("KSChannelID")
+    if tag is None or tag in ("arm64", "universal"):
+        return "stable"
+    if not isinstance(tag, str):
+        raise ValueError("KSChannelID must be a string")
+    for prefix in ("arm64-", "universal-"):
+        if tag.startswith(prefix):
+            tag = tag[len(prefix):]
+            break
+    if tag == "extended":
+        return "stable"
+    return tag if tag in ("beta", "dev", "canary") else "unknown"
+
+
+def validate_identity(product, internal, branded, metadata):
+    if product not in ("unknown", "debug", "alpha", "beta", "stable"):
+        raise ValueError("Unknown Access product identity")
+    if internal and product not in ("debug", "alpha"):
+        raise ValueError("Internal Options requires Debug or Alpha identity")
+    browser = chromium_channel(branded, metadata)
+    if browser in ("beta", "stable") and product not in ("unknown", browser):
+        raise ValueError("Access product identity conflicts with Chromium release channel")
+    return browser
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--plist", type=Path, required=True)
+    parser.add_argument("--product-channel", required=True)
+    parser.add_argument("--internal-options", choices=("true", "false"), required=True)
+    parser.add_argument("--chrome-branded", choices=("true", "false"), required=True)
+    parser.add_argument("--stamp", type=Path, required=True)
+    args = parser.parse_args()
+    with args.plist.open("rb") as source:
+        metadata = plistlib.load(source)
+    validate_identity(args.product_channel, args.internal_options == "true",
+                      args.chrome_branded == "true", metadata)
+    args.stamp.parent.mkdir(parents=True, exist_ok=True)
+    args.stamp.write_text("Access build identity verified\n", encoding="utf-8")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/chrome/browser/aegis/access/verify_access_build_identity_test.py b/chrome/browser/aegis/access/verify_access_build_identity_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..3e4054e48a5880bf0e9a4a1b4bc762c39ee22b9c
--- /dev/null
+++ b/chrome/browser/aegis/access/verify_access_build_identity_test.py
@@ -0,0 +1,79 @@
+# Copyright 2026 GCSA
+import unittest
+import plistlib
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+import verify_access_build_identity as identity
+
+
+class BuildIdentityTests(unittest.TestCase):
+    def test_internal_channels_require_explicit_capability(self):
+        for product in ("unknown", "debug", "alpha", "beta", "stable"):
+            for enabled in (False, True):
+                with self.subTest(product=product, enabled=enabled):
+                    if enabled and product not in ("debug", "alpha"):
+                        with self.assertRaises(ValueError):
+                            identity.validate_identity(product, enabled, False, {})
+                    else:
+                        self.assertEqual(identity.validate_identity(product, enabled, False, {}), "unknown")
+
+    def test_known_release_metadata_rejects_conflicting_identity(self):
+        for channel, metadata in (("beta", {"KSProductID": "Chrome", "KSChannelID": "arm64-beta"}), ("stable", {"KSProductID": "Chrome"})):
+            for product in ("unknown", "debug", "alpha", "beta", "stable"):
+                with self.subTest(channel=channel, product=product):
+                    if product not in ("unknown", channel):
+                        with self.assertRaises(ValueError):
+                            identity.validate_identity(product, False, True, metadata)
+                    else:
+                        self.assertEqual(identity.validate_identity(product, False, True, metadata), channel)
+
+    def test_channel_metadata_matches_chromium_mac_parsing(self):
+        for tag, expected in ((None, "stable"), ("arm64", "stable"),
+                              ("universal", "stable"), ("extended", "stable"),
+                              ("arm64-extended", "stable"), ("universal-beta", "beta"),
+                              ("dev", "dev"), ("arm64-canary", "canary"),
+                              ("", "unknown"), ("future", "unknown")):
+            with self.subTest(tag=tag):
+                metadata = {"KSProductID": "Chrome"}
+                if tag is not None:
+                    metadata["KSChannelID"] = tag
+                self.assertEqual(identity.chromium_channel(True, metadata), expected)
+                self.assertEqual(identity.chromium_channel(False, metadata), "unknown")
+
+    def test_branded_build_without_keystone_has_unknown_channel(self):
+        for metadata in ({}, {"KSChannelID": "beta"}, {"KSChannelID": "arm64"}):
+            self.assertEqual(identity.chromium_channel(True, metadata), "unknown")
+            for product in ("debug", "alpha", "beta"):
+                self.assertEqual(identity.validate_identity(product, False, True, metadata), "unknown")
+        self.assertEqual(identity.chromium_channel(True, {"KSProductID": ""}), "stable")
+
+    def test_branded_internal_dev_can_use_explicit_internal_identity(self):
+        for product in ("debug", "alpha"):
+            self.assertEqual(identity.validate_identity(product, True, True, {"KSProductID": "Chrome", "KSChannelID": "dev"}), "dev")
+        with self.assertRaises(ValueError):
+            identity.validate_identity("future", False, False, {})
+
+    def test_build_action_rejects_conflict_before_writing_stamp(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            info = root / "Info.plist"
+            stamp = root / "verified.stamp"
+            info.write_bytes(plistlib.dumps({"KSProductID": "Chrome", "KSChannelID": "beta"}))
+            command = [sys.executable, "-B", str(Path(identity.__file__)),
+                       "--plist", str(info), "--product-channel", "alpha",
+                       "--internal-options", "false", "--chrome-branded", "true",
+                       "--stamp", str(stamp)]
+            conflict = subprocess.run(command, capture_output=True, text=True)
+            self.assertNotEqual(conflict.returncode, 0)
+            self.assertIn("conflicts", conflict.stderr)
+            self.assertFalse(stamp.exists())
+            command[command.index("alpha")] = "beta"
+            accepted = subprocess.run(command, capture_output=True, text=True)
+            self.assertEqual(accepted.returncode, 0, accepted.stderr)
+            self.assertTrue(stamp.is_file())
+
+
+if __name__ == "__main__":
+    unittest.main()
