+:root {
+  color-scheme: light dark;
+  font: 15px system-ui, sans-serif;
+  background: Canvas;
+  color: CanvasText;
+}
+body { margin: 0; height: 100dvh; display: flex; flex-direction: column; }
+header, section { padding: 12px 20px; flex: none; }
+h1 { font-size: 1.3rem; margin: 0 0 10px; }
+button { cursor: pointer; font: inherit; padding: 6px 12px; }
+p { margin: 6px 0; }
+#actions:not([hidden]) { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
+#zoom-label { display: inline-flex; align-items: center; gap: 6px; }
+#zoom { max-width: 100px; }
+#preview { flex: 1; min-height: 0; overflow: auto; background: color-mix(in srgb, CanvasText 8%, Canvas); }
+#paper { position: relative; width: max-content; margin: 12px auto; }
+#source { display: block; touch-action: pan-x pan-y; user-select: none; }
+#paper.cropping #source { touch-action: none; cursor: crosshair; }
+#outline { pointer-events: none; position: absolute; box-sizing: border-box; border: 2px solid #1686fe; outline: 1px solid white; }
+#text { display: block; width: 100%; box-sizing: border-box; font: inherit; margin-bottom: 8px; }
+dialog { max-width: min(90vw, 600px); padding: 16px; }
+dialog img { display: block; max-width: 100%; max-height: 55vh; margin: auto; }
+dialog form { display: flex; justify-content: flex-end; gap: 8px; }
