+    }
+    store.Record(std::move(event));
+  }
+
+  const auto recent = store.Recent();
+  ASSERT_EQ(PrivacyEventStore::kMaxEventsPerDocument, recent.size());
+  EXPECT_EQ(PrivacyEventStore::kMaxDetails, recent.front().details.size());
+}
