diff --git a/chrome/browser/aegis/access/access_build_channel.cc b/chrome/browser/aegis/access/access_build_channel.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c446f9b69ab4c6a76e6222f18524a89d567b073f
--- /dev/null
+++ b/chrome/browser/aegis/access/access_build_channel.cc
@@ -0,0 +1,36 @@
+// Copyright 2026 GCSA
+#include "chrome/browser/aegis/access/access_build_channel.h"
+
+#include "chrome/browser/aegis/access/access_buildflags.h"
+#include "chrome/common/channel_info.h"
+#include "components/aegis_access/browser_request_metadata_seed.h"
+#include "components/version_info/channel.h"
+
+namespace aegis::access {
+namespace {
+aegis_access::BrowserReleaseChannel BrowserReleaseChannel() {
+  switch (chrome::GetChannel()) {
+    case version_info::Channel::STABLE:
+      return aegis_access::BrowserReleaseChannel::kStable;
+    case version_info::Channel::BETA:
+      return aegis_access::BrowserReleaseChannel::kBeta;
+    case version_info::Channel::DEV:
+      return aegis_access::BrowserReleaseChannel::kDev;
+    case version_info::Channel::CANARY:
+      return aegis_access::BrowserReleaseChannel::kCanary;
+    case version_info::Channel::UNKNOWN:
+      return aegis_access::BrowserReleaseChannel::kUnknown;
+  }
+  return aegis_access::BrowserReleaseChannel::kInvalid;
+}
+}  // namespace
+
+aegis_access::ChannelNamespace AccessChannelForCurrentBuild() {
+  auto channel = aegis_access::MapBrowserReleaseChannel(BrowserReleaseChannel());
+#if BUILDFLAG(AEGIS_ALPHA_TEST_NODE_ENABLED)
+  if (channel == aegis_access::ChannelNamespace::kDev)
+    channel = aegis_access::ChannelNamespace::kAlpha;
+#endif
+  return channel;
+}
+}  // namespace aegis::access
diff --git a/chrome/browser/aegis/access/access_build_channel.h b/chrome/browser/aegis/access/access_build_channel.h
new file mode 100644
index 0000000000000000000000000000000000000000..5eed2306026a999b179ad31a08680753c23af91a
--- /dev/null
+++ b/chrome/browser/aegis/access/access_build_channel.h
@@ -0,0 +1,12 @@
+// Copyright 2026 GCSA
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_BUILD_CHANNEL_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_BUILD_CHANNEL_H_
+
+#include "components/aegis_access/access_route_types.h"
+
+namespace aegis::access {
+// Explicit Alpha test builds use Alpha ownership even when unbranded Chromium
+// reports UNKNOWN. Chromium branding and the normal channel mapping are kept.
+aegis_access::ChannelNamespace AccessChannelForCurrentBuild();
+}  // namespace aegis::access
+#endif
