 namespace aegis::access {
 
-// Access namespace for this build. Explicit Alpha test builds use Alpha even
-// when unbranded Chromium reports UNKNOWN; Chromium branding is unaffected.
-aegis_access::ChannelNamespace AccessChannelForCurrentBuild();
