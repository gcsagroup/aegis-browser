     : HttpProxySocketParams(std::nullopt,
                             std::move(quic_ssl_config),
                             endpoint,
@@ -188,7 +191,8 @@ HttpProxySocketParams::HttpProxySocketParams(
                             std::move(traffic_annotation),
                             network_anonymization_key,
                             secure_dns_policy,
-                            target_network) {}
+                            target_network,
+                            std::move(access_proxy_route)) {}
 
 HttpProxySocketParams::HttpProxySocketParams(
     std::optional<ConnectJobParams> nested_params,
@@ -200,7 +204,8 @@ HttpProxySocketParams::HttpProxySocketParams(
     const NetworkTrafficAnnotationTag traffic_annotation,
     const NetworkAnonymizationKey& network_anonymization_key,
     SecureDnsPolicy secure_dns_policy,
-    handles::NetworkHandle target_network)
+    handles::NetworkHandle target_network,
+    scoped_refptr<AccessProxyRoute> access_proxy_route)
     : nested_params_(std::move(nested_params)),
       quic_ssl_config_(std::move(quic_ssl_config)),
       endpoint_(endpoint),
@@ -210,7 +215,22 @@ HttpProxySocketParams::HttpProxySocketParams(
       network_anonymization_key_(network_anonymization_key),
       traffic_annotation_(traffic_annotation),
       secure_dns_policy_(secure_dns_policy),
-      target_network_(target_network) {
+      target_network_(target_network),
+      access_proxy_route_(std::move(access_proxy_route)) {
+  if (access_proxy_route_) {
+    // Only the exact registered endpoint may consume this route's credentials.
+    // Value equality alone does not authorize a route; registration happens
+    // before this transport-only object is created.
+    CHECK(proxy_chain_ == access_proxy_route_->proxy_chain());
+    CHECK_EQ(proxy_chain_index_, 0u);
+    CHECK(is_over_transport());
+    CHECK(proxy_server().is_http());
+    CHECK(std::holds_alternative<HostPortPair>(
+        transport_params()->destination()));
+    CHECK(std::get<HostPortPair>(transport_params()->destination()) ==
+          proxy_server().host_port_pair());
+  }
+
   DCHECK(!proxy_chain_.is_direct());
   DCHECK(proxy_chain_.IsValid());
   CHECK(proxy_chain_index_ < proxy_chain_.length());
@@ -233,6 +253,13 @@ HttpProxySocketParams::HttpProxySocketParams(
 
 HttpProxySocketParams::~HttpProxySocketParams() = default;
 
+HttpAuthCache* HttpProxySocketParams::GetProxyAuthCache(
+    HttpAuthCache* native_cache) const {
+  return access_proxy_route_ ? access_proxy_route_->proxy_auth_cache()
+                             : native_cache;
+}
+
+
 std::unique_ptr<HttpProxyConnectJob> HttpProxyConnectJob::Factory::Create(
     RequestPriority priority,
     const SocketTag& socket_tag,
@@ -267,7 +294,8 @@ HttpProxyConnectJob::HttpProxyConnectJob(
                     HttpAuth::AUTH_PROXY,
                     MakeProxyUrl(*params_),
                     params_->network_anonymization_key(),
-                    common_connect_job_params->http_auth_cache,
+                    params_->GetProxyAuthCache(
+                        common_connect_job_params->http_auth_cache),
                     common_connect_job_params->http_auth_handler_factory,
                     host_resolver())
               : nullptr) {}
@@ -938,7 +966,10 @@ SpdySessionKey HttpProxyConnectJob::CreateSpdySessionKey() const {
       session_key_proxy_chain, SessionUsage::kProxy, socket_tag(),
       params_->network_anonymization_key(), params_->secure_dns_policy(),
       /*disable_cert_verification_network_fetches=*/true,
-      params_->target_network());
+      params_->target_network(),
+      params_->access_proxy_route()
+          ? std::make_optional(params_->access_proxy_route()->isolation_key())
+          : std::nullopt);
 }
 
