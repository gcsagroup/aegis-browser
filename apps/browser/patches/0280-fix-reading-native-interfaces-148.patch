diff --git a/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc b/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc
index da4b93691d581e4d61a0f89514d884b2c184a366..758bd8658e6853d7c70e84486e70b6fc27dcd8e7 100644
--- a/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc
+++ b/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc
@@ -612,7 +612,10 @@ void AegisAgentPageHandler::ReadingCommand(
   if (!reading_workspace_) {
     reading_workspace_ = std::make_unique<AegisReadingWorkspace>(profile_, browser_);
   }
-  reading_workspace_->Run(request, std::move(callback));
+  reading_workspace_->Run(request, base::BindOnce(
+      [](ReadingCommandCallback done, std::string result, std::string error) {
+        std::move(done).Run(result, error);
+      }, std::move(callback)));
 }
 
 void AegisAgentPageHandler::ShowUI() {
