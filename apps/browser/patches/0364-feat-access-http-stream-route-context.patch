-        /*disable_cert_network_fetches=*/true, request_info.target_network);
+        /*disable_cert_network_fetches=*/true, request_info.target_network,
+        route_key);
   }
   return SpdySessionKey(
       HostPortPair::FromURL(request_info.url), request_info.privacy_mode,
