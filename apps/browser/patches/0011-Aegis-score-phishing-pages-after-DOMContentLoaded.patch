+void ChromeRenderFrameObserver::CollectAegisPageSignals(
+    CollectAegisPageSignalsCallback callback) {
+  int32_t password_fields = 0;
+  int32_t forms = 0;
+  std::string title;
+  std::string text_sample;
+
+  WebLocalFrame* frame = render_frame() ? render_frame()->GetWebFrame() : nullptr;
+  if (frame && !frame->Parent() && !frame->IsInFencedFrameTree()) {
+    blink::WebDocument doc = frame->GetDocument();
+    title = doc.Title().Utf8();
+    forms = static_cast<int32_t>(doc.Forms().size());
+    blink::WebElement body = doc.Body();
+    if (!body.IsNull()) {
+      text_sample = body.TextContentAbridged(2048).Utf8();
+    }
+    blink::WebElement root = doc.DocumentElement();
+    if (!root.IsNull()) {
+      blink::WebElementCollection inputs =
+          root.GetElementsByHTMLTagName("input");
+      for (blink::WebElement el = inputs.FirstItem(); !el.IsNull();
+           el = inputs.NextItem()) {
+        const blink::WebInputElement input =
+            el.DynamicTo<blink::WebInputElement>();
+        if (input.IsNull()) {
+          continue;
+        }
+        if (input.FormControlType() ==
+            blink::mojom::FormControlType::kInputPassword) {
+          ++password_fields;
+        }
+      }
+    }
+  }
+  std::move(callback).Run(password_fields, forms, title, text_sample);
+}
