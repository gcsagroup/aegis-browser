+TEST(OllamaSidecarSecurityPolicyTest, AcceptsOnlyNumericLoopbackRoots) {
+  EXPECT_TRUE(IsAllowedOllamaBaseUrl(GURL("http://127.0.0.1:11434/")));
+  EXPECT_TRUE(IsAllowedOllamaBaseUrl(GURL("https://127.255.255.254/")));
+  EXPECT_TRUE(IsAllowedOllamaBaseUrl(GURL("http://[::1]:11434/")));
+}
+
+TEST(OllamaSidecarSecurityPolicyTest, RejectsNamesAndNonLoopbackAddresses) {
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://localhost:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://localhost.:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://0.0.0.0:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://192.168.1.20:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://[::]:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://[2001:db8::1]:11434/")));
+}
+
+TEST(OllamaSidecarSecurityPolicyTest, RejectsAmbiguousUrlComponents) {
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("ftp://127.0.0.1:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://user@127.0.0.1:11434/")));
+  EXPECT_FALSE(
+      IsAllowedOllamaBaseUrl(GURL("http://user:pass@127.0.0.1:11434/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://127.0.0.1:11434/api")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://127.0.0.1:11434/?model=x")));
+  EXPECT_FALSE(
+      IsAllowedOllamaBaseUrl(GURL("http://127.0.0.1:11434/#fragment")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("http://127.0.0.1:0/")));
+  EXPECT_FALSE(IsAllowedOllamaBaseUrl(GURL("not a url")));
+}
+
+TEST(OllamaSidecarSecurityPolicyTest, AlwaysBypassesProxyAndCache) {
+  const int flags = OllamaRequestLoadFlags();
+  EXPECT_NE(0, flags & net::LOAD_BYPASS_PROXY);
+  EXPECT_NE(0, flags & net::LOAD_BYPASS_CACHE);
+  EXPECT_NE(0, flags & net::LOAD_DISABLE_CACHE);
+}
