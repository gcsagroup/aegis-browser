+
+TEST(CookieClassifyTest, RejectsOnlyAnalyticsAndAdvertisingByDefault) {
+  EXPECT_TRUE(ShouldRejectCookie(CookieCategory::kAnalytics));
+  EXPECT_TRUE(ShouldRejectCookie(CookieCategory::kAdvertising));
