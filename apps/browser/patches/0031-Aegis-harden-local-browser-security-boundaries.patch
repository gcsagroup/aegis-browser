+      PhishAssessment assessment) {
+    const GURL url("https://phish.example.test/login");
+    auto controller =
+        std::make_unique<AegisPhishControllerClient>(web_contents(), url);
+    return std::make_unique<TestAegisPhishBlockingPage>(
