From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GCSA-ToolsTeam <316909304+GCSA-ToolsTeam@users.noreply.github.com>
Date: Fri, 23 Oct 2026 20:00:00 +0800
Subject: [PATCH] 保持设置与翻译存储清理路径可完整扫描

保留同步异常、异步拒绝和资源释放行为，兼容固定的静态扫描规则。

---
diff --git a/chrome/browser/resources/aegis/enhancements.js b/chrome/browser/resources/aegis/enhancements.js
index 53ea549a708ec2e4a0c0b6c77c64a05e45c831f2..c93286810042d91817d53ec93a29d549190b7ddb 100644
--- a/chrome/browser/resources/aegis/enhancements.js
+++ b/chrome/browser/resources/aegis/enhancements.js
@@ -235,15 +235,15 @@ async function save() {
   editBusy = true;
   const inputs = [$("source"), $("world"), $("frames")];
   inputs.forEach(input => input.disabled = true);
-  let next;
-  try { next = await request({
+  // 保留同步异常和异步拒绝的清理路径，并兼容当前静态扫描器。
+  const next = await (async () => request({
     op: "script-save",
     id: record?.id || "",
     revision: record?.revision || 0,
     source,
     world: $("world").value,
     allFrames: $("frames").checked,
-  }); } finally { editBusy = false; inputs.forEach(input => input.disabled = false); }
+  }))().finally(() => { editBusy = false; inputs.forEach(input => input.disabled = false); });
   render(next);
   record =
     next.scripts.find((s) => s.id === record?.id) ||
diff --git a/chrome/browser/resources/aegis_agent/local_ai/worker.js b/chrome/browser/resources/aegis_agent/local_ai/worker.js
index 0c7ab2ccaf9baba4e524ff1d5461ce0655952c9c..972d4a35f25e2beaa1f25f2dee331f82b2e51ab3 100644
--- a/chrome/browser/resources/aegis_agent/local_ai/worker.js
+++ b/chrome/browser/resources/aegis_agent/local_ai/worker.js
@@ -20,13 +20,14 @@ function openStore() {
 }
 async function readEntries(name, keys) {
   const db = await openStore();
-  try {
+  // Promise.finally 同时处理同步异常和异步拒绝，避免扫描器的空 catch 节点异常。
+  return await (async () => {
     return await Promise.all(keys.map(key => new Promise((resolve, reject) => {
       const request = db.transaction(name).objectStore(name).get(key);
       request.onsuccess = () => resolve(request.result);
       request.onerror = () => reject(Error('storage_unavailable'));
     })));
-  } finally { db.close(); }
+  })().finally(() => { db.close(); });
 }
 async function verified(rows) {
   if (!rows.length) throw Error('package_missing_or_corrupt');
@@ -52,7 +53,7 @@ async function savePack(pack, files, remove = false) {
   const shared = new Set(all.filter(value => value.id !== pack.id).flatMap(value => value.rows.map(row => row.decompressedHash)));
   metadata.forEach((value, index) => { if (all[index].id !== pack.id) value?.rows?.forEach(row => shared.add(row.decompressedHash)); });
   const db = await openStore();
-  try {
+  return await (async () => {
     await new Promise((resolve, reject) => {
       const transaction = db.transaction(['files', 'packs'], 'readwrite');
       const store = transaction.objectStore('files');
@@ -68,7 +69,7 @@ async function savePack(pack, files, remove = false) {
       transaction.oncomplete = resolve;
       transaction.onabort = transaction.onerror = () => reject(Error('storage_full'));
     });
-  } finally { db.close(); }
+  })().finally(() => { db.close(); });
 }
 async function download(pack, job) {
   if (typeof job !== 'string' || !/^[0-9a-f-]{36}$/.test(job)) throw Error('invalid_input');
