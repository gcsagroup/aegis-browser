From d666016532963cd0641859dbf9d53158e2c6f3d6 Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 11 Nov 2026 02:38:35 +0800
Subject: [PATCH] fix(access): migrate legacy rules with Chromium SQLite

---
 chrome/browser/aegis/access/access_rule_store.cc          | 7 +++++--
 chrome/browser/aegis/access/access_rule_store_unittest.cc | 8 ++++++--
 2 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/aegis/access/access_rule_store.cc b/chrome/browser/aegis/access/access_rule_store.cc
index d75362caea1078acc6c915e996b22b78d5c22fab..aa65f1a0b7fa463816c8d48a18115a1d8c592dd1 100644
--- a/chrome/browser/aegis/access/access_rule_store.cc
+++ b/chrome/browser/aegis/access/access_rule_store.cc
@@ -767,10 +767,13 @@ StoreStatus AccessRuleStore::Open() {
       return terminal_status_;
     }
     legacy_rules.Reset(true);
+    // This Chromium SQLite omits the pragma table used by ALTER's CHECK
+    // validation. Add the plain defaulted column; both readers below still
+    // reject every value other than 0 or 1 before interpreting its scope.
     if (!database_.Execute("ALTER TABLE access_site_groups ADD COLUMN "
-          "website_context INTEGER NOT NULL DEFAULT 0 CHECK(website_context IN (0,1))") ||
+          "website_context INTEGER NOT NULL DEFAULT 0") ||
         !database_.Execute("ALTER TABLE access_mutation_journal ADD COLUMN "
-          "website_context INTEGER NOT NULL DEFAULT 0 CHECK(website_context IN (0,1))") ||
+          "website_context INTEGER NOT NULL DEFAULT 0") ||
         !database_.Execute("UPDATE access_store_identity SET schema_version=2 WHERE schema_version=1") ||
         !database_.Execute("UPDATE access_mutation_journal SET schema_version=2 WHERE schema_version=1") ||
         !meta_table_.SetVersionNumber(kSchemaVersion) ||
diff --git a/chrome/browser/aegis/access/access_rule_store_unittest.cc b/chrome/browser/aegis/access/access_rule_store_unittest.cc
index 11288fb5ca5fd6eca3beecc9be779dc43d1ed8a9..90b548e28b0643a2d5cc677c926faba885c23d5c 100644
--- a/chrome/browser/aegis/access/access_rule_store_unittest.cc
+++ b/chrome/browser/aegis/access/access_rule_store_unittest.cc
@@ -1570,7 +1570,9 @@ TEST(AccessRuleStoreTest, ExplicitWebsiteMutationAtomicallyCoalescesLegacyAliase
 }
 
 TEST(AccessRuleStoreTest, WebsiteAliasDeletionRollsBackWithTheWholeMutation) {
-  AccessRuleStore store(AccessRuleStoreTestPeer::Ephemeral());
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  AccessRuleStore store(AccessRuleStoreTestPeer::Persistent(directory.GetPath()));
   ASSERT_EQ(store.Open(), StoreStatus::kValid);
   for (const char* host : {"example.com", "www.example.com"})
     Commit(&store, Prepare(&store, BubbleWebsiteFixture(host, host, false)));
@@ -1587,7 +1589,9 @@ TEST(AccessRuleStoreTest, WebsiteAliasDeletionRollsBackWithTheWholeMutation) {
 }
 
 TEST(AccessRuleStoreTest, WebsiteAndLegacyPendingMutationsCannotCross) {
-  AccessRuleStore store(AccessRuleStoreTestPeer::Ephemeral());
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  AccessRuleStore store(AccessRuleStoreTestPeer::Persistent(directory.GetPath()));
   ASSERT_EQ(store.Open(), StoreStatus::kValid);
   const auto legacy = Prepare(&store, BubbleWebsiteFixture("legacy-pending", "www.example.com", false));
   EXPECT_EQ(store.PrepareSiteGroupMutation(BubbleWebsiteFixture("website-conflict", "example.com", true)).status,
-- 
