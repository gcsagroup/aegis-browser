From b67e2aa90a7663fbdee9bdc0572c34d320e4fcae Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Fri, 13 Nov 2026 18:01:07 +0800
Subject: [PATCH] fix(access-log): bound severity tag indexing with array
---

diff --git a/chrome/browser/aegis/access/access_core_log.h b/chrome/browser/aegis/access/access_core_log.h
index 62ae0385e140ef8162c127739c8ef278bbe737dd..16362e39ba9d0e974a337f47972a03559124bed6 100644
--- a/chrome/browser/aegis/access/access_core_log.h
+++ b/chrome/browser/aegis/access/access_core_log.h
@@ -99,8 +99,8 @@ class AccessCoreLog {
       }
       safe += SafeTarget(target, protected_values) ? target : "[redacted]";
     } else {
-      constexpr std::string_view tags[] = {"[Debug] ", "[Info] ", "[Warning] ",
-                                           "[Error] "};
+      constexpr std::array<std::string_view, 4> tags = {
+          "[Debug] ", "[Info] ", "[Warning] ", "[Error] "};
       for (severity = 0; severity < 4 && !line.starts_with(tags[severity]);
            ++severity) {
       }
