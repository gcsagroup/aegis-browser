diff --git a/components/download/public/common/download_features.cc b/components/download/public/common/download_features.cc
index cd5850b9d2..f769c2dc01 100644
--- a/components/download/public/common/download_features.cc
+++ b/components/download/public/common/download_features.cc
@@ -4,14 +4,50 @@
 
 #include "components/download/public/common/download_features.h"
 
+#include <atomic>
+
 #include "build/android_buildflags.h"
 #include "build/build_config.h"
 
 namespace download {
 namespace features {
 
+namespace {
+
+std::atomic<int> g_aegis_parallel_mode{0};
+std::atomic<bool> g_aegis_reduce_on_metered{true};
+std::atomic<bool> g_aegis_reduce_on_battery{true};
+
+}  // namespace
+
 BASE_FEATURE(kParallelDownloading, base::FEATURE_ENABLED_BY_DEFAULT);
 
+void ConfigureAegisParallelDownloading(int parallel_mode,
+                                       bool reduce_on_metered,
+                                       bool reduce_on_battery) {
+  if (parallel_mode != 0 && parallel_mode != 1 && parallel_mode != 3 &&
+      parallel_mode != 6) {
+    parallel_mode = 0;
+  }
+  g_aegis_parallel_mode.store(parallel_mode, std::memory_order_relaxed);
+  g_aegis_reduce_on_metered.store(reduce_on_metered,
+                                  std::memory_order_relaxed);
+  g_aegis_reduce_on_battery.store(reduce_on_battery,
+                                  std::memory_order_relaxed);
+}
+
+int GetAegisParallelDownloadMode() {
+  return g_aegis_parallel_mode.load(std::memory_order_relaxed);
+}
+
+bool ShouldAegisReduceParallelismOnMetered() {
+  return g_aegis_reduce_on_metered.load(std::memory_order_relaxed);
+}
+
+bool ShouldAegisReduceParallelismOnBattery() {
+  return g_aegis_reduce_on_battery.load(std::memory_order_relaxed);
+}
+
 #if BUILDFLAG(IS_WIN) || BUILDFLAG(IS_MAC)
 BASE_FEATURE(kBackoffInDownloading, base::FEATURE_DISABLED_BY_DEFAULT);
 #endif
