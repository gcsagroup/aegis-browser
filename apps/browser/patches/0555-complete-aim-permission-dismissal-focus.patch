+IN_PROC_BROWSER_TEST_F(OmniboxAimPopupEmbeddedPermissionBrowserTest,
+                       BackgroundEmbeddedPromptCloseDoesNotActivateAim) {
+  ASSERT_NO_FATAL_FAILURE(ShowFocusedAimPopup());
+  ASSERT_NO_FATAL_FAILURE(ShowEmbeddedMicrophonePrompt());
+
+  auto* other_browser = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(other_browser);
+  auto* other_view = BrowserView::GetBrowserViewForBrowser(other_browser);
+  ASSERT_TRUE(other_view && other_view->GetWidget());
+  const auto other_widget = other_view->GetWidget()->GetWeakPtr();
+  other_widget->Activate();
+  ASSERT_TRUE(base::test::RunUntil(
+      [&] { return other_widget && other_widget->IsActive(); }));
+
+  ASSERT_TRUE(prompt_ && prompt_->IsVisible() && !prompt_->IsClosed());
+  ASSERT_FALSE(prompt_->IsActive());
+  ASSERT_TRUE(browser_widget_ && !browser_widget_->IsActive());
+  auto* presenter = GetAimPresenter();
+  ASSERT_TRUE(presenter && presenter->IsShown() && presenter->GetWidget());
+  ASSERT_FALSE(presenter->GetWidget()->IsActive());
+  ASSERT_TRUE(presenter->IsPermissionPromptPreventingClose());
+  ASSERT_FALSE(presenter->get_minimum_size().IsEmpty());
+
+  prompt_->CloseWithReason(views::Widget::ClosedReason::kCloseButtonClicked);
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    const auto* manager = GetPermissionManager();
+    const auto* current_presenter = GetAimPresenter();
+    return manager && !manager->IsRequestInProgress() &&
+           !manager->GetCurrentPrompt() && current_presenter &&
+           !current_presenter->IsPermissionPromptPreventingClose() &&
+           current_presenter->get_minimum_size().IsEmpty();
+  }));
+
+  // ClosingPermission sends a hide after dismissal. Drain any deferred focus
+  // and visibility work before checking activation and the cleared state.
+  base::RunLoop().RunUntilIdle();
+  ASSERT_TRUE(other_widget);
+  EXPECT_TRUE(other_widget->IsActive());
+  ASSERT_TRUE(browser_widget_);
+  EXPECT_FALSE(browser_widget_->IsActive());
+  presenter = GetAimPresenter();
+  ASSERT_TRUE(presenter);
+  if (const auto* popup = presenter->GetWidget()) {
+    EXPECT_FALSE(popup->IsActive());
+  }
+  EXPECT_FALSE(presenter->IsPermissionPromptPreventingClose());
+  EXPECT_TRUE(presenter->get_minimum_size().IsEmpty());
+}
