+IN_PROC_BROWSER_TEST_F(
+    OmniboxAimPopupEmbeddedPermissionWebUILocationBarBrowserTest,
+    EmbeddedPromptEscapeRestoresComposeboxInputFocus) {
+  auto* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  ASSERT_TRUE(browser_view);
+  ASSERT_FALSE(browser_view->GetLocationBarView());
+  auto* bar = browser_view->GetLocationBar();
+  ASSERT_TRUE(bar);
+  ASSERT_TRUE(base::test::RunUntil([&] { return bar->GetAnchorOrNull(); }));
+
+  ASSERT_NO_FATAL_FAILURE(ShowFocusedAimPopup());
+  // Select the layout that renders the real microphone control even when
+  // the test profile has no context inputs.
+  ASSERT_EQ(true, content::EvalJs(aim_contents_.get(), R"(
+    (async () => {
+      const box = document.querySelector('omnibox-aim-app').shadowRoot
+          .querySelector('cr-omnibox-composebox');
+      box.searchboxLayoutMode = 'TallBottomContext';
+      await box.updateComplete;
+      const microphone = box.shadowRoot.querySelector('#voiceSearchButton');
+      microphone.focus();
+      return box.shadowRoot.activeElement === microphone &&
+          !box.isFocusInInput();
+    })()
+  )"));
+  ASSERT_NO_FATAL_FAILURE(ShowEmbeddedMicrophonePrompt());
+
+  base::test::ScopedRunLoopTimeout timeout(FROM_HERE,
+                                           TestTimeouts::action_timeout());
+  ASSERT_TRUE(base::test::RunUntil([&] {
+    return prompt_ && !prompt_->IsClosed() && prompt_->IsVisible() &&
+           prompt_->IsActive();
+  })) << "The embedded prompt must be key when Escape is dispatched";
+  auto* dialog =
+      views::AsViewClass<views::DialogClientView>(prompt_->client_view());
+  ASSERT_TRUE(dialog);
+  ASSERT_TRUE(dialog->AcceleratorPressed(
+      ui::Accelerator(ui::VKEY_ESCAPE, ui::EF_NONE)));
+  if (prompt_) {
+    EXPECT_EQ(views::Widget::ClosedReason::kEscKeyPressed,
+              prompt_->closed_reason());
+  }
+  ASSERT_NO_FATAL_FAILURE(VerifyAimRestoredAfterPromptClose());
+}
