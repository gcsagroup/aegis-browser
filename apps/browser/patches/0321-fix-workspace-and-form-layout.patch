 :host section { margin: 12px 0; }
 @media (max-width: 650px) { body { padding: 14px; } section { padding: 14px; } .target-summary .row { align-items: stretch; } .target-summary select { flex-basis: 100%; } }
+
+/* 标签在输入后仍保持可见；窄屏字段和脚本选项使用同一左边界。 */
+#enhancement-root { min-width: 0; overflow-wrap: anywhere; }
+label > input:not([type=checkbox]):not([type=file]), label > select {
+  display: block;
+  width: 100%;
+  min-width: 0;
+  margin-top: 6px;
+}
+input[type=checkbox] { flex: none; }
+.row > *, .toggle > * { min-width: 0; }
+@media (max-width: 650px) {
+  body { padding: 16px; }
+  section { padding: 16px; margin: 16px 0; }
+  input:not([type=checkbox]), select, textarea { font-size: 16px; }
+}
+@media (pointer: coarse) {
+  button, .file, summary, input:not([type=checkbox]), select { min-height: 44px; }
+}
diff --git a/chrome/browser/resources/aegis/markdown.css b/chrome/browser/resources/aegis/markdown.css
index 7154f0442f89d12c6b5a9bc2317a50b77879189c..6f1156af74907b456eb2acf940da539bb22b215c 100644
