     "language_packs.ts",
diff --git a/chrome/browser/resources/aegis_agent/agent.css b/chrome/browser/resources/aegis_agent/agent.css
index faa56b94facaef7116e6b666e31e58292876b190..667657b4cc3e4eb6cf550f7ce19017fcbba2315e 100644
--- a/chrome/browser/resources/aegis_agent/agent.css
+++ b/chrome/browser/resources/aegis_agent/agent.css
@@ -1055,3 +1055,60 @@ body.reading-workspace-only main > #reading-ai-settings[open] { display:block !i
 
 [data-search-match] { outline: 2px solid #3986ec;
  outline-offset: 4px; }
+
+/* 独立设置页保留原控件，隐藏工作区导航和无关表单。 */
+.mobile-settings-back { display: inline-block;
+ width: fit-content;
+ min-height: 44px;
+ padding: 10px 0;
+ color: var(--primary); }
+
+body[data-mobile-settings] main > :not(.hero):not(.mobile-settings-back) { display: none !important; }
+
+body[data-mobile-settings='reading'] main > #reading-ai-settings,
