 p { color: var(--muted); }
 .hint, small { font-size: 12px; color: var(--muted); }
 .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
@@ -57,3 +57,22 @@ pre { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 260px; overflo
