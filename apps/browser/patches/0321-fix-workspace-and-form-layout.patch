         <h2>$i18n{downloadsTitle}</h2>
         <p class="meta">$i18n{downloadsMeta}</p>
-        <aegis-download-panel></aegis-download-panel>
+        <aegis-download-panel embedded></aegis-download-panel>
         <p><a href="chrome://downloads" target="_top">$i18n{downloadsHistory}</a></p>
         <details><summary>$i18n{technicalDetails}</summary><p class="scope-note">$i18n{torrentSafety}</p></details>
       </section>
diff --git a/chrome/browser/resources/aegis/aegis.ts b/chrome/browser/resources/aegis/aegis.ts
index 3971afc63efb983bd15d6fb5a01a75de3e9457ce..cb3f7f1a72cf07377326a3cc7079085493ba864b 100644
--- a/chrome/browser/resources/aegis/aegis.ts
+++ b/chrome/browser/resources/aegis/aegis.ts
@@ -3,6 +3,7 @@
 import '/strings.m.js';
 import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
 import './policy_worker.js';
+import {initializeMobileSettings} from './mobile_settings.js';
 import 'chrome://resources/cr_components/aegis_downloads/aegis_download_panel.js';
 
 import type {AegisDownloadPanelElement} from 'chrome://resources/cr_components/aegis_downloads/aegis_download_panel.js';
@@ -1500,6 +1501,12 @@ async function init() {
   const status: AegisStatus =
       withRendererPolicyWorkerStatus(await requestSettings('getStatus'));
   applyStatus(status);
+  if (status.isAndroid) {
+    initializeMobileSettings(async section => {
+      const result: AegisStatus = await sendWithPromise('openBrowserAgent', section);
+      if (result.ok === false) throw new Error(result.error || 'unavailable');
+    });
+  }
   bindToggle('tracker', 'trackerBlocking');
   bindToggle('phish', 'phishInterstitial');
   bindToggle('fingerprint', 'fingerprintGuard');
diff --git a/chrome/browser/resources/aegis/enhancements.css b/chrome/browser/resources/aegis/enhancements.css
index cda4f732e0fe61a81772a726974ed50d1ef33fd2..93684e3be1b3e188301dcf43065db001d322d0e8 100644
--- a/chrome/browser/resources/aegis/enhancements.css
+++ b/chrome/browser/resources/aegis/enhancements.css
@@ -12,12 +12,12 @@
 }
 * { box-sizing: border-box; }
 body { margin: 0; padding: 24px; }
-#enhancement-root { max-width: 960px; margin: auto; }
+#enhancement-root { max-width: 1000px; margin: auto; }
