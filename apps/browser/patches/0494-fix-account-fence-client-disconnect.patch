From 981218a4d40e28ae4cf7fd73226259f1e6f7919b Mon Sep 17 00:00:00 2001
From: Aegis Browser <devnull@localhost>
Date: Sat, 14 Nov 2026 04:35:02 +0800
Subject: [PATCH] fix(access): republish account fences after client disconnect
---

diff --git a/chrome/browser/aegis/access/access_network_context_transport.cc b/chrome/browser/aegis/access/access_network_context_transport.cc
index 108980e411ba2c2fa1c54d265d50c2ed8e2422e8..e450938b4070e475eb49dc5a07a2af1ba88413b9 100644
--- a/chrome/browser/aegis/access/access_network_context_transport.cc
+++ b/chrome/browser/aegis/access/access_network_context_transport.cc
@@ -166,6 +166,16 @@ bool AccessNetworkContextTransport::ConfigureNetworkContext(
   ++state.clients_generation;
   state.clients.Add(std::move(client));
 #if BUILDFLAG(IS_MAC)
+  state.clients.set_disconnect_handler(base::BindRepeating(
+      [](base::WeakPtr<AccessNetworkContextTransport> self,
+         std::string partition, mojo::RemoteSetElementId) {
+        if (!self) return;
+        auto found = self->partitions_.find(partition);
+        if (found == self->partitions_.end()) return;
+        auto& current = found->second;
+        if (!current.account_fenced.empty() || !current.account_sites.empty())
+          self->PublishAccountConfig(current);
+      }, transport->weak_factory_.GetWeakPtr(), *key));
   if (!state.account_fenced.empty() || !state.account_sites.empty())
     transport->PublishAccountConfig(state);
 #endif
diff --git a/chrome/browser/aegis/access/access_paid_site_mac_unittest.mm b/chrome/browser/aegis/access/access_paid_site_mac_unittest.mm
index 0f0afe4465ce9a140f972743ae612973a9ba2ef5..3e9862cb38ad02a35bdccf70d21aa369d3964242 100644
--- a/chrome/browser/aegis/access/access_paid_site_mac_unittest.mm
+++ b/chrome/browser/aegis/access/access_paid_site_mac_unittest.mm
@@ -107,6 +107,10 @@ TEST(PaidSiteMac, BrowserDispatchWaitsForCurrentConfigOnEveryPipe) {
   second.receiver.reset();
   task.RunUntilIdle();
   EXPECT_EQ(net::ERR_BLOCKED_BY_CLIENT, dispatch(selected));
+  ASSERT_EQ(first.replies.size(), 5u);
+  std::move(first.replies.back()).Run();
+  task.RunUntilIdle();
+  EXPECT_EQ(net::OK, dispatch(selected));
 }
 
 TEST(PaidSiteMac, PaidWebsiteRejectsLocalErrorPageRetryForAliases) {
