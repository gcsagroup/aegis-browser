 /* 来源名称与地址来自浏览器，窄侧栏中允许完整换行。 */
-.research-sources { display: grid; gap: 8px; max-height: 320px; overflow: auto; margin-block: 12px; }
-.research-source { display: flex; align-items: start; gap: 8px; padding: 8px; border: 1px solid var(--line); border-radius: 8px; }
-.research-source input { width: auto; flex: none; margin-top: 3px; }
-.research-source span { min-width: 0; }
-.research-source strong, .research-source small { display: block; overflow-wrap: anywhere; }
-.research-source small { color: var(--muted); margin-top: 4px; }
-.workspace-tools { margin-block: 8px; }
-.source-link { text-align: start; overflow-wrap: anywhere; width: 100%; }
+.research-sources {
+  display: grid;
+  gap: 8px;
+  max-height: 320px;
+  overflow: auto;
+  margin-block: 12px;
+}
+
+.research-source {
+  display: flex;
+  align-items: start;
+  gap: 8px;
+  padding: 8px;
+  border: 1px solid var(--line);
+  border-radius: 8px;
+}
+
+.research-source input {
+  width: auto;
+  flex: none;
+  margin-top: 3px;
+}
+
+.research-source span {
+  min-width: 0;
+}
+
+.research-source strong,
+.research-source small {
+  display: block;
+  overflow-wrap: anywhere;
+}
+
+.research-source small {
+  color: var(--muted);
+  margin-top: 4px;
+}
+
+.workspace-tools {
+  margin-block: 8px;
+}
+
+.source-link {
+  text-align: start;
+  overflow-wrap: anywhere;
+  width: 100%;
+}
