From 5abe51306db841adce9b419ca8a6672c22c759ff Mon Sep 17 00:00:00 2001
From: MacBook Pro <lazy@MacBook-Pro.local>
Date: Mon, 24 Aug 2026 21:11:56 +0800
Subject: [PATCH] fix: preserve initial blank ownership across hash navigation

---
 .../protocol/devtools_protocol_browsertest.cc         | 11 +++++++++++
 content/browser/devtools/devtools_agent_host_impl.cc  |  2 +-
 .../devtools/render_frame_devtools_agent_host.cc      |  3 +--
 3 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/devtools/protocol/devtools_protocol_browsertest.cc b/chrome/browser/devtools/protocol/devtools_protocol_browsertest.cc
index 73a21d6a37..650260705b 100644
--- a/chrome/browser/devtools/protocol/devtools_protocol_browsertest.cc
+++ b/chrome/browser/devtools/protocol/devtools_protocol_browsertest.cc
@@ -708,6 +708,17 @@ IN_PROC_BROWSER_TEST_F(AegisRemoteDevToolsProtocolTest,
   const std::string* target_id = create_result->FindString("targetId");
   ASSERT_TRUE(target_id);
 
+  scoped_refptr<content::DevToolsAgentHost> created_target =
+      content::DevToolsAgentHost::GetForId(*target_id);
+  ASSERT_TRUE(created_target);
+  content::WebContents* created_contents = created_target->GetWebContents();
+  ASSERT_TRUE(created_contents);
+  content::RenderFrameHost* initial_document =
+      created_contents->GetPrimaryMainFrame();
+  ASSERT_TRUE(content::NavigateToURL(created_contents,
+                                     GURL("about:blank#same-document")));
+  EXPECT_EQ(initial_document, created_contents->GetPrimaryMainFrame());
+
   const base::DictValue* attach_result = SendCommandSync(
       "Target.attachToTarget",
       base::DictValue().Set("targetId", *target_id).Set("flatten", true));
diff --git a/content/browser/devtools/devtools_agent_host_impl.cc b/content/browser/devtools/devtools_agent_host_impl.cc
index fd5cbd9a99..f8a34c5276 100644
--- a/content/browser/devtools/devtools_agent_host_impl.cc
+++ b/content/browser/devtools/devtools_agent_host_impl.cc
@@ -407,7 +407,7 @@ bool DevToolsAgentHostImpl::IsRemoteDebuggingTargetOperationAllowed(
     }
     const GURL target_url = target->GetURLForRemoteDebugging();
     const bool is_initial_blank_target =
-        client && target_url.spec() == url::kAboutBlankURL &&
+        client && target_url.IsAboutBlank() &&
         (target->GetType() == DevToolsAgentHost::kTypePage ||
          target->GetType() == DevToolsAgentHost::kTypeTab);
     const WeakDocumentPtr target_document =
diff --git a/content/browser/devtools/render_frame_devtools_agent_host.cc b/content/browser/devtools/render_frame_devtools_agent_host.cc
index 050e41f624..450e6a8f33 100644
--- a/content/browser/devtools/render_frame_devtools_agent_host.cc
+++ b/content/browser/devtools/render_frame_devtools_agent_host.cc
@@ -1192,8 +1192,7 @@ bool RenderFrameDevToolsAgentHost::ShouldAllowSession(
     return true;
   }
   const bool is_initial_blank_target =
-      agent_host &&
-      frame_host->GetLastCommittedURL().spec() == url::kAboutBlankURL &&
+      agent_host && frame_host->GetLastCommittedURL().IsAboutBlank() &&
       (agent_host->GetType() == DevToolsAgentHost::kTypePage ||
        agent_host->GetType() == DevToolsAgentHost::kTypeTab);
   if (is_initial_blank_target &&
-- 
