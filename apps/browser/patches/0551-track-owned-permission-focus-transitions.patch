+bool OmniboxPopupAimPresenter::
+    ShouldRestoreFocusAfterPermissionPromptDismissed() const {
+  const auto* widget = GetWidget();
+  return widget && HasOpenWidget() && widget->IsVisible() &&
+         widget->CanActivate() && ShouldReceiveFocus();
+}
+
+bool OmniboxPopupAimPresenter::IsBrowserOrPopupActive() const {
+  if (GetWidget()->IsActive()) {
+    return true;
+  }
+  auto* location_bar_widget = delegate().GetLocationBarWidget();
+  auto* browser_widget =
+      location_bar_widget ? location_bar_widget->GetTopLevelWidget() : nullptr;
+  return browser_widget && browser_widget->IsActive();
+}
+
+void OmniboxPopupAimPresenter::RequestFocusAfterPermissionPromptDismissed() {
+  pending_permission_focus_restore_.Cancel();
+  if (IsBrowserOrPopupActive()) {
+    RestorePermissionPromptFocusIfActive();
+    return;
+  }
+
+  // A closing native prompt can return activation to the owner asynchronously.
+  // Recheck actual activation after the close, including when another window
+  // already holds focus and the request was removed in the background.
+  pending_permission_focus_restore_.Reset(base::BindOnce(
+      [](base::WeakPtr<OmniboxPopupAimPresenter> presenter) {
+        if (presenter && presenter->IsPermissionPromptFocusRestorePending()) {
+          presenter->RestorePermissionPromptFocusIfActive();
+        }
+      },
+      weak_factory_.GetWeakPtr()));
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, pending_permission_focus_restore_.callback());
+}
+
+void OmniboxPopupAimPresenter::RestorePermissionPromptFocusIfActive() {
+  if (ShouldRestoreFocusAfterPermissionPromptDismissed() &&
+      IsBrowserOrPopupActive()) {
+    RequestFocus();
+  }
+  FinishPermissionPromptFocusRestore();
+}
