diff --git a/chrome/installer/setup/aegis_launch_policy.h b/chrome/installer/setup/aegis_launch_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..9cef1fa2abd88e70ba3943b577e263b902e7c19a
--- /dev/null
+++ b/chrome/installer/setup/aegis_launch_policy.h
@@ -0,0 +1,20 @@
+// Copyright 2026 The GCSA Aegis Authors
+// 交互式安装后的启动策略；只允许成功安装状态，不把失败或维护任务当作安装成功。
+#ifndef CHROME_INSTALLER_SETUP_AEGIS_LAUNCH_POLICY_H_
+#define CHROME_INSTALLER_SETUP_AEGIS_LAUNCH_POLICY_H_
+
+#include "chrome/installer/util/util_constants.h"
+
+namespace installer {
+// 显式静默或禁止启动始终优先；覆盖首次安装、修复和升级，不重复启动已有实例分支。
+constexpr bool ShouldLaunchAegisAfterInstall(InstallStatus status,
+                                             bool interactive,
+                                             bool silent,
+                                             bool do_not_launch) {
+  return interactive && !silent && !do_not_launch &&
+         (status == FIRST_INSTALL_SUCCESS || status == INSTALL_REPAIRED ||
+          status == NEW_VERSION_UPDATED || status == IN_USE_UPDATED ||
+          status == OLD_VERSION_DOWNGRADE || status == IN_USE_DOWNGRADE);
+}
+}  // namespace installer
+#endif  // CHROME_INSTALLER_SETUP_AEGIS_LAUNCH_POLICY_H_
diff --git a/chrome/installer/setup/aegis_launch_policy_unittest.cc b/chrome/installer/setup/aegis_launch_policy_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..56485db6187abe8de8e456aa1c3555b7f8a65dcd
--- /dev/null
+++ b/chrome/installer/setup/aegis_launch_policy_unittest.cc
@@ -0,0 +1,25 @@
+// Copyright 2026 The GCSA Aegis Authors
+// 安装结果和用户启动意图的契约测试，不写注册表或启动真实浏览器。
+#include "chrome/installer/setup/aegis_launch_policy.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace installer {
+TEST(AegisLaunchPolicyTest, LaunchesAfterFreshRepairAndUpdate) {
+  for (auto status :
+       {FIRST_INSTALL_SUCCESS, INSTALL_REPAIRED, NEW_VERSION_UPDATED,
+        IN_USE_UPDATED, OLD_VERSION_DOWNGRADE, IN_USE_DOWNGRADE}) {
+    EXPECT_TRUE(ShouldLaunchAegisAfterInstall(status, true, false, false));
+    EXPECT_FALSE(ShouldLaunchAegisAfterInstall(status, false, false, false));
+    EXPECT_FALSE(ShouldLaunchAegisAfterInstall(status, true, true, false));
+    EXPECT_FALSE(ShouldLaunchAegisAfterInstall(status, true, false, true));
+  }
+}
+
+TEST(AegisLaunchPolicyTest, FailureMaintenanceAndExistingLaunchNeverLaunch) {
+  for (auto status : {INSTALL_FAILED, SAME_VERSION_REPAIR_FAILED, OS_ERROR,
+                      UNINSTALL_SUCCESSFUL, EXISTING_VERSION_LAUNCHED,
+                      RENAME_SUCCESSFUL, INVALID_ARCHIVE}) {
+    EXPECT_FALSE(ShouldLaunchAegisAfterInstall(status, true, false, false));
+  }
+}
+}  // namespace installer
