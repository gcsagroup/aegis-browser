+++ b/chrome/installer/mini_installer/aegis_install_ui.h
@@ -0,0 +1,46 @@
+// Copyright 2026 The GCSA Aegis Authors
+// 安装器的轻量原生界面；不依赖 CRT，不执行安装、提权或浏览器启动。
+#ifndef CHROME_INSTALLER_MINI_INSTALLER_AEGIS_INSTALL_UI_H_
+#define CHROME_INSTALLER_MINI_INSTALLER_AEGIS_INSTALL_UI_H_
+
+#include <windows.h>
+
+namespace mini_installer {
+
+// 安装工作留在调用线程；窗口和控件仅由独立消息线程持有。
+// Finish 必须在销毁前调用：成功短暂展示完成状态，失败保留窗口供用户关闭。
+class AegisInstallUi {
+ public:
+  explicit AegisInstallUi(bool interactive);
+  ~AegisInstallUi();
+  AegisInstallUi(const AegisInstallUi&) = delete;
+  AegisInstallUi& operator=(const AegisInstallUi&) = delete;
+
+  void Installing();
+  void Finish(DWORD exit_code);
+
+ private:
+  static DWORD WINAPI ThreadMain(void* context);
+  static LRESULT CALLBACK WindowProc(HWND window,
+                                     UINT message,
+                                     WPARAM wparam,
+                                     LPARAM lparam);
+  void CreateControls();
+  int Scale(int value) const;
+
+  HANDLE thread_ = nullptr;
+  HANDLE ready_ = nullptr;
+  HWND window_ = nullptr;
+  HWND status_ = nullptr;
+  HWND detail_ = nullptr;
+  HWND progress_ = nullptr;
+  HWND close_ = nullptr;
+  HFONT font_ = nullptr;
+  HFONT title_font_ = nullptr;
+  UINT dpi_ = 96;
+  bool interactive_;
+  bool complete_ = false;
+};
+
+}  // namespace mini_installer
+#endif  // CHROME_INSTALLER_MINI_INSTALLER_AEGIS_INSTALL_UI_H_
diff --git a/chrome/installer/mini_installer/aegis_install_ui_unittest.cc b/chrome/installer/mini_installer/aegis_install_ui_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..72798c08cfbe3fc6bf86d3fdd5383afb403f13a3
--- /dev/null
+++ b/chrome/installer/mini_installer/aegis_install_ui_unittest.cc
@@ -0,0 +1,68 @@
+// Copyright 2026 The GCSA Aegis Authors
+// 验证真实 Win32 窗口的阶段与生命周期，不启动安装或写入用户注册表。
+#include "chrome/installer/mini_installer/aegis_install_ui.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace mini_installer {
+namespace {
+HWND OwnWindow() {
+  HWND window = ::FindWindow(L"GCSAAegisInstallProgress", nullptr);
+  DWORD pid = 0;
+  ::GetWindowThreadProcessId(window, &pid);
+  return pid == ::GetCurrentProcessId() ? window : nullptr;
+}
+
+bool WaitForText(HWND window, const wchar_t* expected) {
+  for (int attempt = 0; attempt < 100; ++attempt) {
+    for (HWND child = ::GetWindow(window, GW_CHILD); child;
+         child = ::GetWindow(child, GW_HWNDNEXT)) {
+      wchar_t text[256] = {};
+      ::GetWindowText(child, text, sizeof(text) / sizeof(text[0]));
+      if (std::wstring(text).find(expected) != std::wstring::npos)
+        return true;
+    }
+    ::Sleep(25);
+  }
+  return false;
+}
+}  // namespace
+
+TEST(AegisInstallUiTest, SilentDoesNotCreateWindow) {
+  AegisInstallUi ui(false);
+  ui.Installing();
+  ui.Finish(0);
+  EXPECT_EQ(nullptr, OwnWindow());
+}
+
+TEST(AegisInstallUiTest, SuccessShowsStagesAndClosesAutomatically) {
+  {
+    AegisInstallUi ui(true);
+    HWND window = OwnWindow();
+    EXPECT_TRUE(window);
+    EXPECT_TRUE(WaitForText(window, L"正在准备安装"));
+    ::SendMessage(window, WM_CLOSE, 0, 0);
+    EXPECT_TRUE(::IsWindow(window));  // 安装提交期间关闭窗口不能中断文件写入。
+    ui.Installing();
+    EXPECT_TRUE(WaitForText(window, L"正在安装 GCSA Aegis"));
+    ui.Finish(0);
+    EXPECT_TRUE(WaitForText(window, L"安装完成"));
+  }
+  EXPECT_EQ(nullptr, OwnWindow());
+}
+
+TEST(AegisInstallUiTest, FailureRemainsUntilAcknowledged) {
+  {
+    AegisInstallUi ui(true);
+    HWND window = OwnWindow();
+    ui.Finish(31);
+    EXPECT_TRUE(WaitForText(window, L"错误代码：31"));
+    ::Sleep(1800);  // 超过成功页收起时间，失败仍应可读。
+    EXPECT_TRUE(::IsWindow(window));
+    ::SendMessage(window, WM_CLOSE, 0, 0);
+  }
+  EXPECT_EQ(nullptr, OwnWindow());
+}
+}  // namespace mini_installer
diff --git a/chrome/installer/mini_installer/configuration.cc b/chrome/installer/mini_installer/configuration.cc
