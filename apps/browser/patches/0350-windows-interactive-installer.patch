@@ -60,6 +60,7 @@ void Configuration::Clear() {
   command_line_ = nullptr;
   argument_count_ = 0;
   is_system_level_ = false;
+  is_interactive_install_ = true;
   has_invalid_switch_ = false;
   should_delete_extracted_files_ = true;
 }
@@ -74,6 +75,15 @@ bool Configuration::ParseCommandLine(const wchar_t* command_line) {
     return false;
 
   for (int i = 1; i < argument_count_; ++i) {
+    // 精确匹配 argv，路径中的 silent 字样不能误触发静默模式。
+    const wchar_t* arg = UNSAFE_TODO(args_[i]);
+    if (::lstrcmpi(arg, L"--silent") == 0 ||
+        ::lstrcmpi(arg, L"--unattended") == 0 ||
+        ::lstrcmpi(arg, L"--update") == 0 ||
+        ::lstrcmpi(arg, L"--uninstall") == 0 ||
+        ::lstrcmpi(arg, L"/silent") == 0 || ::lstrcmpi(arg, L"/S") == 0) {
+      is_interactive_install_ = false;
+    }
     if (0 == ::lstrcmpi(UNSAFE_TODO(args_[i]), L"--system-level")) {
       is_system_level_ = true;
     }
diff --git a/chrome/installer/mini_installer/configuration.h b/chrome/installer/mini_installer/configuration.h
