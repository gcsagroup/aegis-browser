   bool should_delete_extracted_files_;
 
diff --git a/chrome/installer/mini_installer/configuration_test.cc b/chrome/installer/mini_installer/configuration_test.cc
index 744340a2fe3371b027f1021e7d71d5199b369d4e..bda18650ca3ecfc183f54e067acac560bafe0957 100644
--- a/chrome/installer/mini_installer/configuration_test.cc
+++ b/chrome/installer/mini_installer/configuration_test.cc
@@ -165,4 +165,20 @@ TEST_F(MiniInstallerConfigurationTest, DeleteExtractedFilesBogusValues) {
   EXPECT_TRUE(TestConfiguration(L"spam.exe").should_delete_extracted_files());
 }
 
+// 双击与系统级安装显示进度；自动部署/更新不弹窗，路径不参与开关匹配。
+TEST_F(MiniInstallerConfigurationTest, AegisInteractiveInstall) {
+  EXPECT_TRUE(TestConfiguration(L"setup.exe").is_interactive_install());
+  EXPECT_TRUE(
+      TestConfiguration(L"setup.exe --system-level").is_interactive_install());
+  EXPECT_TRUE(
+      TestConfiguration(L"\"C:\\silent folder\\setup.exe\" --verbose-logging")
+          .is_interactive_install());
+  for (const wchar_t* command :
+       {L"setup.exe --silent", L"setup.exe --unattended", L"setup.exe --update",
+        L"setup.exe /S", L"setup.exe /silent", L"setup.exe --uninstall",
+        L"setup.exe --SILENT --system-level"}) {
+    EXPECT_FALSE(TestConfiguration(command).is_interactive_install());
+  }
+}
+
