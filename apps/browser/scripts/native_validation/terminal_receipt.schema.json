{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terminal receiver frame v1",
  "$comment": "Structural wire schema. Before JSON decoding enforce <=1048576 bytes/frame and cumulative context.rawMax. Code additionally rejects duplicate keys, nonfinite constants, non-integer lexical numbers (including 1.0), noncanonical base64 and context/sequence/clock/decoded-byte mismatches. A schema match conveys no authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/data"
    },
    {
      "$ref": "#/$defs/terminal"
    }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "taskID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{32,128}$"
        },
        "productSHA": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "nativeSHA": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "hostID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "bootID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "deadlineNS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "clockBootID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "timebase": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "stdoutMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "stderrMax": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "rawMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "recordMax": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 65536
        }
      },
      "required": [
        "version",
        "taskID",
        "nonce",
        "productSHA",
        "nativeSHA",
        "hostID",
        "bootID",
        "deadlineNS",
        "clockBootID",
        "timebase",
        "stdoutMax",
        "stderrMax",
        "rawMax",
        "recordMax"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "const": "data"
        },
        "stream": {
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "maxLength": 1048576
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      },
      "required": [
        "version",
        "context",
        "seq",
        "kind",
        "stream",
        "data",
        "bytes"
      ],
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1,
          "type": "integer"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "kind": {
          "const": "terminal"
        },
        "actualExit": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "stdoutEOF": {
          "const": true
        },
        "stderrEOF": {
          "const": true
        },
        "waitObserved": {
          "const": true
        },
        "observationSource": {
          "const": "controller-observation"
        }
      },
      "required": [
        "version",
        "context",
        "seq",
        "kind",
        "actualExit",
        "stdoutEOF",
        "stderrEOF",
        "waitObserved",
        "observationSource"
      ],
      "additionalProperties": false
    }
  }
}
