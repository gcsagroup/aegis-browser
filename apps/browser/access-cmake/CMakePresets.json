{
  "version": 3,
  "configurePresets": [
    {
      "name": "common",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-arm64",
      "inherits": "common",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "windows-x64",
      "inherits": "common",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang-cl" }
    },
    {
      "name": "android",
      "hidden": true,
      "inherits": "common",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": { "ANDROID_PLATFORM": "android-26", "ANDROID_STL": "c++_static" }
    },
    {
      "name": "android-arm64",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x64",
      "inherits": "android",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ]
}
