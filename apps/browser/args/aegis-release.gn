# GCSA-aegis release / distributable build (self-contained .app).
# Usage:
#   gn gen out/AegisRelease --args="$(cat apps/browser/args/aegis-release.gn)"
#   autoninja -C out/AegisRelease chrome
#   OUT_DIR=.../out/AegisRelease pnpm --filter @gcsa-aegis/browser package

is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

target_cpu = "arm64"

proprietary_codecs = false
ffmpeg_branding = "Chromium"

# 这是面向用户的自包含构建。Chromium 的 official build 语义独立于
# Google branding；它会关闭昂贵 DCHECK，并让 DUMP_WILL_BE_CHECK 只记录
# 诊断信息，避免可恢复的合成器异常反复杀死 GPU 进程。
is_official_build = true

# 本地固定源码树未下载 Chromium 官方 PGO profile；先关闭 PGO，保证发布
# 语义可复现。正式外发前应下载与 CHROMIUM_VERSION 对应的 profile 再启用。
chrome_pgo_phase = 0
