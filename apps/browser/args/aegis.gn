# Prefer these GN args for GCSA-aegis developer builds.
# Usage: gn gen out/Aegis --args="$(cat apps/browser/args/aegis.gn)"
#
# Release packaging tip: set is_component_build = false, re-gen + rebuild,
# then `pnpm --filter @gcsa-aegis/browser package` for a self-contained .app.

is_debug = false
is_component_build = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0

# Keep the independent access-route test in the generated developer graph.
# Chromium attaches root_extra_deps to its test-only gn_all target; building
# the production `chrome` target does not link or run this executable.
root_extra_deps = [
  "//chrome/browser/aegis/access:access_local_core_manager_unittests",
  "//chrome/browser/aegis/access:access_async_rule_store_unittests",
  "//chrome/browser/aegis/access:access_published_request_runtime_unittests",
  "//chrome/browser/aegis/access:access_network_context_transport_unittests",
  "//components/aegis_access:access_private_context_client_unittests",
  "//components/aegis_access:access_network_context_ipc_unittests",
  "//components/aegis_access:access_network_context_state_unittests",
  "//components/aegis_access:access_cors_route_unittests",
  "//components/aegis_access:access_private_factory_unittests",
  "//components/aegis_access:access_route_wire_unittests",
  "//components/aegis_access:access_http_route_execution_unittests",
  "//components/aegis_access:access_terminal_factory_unittests",
  "//components/aegis_access:access_network_route_registry_unittests",
  "//components/aegis_access:access_network_url_loader_unittests",
  "//components/aegis_access:access_proxy_tunnel_context_unittests",
  "//components/aegis_access:access_route_request_context_unittests",
  "//components/aegis_access:access_proxy_route_context_unittests",
  "//components/aegis_access:access_route_pool_isolation_unittests",
  "//chrome/browser/aegis/access:access_navigation_retry_tab_helper_unittests",
  "//chrome/browser/aegis/access:access_navigation_retry_state_unittests",
  "//chrome/browser/aegis/access:access_service_coordinator_unittests",
  "//chrome/browser/aegis/access:access_site_intent_unittests",
  "//chrome/browser/aegis/access:access_site_proxy_bubble_unittests",
  "//chrome/browser/aegis/access:access_site_proxy_session_unittests",
  "//chrome/browser/aegis/access:access_site_dev_allow_block_panel_unittests",
  "//chrome/browser/aegis/access:access_rule_store_unittests",
  "//components/aegis_access:aegis_access_unittests",
  "//components/aegis_access:browser_request_metadata_seed_unittests",
  "//components/aegis_access:request_dispatch_gate_unittests",
  "//components/aegis_access:request_ownership_registry_unittests",
]

# Faster local iteration on Apple Silicon
target_cpu = "arm64"

# 使用独立的 GCSA Aegis 视觉和产品身份。独立 Bundle ID 会让
# 验证版本使用独立数据目录，避免污染日常 Chromium Profile。
is_chrome_branded = false
branding_path_component = "gcsa_aegis"
branding_path_product = "chromium"
branding_file_path = "//chrome/app/theme/gcsa_aegis/BRANDING"

# Keep proprietary codecs off unless you have a licensing plan
proprietary_codecs = false
ffmpeg_branding = "Chromium"

# Enable official-ish optimizations without claiming Google branding
is_official_build = false

# 面向产品的构建不加载 Chromium 的测试 Field Trial 配置。该配置会在
# macOS 上启用实验性 SearchSettingsUpdate，隐藏完整搜索引擎管理页。
disable_fieldtrial_testing_config = true
