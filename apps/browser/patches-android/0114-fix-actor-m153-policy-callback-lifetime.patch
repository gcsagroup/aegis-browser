 }
@@ -1471,8 +1471,8 @@ TEST_F(AegisExecutionEngineUrlGatingTest,
       switches::kDisableActorSafetyChecks);
   const GURL url("https://outside-scope.test/");
   auto& engine = GetExecutionEngine();
-  engine.origin_gating_checker().AllowNavigationTo(
-      url::Origin::Create(url), /*is_user_confirmed=*/true);
+  engine.origin_gating_checker().AllowNavigationTo(url::Origin::Create(url),
+                                                   /*is_user_confirmed=*/true);
   SetPolicyReason(EnterprisePolicyChecker::UrlBlockReason::kExplicitlyBlocked);
   base::test::TestFuture<MayActOnUrlBlockReason> allowed;
   engine.IsAcceptableNavigationDestination(url, allowed.GetCallback());
