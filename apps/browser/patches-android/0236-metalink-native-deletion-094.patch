 // 产品版本独立于 Chromium 内核版本；发布 tag 使用 v2.0.0.40。
-inline constexpr char kProductVersion[] = "2.0.0.93";
-inline constexpr char kProductVersionLabel[] = "Ver 2.0 (093)";
