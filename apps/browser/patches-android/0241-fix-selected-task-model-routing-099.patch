+TEST_F(AegisAgentServiceTest, SelectedTasksFreezeAutomaticModelPoolRoute) {
+  auto* settings = AegisServiceFactory::GetForProfile(profile_);
+  ASSERT_TRUE(settings);
+  std::vector<AgentModelCatalogEntry> catalog = {
+      ServiceModelEntry("primary", "http://127.0.0.1:8771/v1", "primary", 20),
+      ServiceModelEntry("fallback", "http://127.0.0.1:8772/v1", "fallback", 10)};
+  catalog[0].cost_microusd_per_million_tokens = 123;
+  catalog[1].cost_microusd_per_million_tokens = 456;
+  std::string error;
+  ASSERT_TRUE(settings->SetAgentModelRoutingSettings(
+      AgentModelSelectionMode::kBalanced, catalog, &error)) << error;
+  auto* service = AegisAgentServiceFactory::GetForProfile(profile_);
+  ASSERT_TRUE(service);
+  ASSERT_FALSE(service->ConfiguredModelDestination());
+  const int revision = settings->AgentModelCatalogRevision();
+  testing::NiceMock<MockBrowserWindowInterface> window;
+  ON_CALL(window, GetType()).WillByDefault(
+      testing::Return(BrowserWindowInterface::TYPE_NORMAL));
+  std::vector<std::unique_ptr<tabs::MockTabInterface>> tabs;
+  std::vector<int32_t> ids;
+  for (int index = 0; index < 3; ++index) {
+    auto tab = std::make_unique<tabs::MockTabInterface>();
+    ON_CALL(*tab, GetProfile()).WillByDefault(testing::Return(profile_.get()));
+    ON_CALL(*tab, GetURL()).WillByDefault(testing::Return(
+        GURL("https://fixture.example/" + base::NumberToString(index))));
+    ON_CALL(*tab, GetBrowserWindowInterface()).WillByDefault(
+        testing::Return(&window));
+    ids.push_back(tab->GetHandle().raw_value());
+    tabs.push_back(std::move(tab));
+  }
+  auto* research = service->CreateSelectedResearchTask("比较所选页面", ids);
+  auto* grouping = service->CreateSelectedTabGroupTask("分组所选标签", ids);
+  ASSERT_TRUE(research);
+  ASSERT_TRUE(grouping);
+  catalog[0].destination.model = "new-primary";
+  ASSERT_TRUE(settings->SetAgentModelRoutingSettings(
+      AgentModelSelectionMode::kBalanced, catalog, &error)) << error;
+  for (auto* task : {research, grouping}) {
+    EXPECT_EQ(task->scope().model_destination.model, "primary");
+    ASSERT_TRUE(task->scope().model_fallback_destination);
+    EXPECT_EQ(task->scope().model_fallback_destination->model, "fallback");
+    EXPECT_EQ(task->scope().model_selection_mode,
+              AgentModelSelectionMode::kBalanced);
+    EXPECT_EQ(task->scope().model_catalog_revision, revision);
+    EXPECT_EQ(task->model_routing_metrics()
+                  .primary_model_cost_microusd_per_million_tokens, 123);
+    EXPECT_EQ(task->model_routing_metrics()
+                  .fallback_model_cost_microusd_per_million_tokens, 456);
+    EXPECT_EQ(task->scope().allowed_tab_ids.size(), 3u);
+    EXPECT_EQ(task->state(), AgentTaskState::kAwaitingTaskConsent);
+  }
+  EXPECT_TRUE(research->scope().selected_pages_research);
+  EXPECT_TRUE(grouping->scope().selected_tab_group);
+  EXPECT_FALSE(grouping->scope().AllowsTool("page.observe"));
+}
