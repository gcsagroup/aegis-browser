+// 异步查找恢复时，离屏延迟渲染区域仍可能有尚未处理的样式变更。
+TEST_F(TextFragmentSelectorGeneratorTest, AsyncSearchUpdatesLockedSubtree) {
+  SimRequest request("https://example.com/test.html", "text/html");
+  LoadURL("https://example.com/test.html");
+  request.Complete(R"HTML(
+    <!DOCTYPE html>
+    <p id="target">Selected words for this regression</p>
+    <div style="height: 10000px"></div>
+    <div id="locked" style="content-visibility: auto; contain-intrinsic-size: 100px">
+      <span id="pending">Other searchable words</span>
+    </div>
+  )HTML");
+  Compositor().BeginFrame();
+
+  Element* locked = GetDocument().getElementById(AtomicString("locked"));
+  ASSERT_TRUE(locked->GetDisplayLockContext());
+  ASSERT_TRUE(locked->GetDisplayLockContext()->IsLocked());
+
+  Node* text = GetDocument().getElementById(AtomicString("target"))->firstChild();
+  bool finished = false;
+  String selector;
+  CreateGenerator()->Generate(
+      *MakeGarbageCollected<RangeInFlatTree>(
+          PositionInFlatTree::FirstPositionInNode(*text),
+          PositionInFlatTree::LastPositionInNode(*text)),
+      BindOnce(
+          [](bool& finished, String& selector,
+             const TextFragmentSelector& generated_selector,
+             LinkGenerationError error) {
+            EXPECT_EQ(LinkGenerationError::kNone, error);
+            selector = generated_selector.ToString();
+            finished = true;
+          },
+          std::ref(finished), std::ref(selector)));
+  ASSERT_FALSE(finished);
+
+  GetDocument().getElementById(AtomicString("pending"))->setAttribute(
+      html_names::kStyleAttr, AtomicString("color: red"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_TRUE(finished);
+  EXPECT_EQ("Selected%20words%20for%20this%20regression", selector);
+}
