-// P-mac-5 browser fixture: controlled node/runtime fault must not open the
-// origin via DIRECT; recovery restores the PROXY path; OFF returns native.
-// Product session drill: AccessSiteProxySessionTest.ProductFaultDrillHealthyOnFaultRecoveryOff
-// and RunSiteProxyFaultProductDrill (access_site_proxy_fault_fixture.h).
-// P-mac-6 five-step evidence (B2-1..B2-5 + correlation IDs):
-// AccessSiteProxySessionTest.Phase1EvidenceDrillOnLoadFaultRecoveryOff and
-// RunSiteProxyPhase1EvidenceDrill (access_site_proxy_phase1_evidence_fixture.h).
-// Overlay/unit drills alone must not be recorded as product B4 PASS.
-IN_PROC_BROWSER_TEST_F(AccessProxyingURLLoaderFactoryBrowserTest,
-                       ControlledOnFaultRecoveryOffPreservesRoute) {
-  size_t ignored_origin = 0, ignored_proxy = 0;
-  ASSERT_NO_FATAL_FAILURE(
-      PreparePrefetchTest(&ignored_origin, &ignored_proxy));
-  Profile* const profile = browser()->GetProfile();
-  const std::string run = base::UnguessableToken::Create().ToString();
-
-  ASSERT_NO_FATAL_FAILURE(ExpectLifecycleStage(run, "healthy", false, false));
-  ASSERT_EQ(browser()->GetProfile(), profile);
-
-  const uint64_t on_generation = bootstrap_policy_generation_ + 1;
-  const uint64_t off_generation = on_generation + 1;
-  PublishProxyPolicy(/*publish_endpoint=*/true);
-  ASSERT_EQ(last_publication_generation_, on_generation);
-  auto* runtime = AccessPublishedRequestRuntime::GetOrCreate(profile);
-  ASSERT_NE(runtime, nullptr);
-  const auto on = runtime->CaptureProxyGenerationTupleOnUiThread(*owner_, kProxyGroup);
-  ASSERT_EQ(on.status, aegis_access::RequestGenerationTupleBuildStatus::kComplete);
-  ASSERT_TRUE(on.generations.has_value());
-  ASSERT_EQ(on.generations->policy_generation, on_generation);
