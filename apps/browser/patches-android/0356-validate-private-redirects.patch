     auto* runtime =
         AccessPublishedRequestRuntime::GetOrCreate(browser()->GetProfile());
@@ -1193,7 +1211,8 @@ class AccessProxyingURLLoaderFactoryBrowserTest : public InProcessBrowserTest {
