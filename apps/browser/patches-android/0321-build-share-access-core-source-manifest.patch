diff --git a/components/aegis_access/access_route_planner.cc b/components/aegis_access/access_route_planner.cc
index 177577694ba1ddb7885da983d0b87fa6a288eaeb..87b52aef91e0e731c49115d4a5863bcce109869c 100644
