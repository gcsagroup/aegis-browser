diff --git a/components/aegis_access/request_ownership_registry.cc b/components/aegis_access/request_ownership_registry.cc
index 80a2ed567e2957a7c2af0490b00549316e993275..9abc3517be8b66ca0801674dd9e639ef1718cb4b 100644
--- a/components/aegis_access/request_ownership_registry.cc
+++ b/components/aegis_access/request_ownership_registry.cc
@@ -7,12 +7,18 @@
 namespace aegis_access {
 namespace {
 
-bool IsComplete(const GenerationTuple& generations) {
-  return generations.policy_generation != 0 &&
-         generations.identity_generation != 0 &&
-         generations.selection_generation != 0 &&
-         generations.network_epoch != 0 &&
-         generations.base_proxy_config_generation != 0;
+bool IsComplete(const RequestOwnershipRecord& record) {
+  const auto& generations = record.generations;
+  if (!generations.policy_generation || !generations.identity_generation ||
+      !generations.network_epoch || !generations.base_proxy_config_generation)
+    return false;
+  switch (record.route) {
+    case RequestOwnershipRoute::kProxy:
+      return generations.selection_generation != 0;
+    case RequestOwnershipRoute::kNative:
+      return generations.selection_generation == 0;
+  }
+  return false;
 }
 
 bool IsKnown(RequestScheme scheme) {
@@ -40,7 +46,7 @@ bool HasExactlyOneAttributionToken(const RequestCancellationSelector& selector)
 
 bool HasValidRequestMetadata(const RequestOwnershipRecord& record) {
   return !record.request_id.empty() && IsCompleteOwner(record.owner) &&
-         IsComplete(record.generations) && !record.exact_host.empty() &&
+         IsComplete(record) && !record.exact_host.empty() &&
          IsKnown(record.scheme) && record.port != 0;
 }
 
@@ -58,6 +64,9 @@ bool IsValidRecord(const RequestOwnershipRecord& record) {
 }
 
 bool IsValidSelector(const RequestCancellationSelector& selector) {
+  if (selector.website_context &&
+      selector.top_level_site != "http://" + selector.exact_host &&
+      selector.top_level_site != "https://" + selector.exact_host) return false;
   return IsCompleteOwner(selector.owner) &&
          HasExactlyOneAttributionToken(selector) &&
          !selector.top_level_site.empty() && !selector.exact_host.empty() &&
@@ -66,6 +75,11 @@ bool IsValidSelector(const RequestCancellationSelector& selector) {
 
 bool MatchesSelector(const RequestOwnershipRecord& record,
                      const RequestCancellationSelector& selector) {
+  if (selector.website_context) {
+    return record.site_ownership_reliable && record.owner == selector.owner &&
+        (record.top_level_site == "http://" + selector.exact_host ||
+         record.top_level_site == "https://" + selector.exact_host);
+  }
   if (!record.site_ownership_reliable || record.owner != selector.owner ||
       record.top_level_site != selector.top_level_site ||
       record.exact_host != selector.exact_host ||
@@ -87,7 +101,7 @@ bool SameSelector(const RequestCancellationSelector& left,
          left.pending_navigation_token == right.pending_navigation_token &&
          left.top_level_site == right.top_level_site &&
          left.exact_host == right.exact_host && left.scheme == right.scheme &&
-         left.port == right.port;
+         left.port == right.port && left.website_context == right.website_context;
 }
 
 bool IsValidBarrier(const RequestDispatchBarrier& barrier) {
diff --git a/components/aegis_access/request_ownership_registry.h b/components/aegis_access/request_ownership_registry.h
index 4af26307bd911349198e91ba68a8130bd2c927a3..49f1b106d0f9902ab429d5947248261e65d35e30 100644
--- a/components/aegis_access/request_ownership_registry.h
+++ b/components/aegis_access/request_ownership_registry.h
@@ -45,6 +45,11 @@ class RequestTerminationHandle {
 // Browser-owned, already-normalized identity for one in-flight request. The
 // registry does not parse URLs or trust renderer-provided Profile/partition
 // strings. RequestPolicyContext is the intended source for these fields.
+enum class RequestOwnershipRoute {
+  kProxy,
+  kNative,
+};
+
 struct RequestOwnershipRecord {
   std::string request_id;
   OwnershipKey owner;
@@ -56,6 +61,9 @@ struct RequestOwnershipRecord {
   std::string exact_host;
   RequestScheme scheme = RequestScheme::kInvalid;
   uint16_t port = 0;
+  // Native tracking has no proxy selection. This flag grants no route: the
+  // private NetworkContext independently evaluates the actual target policy.
+  RequestOwnershipRoute route = RequestOwnershipRoute::kProxy;
 
   friend bool operator==(const RequestOwnershipRecord&,
                          const RequestOwnershipRecord&) = default;
@@ -92,6 +100,9 @@ struct RequestCancellationSelector {
   std::string exact_host;
   RequestScheme scheme = RequestScheme::kInvalid;
   uint16_t port = 0;
+  // Browser-issued website toggle: match both trusted HTTP(S) top sites and
+  // all their page destinations in this owner, preserving other websites.
+  bool website_context = false;
 
   friend bool operator==(const RequestCancellationSelector&,
                          const RequestCancellationSelector&) = default;
diff --git a/components/aegis_access/site_proxy_rule_group.cc b/components/aegis_access/site_proxy_rule_group.cc
index dfaad9e6f8ae377aaec852676036f0b25dd9da06..dc2c0577c6a062262185686ec5e7a92eedb55e82 100644
--- a/components/aegis_access/site_proxy_rule_group.cc
+++ b/components/aegis_access/site_proxy_rule_group.cc
@@ -87,6 +87,8 @@ GroupValidation ValidateSiteProxyRuleGroup(
   }
 
   for (const SiteProxyRuleMember& member : members) {
+    if (member.scope != (group->website_context ? PolicyScope::kWebsite : PolicyScope::kSite))
+      return Unknown(GroupValidationError::kScopeMismatch);
     if (!IsCompleteOwner(member.owner) || member.owner != group->owner ||
         member.site_toggle_id != group->site_toggle_id) {
       return Unknown(GroupValidationError::kOwnershipMismatch);
diff --git a/components/aegis_access/site_proxy_rule_group.h b/components/aegis_access/site_proxy_rule_group.h
