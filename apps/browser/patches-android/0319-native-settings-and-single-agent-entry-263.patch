+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.content.WebContentsFactory;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.components.browser_ui.settings.SettingsFragment;
+import org.chromium.components.browser_ui.styles.SemanticColorUtils;
+import org.chromium.components.browser_ui.widget.gesture.BackPressHandler;
+import org.chromium.components.embedder_support.view.ContentView;
+import org.chromium.components.thinwebview.ThinWebView;
+import org.chromium.components.thinwebview.ThinWebViewAttachParams;
+import org.chromium.components.thinwebview.ThinWebViewConstraints;
+import org.chromium.components.thinwebview.ThinWebViewFactory;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.content_public.browser.NavigationHandle;
+import org.chromium.content_public.browser.Visibility;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.WebContentsObserver;
+import org.chromium.ui.base.ViewAndroidDelegate;
+import org.chromium.url.GURL;
+
+/** 在原生设置页面栈内承载 Aegis 设置，复用当前用户配置且不创建浏览器标签页。 */
+@NullMarked
+public final class AegisSettings extends Fragment
+        implements SettingsFragment, ProfileDependentSetting, BackPressHandler {
+    private static final String HOME_URL = "chrome://aegis/";
+    private static final String SAVED_URL = "aegis_settings_url";
+
+    private final SettableNonNullObservableSupplier<Boolean> mCanGoBack =
+            ObservableSuppliers.createNonNull(false);
+    private @Nullable Profile mProfile;
+    private @Nullable WebContents mWebContents;
+    private @Nullable WebContentsObserver mObserver;
+    private @Nullable ThinWebView mThinWebView;
+
+    @Override
+    public void setProfile(Profile profile) {
+        mProfile = profile;
+    }
+
+    @Override
+    public int getAnimationType() {
+        return AnimationType.PROPERTY;
+    }
+
+    @Override
+    public View onCreateView(
+            LayoutInflater inflater, @Nullable ViewGroup container, @Nullable Bundle state) {
+        SettingsActivity activity = (SettingsActivity) requireActivity();
+        WebContents contents =
+                WebContentsFactory.createWebContents(
+                        assumeNonNull(mProfile), /* initiallyHidden= */ false, false);
+        mWebContents = contents;
+        ContentView contentView = ContentView.createContentView(activity, contents);
+        contents.setDelegates(
+                VersionInfo.getProductVersion(),
+                ViewAndroidDelegate.createBasicDelegate(contentView),
+                contentView,
+                /* windowAndroid= */ null,
+                WebContents.createDefaultInternalsHolder());
+        ThinWebViewConstraints constraints = new ThinWebViewConstraints();
+        // Fragment 切换时会调整透明度，需要可参与动画的 TextureView。
+        constraints.supportsOpacity = true;
+        constraints.backgroundColor = SemanticColorUtils.getSettingsBackgroundColor(activity);
+        mThinWebView =
+                ThinWebViewFactory.create(
+                        activity,
+                        constraints,
+                        activity.getIntentRequestTracker(),
+                        /* enablePermissionRequests= */ false);
+        mThinWebView.attachWebContents(
+                contents,
+                contentView,
+                new ThinWebViewAttachParams.Builder().setSupportTheming(true).build());
+        mObserver =
+                new WebContentsObserver(contents) {
+                    @Override
+                    public void didFinishNavigationInPrimaryMainFrame(NavigationHandle handle) {
+                        updateBackState();
+                    }
+
+                    @Override
+                    public void navigationEntriesChanged() {
+                        updateBackState();
+                    }
+                };
+        String url = state == null ? HOME_URL : state.getString(SAVED_URL, HOME_URL);
+        GURL restored = new GURL(url);
+        boolean isSettingsUrl =
+                ("chrome".equals(restored.getScheme()) && "aegis".equals(restored.getHost()))
+                        || ("chrome-untrusted".equals(restored.getScheme())
+                                && "aegis-agent".equals(restored.getHost()));
+        contents.getNavigationController()
+                .loadUrl(new LoadUrlParams(isSettingsUrl ? url : HOME_URL));
+        // 原生设置会给根视图添加大屏留白，由外层承接，避免渲染宽度包含留白。
+        FrameLayout root = new FrameLayout(activity);
+        root.addView(
+                mThinWebView.getView(),
+                new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        contentView.requestFocus();
+        return root;
+    }
+
+    private void updateBackState() {
+        if (mWebContents == null) return;
+        GURL url = mWebContents.getLastCommittedUrl();
+        boolean isHome =
+                "chrome".equals(url.getScheme())
+                        && "aegis".equals(url.getHost())
+                        && (url.getRef().isEmpty() || "home".equals(url.getRef()));
+        mCanGoBack.set(!url.isEmpty() && !isHome);
+    }
+
+    @Override
+    public NonNullObservableSupplier<Boolean> getHandleBackPressChangedSupplier() {
+        return mCanGoBack;
+    }
+
+    @Override
+    public int handleBackPress() {
+        if (mWebContents == null || !mCanGoBack.get()) return BackPressResult.FAILURE;
+        if (mWebContents.getNavigationController().canGoBack()) {
+            mWebContents.getNavigationController().goBack();
+        } else {
+            // 配置变化后恢复的子页没有历史记录，先回到 Aegis 设置首页。
+            mWebContents.getNavigationController().loadUrl(new LoadUrlParams(HOME_URL));
+        }
+        return BackPressResult.SUCCESS;
+    }
+
+    @Override
+    public boolean onOptionsItemSelected(MenuItem item) {
+        if (item.getItemId() == android.R.id.home && mCanGoBack.get()) {
+            return handleBackPress() == BackPressResult.SUCCESS;
+        }
+        return super.onOptionsItemSelected(item);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        requireActivity().setTitle("GCSA Aegis");
+        if (mWebContents != null) mWebContents.updateWebContentsVisibility(Visibility.VISIBLE);
+    }
+
+    @Override
+    public void onPause() {
+        if (mWebContents != null) mWebContents.updateWebContentsVisibility(Visibility.HIDDEN);
+        super.onPause();
+    }
+
+    @Override
+    public void onSaveInstanceState(Bundle state) {
+        super.onSaveInstanceState(state);
+        if (mWebContents != null) {
+            state.putString(SAVED_URL, mWebContents.getLastCommittedUrl().getSpec());
+        }
+    }
+
+    @Override
+    public void onDestroyView() {
+        if (mObserver != null) mObserver.observe(null);
+        mObserver = null;
+        if (mThinWebView != null) mThinWebView.destroy();
+        mThinWebView = null;
+        if (mWebContents != null) mWebContents.destroy();
+        mWebContents = null;
+        mCanGoBack.set(false);
+        super.onDestroyView();
+    }
+}
