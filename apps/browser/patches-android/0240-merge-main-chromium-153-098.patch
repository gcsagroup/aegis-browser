+  EXPECT_EQ(healthy_loader->NetError(), net::OK);
+  EXPECT_EQ(dispatch_state->ownership().size(), 0u);
+  ExpectRoutingDelta(origin_before, proxy_before, /*origin_delta=*/0u,
+                     /*proxy_delta=*/0u);
