+StoreResult<StoredPolicySnapshot> SnapshotError(StoreStatus status,
+                                                std::string detail) {
+  return {status, std::nullopt, std::move(detail)};
+}
+
+StoreResult<PendingMutationRecord> MutationError(StoreStatus status,
+                                                 std::string detail) {
+  return {status, std::nullopt, std::move(detail)};
+}
