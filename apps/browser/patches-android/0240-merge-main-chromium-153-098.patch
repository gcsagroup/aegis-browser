+  EXPECT_EQ(done.Get<2>()->model, "jev-1.13.0");
+  EXPECT_EQ(done.Get<2>()->input_tokens, 42);
+  EXPECT_EQ(done.Get<2>()->output_tokens, 18);
+  EXPECT_GE(done.Get<2>()->latency, base::TimeDelta());
+}
