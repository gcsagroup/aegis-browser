 void SubresourceProxyingURLLoaderService::BindContext::OnDidCommitNavigation(
     WeakDocumentPtr committed_document) {
+  if (document_state_ != DocumentState::kPending) {
+    return;
+  }
   document = committed_document;
+  document_state_ = render_frame_host &&
+                            document.AsRenderFrameHostIfValid() ==
+                                render_frame_host.get()
+                        ? DocumentState::kCommitted
+                        : DocumentState::kInvalid;
+  auto pending_prefetches = std::move(pending_prefetches_);
+  for (auto& callback : pending_prefetches) {
+    std::move(callback).Run(document_state_ == DocumentState::kCommitted);
+  }
+}
+
+void SubresourceProxyingURLLoaderService::BindContext::OnNavigationCancelled() {
+  if (document_state_ != DocumentState::kPending) {
+    return;
+  }
+  document_state_ = DocumentState::kInvalid;
+  auto pending_prefetches = std::move(pending_prefetches_);
+  for (auto& callback : pending_prefetches) {
+    std::move(callback).Run(false);
+  }
+}
+
+bool SubresourceProxyingURLLoaderService::BindContext::QueuePendingPrefetch(
+    base::OnceCallback<void(bool)> callback) {
+  // A renderer must not be able to retain an unbounded number of pending
+  // clients while a navigation is waiting to commit.
+  constexpr size_t kMaxPendingPrefetches = 64;
+  if (document_state_ != DocumentState::kPending ||
+      pending_prefetches_.size() >= kMaxPendingPrefetches) {
+    std::move(callback).Run(false);
+    return false;
+  }
+  pending_prefetches_.push_back(std::move(callback));
+  return true;
 }
 
