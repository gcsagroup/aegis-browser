+IN_PROC_BROWSER_TEST_F(PrefetchBrowserTestBase,
+                       CancelledNavigationAbortsQueuedFactoryAndClone) {
+  embedded_test_server()->RegisterRequestHandler(base::BindRepeating(
+      [](const net::test_server::HttpRequest&)
+          -> std::unique_ptr<net::test_server::HttpResponse> {
+        auto response = std::make_unique<net::test_server::BasicHttpResponse>();
+        response->set_content("");
+        return response;
+      }));
+  auto queued_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/cancelled-queued-prefetch");
+  auto healthy_requests = RequestCounter::CreateAndMonitor(
+      embedded_test_server(), "/cancelled-prefetch-health");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  const GURL first_url = embedded_test_server()->GetURL("/first");
+  ASSERT_TRUE(NavigateToURL(shell(), first_url));
+
+  auto* frame = static_cast<RenderFrameHostImpl*>(
+      shell()->web_contents()->GetPrimaryMainFrame());
+  auto* partition = static_cast<StoragePartitionImpl*>(
+      shell()->web_contents()->GetBrowserContext()->GetDefaultStoragePartition());
+  auto* service = partition->GetSubresourceProxyingURLLoaderService();
+
+  const GURL pending_url = embedded_test_server()->GetURL("/uncommitted");
+  TestNavigationManager navigation(shell()->web_contents(), pending_url);
+  shell()->LoadURL(pending_url);
+  ASSERT_TRUE(navigation.WaitForResponse());
+  auto* pending_request = NavigationRequest::From(navigation.GetNavigationHandle());
+  ASSERT_TRUE(pending_request);
+
+  mojo::Remote<network::mojom::URLLoaderFactory> factory;
+  auto context = service->GetFactory(
+      factory.BindNewPipeAndPassReceiver(), frame->GetFrameTreeNodeId(),
+      partition->GetURLLoaderFactoryForBrowserProcess(), frame->GetWeakPtr(),
+      nullptr);
+  pending_request->set_subresource_proxying_url_loader_service_bind_context(
+      context);
+  mojo::Remote<network::mojom::URLLoaderFactory> clone;
+  factory->Clone(clone.BindNewPipeAndPassReceiver());
+  factory.FlushForTesting();
+
+  auto start_prefetch = [&](network::mojom::URLLoaderFactory* target_factory,
+                            const GURL& url,
+                            base::test::TestFuture<std::optional<std::string>>&
+                                result) {
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = url;
+    request->load_flags = net::LOAD_PREFETCH;
+    request->mode = network::mojom::RequestMode::kNoCors;
+    request->destination = network::mojom::RequestDestination::kEmpty;
+    request->request_initiator = url::Origin::Create(first_url);
+    auto loader = network::SimpleURLLoader::Create(
+        std::move(request), TRAFFIC_ANNOTATION_FOR_TESTS);
+    loader->DownloadToStringOfUnboundedSizeUntilCrashAndDie(
+        target_factory, result.GetCallback());
+    return loader;
+  };
+  const GURL queued_url =
+      embedded_test_server()->GetURL("/cancelled-queued-prefetch");
+  base::test::TestFuture<std::optional<std::string>> original_result;
+  base::test::TestFuture<std::optional<std::string>> clone_result;
+  auto original_loader =
+      start_prefetch(factory.get(), queued_url, original_result);
+  auto clone_loader = start_prefetch(clone.get(), queued_url, clone_result);
+  factory.FlushForTesting();
+  clone.FlushForTesting();
+  EXPECT_FALSE(original_result.IsReady());
+  EXPECT_FALSE(clone_result.IsReady());
+  EXPECT_EQ(queued_requests->GetRequestCount(), 0);
+
+  shell()->web_contents()->Stop();
+  ASSERT_TRUE(navigation.WaitForNavigationFinished());
+  ASSERT_TRUE(original_result.Wait());
+  ASSERT_TRUE(clone_result.Wait());
+  EXPECT_EQ(original_loader->NetError(), net::ERR_ABORTED);
+  EXPECT_EQ(clone_loader->NetError(), net::ERR_ABORTED);
+  EXPECT_EQ(queued_requests->GetRequestCount(), 0);
+  EXPECT_EQ(shell()->web_contents()->GetLastCommittedURL(), first_url);
+
+  mojo::Remote<network::mojom::URLLoaderFactory> healthy_factory;
+  auto healthy_context = service->GetFactory(
+      healthy_factory.BindNewPipeAndPassReceiver(), frame->GetFrameTreeNodeId(),
+      partition->GetURLLoaderFactoryForBrowserProcess(), frame->GetWeakPtr(),
+      nullptr);
+  healthy_context->OnDidCommitNavigation(frame->GetWeakDocumentPtr());
+  base::test::TestFuture<std::optional<std::string>> healthy_result;
+  auto healthy_loader = start_prefetch(
+      healthy_factory.get(),
+      embedded_test_server()->GetURL("/cancelled-prefetch-health"),
+      healthy_result);
+  ASSERT_TRUE(healthy_result.Wait());
+  EXPECT_EQ(healthy_loader->NetError(), net::OK);
+  EXPECT_EQ(healthy_requests->GetRequestCount(), 1);
+  EXPECT_EQ(queued_requests->GetRequestCount(), 0);
+}
