+#endif  // COMPONENTS_AEGIS_ACCESS_REQUEST_GENERATION_TUPLE_BUILDER_H_
diff --git a/components/aegis_access/request_generation_tuple_builder_contract_test.h b/components/aegis_access/request_generation_tuple_builder_contract_test.h
new file mode 100644
index 0000000000000000000000000000000000000000..17e9b810870b2d502cd14c70d9255ead6c579ad2
