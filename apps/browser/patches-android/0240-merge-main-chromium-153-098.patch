+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_AEGIS_ACCESS_ACCESS_RULE_STORE_H_
+#define CHROME_BROWSER_AEGIS_ACCESS_ACCESS_RULE_STORE_H_
+
