+    EXPECT_FALSE(AgentGoalRequestsWindowTabMetadata(goal));
+    EXPECT_FALSE(AgentBrowserGoalNeedsClarification(
+        goal, AgentWorkflowKind::kBrowserSteward));
+  }
+}
