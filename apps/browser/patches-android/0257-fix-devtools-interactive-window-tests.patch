+  content::WebContents::CreateParams create_params(browser()->GetProfile());
   create_params.desired_renderer_state =
       content::WebContents::CreateParams::kInitializeAndWarmupRendererProcess;
   auto created_contents_owner = content::WebContents::Create(create_params);
@@ -544,7 +544,7 @@ IN_PROC_BROWSER_TEST_F(AegisRemoteDevToolsProtocolTest,
   EXPECT_TRUE(found_http_target);
   EXPECT_FALSE(found_internal_target);
 
-  const int window_id = browser()->session_id().id();
+  const int window_id = browser()->GetSessionID().id();
   EXPECT_FALSE(SendCommandSync("Browser.getWindowBounds",
                                base::DictValue().Set("windowId", window_id)));
   ASSERT_TRUE(error());
