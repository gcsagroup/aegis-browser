+++ b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AegisAndroidUpdate.java
@@ -0,0 +1,189 @@
+// Copyright 2026 The GCSA Aegis Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.about_settings;
+
+import android.content.Context;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.os.Build;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.Set;
+
+import javax.net.ssl.HttpsURLConnection;
+
+/** 显式检查与下载；调用者负责后台线程及系统安装确认，不自动安装。 */
+@NullMarked
+final class AegisAndroidUpdate {
+    private static final String API =
+            "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
+    private static final int SIGNATURE_FLAGS = PackageManager.GET_SIGNING_CERTIFICATES;
+
+    static Optional<AegisUpdatePolicy.Update> check(Context context) throws Exception {
+        AegisUpdatePolicy.require(
+                Arrays.asList(Build.SUPPORTED_ABIS).contains("arm64-v8a"),
+                "此更新入口仅支持 Android ARM64");
+        PackageInfo installed = installed(context);
+        AegisUpdatePolicy.require(installed.versionName != null, "当前产品版本缺失");
+        String current = AegisUpdatePolicy.fromLabel(Objects.requireNonNull(installed.versionName));
+        HttpsURLConnection connection = connect(URI.create(API).toURL());
+        try {
+            int status = connection.getResponseCode();
+            if (status == 404) throw new AegisUpdatePolicy.Failure("暂无可用的正式版更新");
+            if (status != 200) throw new IOException("更新服务暂不可用，请稍后重试");
+            ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+            try (InputStream input = connection.getInputStream()) {
+                AegisUpdatePolicy.copyBounded(
+                        input, bytes, 1024 * 1024, System.nanoTime() + 30_000_000_000L);
+            }
+            JSONObject release = new JSONObject(bytes.toString(StandardCharsets.UTF_8.name()));
+            JSONArray rows = release.getJSONArray("assets");
+            List<AegisUpdatePolicy.Asset> assets = new ArrayList<>();
+            for (int i = 0; i < rows.length(); i++) {
+                JSONObject row = rows.getJSONObject(i);
+                assets.add(
+                        new AegisUpdatePolicy.Asset(
+                                row.getString("name"),
+                                row.getString("browser_download_url"),
+                                row.optString("digest", ""),
+                                row.getLong("size"),
+                                "uploaded".equals(row.getString("state"))));
+            }
+            return AegisUpdatePolicy.select(
+                    current,
+                    release.getString("tag_name"),
+                    release.getString("html_url"),
+                    release.getBoolean("draft"),
+                    release.getBoolean("prerelease"),
+                    assets);
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    static File download(Context context, AegisUpdatePolicy.Update update) throws Exception {
+        File directory = new File(context.getCacheDir(), "aegis-updates");
+        if (!directory.isDirectory() && !directory.mkdirs()) {
+            throw new IOException("无法创建安装包目录");
+        }
+        if (directory.getUsableSpace() < update.asset.size + 128L * 1024 * 1024) {
+            throw new IOException("存储空间不足，未开始下载");
+        }
+        File output = File.createTempFile("aegis-", ".apk", directory);
+        boolean verified = false;
+        try {
+            URI uri = URI.create(update.asset.url);
+            long deadline = System.nanoTime() + 600_000_000_000L;
+            for (int redirects = 0; redirects <= 5; redirects++) {
+                AegisUpdatePolicy.require(AegisUpdatePolicy.allowedDownload(uri), "下载来源无效");
+                HttpsURLConnection connection = connect(uri.toURL());
+                try {
+                    int status = connection.getResponseCode();
+                    if (status == 301
+                            || status == 302
+                            || status == 303
+                            || status == 307
+                            || status == 308) {
+                        String location = connection.getHeaderField("Location");
+                        if (location == null) throw new IOException("下载跳转缺少目标");
+                        uri = uri.resolve(location);
+                        continue;
+                    }
+                    if (status != 200) throw new IOException("安装包下载失败，请重试");
+                    long length = connection.getContentLengthLong();
+                    if (length != -1 && length != update.asset.size) {
+                        throw new IOException("安装包大小与发行记录不符");
+                    }
+                    try (InputStream input = connection.getInputStream();
+                            FileOutputStream target = new FileOutputStream(output)) {
+                        long count =
+                                AegisUpdatePolicy.copyBounded(
+                                        input, target, update.asset.size, deadline);
+                        if (count != update.asset.size) throw new IOException("安装包下载不完整");
+                        target.getFD().sync();
+                    }
+                    verify(context, update, output);
+                    verified = true;
+                    return output;
+                } finally {
+                    connection.disconnect();
+                }
+            }
+            throw new IOException("下载跳转次数过多");
+        } finally {
+            // 只删除本次新建且未通过校验的临时包，不触碰旧包或用户资料。
+            if (!verified) output.delete();
+        }
+    }
+
+    static void verify(Context context, AegisUpdatePolicy.Update update, File file)
+            throws Exception {
+        AegisUpdatePolicy.verifyFile(update.asset, file);
+        PackageInfo current = installed(context);
+        PackageInfo candidate =
+                Objects.requireNonNull(
+                        context.getPackageManager()
+                                .getPackageArchiveInfo(file.getAbsolutePath(), SIGNATURE_FLAGS));
+        AegisUpdatePolicy.verifyPackage(
+                new AegisUpdatePolicy.PackageIdentity(
+                        context.getPackageName(),
+                        Objects.requireNonNull(current.versionName),
+                        current.getLongVersionCode(),
+                        signers(current)),
+                new AegisUpdatePolicy.PackageIdentity(
+                        Objects.requireNonNull(candidate.packageName),
+                        Objects.requireNonNull(candidate.versionName),
+                        candidate.getLongVersionCode(),
+                        signers(candidate)),
+                update.version);
+    }
+
+    private static PackageInfo installed(Context context)
+            throws PackageManager.NameNotFoundException {
+        return context.getPackageManager()
+                .getPackageInfo(context.getPackageName(), SIGNATURE_FLAGS);
+    }
+
+    private static Set<String> signers(PackageInfo info) {
+        AegisUpdatePolicy.require(info.signingInfo != null, "安装包没有签名信息");
+        Signature[] signatures =
+                Objects.requireNonNull(
+                        Objects.requireNonNull(info.signingInfo).getApkContentsSigners());
+        AegisUpdatePolicy.require(signatures != null && signatures.length > 0, "安装包没有签名证书");
+        Set<String> result = new HashSet<>();
+        for (Signature signature : signatures) result.add(signature.toCharsString());
+        return result;
+    }
+
+    private static HttpsURLConnection connect(URL url) throws IOException {
+        HttpsURLConnection connection = (HttpsURLConnection) url.openConnection();
+        connection.setConnectTimeout(15_000);
+        connection.setReadTimeout(20_000);
+        connection.setInstanceFollowRedirects(false);
+        connection.setRequestProperty("User-Agent", "Aegis-Android-Updater");
+        connection.setRequestProperty("Accept", "application/vnd.github+json");
+        connection.setRequestProperty("Accept-Encoding", "identity");
+        return connection;
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AegisUpdatePolicy.java b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AegisUpdatePolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..3b324ae80b6f22587393857c9ac3a228f9c7c799
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/about_settings/AegisUpdatePolicy.java
@@ -0,0 +1,234 @@
+// Copyright 2026 The GCSA Aegis Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.about_settings;
+
+import org.chromium.build.annotations.NullMarked;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.URI;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Android 独立资产协议；拒绝桌面包、预发行、缺少摘要和版本降级。 */
+@NullMarked
+final class AegisUpdatePolicy {
+    static final class Failure extends IllegalArgumentException {
+        private static final long serialVersionUID = 1L;
+
+        Failure(String message) {
+            super(message);
+        }
+    }
+
+    static final String REPOSITORY = "https://github.com/gcsagroup/aegis-browser";
+    static final long MAX_BYTES = 2L * 1024 * 1024 * 1024;
+    private static final Pattern VERSION =
+            Pattern.compile(
+                    "(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)");
+    private static final Pattern LABEL =
+            Pattern.compile("Ver (0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) \\(([0-9]{1,10})\\)");
+
+    static final class Asset {
+        final String name;
+        final String url;
+        final String digest;
+        final long size;
+        final boolean uploaded;
+
+        Asset(String name, String url, String digest, long size, boolean uploaded) {
+            this.name = name;
+            this.url = url;
+            this.digest = digest;
+            this.size = size;
+            this.uploaded = uploaded;
+        }
+    }
+
+    static final class Update {
+        final String version;
+        final Asset asset;
+
+        Update(String version, Asset asset) {
+            this.version = version;
+            this.asset = asset;
+        }
+    }
+
+    static final class PackageIdentity {
+        final String name;
+        final String version;
+        final long code;
+        final Set<String> signers;
+
+        PackageIdentity(String name, String version, long code, Set<String> signers) {
+            this.name = name;
+            this.version = fromLabel(version);
+            this.code = code;
+            this.signers = signers;
+        }
+    }
+
+    static void verifyPackage(PackageIdentity current, PackageIdentity candidate, String version) {
+        require(current.name.equals(candidate.name), "安装包包名不匹配");
+        require(candidate.code > current.code, "拒绝版本码降级或重复安装");
+        require(candidate.version.equals(version), "安装包产品版本与发行记录不符");
+        require(compare(version, current.version) > 0, "拒绝产品版本降级");
+        require(
+                !current.signers.isEmpty() && current.signers.equals(candidate.signers),
+                "安装包签名与已安装应用不一致");
+    }
+
+    static String fromLabel(String label) {
+        if (VERSION.matcher(label).matches()) {
+            parseVersion(label);
+            return label;
+        }
+        Matcher match = LABEL.matcher(label);
+        require(match.matches(), "当前产品版本无法识别");
+        String result =
+                match.group(1) + "." + match.group(2) + ".0." + Long.parseLong(match.group(3));
+        parseVersion(result);
+        return result;
+    }
+
+    static String displayLabel(String value) {
+        String[] parts = fromLabel(value).split("\\.");
+        String revision = parts[2].equals("0") ? "" : "." + parts[2];
+        return "Ver "
+                + parts[0]
+                + "."
+                + parts[1]
+                + revision
+                + " ("
+                + String.format(Locale.ROOT, "%03d", Long.parseLong(parts[3]))
+                + ")";
+    }
+
+    static int compare(String left, String right) {
+        long[] a = parseVersion(left);
+        long[] b = parseVersion(right);
+        for (int i = 0; i < 4; i++) {
+            int result = Long.compare(a[i], b[i]);
+            if (result != 0) return result;
+        }
+        return 0;
+    }
+
+    static Optional<Update> select(
+            String current,
+            String tag,
+            String page,
+            boolean draft,
+            boolean prerelease,
+            List<Asset> assets) {
+        require(!draft && !prerelease, "不是正式发行");
+        require(tag.startsWith("v"), "发行版本无效");
+        String version = tag.substring(1);
+        parseVersion(version);
+        require(page.equals(REPOSITORY + "/releases/tag/" + tag), "发行来源不匹配");
+        int order = compare(version, current);
+        require(order >= 0, "拒绝版本降级");
+        if (order == 0) return Optional.empty();
+        String prefix = "GCSA-aegis-" + version + "-chromium-";
+        Pattern name =
+                Pattern.compile(
+                        Pattern.quote(prefix)
+                                + "[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+-android-arm64\\.apk");
+        Optional<Asset> selected = Optional.empty();
+        for (Asset asset : assets) {
+            if (!name.matcher(asset.name).matches()) continue;
+            require(!selected.isPresent(), "Android 安装包重复");
+            require(asset.uploaded, "安装包尚未上传完成");
+            require(asset.size > 0 && asset.size <= MAX_BYTES, "安装包大小无效");
+            require(asset.digest.matches("sha256:[a-fA-F0-9]{64}"), "安装包缺少有效 SHA-256");
+            require(
+                    asset.url.equals(REPOSITORY + "/releases/download/" + tag + "/" + asset.name),
+                    "安装包来源不匹配");
+            selected = Optional.of(asset);
+        }
+        require(selected.isPresent(), "正式发行缺少 Android ARM64 安装包");
+        return Optional.of(new Update(version, selected.get()));
+    }
+
+    // GitHub 下载仅允许 HTTPS 的官方资产主机；不携带凭据或跳转至任意域名。
+    static boolean allowedDownload(URI uri) {
+        if (!"https".equals(uri.getScheme())
+                || uri.getUserInfo() != null
+                || uri.getFragment() != null
+                || (uri.getPort() != -1 && uri.getPort() != 443)) {
+            return false;
+        }
+        return ("github.com".equals(uri.getHost())
+                        && uri.getPath().startsWith("/gcsagroup/aegis-browser/releases/download/"))
+                || "release-assets.githubusercontent.com".equals(uri.getHost());
+    }
+
+    static void verifyFile(Asset asset, File file) throws IOException, NoSuchAlgorithmException {
+        require(
+                asset.size > 0 && asset.size <= MAX_BYTES && file.length() == asset.size,
+                "安装包大小校验失败");
+        require(asset.digest.matches("sha256:[a-fA-F0-9]{64}"), "安装包摘要格式无效");
+        MessageDigest digest = MessageDigest.getInstance("SHA-256");
+        try (InputStream input = new FileInputStream(file)) {
+            byte[] buffer = new byte[64 * 1024];
+            long total = 0;
+            for (int count; (count = input.read(buffer)) != -1; ) {
+                if (Thread.currentThread().isInterrupted()) throw new IOException("已取消");
+                total += count;
+                require(total <= asset.size, "校验期间安装包大小发生变化");
+                digest.update(buffer, 0, count);
+            }
+            require(total == asset.size, "安装包下载不完整");
+        }
+        StringBuilder hex = new StringBuilder();
+        for (byte value : digest.digest()) {
+            hex.append(String.format(Locale.ROOT, "%02x", value & 255));
+        }
+        require(
+                hex.toString().equals(asset.digest.substring(7).toLowerCase(Locale.ROOT)),
+                "安装包 SHA-256 校验失败");
+    }
+
+    private static long[] parseVersion(String value) {
+        Matcher match = VERSION.matcher(value);
+        require(match.matches(), "产品版本格式无效");
+        long[] result = new long[4];
+        for (int i = 0; i < 4; i++) {
+            require(match.group(i + 1).length() <= 10, "产品版本超出范围");
+            result[i] = Long.parseLong(match.group(i + 1));
+            require(result[i] <= Integer.MAX_VALUE, "产品版本超出范围");
+        }
+        return result;
+    }
+
+    static void require(boolean condition, String message) {
+        if (!condition) throw new Failure(message);
+    }
+
+    static long copyBounded(
+            InputStream input, java.io.OutputStream output, long limit, long deadline)
+            throws IOException {
+        long count = 0;
+        byte[] buffer = new byte[64 * 1024];
+        for (int size; (size = input.read(buffer)) != -1; ) {
+            if (Thread.currentThread().isInterrupted() || System.nanoTime() > deadline) {
+                throw new IOException("下载已取消或超时，请重试");
+            }
+            count += size;
+            if (count > limit) throw new IOException("响应大小超过限制");
+            output.write(buffer, 0, size);
+        }
+        return count;
+    }
+}
