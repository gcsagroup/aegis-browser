+import java.nio.file.Path;
+import java.util.List;
+import java.util.Set;
+
+/** 真实临时文件与拒绝路径；不替代 Android 安装器及签名实机验收。 */
+public class AegisUpdatePolicyTest {
+    private static final String V = "2.1.0.110";
+    private static final String NAME =
+            "GCSA-aegis-" + V + "-chromium-154.0.8037.126-android-arm64.apk";
+    private static final String PAGE = AegisUpdatePolicy.REPOSITORY + "/releases/tag/v" + V;
+    private static final String URL =
+            AegisUpdatePolicy.REPOSITORY + "/releases/download/v" + V + "/" + NAME;
+    private static final String HASH =
+            "sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
+
+    private AegisUpdatePolicy.Asset asset(String url, String hash, long size) {
+        return new AegisUpdatePolicy.Asset(NAME, url, hash, size, true);
+    }
+
+    @Test
+    public void acceptsMatchingAndroidAsset() {
+        assertEquals(
+                V,
+                AegisUpdatePolicy.select(
+                                "2.0.0.109",
+                                "v" + V,
+                                PAGE,
+                                false,
+                                false,
+                                List.of(asset(URL, HASH, 3)))
+                        .get()
+                        .version);
+    }
+
+    @Test
+    public void sameVersionNeedsNoDownload() {
+        assertFalse(
+                AegisUpdatePolicy.select(V, "v" + V, PAGE, false, false, List.of()).isPresent());
+    }
+
+    @Test
+    public void rejectsDowngrade() {
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () -> AegisUpdatePolicy.select("2.2.0.1", "v" + V, PAGE, false, false, List.of()));
+    }
+
+    @Test
+    public void rejectsDraftAndPreview() {
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () -> AegisUpdatePolicy.select("2.0.0.1", "v" + V, PAGE, true, false, List.of()));
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () -> AegisUpdatePolicy.select("2.0.0.1", "v" + V, PAGE, false, true, List.of()));
+    }
+
+    @Test
+    public void rejectsMissingAndDuplicateAssets() {
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () -> AegisUpdatePolicy.select("2.0.0.1", "v" + V, PAGE, false, false, List.of()));
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () ->
+                        AegisUpdatePolicy.select(
+                                "2.0.0.1",
+                                "v" + V,
+                                PAGE,
+                                false,
+                                false,
+                                List.of(asset(URL, HASH, 3), asset(URL, HASH, 3))));
+    }
+
+    @Test
+    public void rejectsInvalidMetadata() {
+        for (AegisUpdatePolicy.Asset row :
+                List.of(
+                        asset(URL, "", 3),
+                        asset(URL, HASH, 0),
+                        asset(URL, HASH, AegisUpdatePolicy.MAX_BYTES + 1),
+                        asset(URL + "?other=1", HASH, 3))) {
+            assertThrows(
+                    AegisUpdatePolicy.Failure.class,
+                    () ->
+                            AegisUpdatePolicy.select(
+                                    "2.0.0.1", "v" + V, PAGE, false, false, List.of(row)));
+        }
+    }
+
+    @Test
+    public void rejectsForeignPageAndDesktopPackage() {
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () ->
+                        AegisUpdatePolicy.select(
+                                "2.0.0.1",
+                                "v" + V,
+                                PAGE + "/other",
+                                false,
+                                false,
+                                List.of(asset(URL, HASH, 3))));
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () ->
+                        AegisUpdatePolicy.select(
+                                "2.0.0.1",
+                                "v" + V,
+                                PAGE,
+                                false,
+                                false,
+                                List.of(
+                                        new AegisUpdatePolicy.Asset(
+                                                "GCSA-aegis-" + V + "-mac-arm64.dmg",
+                                                URL,
+                                                HASH,
+                                                3,
+                                                true))));
+    }
+
+    @Test
+    public void validatesVersionBoundaries() {
+        assertEquals("Ver 2.0 (094)", AegisUpdatePolicy.displayLabel("Ver 2.0 (094)"));
+        assertEquals("Ver 2.1 (110)", AegisUpdatePolicy.displayLabel("2.1.0.110"));
+        assertEquals("Ver 2.1.1 (110)", AegisUpdatePolicy.displayLabel("2.1.1.110"));
+        assertEquals("2.1.1.110", AegisUpdatePolicy.fromLabel("2.1.1.110"));
+        assertEquals("2.0.0.94", AegisUpdatePolicy.fromLabel("Ver 2.0 (094)"));
+        assertEquals("2.1.0.110", AegisUpdatePolicy.fromLabel("Ver 2.1 (110)"));
+        assertTrue(AegisUpdatePolicy.compare("2.1.0.1", "2.0.99.999") > 0);
+        for (String value :
+                List.of(
+                        "02.1.0.1",
+                        "2.1.0.1-preview",
+                        "999999999999999999999.0.0.0",
+                        "2.1.0.2147483648")) {
+            assertThrows(
+                    AegisUpdatePolicy.Failure.class, () -> AegisUpdatePolicy.compare(value, V));
+        }
+    }
+
+    @Test
+    public void constrainsRedirects() {
+        assertTrue(AegisUpdatePolicy.allowedDownload(URI.create(URL)));
+        assertTrue(
+                AegisUpdatePolicy.allowedDownload(
+                        URI.create("https://release-assets.githubusercontent.com/a?token=x")));
+        for (String url :
+                List.of(
+                        "http://github.com/gcsagroup/aegis-browser/releases/download/x",
+                        "https://evil.test/x",
+                        "https://github.com.evil.test/x",
+                        "https://user@release-assets.githubusercontent.com/x",
+                        "https://release-assets.githubusercontent.com:444/x",
+                        "https://github.com/other/repo/x")) {
+            assertFalse(url, AegisUpdatePolicy.allowedDownload(URI.create(url)));
+        }
+    }
+
+    @Test
+    public void checksRealBytesAndCorruption() throws Exception {
+        Path file = Files.createTempFile("aegis-update-test-", ".apk");
+        try {
+            Files.write(file, new byte[] {97, 98, 99});
+            AegisUpdatePolicy.verifyFile(asset(URL, HASH, 3), file.toFile());
+            Files.write(file, new byte[] {97, 98, 100});
+            assertThrows(
+                    AegisUpdatePolicy.Failure.class,
+                    () -> AegisUpdatePolicy.verifyFile(asset(URL, HASH, 3), file.toFile()));
+            Files.write(file, new byte[] {97});
+            assertThrows(
+                    AegisUpdatePolicy.Failure.class,
+                    () -> AegisUpdatePolicy.verifyFile(asset(URL, HASH, 3), file.toFile()));
+        } finally {
+            Files.delete(file);
+        }
+    }
+
+    @Test
+    public void packageIdentityPreservesUpgradePath() {
+        AegisUpdatePolicy.PackageIdentity current =
+                new AegisUpdatePolicy.PackageIdentity(
+                        "app.gcsa.aegis",
+                        "Ver 2.0 (094)",
+                        2000000094L,
+                        Set.of("existing-certificate"));
+        AegisUpdatePolicy.PackageIdentity next =
+                new AegisUpdatePolicy.PackageIdentity(
+                        "app.gcsa.aegis", V, 2000000110L, Set.of("existing-certificate"));
+        AegisUpdatePolicy.verifyPackage(current, next, V);
+        for (AegisUpdatePolicy.PackageIdentity invalid :
+                List.of(
+                        new AegisUpdatePolicy.PackageIdentity(
+                                "other.package", V, next.code, next.signers),
+                        new AegisUpdatePolicy.PackageIdentity(
+                                next.name, V, current.code, next.signers),
+                        new AegisUpdatePolicy.PackageIdentity(
+                                next.name, "2.0.0.93", next.code, next.signers),
+                        new AegisUpdatePolicy.PackageIdentity(
+                                next.name, "2.1.0.111", next.code, next.signers),
+                        new AegisUpdatePolicy.PackageIdentity(
+                                next.name, V, next.code, Set.of("different-certificate")),
+                        new AegisUpdatePolicy.PackageIdentity(next.name, V, next.code, Set.of()))) {
+            assertThrows(
+                    AegisUpdatePolicy.Failure.class,
+                    () -> AegisUpdatePolicy.verifyPackage(current, invalid, V));
+        }
+        assertThrows(
+                AegisUpdatePolicy.Failure.class,
+                () ->
+                        AegisUpdatePolicy.verifyPackage(
+                                new AegisUpdatePolicy.PackageIdentity(
+                                        next.name, "2.0.0.94", current.code, Set.of()),
+                                new AegisUpdatePolicy.PackageIdentity(
+                                        next.name, V, next.code, Set.of()),
+                                V));
+    }
+
+    @Test
+    public void boundsDownloadedBytes() throws Exception {
+        java.io.ByteArrayOutputStream output = new java.io.ByteArrayOutputStream();
+        assertEquals(
+                3,
+                AegisUpdatePolicy.copyBounded(
+                        new java.io.ByteArrayInputStream(new byte[] {1, 2, 3}),
+                        output,
+                        3,
+                        System.nanoTime() + 1000000000L));
+        assertArrayEquals(new byte[] {1, 2, 3}, output.toByteArray());
+        assertThrows(
+                java.io.IOException.class,
+                () ->
+                        AegisUpdatePolicy.copyBounded(
+                                new java.io.ByteArrayInputStream(new byte[] {1, 2, 3, 4}),
+                                new java.io.ByteArrayOutputStream(),
+                                3,
+                                System.nanoTime() + 1000000000L));
+    }
+
+    @Test
+    public void propagatesNetworkFailureAndDeadline() {
+        java.io.InputStream failed =
+                new java.io.InputStream() {
+                    @Override
+                    public int read() throws java.io.IOException {
+                        throw new java.io.IOException("受控网络失败");
+                    }
+                };
+        assertThrows(
+                java.io.IOException.class,
+                () ->
+                        AegisUpdatePolicy.copyBounded(
+                                failed,
+                                new java.io.ByteArrayOutputStream(),
+                                100,
+                                System.nanoTime() + 1000000000L));
+        assertThrows(
+                java.io.IOException.class,
+                () ->
+                        AegisUpdatePolicy.copyBounded(
+                                new java.io.ByteArrayInputStream(new byte[] {1}),
+                                new java.io.ByteArrayOutputStream(),
+                                100,
+                                System.nanoTime() - 1));
+    }
+
+    @Test
+    public void stopsOnCancellation() {
+        Thread.currentThread().interrupt();
+        try {
+            assertThrows(
+                    java.io.IOException.class,
+                    () ->
+                            AegisUpdatePolicy.copyBounded(
+                                    new java.io.ByteArrayInputStream(new byte[] {1}),
+                                    new java.io.ByteArrayOutputStream(),
+                                    100,
+                                    System.nanoTime() + 1000000000L));
+        } finally {
+            Thread.interrupted();
+        }
+    }
+}
