@@ -0,0 +1,208 @@
+// Copyright 2026 The GCSA Aegis Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.about_settings;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.ClipData;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.util.ChromeFileProvider;
+
+import java.io.File;
+import java.util.Optional;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.function.BooleanSupplier;
+
+/** 关于页的显式更新入口；下载和安装分别由用户确认。 */
+@NullMarked
+final class AegisUpdatePreference implements AutoCloseable {
+    private final Activity mActivity;
+    private final BooleanSupplier mPageVisible;
+    private final Preference mPreference;
+    private final Handler mMain = new Handler(Looper.getMainLooper());
+    private final ExecutorService mWorker = Executors.newSingleThreadExecutor();
+    private boolean mClosed;
+    private @Nullable AlertDialog mDialog;
+
+    AegisUpdatePreference(Activity activity, Preference preference, BooleanSupplier pageVisible) {
+        mPageVisible = pageVisible;
+        mActivity = activity;
+        mPreference = preference;
+        preference.setKey("aegis_check_update");
+        preference.setTitle("检查 Aegis 更新");
+        preference.setSummary("检查正式发行；下载后由系统确认安装");
+        preference.setOnPreferenceClickListener(
+                ignored -> {
+                    check();
+                    return true;
+                });
+    }
+
+    private void check() {
+        if (mClosed) return;
+        mPreference.setEnabled(false);
+        mPreference.setSummary("正在检查…");
+        mWorker.execute(
+                () -> {
+                    try {
+                        Optional<AegisUpdatePolicy.Update> update =
+                                AegisAndroidUpdate.check(mActivity);
+                        post(
+                                () -> {
+                                    mPreference.setEnabled(true);
+                                    if (!update.isPresent()) {
+                                        mPreference.setSummary("当前已是最新正式版本");
+                                        return;
+                                    }
+                                    AegisUpdatePolicy.Update next = update.get();
+                                    mPreference.setSummary("发现正式版本 " + next.version);
+                                    showDialog(
+                                            new AlertDialog.Builder(mActivity)
+                                                    .setTitle("下载 Aegis " + next.version)
+                                                    .setMessage(
+                                                            "安装包约 "
+                                                                    + ((next.asset.size + 1048575)
+                                                                            / 1048576)
+                                                                    + " MB。下载完成后核对摘要、包名和签名，再由系统确认安装。")
+                                                    .setNegativeButton("取消", null)
+                                                    .setPositiveButton(
+                                                            "下载", (dialog, which) -> download(next))
+                                                    .create());
+                                });
+                    } catch (Exception error) {
+                        failed(error);
+                    }
+                });
+    }
+
+    private void download(AegisUpdatePolicy.Update update) {
+        if (mClosed) return;
+        mPreference.setEnabled(false);
+        mPreference.setSummary("正在下载并校验安装包…");
+        mWorker.execute(
+                () -> {
+                    try {
+                        File file = AegisAndroidUpdate.download(mActivity, update);
+                        post(
+                                () -> {
+                                    mPreference.setEnabled(true);
+                                    mPreference.setTitle("安装已验证的更新");
+                                    mPreference.setSummary("版本 " + update.version + "；点击进入系统安装确认");
+                                    mPreference.setOnPreferenceClickListener(
+                                            ignored -> {
+                                                install(update, file);
+                                                return true;
+                                            });
+                                    showDialog(
+                                            new AlertDialog.Builder(mActivity)
+                                                    .setTitle("安装包校验通过")
+                                                    .setMessage("继续后由 Android 确认安装。现有应用资料将保留。")
+                                                    .setNegativeButton("稍后", null)
+                                                    .setPositiveButton(
+                                                            "继续",
+                                                            (dialog, which) ->
+                                                                    install(update, file))
+                                                    .create());
+                                });
+                    } catch (Exception error) {
+                        failed(error);
+                    }
+                });
+    }
+
+    private void install(AegisUpdatePolicy.Update update, File file) {
+        if (mClosed) return;
+        // 系统授权只能由用户完成，返回后再次点击即可继续。
+        if (!mActivity.getPackageManager().canRequestPackageInstalls()) {
+            try {
+                mPreference.setSummary("请允许此应用安装更新，返回后再次点击安装");
+                mActivity.startActivity(
+                        new Intent(
+                                Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+                                Uri.parse("package:" + mActivity.getPackageName())));
+            } catch (RuntimeException error) {
+                failed(error);
+            }
+            return;
+        }
+        mPreference.setEnabled(false);
+        mWorker.execute(
+                () -> {
+                    try {
+                        // 等待安装期间版本或文件可能变化，进入系统安装器前重新校验。
+                        AegisAndroidUpdate.verify(mActivity, update, file);
+                        post(
+                                () -> {
+                                    mPreference.setEnabled(true);
+                                    try {
+                                        Uri uri = ChromeFileProvider.generateUri(file);
+                                        Intent intent = new Intent(Intent.ACTION_INSTALL_PACKAGE);
+                                        intent.setData(uri);
+                                        intent.setClipData(ClipData.newRawUri("Aegis 更新", uri));
+                                        intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+                                        mActivity.startActivity(intent);
+                                        mPreference.setSummary("已打开系统安装确认；完成后请重新打开关于页核对版本");
+                                    } catch (RuntimeException error) {
+                                        failed(error);
+                                    }
+                                });
+                    } catch (Exception error) {
+                        failed(error);
+                    }
+                });
+    }
+
+    private void failed(Exception error) {
+        // 不把下载跳转参数、底层异常或凭据展示到界面。
+        String message =
+                error instanceof AegisUpdatePolicy.Failure && error.getMessage() != null
+                        ? error.getMessage()
+                        : "更新未完成，请检查网络、存储和系统安装设置后重试";
+        post(
+                () -> {
+                    mPreference.setEnabled(true);
+                    mPreference.setSummary(message);
+                    mPreference.setTitle("检查 Aegis 更新");
+                    mPreference.setOnPreferenceClickListener(
+                            ignored -> {
+                                check();
+                                return true;
+                            });
+                });
+    }
+
+    private void showDialog(AlertDialog dialog) {
+        if (mPageVisible.getAsBoolean()) {
+            if (mDialog != null) mDialog.dismiss();
+            mDialog = dialog;
+            dialog.show();
+        }
+    }
+
+    private void post(Runnable action) {
+        mMain.post(
+                () -> {
+                    if (!mClosed && !mActivity.isFinishing() && !mActivity.isDestroyed())
+                        action.run();
+                });
+    }
+
+    @Override
+    public void close() {
+        mClosed = true;
+        if (mDialog != null) mDialog.dismiss();
+        mWorker.shutdownNow();
+    }
+}
