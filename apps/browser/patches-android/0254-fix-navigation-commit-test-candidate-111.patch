---
 chrome/browser/actor/execution_engine_unittest.cc  | 9 +++++----
 chrome/browser/ui/webui/help/aegis_github_update.h | 4 ++--
 2 files changed, 7 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/actor/execution_engine_unittest.cc b/chrome/browser/actor/execution_engine_unittest.cc
index 41524086a387b05403755dd3bc9735a32e5b1d9e..8e4c31f3e03ee06f517a85ad6c0a78c5d2517216 100644
--- a/chrome/browser/actor/execution_engine_unittest.cc
+++ b/chrome/browser/actor/execution_engine_unittest.cc
@@ -1493,10 +1493,11 @@ TEST_F(AegisExecutionEngineUrlGatingTest,
       url::Origin::Create(destination), /*is_user_confirmed=*/true);
   SetPolicyReason(EnterprisePolicyChecker::UrlBlockReason::kExplicitlyBlocked);
   content::MockNavigationHandle navigation(destination, main_rfh());
-  base::test::TestFuture<bool> allowed;
-  EXPECT_EQ(engine.ShouldDeferNavigation(navigation, allowed.GetCallback()),
-            content::NavigationThrottle::DEFER);
-  EXPECT_FALSE(allowed.Get());
+  base::test::TestFuture<MayActOnUrlBlockReason> allowed;
+  engine.ShouldNavigationCommit(navigation, allowed.GetCallback());
+  // 新接口异步返回具体拒绝原因，确认缓存不能绕过明确的策略拒绝。
+  EXPECT_FALSE(allowed.IsReady());
+  EXPECT_EQ(allowed.Get(), MayActOnUrlBlockReason::kEnterprisePolicy);
 }
 
 TEST_F(AegisExecutionEngineUrlGatingTest, ApprovedScopeStillRejectsFileScheme) {
diff --git a/chrome/browser/ui/webui/help/aegis_github_update.h b/chrome/browser/ui/webui/help/aegis_github_update.h
