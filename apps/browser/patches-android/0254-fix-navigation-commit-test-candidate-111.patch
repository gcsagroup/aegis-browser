-inline constexpr char kProductVersionLabel[] = "Ver 2.1 (110)";
+inline constexpr char kProductVersion[] = "2.1.0.111";
+inline constexpr char kProductVersionLabel[] = "Ver 2.1 (111)";
 inline constexpr char kReleaseAPI[] =
     "https://api.github.com/repos/gcsagroup/aegis-browser/releases/latest";
