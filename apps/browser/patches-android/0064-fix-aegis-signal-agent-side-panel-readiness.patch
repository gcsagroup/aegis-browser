+++ b/chrome/browser/ui/webui/aegis_agent/aegis_agent.mojom
@@ -109,6 +109,8 @@ interface Page {
 };
 
 interface PageHandler {
+  ShowUI();
+
   GetSnapshot() => (TaskSnapshot snapshot);
 
   CreateTask(string goal,
diff --git a/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc b/chrome/browser/ui/webui/aegis_agent/aegis_agent_page_handler.cc
index 7dc07d318cfc2a381076dc4c09f9a815fbe097be..59d5a0085b664280c2e0f8f59ac9a4772918d6fd 100644
