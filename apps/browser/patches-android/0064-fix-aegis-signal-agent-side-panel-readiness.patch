Date: Sat, 29 Aug 2026 03:02:09 +0800
Subject: [PATCH] fix(aegis): signal agent side panel readiness

---
 .../aegis/agent/aegis_agent_browsertest.cc    | 26 +++++++++++++++++++
 chrome/browser/resources/aegis_agent/agent.ts |  5 +++-
 .../ui/webui/aegis_agent/aegis_agent.mojom    |  2 ++
 .../aegis_agent/aegis_agent_page_handler.cc   |  9 +++++++
 .../aegis_agent/aegis_agent_page_handler.h    |  4 +++
 .../ui/webui/aegis_agent/aegis_agent_ui.cc    |  2 +-
 6 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
index 489ba392d25901238e176a5c16b9c3d729386bad..354f418e54a008319211f38b7b04318e82c4336d 100644
--- a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
+++ b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
@@ -19,8 +19,10 @@
 #include "chrome/browser/ui/browser.h"
 #include "chrome/browser/ui/browser_actions.h"
 #include "chrome/browser/ui/browser_window/public/browser_window_features.h"
+#include "chrome/browser/ui/side_panel/side_panel_action_callback.h"
 #include "chrome/browser/ui/side_panel/side_panel_entry.h"
 #include "chrome/browser/ui/side_panel/side_panel_entry_key.h"
+#include "chrome/browser/ui/side_panel/side_panel_enums.h"
 #include "chrome/browser/ui/side_panel/side_panel_registry.h"
 #include "chrome/browser/ui/side_panel/side_panel_ui.h"
 #include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.h"
@@ -116,6 +118,30 @@ IN_PROC_BROWSER_TEST_F(AegisAgentDefaultEntryBrowserTest,
   EXPECT_FALSE(pinned->Contains(kActionSidePanelShowAegisAgent));
 }
 
+IN_PROC_BROWSER_TEST_F(AegisAgentDefaultEntryBrowserTest,
+                       PinnedToolbarActionOpensPanel) {
+  actions::ActionItem* action = actions::ActionManager::Get().FindAction(
+      kActionSidePanelShowAegisAgent,
+      browser()->GetActions()->root_action_item());
+  ASSERT_TRUE(action);
+  SidePanelUI* side_panel = browser()->GetFeatures().side_panel_ui();
+  ASSERT_TRUE(side_panel);
+  side_panel->DisableAnimationsForTesting();
+
+  action->InvokeAction(
+      actions::ActionInvocationContext::Builder()
+          .SetProperty(
+              kSidePanelOpenTriggerKey,
+              static_cast<std::underlying_type_t<SidePanelOpenTrigger>>(
+                  SidePanelOpenTrigger::kPinnedEntryToolbarButton))
+          .Build());
+
+  EXPECT_TRUE(base::test::RunUntil([&]() {
+    return side_panel->IsSidePanelEntryShowing(
+        SidePanelEntry::Key(SidePanelEntry::Id::kAegisAgent));
+  }));
+}
+
 class AegisAgentBrowserTest : public InProcessBrowserTest {
  public:
   AegisAgentBrowserTest() {
diff --git a/chrome/browser/resources/aegis_agent/agent.ts b/chrome/browser/resources/aegis_agent/agent.ts
index b33475a400842ec3dcc544f56d8966584f93a3f5..f8f41b70e2607ac686920aace2466841df9cf93a 100644
--- a/chrome/browser/resources/aegis_agent/agent.ts
+++ b/chrome/browser/resources/aegis_agent/agent.ts
@@ -397,4 +397,7 @@ function bindActions() {
 initializeLabels();
 bindActions();
 proxy.callbackRouter.onSnapshotChanged.addListener(render);
-proxy.handler.getSnapshot().then(({snapshot: initial}) => render(initial));
+proxy.handler.getSnapshot().then(({snapshot: initial}) => {
+  render(initial);
+  proxy.handler.showUI();
+});
diff --git a/chrome/browser/ui/webui/aegis_agent/aegis_agent.mojom b/chrome/browser/ui/webui/aegis_agent/aegis_agent.mojom
index 3948b1e753edc72e5a66326f76760a2f82e79134..3c454d22ec3768a9e622b3f6a5986e7f98504f26 100644
