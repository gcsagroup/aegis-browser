   ~AegisAgentPageHandler() override;
 
+  void ShowUI() override;
   void GetSnapshot(GetSnapshotCallback callback) override;
   void CreateTask(const std::string& goal,
                   aegis_agent::mojom::AgentMode mode,
@@ -91,6 +94,7 @@ class AegisAgentPageHandler : public aegis_agent::mojom::PageHandler,
 
   raw_ptr<Profile> profile_;
   raw_ptr<BrowserWindowInterface> browser_ = nullptr;
+  raw_ptr<AegisAgentUI> ui_ = nullptr;
   raw_ptr<aegis::agent::AegisAgentService> service_ = nullptr;
   std::string active_task_id_;
   std::string last_error_;
diff --git a/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc b/chrome/browser/ui/webui/aegis_agent/aegis_agent_ui.cc
index 9ad9678911d8193ad16f16ffd5b175d5473e35b6..0da7b17209cc8f797a49c67a1b9efa451b07b2e0 100644
