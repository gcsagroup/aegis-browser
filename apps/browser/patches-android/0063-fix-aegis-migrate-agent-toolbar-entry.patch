From 544ff0e0e638b28d03f2246a3ad00ba806633af2 Mon Sep 17 00:00:00 2001
From: MacBook Pro <lazy@MacBook-Pro.local>
Date: Sat, 29 Aug 2026 01:38:01 +0800
Subject: [PATCH] fix(aegis): migrate agent toolbar entry

---
 .../browser/aegis/agent/aegis_agent_browsertest.cc | 23 ++++++++++++++++++++++
 .../pinned_toolbar/pinned_toolbar_actions_model.cc |  6 ++++++
 chrome/browser/ui/toolbar/toolbar_pref_names.cc    |  1 +
 chrome/browser/ui/toolbar/toolbar_pref_names.h     |  5 +++++
 4 files changed, 35 insertions(+)

diff --git a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
index dd30ca14c91a25fc2aecae6d30d362858cf75eb1..489ba392d25901238e176a5c16b9c3d729386bad 100644
--- a/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
+++ b/chrome/browser/aegis/agent/aegis_agent_browsertest.cc
@@ -24,6 +24,7 @@
 #include "chrome/browser/ui/side_panel/side_panel_registry.h"
 #include "chrome/browser/ui/side_panel/side_panel_ui.h"
 #include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.h"
+#include "chrome/browser/ui/toolbar/toolbar_pref_names.h"
 #include "chrome/browser/ui/views/side_panel/aegis_agent/aegis_agent_side_panel.h"
 #include "chrome/common/aegis/features.h"
 #include "chrome/common/aegis/pref_names.h"
@@ -91,6 +92,28 @@ IN_PROC_BROWSER_TEST_F(AegisAgentDefaultEntryBrowserTest,
       PinnedToolbarActionsModel::Get(profile);
   ASSERT_TRUE(pinned);
   EXPECT_TRUE(pinned->Contains(kActionSidePanelShowAegisAgent));
+  EXPECT_TRUE(
+      profile->GetPrefs()->GetBoolean(::prefs::kAegisAgentAutoPinnedMigration));
+}
+
+IN_PROC_BROWSER_TEST_F(AegisAgentDefaultEntryBrowserTest,
+                       ExistingProfilePinsEntryOnlyOnce) {
+  Profile* profile = browser()->profile();
+  PinnedToolbarActionsModel* pinned =
+      PinnedToolbarActionsModel::Get(profile);
+  ASSERT_TRUE(pinned);
+
+  pinned->UpdatePinnedState(kActionSidePanelShowAegisAgent, false);
+  profile->GetPrefs()->SetBoolean(::prefs::kAegisAgentAutoPinnedMigration,
+                                  false);
+  pinned->MaybeMigrateExistingPinnedStates();
+  EXPECT_TRUE(pinned->Contains(kActionSidePanelShowAegisAgent));
+  EXPECT_TRUE(
+      profile->GetPrefs()->GetBoolean(::prefs::kAegisAgentAutoPinnedMigration));
+
+  pinned->UpdatePinnedState(kActionSidePanelShowAegisAgent, false);
+  pinned->MaybeMigrateExistingPinnedStates();
+  EXPECT_FALSE(pinned->Contains(kActionSidePanelShowAegisAgent));
 }
 
 class AegisAgentBrowserTest : public InProcessBrowserTest {
diff --git a/chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.cc b/chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.cc
index dcd99a882c7a1b3d5d20c5529aaec4aad2e533ad..8a005f4864cd90ab7c99281a636097ff54fcd971 100644
--- a/chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.cc
+++ b/chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model.cc
@@ -22,6 +22,7 @@
 #include "chrome/browser/ui/toolbar/pinned_toolbar/pinned_toolbar_actions_model_factory.h"
 #include "chrome/browser/ui/toolbar/toolbar_pref_names.h"
 #include "chrome/browser/ui/ui_features.h"
+#include "chrome/common/aegis/features.h"
 #include "chrome/common/chrome_features.h"
 #include "chrome/common/pref_names.h"
 #include "components/prefs/pref_change_registrar.h"
@@ -248,6 +249,11 @@ void PinnedToolbarActionsModel::MaybeMigrateExistingPinnedStates() {
     UpdatePinnedState(kActionRouteMedia, previously_pinned);
     pref_service_->SetBoolean(prefs::kPinnedCastMigrationComplete, true);
   }
+  if (base::FeatureList::IsEnabled(aegis::features::kAegisAgent) &&
+      !pref_service_->GetBoolean(prefs::kAegisAgentAutoPinnedMigration)) {
+    UpdatePinnedState(kActionSidePanelShowAegisAgent, true);
+    pref_service_->SetBoolean(prefs::kAegisAgentAutoPinnedMigration, true);
+  }
   if (base::FeatureList::IsEnabled(
           features::kTabsFromOtherDevicesSidePanelPinnedByDefault) &&
       !pref_service_->GetBoolean(
diff --git a/chrome/browser/ui/toolbar/toolbar_pref_names.cc b/chrome/browser/ui/toolbar/toolbar_pref_names.cc
index d17b690716f846d75df387ec56e63e65c928a0eb..50bcfc2a160ca0bc41c11aa8cf8526ecc2b3e336 100644
--- a/chrome/browser/ui/toolbar/toolbar_pref_names.cc
+++ b/chrome/browser/ui/toolbar/toolbar_pref_names.cc
@@ -64,6 +64,7 @@ void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(
       prefs::kPinnedCastMigrationComplete, false,
       user_prefs::PrefRegistrySyncable::SYNCABLE_PREF);
+  registry->RegisterBooleanPref(prefs::kAegisAgentAutoPinnedMigration, false);
   registry->RegisterBooleanPref(prefs::kTabsFromOtherDevicesAutoPinnedMigration,
                                 false);
   registry->RegisterBooleanPref(
diff --git a/chrome/browser/ui/toolbar/toolbar_pref_names.h b/chrome/browser/ui/toolbar/toolbar_pref_names.h
index be7a5d1275ea6aeecde96aad90d5c28617baaefa..3dd5f05296c878151e3ebb4a3d26f27bb1f5816c 100644
--- a/chrome/browser/ui/toolbar/toolbar_pref_names.h
+++ b/chrome/browser/ui/toolbar/toolbar_pref_names.h
@@ -29,6 +29,11 @@ inline constexpr char kPinnedChromeLabsMigrationComplete[] =
 inline constexpr char kPinnedCastMigrationComplete[] =
     "toolbar.pinned_cast_migration_complete";
 
+// Indicates whether the Aegis Agent entry has been auto-pinned once for
+// profiles that existed before the entry shipped by default.
+inline constexpr char kAegisAgentAutoPinnedMigration[] =
+    "toolbar.aegis_agent_auto_pinned_migration";
+
 // Indicates whether tabs from other devices side panel has been auto-pinned.
 inline constexpr char kTabsFromOtherDevicesAutoPinnedMigration[] =
     "toolbar.tabs_from_other_devices_auto_pinned_migration";
