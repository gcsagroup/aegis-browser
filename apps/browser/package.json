{
  "name": "@gcsa-aegis/browser",
  "version": "0.1.0",
  "private": true,
  "description": "GCSA-aegis Chromium fork host — product browser, not Electron and not an extension.",
  "license": "Apache-2.0",
  "scripts": {
    "bootstrap": "bash ./scripts/bootstrap-depot-tools.sh",
    "bootstrap:libtorrent": "bash ./scripts/bootstrap-libtorrent.sh",
    "fetch": "bash ./scripts/fetch-chromium.sh",
    "sync": "bash ./scripts/fetch-chromium.sh --sync-only",
    "apply-patches": "bash ./scripts/apply-patches.sh",
    "seed-patch": "bash ./scripts/seed-overlay-patch.sh",
    "build": "bash ./scripts/build.sh",
    "build:release": "bash ./scripts/build-release.sh",
    "build:android": "bash ./scripts/build-android.sh",
    "package": "bash ./scripts/package.sh",
    "package:android": "bash ./scripts/package-android.sh",
    "identity": "node ./scripts/write-build-identity.mjs",
    "test:agent-ui": "node ./scripts/agent-ui-status_test.mjs && node ./scripts/agent-model-selection_test.mjs && node ./scripts/summary-model-requests_test.mjs && node ./scripts/download-error-copy_test.mjs && node ./scripts/ui-locale-aliases_test.mjs",
    "test:android-target": "node --test ./scripts/verify-android-agent-target_test.mjs",
    "test:android-ui": "node --check ./scripts/android-agent-ui.mjs && node --test ./scripts/android-agent-ui_test.mjs",
    "test:model-relay": "pnpm run test:winrm-model-relay && pnpm run test:local-model",
    "test:scripts": "bash ./scripts/run-script-quality-checks.sh",
    "verify:cdp-runtime": "node ./scripts/verify-cdp-runtime.mjs",
    "verify:agent-runtime": "node ./scripts/verify-agent-runtime.mjs --self-test",
    "verify:download-runtime": "node ./scripts/verify-download-runtime.mjs",
    "verify:bytecode-shadow-runtime": "node ./scripts/verify-bytecode-shadow-runtime.mjs",
    "verify:bytecode-shadow-sites-runtime": "node ./scripts/verify-bytecode-shadow-sites-runtime.mjs",
    "verify:fingerprint-runtime": "node ./scripts/verify-fingerprint-runtime.mjs --require-webgpu",
    "verify:miner-runtime": "node ./scripts/verify-miner-runtime.mjs",
    "verify:multisite-runtime": "bash ./scripts/verify-multisite-runtime.sh",
    "android:gclient": "bash ./scripts/enable-android-gclient.sh",
    "android:keystore": "bash ./scripts/android-keystore.sh",
    "sign": "bash ./scripts/sign-chromium-app.sh",
    "sync-core-snapshot": "bash ./scripts/sync-core-snapshot.sh",
    "sync-easylist": "bash ./scripts/sync-easylist.sh",
    "sync-policy-worker": "bash ./scripts/sync-policy-worker.sh",
    "install-threat-index": "bash ./scripts/install-threat-index.sh",
    "run": "bash ./scripts/run.sh",
    "run:release": "bash ./scripts/run-release.sh",
    "status": "bash ./scripts/status.sh",
    "test:local-model": "node --test ./scripts/verify-agent-local-model_test.mjs",
    "test:winrm-model-relay": "node --check ./scripts/agent-winrm-model-relay.mjs && node ./scripts/agent-winrm-model-relay.mjs --self-test",
    "test:scripts:android": "bash ./scripts/package-android-guards_test.sh && bash -n ./scripts/package-android.sh"
  },
  "devDependencies": {
    "@gcsa-aegis/core": "workspace:*"
  }
}
