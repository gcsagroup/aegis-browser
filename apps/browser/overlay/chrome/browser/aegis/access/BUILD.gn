import("//build/buildflag_header.gni")
import("//chrome/browser/aegis/access/alpha_access.gni")
import("//testing/test.gni")

buildflag_header("access_buildflags") {
  header = "access_buildflags.h"
  allow_dev_files = !is_official_build
  flags = [
    "AEGIS_DEV_LOCAL_NODE_ALLOWED=$allow_dev_files",
    "AEGIS_PRIVATE_TEST_NODE_ENABLED=$aegis_private_test_node_enabled",
    "AEGIS_BETA_TEST_NODE_ENABLED=$aegis_beta_test_node_enabled",
  ]
}

if (aegis_private_test_node_enabled) {
  private_channel = "alpha"
  private_dir = aegis_alpha_test_resources_dir
  if (aegis_beta_test_node_enabled) {
    private_channel = "beta"
    private_dir = aegis_beta_test_resources_dir
  }
  # Both variants overwrite the same three resources. This also keeps the
  # normal-build guard effective for output directories reused across channels.
  action("alpha_access_resource_files") {
    script = "prepare_alpha_access_resources.py"
    inputs = [
      "$private_dir/core-manifest.json",
      "$private_dir/node.json",
      "$private_dir/xray",
    ]
    outputs = [
      "$root_out_dir/AegisAlphaAccess/core-manifest.json",
      "$root_out_dir/AegisAlphaAccess/node.json",
      "$root_out_dir/AegisAlphaAccess/xray",
    ]
    args = [
      "--channel",
      private_channel,
      "--source-dir",
      rebase_path(private_dir, root_build_dir),
      "--output-dir",
      rebase_path("$root_out_dir/AegisAlphaAccess", root_build_dir),
    ]
  }

  bundle_data("alpha_access_bundle_data") {
    sources = get_target_outputs(":alpha_access_resource_files")
    outputs =
        [ "{{bundle_resources_dir}}/AegisAlphaAccess/{{source_file_part}}" ]
    public_deps = [ ":alpha_access_resource_files" ]
  }
} else {
  action("alpha_test_resource_guard") {
    script = "verify_no_alpha_access_resources.py"
    inputs = get_target_outputs(":access_buildflags")
    outputs = [ "$target_gen_dir/alpha_test_resources_absent.stamp" ]
    deps = [ ":access_buildflags" ]
    args = [
      "--output-dir",
      rebase_path(root_out_dir, root_build_dir),
      "--stamp",
      rebase_path(outputs[0], root_build_dir),
    ]
  }
}

