# Copyright 2026 GCSA
# Intended path: chrome/browser/ui/webui/aegis/BUILD.gn

declare_args() {
  # 发行构建可预置正式的 HTTPS OCR 接口地址。
  aegis_ocr_service_url = ""
  # 打包环境决定登录目的地，测试和正式包必须显式传入 HTTPS 地址。
  aegis_link_environment = "development"
  aegis_link_portal = ""
}

if (!is_android) {
  source_set("link_background_sync") {
    sources = [
      "link_background_sync.cc",
      "link_background_sync.h",
    ]
    deps = [
      "//base",
      "//chrome/browser/profiles:profile",
      "//chrome/common/aegis",
      "//components/prefs",
      "//content/public/browser",
      "//ui/base",
    ]
  }

  source_set("link_browser_login") {
    sources = [
      "link_browser_login.cc",
      "link_browser_login.h",
    ]
    deps = [
      ":link_configuration",
      ":link_first_run_choice",
      "//base",
      "//chrome/common/aegis",
      "//content/public/browser",
      "//url",
    ]
  }

  source_set("link_first_run_choice") {
    sources = [
      "link_first_run_choice.cc",
      "link_first_run_choice.h",
    ]
    public_deps = [ "//base", "//content/public/browser" ]
  }

  # 显式生成依赖保证切换环境后重新编译账号网络客户端。
  action("link_configuration") {
    script = "link_environment.py"
    outputs = [ "$target_gen_dir/link_portal_origin.h" ]
    args = [
      "--environment=$aegis_link_environment",
      "--portal=$aegis_link_portal",
      "--output=" + rebase_path(outputs[0], root_build_dir),
    ]
  }
}

source_set("aegis") {
  defines = [ "AEGIS_OCR_SERVICE_URL=\"$aegis_ocr_service_url\"" ]
  sources = [
    "aegis_capture_handler.cc",
    "aegis_capture_handler.h",
    "aegis_ui.cc",
    "aegis_ui.h",
    "aegis_ui_handler.cc",
    "aegis_ui_handler.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/aegis",
    "//chrome/browser/aegis:agent_core",
    "//chrome/browser/download",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/aegis:resources",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/side_panel",
    "//chrome/common",
    "//chrome/common/aegis",
    "//components/prefs",
    "//chrome/services/aegis_torrent/public/mojom",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/webui",
  ]
  if (is_mac) {
    deps += [
      "//chrome/browser/aegis/access:access_build_channel",
      "//chrome/browser/aegis/access:access_options_service",
    ]
    sources += [ "aegis_capture_vision.mm" ]
    frameworks = [ "Vision.framework" ]
  }
  if (!is_android) {
    sources += [
      "link_account_handler.cc",
      "link_account_handler.h",
      "link_profile_data.cc",
      "link_profile_data.h",
    ]
    deps += [
      ":link_background_sync",
      ":link_browser_login",
      ":link_configuration",
      ":link_first_run_choice",
      "//chrome/browser/bookmarks",
      "//components/bookmarks/browser",
    ]
    sources += [
      "aegis_enhancement_handler.cc",
      "aegis_enhancement_handler.h",
      "aegis_markdown_ui.cc",
      "aegis_markdown_ui.h",
      "aegis_gesture_handler.cc",
      "aegis_gesture_handler.h",
    ]
    deps += [
      "//chrome/browser/aegis:gesture_core",
      "//chrome/browser/ui/webui/aegis_agent:impl",
      "//components/download/public/common:public",
    ]
    deps += [
      "//chrome/browser/ui/side_panel:side_panel_views_dependent",
      "//chrome/browser/ui/tabs:tab_strip",
    ]
  }

  deps += [ "//chrome/browser:browser_process" ]
}

# The native Options bridge is exclusive to the macOS product.
