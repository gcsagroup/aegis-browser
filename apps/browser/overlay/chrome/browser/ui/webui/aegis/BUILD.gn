# Copyright 2026 GCSA
# Intended path: chrome/browser/ui/webui/aegis/BUILD.gn

declare_args() {
  # 发行构建可预置正式的 HTTPS OCR 接口地址。
  aegis_ocr_service_url = ""
}

source_set("aegis") {
  defines = [ "AEGIS_OCR_SERVICE_URL=\"$aegis_ocr_service_url\"" ]
  sources = [
    "aegis_capture_handler.cc",
    "aegis_capture_handler.h",
    "aegis_ui.cc",
    "aegis_ui.h",
    "aegis_ui_handler.cc",
    "aegis_ui_handler.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/aegis",
    "//chrome/browser/aegis:agent_core",
    "//chrome/browser/download",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/resources/aegis:resources",
    "//chrome/browser/tab_list",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/side_panel",
    "//chrome/common",
    "//chrome/common/aegis",
    "//components/prefs",
    "//chrome/services/aegis_torrent/public/mojom",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/webui",
  ]
  if (is_mac) {
    deps += [
      "//chrome/browser/aegis/access:access_build_channel",
      "//chrome/browser/aegis/access:access_options_service",
    ]
    sources += [ "aegis_capture_vision.mm" ]
    frameworks = [ "Vision.framework" ]
  }
  if (!is_android) {
    sources += [
      "aegis_enhancement_handler.cc",
      "aegis_enhancement_handler.h",
      "aegis_markdown_ui.cc",
      "aegis_markdown_ui.h",
      "aegis_gesture_handler.cc",
      "aegis_gesture_handler.h",
    ]
    deps += [
      "//chrome/browser/aegis:gesture_core",
      "//chrome/browser/ui/webui/aegis_agent:impl",
      "//components/download/public/common:public",
    ]
    deps += [
      "//chrome/browser/ui/side_panel:side_panel_views_dependent",
      "//chrome/browser/ui/tabs:tab_strip",
    ]
  }

  deps += [ "//chrome/browser:browser_process" ]
}

# The native Options bridge is exclusive to the macOS product.
