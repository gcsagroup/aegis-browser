module aegis_agent.mojom;

enum AgentMode {
  kAsk = 0,
  kAct = 1,
  kAutomate = 2,
};

enum Workflow {
  kResearch = 0,
  kBrowserSteward = 1,
  kSafeDownload = 2,
  kShopping = 3,
};

struct PlanStep {
  string step_id;
  string title;
  string tool_name;
  string risk;
};

struct PlanSummary {
  string summary;
  array<string> origins;
  array<string> data_classes;
  array<string> tools;
  int32 max_tabs;
  int32 max_tool_calls;
  int32 max_model_calls;
  int32 max_network_requests;
  string max_duration;
  string provider;
  string model;
  string destination;
  string max_risk;
  array<PlanStep> steps;
};

struct CheckoutSummary {
  string merchant;
  string product;
  int32 quantity;
  string unit_price_minor_units;
  string shipping_minor_units;
  string tax_minor_units;
  string discount_minor_units;
  string total_minor_units;
  string currency;
  string delivery_summary;
  string return_summary;
  int32 source_node_count;
  string observation_fingerprint;
};

struct PendingApproval {
  string action_id;
  string tool_name;
  string origin;
  string risk;
  string argument_summary;
  string action_fingerprint;
  array<string> data_source_origins;
  string target_url;
  string target_description;
  bool is_data_transfer;
  bool requires_user_takeover;
  CheckoutSummary? checkout;
};

struct TimelineEvent {
  string title;
  string detail;
  string timestamp;
  string status;
};

struct MonitorSummary {
  string monitor_id;
  string task_id;
  string kind;
  string origin;
  string target_hash;
  string interval;
  string next_run;
  bool paused;
  bool session_only;
  int32 failures;
  int32 last_check_status;
  int32 last_http_status;
  string change_summary;
  bool change_summary_partial;
};

struct ResearchTab {
  int32 tab_id;
  string title;
  string url;
};

struct ResearchSource {
  string url;
  string title;
  string excerpt;
  string captured_ms;
  bool available;
};

struct SavedResearch {
  string id;
  string goal;
  string summary;
  string outcome;
  string created_ms;
  array<ResearchSource> sources;
  array<string> unfinished;
};

struct DownloadEvidenceField {
  string name;
  string value;
};

struct TaskSnapshot {
  bool feature_enabled;
  bool agent_enabled;
  bool model_configured;
  string model_provider;
  string model_base_url;
  string model_name;
  int32 active_tab_id;
  string active_origin;
  string invocation_context;
  string suggested_goal;
  string task_id;
  string state;
  string mode;
  string goal;
  PlanSummary? plan;
  array<DownloadEvidenceField> download_evidence;
  string result_summary;
  string result_outcome;
  bool research_save_available;
  bool research_session_only;
  array<string> result_sources;
  array<string> result_source_titles;
  array<string> unfinished_items;
  PendingApproval? pending_approval;
  bool undo_available;
  array<TimelineEvent> timeline;
  array<MonitorSummary> monitors;
  string last_error;
};

interface Page {
  OnSnapshotChanged(TaskSnapshot snapshot);
};

interface PageHandler {
  ShowUI();

  GetSnapshot() => (TaskSnapshot snapshot);
  ListResearchTabs() => (array<ResearchTab> tabs, string error);
  CreateResearchTask(string goal, array<int32> tab_ids) => (TaskSnapshot snapshot);
  CreateTabGroupTask(string goal, array<int32> tab_ids) => (TaskSnapshot snapshot);
  ShowProtection();
  OpenResearchSource(string id, uint32 source_index) => (bool ok);
  ReviewResearchSource(string id, uint32 source_index) => (string status);
  SaveResearch(string task_id) => (string error);
  ListSavedResearch() => (array<SavedResearch> records, bool session_only, string error);
  DeleteSavedResearch(string id) => (string error);
  OpenVerifiedSource(string task_id, uint32 source_index) => (bool opened);
  ReviewDownload(string task_id) => (string status, string sha256);


  ConfigureModel(string provider,
                 string base_url,
                 string model,
                 string api_key,
                 bool clear_api_key) => (TaskSnapshot snapshot);

  ListModels(string provider, string base_url, string api_key)
      => (bool ok, string error, array<string> models);

  CreateTask(string goal,
             AgentMode mode,
             Workflow workflow,
             array<string> approved_origins,
             int32 schedule_interval_minutes) => (TaskSnapshot snapshot);

  RequestPlan(string task_id) => (TaskSnapshot snapshot);

  ConsentAndRun(string task_id) => (TaskSnapshot snapshot);

  Pause(string task_id) => (TaskSnapshot snapshot);

  Resume(string task_id) => (TaskSnapshot snapshot);

  TakeOver(string task_id) => (TaskSnapshot snapshot);

  FinishTakeOver(string task_id, bool completed) => (TaskSnapshot snapshot);

  Stop(string task_id) => (TaskSnapshot snapshot);

  Approve(string task_id, string action_id) => (TaskSnapshot snapshot);

  Undo(string task_id) => (TaskSnapshot snapshot);

  SetMonitorPaused(string task_id, string monitor_id, bool paused)
      => (TaskSnapshot snapshot);

  CheckMonitorNow(string task_id, string monitor_id) => (TaskSnapshot snapshot);

  DeleteMonitor(string task_id, string monitor_id) => (TaskSnapshot snapshot);
};

interface PageHandlerFactory {
  CreatePageHandler(
      pending_remote<Page> page, pending_receiver<PageHandler> handler);
};
