module aegis_agent.mojom;

enum AgentMode {
  kAsk = 0,
  kAct = 1,
  kAutomate = 2,
};

enum Workflow {
  kResearch = 0,
  kBrowserSteward = 1,
  kSafeDownload = 2,
  kShopping = 3,
};

enum TypeSafeSettingsError {
  kNone = 0,
  kValidation = 1,
  kStorage = 2,
  kSuperseded = 3,
};

enum ModelSelectionMode {
  kFixed = 0,
  kBalanced = 1,
  kQuality = 2,
  kCost = 3,
  kLocalOnly = 4,
};

struct GenerationProfile {
  string effort;
  int32 max_output_tokens;
};

struct ModelPoolEntry {
  string id;
  string provider;
  string base_url;
  string model;
  bool enabled;
  bool supports_tool_calls;
  bool supports_long_context;
  bool supports_strong_reasoning;
  int32 quality_score;
  int32 latency_score;
  string cost_microusd_per_million_tokens;
  int32 priority;
  array<string> supported_efforts;
  GenerationProfile default_profile;
  GenerationProfile basic_profile;
  GenerationProfile strong_profile;
  string input_price;
  string cached_input_price;
  string output_price;
};

struct PlanStep {
  string step_id;
  string title;
  string tool_name;
  string risk;
};

struct PlanSummary {
  string summary;
  array<string> origins;
  array<string> data_classes;
  array<string> tools;
  int32 max_tabs;
  int32 max_tool_calls;
  int32 max_model_calls;
  int32 max_network_requests;
  string max_duration;
  string provider;
  string model;
  string destination;
  string fallback_provider;
  string fallback_model;
  string fallback_destination;
  ModelSelectionMode model_selection_mode;
  string typesafe_outcome;
  string typesafe_model;
  string typesafe_decisions;
  int32 typesafe_input_tokens;
  int32 typesafe_output_tokens;
  string typesafe_latency_ms;
  bool fallback_used;
  string model_input_tokens;
  string model_output_tokens;
  string model_latency_ms;
  string estimated_model_cost_microusd;
  string reasoning_effort;
  int32 max_output_tokens;
  bool estimated_cost_complete;
  string routing_observations_json;
  string max_risk;
  array<PlanStep> steps;
};

struct CheckoutSummary {
  string merchant;
  string product;
  int32 quantity;
  string unit_price_minor_units;
  string shipping_minor_units;
  string tax_minor_units;
  string discount_minor_units;
  string total_minor_units;
  string currency;
  string delivery_summary;
  string return_summary;
  int32 source_node_count;
  string observation_fingerprint;
};

struct PendingApproval {
  string action_id;
  string tool_name;
  string origin;
  string risk;
  string argument_summary;
  string action_fingerprint;
  bool requires_user_takeover;
  CheckoutSummary? checkout;
};

struct TimelineEvent {
  string title;
  string detail;
  string timestamp;
  string status;
};

struct MonitorSummary {
  string monitor_id;
  string task_id;
  string kind;
  string origin;
  string target_hash;
  string interval;
  string next_run;
  bool paused;
  bool session_only;
  int32 failures;
  int32 last_check_status;
  int32 last_http_status;
  string change_summary;
  bool change_summary_partial;
};

struct TaskSnapshot {
  bool feature_enabled;
  bool agent_enabled;
  bool model_configured;
  string model_provider;
  string model_base_url;
  string model_name;
  ModelSelectionMode model_selection_mode;
  int32 model_catalog_revision;
  array<ModelPoolEntry> model_pool;
  bool typesafe_enabled;
  bool typesafe_key_configured;
  TypeSafeSettingsError typesafe_settings_error;
  int32 active_tab_id;
  string active_origin;
  string invocation_context;
  string suggested_goal;
  string task_id;
  string state;
  string routing_observations_json;
  string mode;
  string goal_route_observations_json;
  string goal;
  PlanSummary? plan;
  string result_summary;
  string result_outcome;
  array<string> result_sources;
  array<string> unfinished_items;
  PendingApproval? pending_approval;
  bool undo_available;
  array<TimelineEvent> timeline;
  array<MonitorSummary> monitors;
  string last_error;
};

interface Page {
  OnSnapshotChanged(TaskSnapshot snapshot);
};

interface PageHandler {
  ShowUI();

  GetSnapshot() => (TaskSnapshot snapshot);

  ConfigureModel(string provider,
                 string base_url,
                 string model,
                 string api_key,
                 bool clear_api_key) => (TaskSnapshot snapshot);

  ConfigureTypeSafe(bool enabled,
                    string api_key,
                    bool clear_api_key) => (TaskSnapshot snapshot);

  ConfigureModelRouting(ModelSelectionMode mode,
                        array<ModelPoolEntry> model_pool)
      => (TaskSnapshot snapshot);

  ListModels(string provider, string base_url, string api_key)
      => (bool ok, string error, array<string> models);

  CreateTask(string goal,
             AgentMode mode,
             Workflow workflow,
             array<string> approved_origins,
             int32 schedule_interval_minutes) => (TaskSnapshot snapshot);

  RequestPlan(string task_id) => (TaskSnapshot snapshot);

  ConsentAndRun(string task_id) => (TaskSnapshot snapshot);

  Pause(string task_id) => (TaskSnapshot snapshot);

  Resume(string task_id) => (TaskSnapshot snapshot);

  TakeOver(string task_id) => (TaskSnapshot snapshot);

  FinishTakeOver(string task_id, bool completed) => (TaskSnapshot snapshot);

  Stop(string task_id) => (TaskSnapshot snapshot);

  Approve(string task_id, string action_id) => (TaskSnapshot snapshot);

  Undo(string task_id) => (TaskSnapshot snapshot);

  SetMonitorPaused(string task_id, string monitor_id, bool paused)
      => (TaskSnapshot snapshot);

  DeleteMonitor(string task_id, string monitor_id) => (TaskSnapshot snapshot);
};

interface PageHandlerFactory {
  CreatePageHandler(
      pending_remote<Page> page, pending_receiver<PageHandler> handler);
};
