import("//chrome/browser/buildflags.gni")
import("//chrome/common/features.gni")
import("//testing/test.gni")

source_set("help") {
  public = [ "version_updater.h" ]
  sources = [ "version_updater.cc" ]
  public_deps = [ "//base" ]
  deps = [
    "//chrome/app:generated_resources_grit",
    "//chrome/browser/upgrade_detector",
    "//ui/base",
  ]

  if (is_chromeos) {
    sources += [
      "help_utils_chromeos.cc",
      "version_updater_chromeos.cc",
    ]
    public += [
      "help_utils_chromeos.h",
      "version_updater_chromeos.h",
    ]
    public_deps += [ "//chromeos/ash/components/dbus/update_engine" ]
    deps += [
      "//ash/constants",
      "//chrome/app:generated_resources_grit",
      "//chrome/browser:browser_process",
      "//chrome/browser/ash/ownership",
      "//chrome/browser/enterprise",
      "//chromeos/ash/components/network",
      "//chromeos/ash/components/settings",
      "//chromeos/dbus/power",
      "//chromeos/strings:strings_grit",
      "//components/policy/core/common",
      "//content/public/browser",
      "//ui/base",
    ]
  }

  if (is_mac) {
    if (enable_updater) {
      sources += [ "version_updater_mac.mm" ]
      deps += [
        "//base:i18n",
        "//chrome/app:branded_strings",
        "//chrome/browser/updater",
        "//chrome/updater:browser_sources",
      ]
      frameworks = [ "Foundation.framework" ]
    } else {
      sources += [ "version_updater_basic.cc" ]
      deps += [
        ":aegis_github_update",
        "//chrome/browser:browser_process",
        "//chrome/common",
        "//content/public/browser",
        "//net",
        "//services/network/public/cpp",
        "//url",
      ]
    }
  }

  if (is_win) {
    if (is_chrome_branded) {
      sources += [ "version_updater_win.cc" ]
      deps += [
        "//chrome/app:generated_resources_grit",
        "//chrome/browser:browser_process",
        "//chrome/browser/first_run",
        "//chrome/browser/google",
        "//content/public/browser",
        "//ui/aura",
        "//ui/base",
        "//ui/gfx",
      ]
    } else {
      sources += [ "version_updater_basic.cc" ]
      deps += [
        ":aegis_github_update",
        "//chrome/browser:browser_process",
        "//chrome/common",
        "//content/public/browser",
        "//net",
        "//services/network/public/cpp",
        "//url",
      ]
    }
  }

  if (is_linux) {
    sources += [ "version_updater_basic.cc" ]
    deps += [
      ":aegis_github_update",
      "//chrome/browser:browser_process",
      "//chrome/common",
      "//content/public/browser",
      "//net",
      "//services/network/public/cpp",
      "//url",
    ]
  }
}

if (!is_android) {
  source_set("test_support") {
    testonly = true
    sources = [
      "test_version_updater.cc",
      "test_version_updater.h",
    ]
    deps = [ ":help" ]
  }

  if (is_chromeos) {
    source_set("unit_tests") {
      testonly = true
      sources = [ "version_updater_chromeos_unittest.cc" ]
      deps = [
        ":help",
        "//base/test:test_support",
        "//chrome/browser/ash/login/users:test_support",
        "//chrome/browser/ash/settings:test_support",
        "//chromeos/ash/components/dbus/shill",
        "//chromeos/ash/components/dbus/update_engine",
        "//chromeos/ash/components/network:test_support",
        "//components/user_manager:test_support",
        "//content/test:test_support",
        "//testing/gmock",
        "//testing/gtest",
      ]
    }
  }
}

if (!is_android && !is_chromeos) {
  source_set("aegis_github_update") {
    sources = [
      "aegis_github_update.cc",
      "aegis_github_update.h",
    ]
    public_deps = [
      "//base",
      "//url",
    ]
    deps = [
      "//components/services/quarantine",
      "//crypto",
      "//net",
      "//services/network/public/cpp",
    ]
  }
  test("aegis_github_update_unittests") {
    # 只链接 HTTP 夹具，避免更新模块测试引入整个
    # network_service。
    sources = [
      "//chrome/browser/profile_resetter/reset_report_uploader.cc",
      "//chrome/browser/profile_resetter/reset_report_uploader.h",
      "//services/network/test/test_url_loader_factory.cc",
      "//services/network/test/test_url_loader_factory.h",
      "//services/network/test/test_utils.cc",
      "//services/network/test/test_utils.h",
      "aegis_github_update_unittest.cc",
      "aegis_settings_safety_unittest.cc",
    ]
    deps = [
      ":aegis_github_update",
      "//base/test:run_all_unittests",
      "//base/test:test_support",
      "//chrome/browser/profile_resetter:profile_reset_report_proto",
      "//components/keyed_service/core",
      "//crypto",
      "//google_apis",
      "//mojo/core/embedder",
      "//mojo/public/cpp/bindings",
      "//net",
      "//services/network/public/cpp",
      "//services/network/public/mojom",
      "//testing/gtest",
    ]

    deps += [
      "//build:branding_buildflags",
      "//content/public/browser",
    ]
  }
}
