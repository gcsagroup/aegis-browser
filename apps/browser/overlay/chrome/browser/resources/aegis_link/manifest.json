{
  "manifest_version": 3,
  "name": "Aegis Link",
  "description": "Sign in to your Aegis Link portal and sync bookmarks and font sizes across desktop profiles.",
  "version": "1.0.0",
  "key": "",
  "incognito": "not_allowed",
  "options_page": "account.html",
  "permissions": ["storage", "scripting", "bookmarks", "fontSettings"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"]
}
