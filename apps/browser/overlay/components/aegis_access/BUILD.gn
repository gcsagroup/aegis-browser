import("//testing/test.gni")

action("generate_route_planner_vectors") {
  script = "generate_route_planner_vectors.py"
  inputs = [ "testdata/route_planner_vectors.json" ]
  outputs = [ "$target_gen_dir/route_planner_golden_vectors.inc" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

action("generate_policy_matcher_vectors") {
  script = "generate_policy_matcher_vectors.py"
  inputs = [ "testdata/policy_matcher_vectors.json" ]
  outputs = [ "$target_gen_dir/policy_matcher_golden_vectors.inc" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

