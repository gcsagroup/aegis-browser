config("public_config") {
  cflags_cc = [
    "-isystem" + rebase_path("//third_party/aegis_libtorrent/source/include",
                             root_build_dir),
    "-isystem$_boost_include_dir",
  ]
  defines = [
    "BOOST_ASIO_ENABLE_CANCELIO",
    "BOOST_ASIO_HAS_STD_CHRONO",
    "BOOST_ASIO_NO_DEPRECATED",
    "BOOST_EXCEPTION_DISABLE",
    "BOOST_SYSTEM_USE_UTF8",
    "_FILE_OFFSET_BITS=64",
    "TORRENT_ABI_VERSION=100",
    "TORRENT_DISABLE_LOGGING",
    "TORRENT_USE_I2P=0",
    "TORRENT_USE_RTC=0",
  ]
  frameworks = [
    "CoreFoundation.framework",
    "SystemConfiguration.framework",
  ]
}

static_library("libtorrent") {
  sources = _libtorrent_sources
  include_dirs = [
    "source/include",
    "source/deps/try_signal",
  ]
  defines = [ "TORRENT_BUILDING_LIBRARY" ]
  configs -= [
    "//build/config/compiler:chromium_code",
    "//build/config/compiler:no_exceptions",
    "//build/config/compiler:no_rtti",
  ]
  configs += [
    "//build/config/compiler:exceptions",
    "//build/config/compiler:no_chromium_code",
    "//build/config/compiler:rtti",
  ]
  public_configs = [ ":public_config" ]
}
