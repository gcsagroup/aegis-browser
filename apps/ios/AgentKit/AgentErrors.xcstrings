    "agent.error.capabilityAlreadyConsumed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionsbestätigung wurde bereits verwendet oder existiert nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action confirmation has already been used or does not exist."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The action confirmation has already been used or does not exist."
          }
        },
        "en-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "The action confirmation has already been used or does not exist."
          }
