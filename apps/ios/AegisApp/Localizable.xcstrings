      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成回执未保存，文件已保留，请重试下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The completion record was not saved. The file has been preserved. Retry the download."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成記錄未儲存，檔案已保留，請重試下載。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
