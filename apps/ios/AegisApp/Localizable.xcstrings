        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาหรือป้อน URL ในแถบที่อยู่ เมื่อต้องการจัดระเบียบข้อมูล ให้เปิดผู้ช่วย AI จากเมนูเพิ่มเติม"
