    "命中本地已知钓鱼主机规则。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命中本地已知钓鱼主机规则。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matched a local known phishing host rule."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "符合本機已知釣魚主機規則。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lokale Regel für einen bekannten Phishing-Host wurde ausgelöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide con una regla local de un servidor de phishing conocido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond à une règle locale d’hôte de hameçonnage connu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cocok dengan aturan lokal host phishing yang dikenal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde a una regola locale per un host di phishing noto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既知のフィッシングホストに対するローカルルールに一致しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알려진 피싱 호스트에 대한 로컬 규칙과 일치합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sepadan dengan peraturan setempat bagi hos pancingan data yang diketahui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Corresponde a uma regra local de um servidor de phishing conhecido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงกับกฎในเครื่องสำหรับโฮสต์ฟิชชิงที่รู้จัก"
          }
        },
        "vi": {
