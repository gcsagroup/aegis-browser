    "有下载文件缺少完成回执，原始文件已保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有下载文件缺少完成回执，原始文件已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some downloads are missing completion records. The original files have been preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分下載檔案缺少完成記錄，原始檔案已保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für einige Downloads fehlen Abschlussnachweise. Die Originaldateien wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan registros de finalización de algunas descargas. Se han conservado los archivos originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléchargements n’ont pas d’enregistrement de fin. Les fichiers originaux ont été conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa unduhan tidak memiliki catatan penyelesaian. File asli tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano i record di completamento di alcuni download. I file originali sono stati conservati."
