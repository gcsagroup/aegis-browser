        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local tool connections are not yet available on iOS. Use the in-app AI assistant for page actions and confirm when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 版暂未提供本机工具连接服务。网页操作通过应用内的 AI 助手发起，并在需要时确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 版暫未提供本機工具連線服務。網頁操作透過應用程式內的 AI 助手發起，並在需要時確認。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungen zu lokalen Werkzeugen sind unter iOS noch nicht verfügbar. Starten Sie Webseitenaktionen über den KI-Assistenten in der App und bestätigen Sie sie bei Bedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones a herramientas locales aún no están disponibles en iOS. Inicia acciones de página desde el asistente de IA de la app y confirma cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions aux outils locaux ne sont pas encore disponibles sur iOS. Lancez les actions sur les pages depuis l’assistant IA de l’app et confirmez lorsque nécessaire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi alat lokal belum tersedia di iOS. Mulai tindakan halaman melalui asisten AI dalam aplikasi dan konfirmasikan bila diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le connessioni agli strumenti locali non sono ancora disponibili su iOS. Avvia le azioni sulle pagine dall’assistente IA nell’app e conferma quando richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 版ではローカルツールへの接続サービスはまだ提供していません。ウェブ操作はアプリ内の AI アシスタントから開始し、必要に応じて確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서는 로컬 도구 연결 서비스를 아직 제공하지 않습니다. 웹페이지 작업은 앱 내 AI 도우미에서 시작하고 필요한 경우 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan alat setempat belum tersedia pada iOS. Mulakan tindakan halaman melalui pembantu AI dalam aplikasi dan sahkan apabila diperlukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ligações a ferramentas locais ainda não estão disponíveis no iOS. Inicie ações nas páginas através do assistente de IA da app e confirme quando necessário."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ยังไม่มีบริการเชื่อมต่อเครื่องมือในเครื่อง ให้เริ่มการดำเนินการหน้าเว็บผ่านผู้ช่วย AI ในแอป และยืนยันเมื่อจำเป็น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS chưa cung cấp dịch vụ kết nối công cụ cục bộ. Bắt đầu thao tác trang web qua trợ lý AI trong ứng dụng và xác nhận khi cần."
          }
        }
      }
    },
