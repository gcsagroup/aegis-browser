        }
      }
    },
    "将替换当前记录。当前原件会另存一份，无效备份不会覆盖现有资料。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces current records after saving a copy. Invalid backups cannot overwrite existing data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将替换当前记录。当前原件会另存一份，无效备份不会覆盖现有资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將取代目前記錄。目前原件會另存一份，無效備份不會覆寫現有資料。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Einträge werden nach dem Speichern einer Kopie ersetzt. Ungültige Sicherungen überschreiben keine vorhandenen Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sustituirán los registros actuales después de guardar una copia. Las copias de seguridad no válidas no sobrescribirán los datos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements actuels seront remplacés après en avoir sauvegardé une copie. Les sauvegardes invalides ne remplaceront pas les données existantes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan saat ini akan diganti setelah salinannya disimpan. Cadangan tidak valid tidak akan menimpa data yang ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record attuali verranno sostituiti dopo averne salvato una copia. I backup non validi non sovrascriveranno i dati esistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の記録のコピーを保存してから置き換えます。無効なバックアップで既存の資料が上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기록의 사본을 저장한 후 교체합니다. 유효하지 않은 백업은 기존 자료를 덮어쓰지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod semasa akan digantikan selepas salinan disimpan. Sandaran tidak sah tidak akan menulis ganti data sedia ada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registos atuais serão substituídos após guardar uma cópia. As cópias de segurança inválidas não substituirão os dados existentes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะบันทึกสำเนาประวัติปัจจุบันก่อนแทนที่ ข้อมูลสำรองที่ไม่ถูกต้องจะไม่เขียนทับข้อมูลเดิม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi hiện tại sẽ được thay thế sau khi lưu một bản sao. Bản sao lưu không hợp lệ sẽ không ghi đè dữ liệu hiện có."
          }
        }
      }
    },
    "将正文完整翻译为简体中文；如果篇幅过长，请明确标注未完成的范围。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translate the full text into English. If it is too long, clearly state what remains untranslated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将正文完整翻译为简体中文；如果篇幅过长，请明确标注未完成的范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將正文完整翻譯為繁體中文；如果篇幅過長，請明確標注未完成的範圍。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze den vollständigen Text ins Deutsche. Falls er zu lang ist, gib klar an, welche Abschnitte noch nicht übersetzt wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce el texto completo al español. Si es demasiado largo, indica claramente qué partes quedan sin traducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduis l’intégralité du texte en français. S’il est trop long, indique clairement les parties qui restent à traduire."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahkan seluruh teks ke bahasa Indonesia. Jika terlalu panjang, nyatakan dengan jelas bagian yang belum diterjemahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci l’intero testo in italiano. Se è troppo lungo, indica chiaramente quali parti restano da tradurre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文全体を日本語に翻訳してください。長すぎる場合は、未翻訳の範囲を明確に示してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 전체를 한국어로 번역하세요. 너무 길면 번역하지 못한 부분을 명확히 표시하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjemahkan keseluruhan teks ke dalam bahasa Melayu. Jika terlalu panjang, nyatakan dengan jelas bahagian yang belum diterjemahkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduz o texto completo para português. Se for demasiado longo, indica claramente as partes que ficaram por traduzir."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แปลเนื้อหาทั้งหมดเป็นภาษาไทย หากยาวเกินไป ให้ระบุส่วนที่ยังแปลไม่เสร็จอย่างชัดเจน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch toàn bộ nội dung sang tiếng Việt. Nếu quá dài, hãy nêu rõ phần chưa được dịch."
          }
        }
      }
    },
