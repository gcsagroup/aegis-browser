        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini ialah pengesahan tindakan berasingan. Meninggalkan atau membatalkannya membuang kelulusan sekali guna tanpa mengubah penanda buku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página confirma a ação separadamente. Sair ou cancelar descarta a aprovação de utilização única e mantém os marcadores inalterados."
          }
