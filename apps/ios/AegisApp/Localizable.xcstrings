    "工作区文件无效或超出容量：最多 100 个工作区，每组 50 个页面。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区文件无效或超出容量：最多 100 个工作区，每组 50 个页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區文件無效或超出容量：最多 100 個工作區，每組 50 個頁面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid workspace file or capacity exceeded: up to 100 workspaces with 50 pages each."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige Arbeitsbereichsdatei oder Kapazität überschritten: höchstens 100 Arbeitsbereiche mit jeweils 50 Seiten."
          }
        },
        "es": {
          "stringUnit": {
