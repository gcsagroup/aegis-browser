    "无法安全保存密钥，请解锁设备后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key could not be stored securely. Unlock the device and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存密钥，请解锁设备后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全保存密鑰，請解鎖設備後重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel konnte nicht sicher gespeichert werden. Entsperren Sie das Gerät und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la clave de forma segura. Desbloquea el dispositivo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la clé de manière sécurisée. Déverrouillez l’appareil et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak dapat disimpan dengan aman. Buka kunci perangkat dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare la chiave in modo sicuro. Sblocca il dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーを安全に保存できませんでした。デバイスのロックを解除して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키를 안전하게 저장할 수 없습니다. 기기 잠금을 해제한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tidak dapat disimpan dengan selamat. Buka kunci peranti dan cuba lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar a chave em segurança. Desbloqueie o dispositivo e tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถบันทึกคีย์อย่างปลอดภัยได้ โปรดปลดล็อกอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu khóa an toàn. Hãy mở khóa thiết bị rồi thử lại."
          }
        }
      }
    },
