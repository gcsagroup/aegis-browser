    "比较所选来源的观点、证据和分歧，逐项引用，说明资料不足之处。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the sources, their evidence, and disagreements. Cite each point and note missing information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较所选来源的观点、证据和分歧，逐项引用，说明资料不足之处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較所選來源的觀點、證據和分歧，逐項引用，說明資料不足之處。"
          }
        }
      }
    },
    "比较所选页面的商品、价格和规格，列出来源；说明未知的运费、库存和时效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare products, prices, and specifications in the selected pages. Cite sources and identify unknown shipping, stock, or timing details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较所选页面的商品、价格和规格，列出来源；说明未知的运费、库存和时效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較所選頁面的商品、價格和規格，列出來源；說明未知的運費、庫存和時效。"
          }
        }
      }
    },
