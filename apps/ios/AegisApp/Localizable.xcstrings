            "state": "translated",
            "value": "검토를 위해 현재 페이지 구조 읽기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca struktur halaman semasa untuk semakan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler a estrutura da página atual para revisão"
          }
        },
        "th": {
