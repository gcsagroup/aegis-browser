    "操作计划超出允许范围，请调整所选标签、网址或步骤。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan is outside the allowed scope. Adjust the selected tabs, URLs or steps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作计划超出允许范围，请调整所选标签、网址或步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作計劃超出允許範圍，請調整所選標籤、網址或步驟。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aktionsplan überschreitet den erlaubten Umfang. Passen Sie die ausgewählten Tabs, URLs oder Schritte an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan supera el ámbito permitido. Ajusta las pestañas, URL o pasos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan dépasse le périmètre autorisé. Modifiez les onglets, URL ou étapes sélectionnés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rencana tindakan di luar cakupan yang diizinkan. Sesuaikan tab, URL, atau langkah yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano supera l’ambito consentito. Modifica le schede, gli URL o i passaggi selezionati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作計画が許可範囲を超えています。選択したタブ、URL、手順を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 계획이 허용 범위를 벗어났습니다. 선택한 탭, URL 또는 단계를 조정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelan tindakan di luar skop yang dibenarkan. Laraskan tab, URL atau langkah yang dipilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano excede o âmbito permitido. Ajuste os separadores, URL ou passos selecionados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนการดำเนินการเกินขอบเขตที่อนุญาต โปรดปรับแท็บ URL หรือขั้นตอนที่เลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kế hoạch thao tác vượt phạm vi cho phép. Hãy điều chỉnh thẻ, URL hoặc các bước đã chọn."
          }
        }
      }
    },
    "操作预览已过期，请重新生成。": {
