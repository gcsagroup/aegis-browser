        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục bản ghi sau khi xác minh giá trị kiểm tra của tệp."
          }
        }
      }
    },
    "已支持广告与跟踪过滤、链接清理及本地风险网址检查。当前页面的导航拦截和清理结果显示在页面提示中。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad and tracker filtering, link cleanup and local URL risk checks are supported. Navigation notices show blocking and cleanup results for the current page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持广告与跟踪过滤、链接清理及本地风险网址检查。当前页面的导航拦截和清理结果显示在页面提示中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持廣告與跟蹤過濾、鏈接清理及本地風險網址檢查。當前頁面的導航攔截和清理結果顯示在頁面提示中。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werbe- und Trackerfilterung, Linkbereinigung und lokale URL-Risikoprüfungen werden unterstützt. Navigationshinweise zeigen die Blockierungs- und Bereinigungsergebnisse für die aktuelle Seite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admite el filtrado de anuncios y rastreadores, la limpieza de enlaces y las comprobaciones locales de riesgo de URL. Los avisos de navegación muestran los resultados de bloqueo y limpieza de la página actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage des publicités et des traqueurs, le nettoyage des liens et les vérifications locales des risques d’URL sont pris en charge. Les avis de navigation indiquent les résultats de blocage et de nettoyage de la page actuelle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemfilteran iklan dan pelacak, pembersihan tautan, serta pemeriksaan risiko URL lokal didukung. Pemberitahuan navigasi menampilkan hasil pemblokiran dan pembersihan untuk halaman saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono supportati il filtraggio di annunci e tracker, la pulizia dei link e i controlli locali dei rischi degli URL. Gli avvisi di navigazione mostrano i risultati del blocco e della pulizia per la pagina attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広告・トラッカーのフィルタリング、リンクのクリーンアップ、ローカルでの URL リスク検査に対応しています。現在のページのナビゲーションブロックとクリーンアップの結果は、ページの通知に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광고 및 추적기 필터링, 링크 정리, 로컬 URL 위험 검사를 지원합니다. 현재 페이지의 탐색 차단 및 정리 결과는 페이지 알림에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penapisan iklan dan penjejak, pembersihan pautan serta semakan risiko URL setempat disokong. Notis navigasi menunjukkan hasil sekatan dan pembersihan untuk halaman semasa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "São suportados a filtragem de anúncios e rastreadores, a limpeza de ligações e as verificações locais de risco dos URL. Os avisos de navegação mostram os resultados de bloqueio e limpeza da página atual."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับการกรองโฆษณาและตัวติดตาม การล้างลิงก์ และการตรวจสอบความเสี่ยง URL ในเครื่อง ผลการบล็อกการนำทางและการล้างของหน้าปัจจุบันจะแสดงในข้อความแจ้งเตือนของหน้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ lọc quảng cáo và trình theo dõi, làm sạch liên kết và kiểm tra rủi ro URL cục bộ. Thông báo điều hướng hiển thị kết quả chặn và làm sạch cho trang hiện tại."
          }
        }
      }
    },
    "已支持独立安全资源规则、网址与页面结构检查、系统加固和可选指纹限制。页面结构观察限加载后的前一分钟。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持独立安全资源规则、网址与页面结构检查、系统加固和可选指纹限制。页面结构观察限加载后的前一分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available: independent security resource rules, URL and page structure checks, system hardening and optional fingerprint limits. Structure monitoring lasts up to one minute after loading begins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已支援獨立安全資源規則、網址與頁面結構檢查、系統強化及可選指紋限制。頁面結構觀察限載入後的前一分鐘。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar sind unabhängige Sicherheitsregeln für Ressourcen, URL- und Seitenstrukturprüfungen, Systemhärtung und optionale Fingerabdruckbeschränkungen. Die Strukturüberwachung ist auf die erste Minute ab Ladebeginn begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se admiten reglas independientes de recursos de seguridad, comprobaciones de URL y estructura de página, refuerzo del sistema y límites opcionales de huellas digitales. La observación de la estructura se limita al primer minuto desde el inicio de la carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sont disponibles : règles de sécurité indépendantes pour les ressources, vérifications des URL et de la structure des pages, durcissement du système et restrictions facultatives d’empreinte numérique. L’observation de la structure est limitée à la première minute après le début du chargement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersedia aturan sumber daya keamanan independen, pemeriksaan URL dan struktur halaman, penguatan sistem, serta pembatasan sidik jari opsional. Pemantauan struktur dibatasi hingga satu menit sejak pemuatan dimulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono disponibili regole di sicurezza indipendenti per le risorse, controlli degli URL e della struttura delle pagine, rafforzamento del sistema e limiti facoltativi sull’impronta digitale. Il monitoraggio della struttura è limitato al primo minuto dall’inizio del caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立したセキュリティリソースルール、URL とページ構造の検査、システムの堅牢化、任意のフィンガープリント制限に対応しています。ページ構造の監視は読み込み開始後の最初の 1 分間に限られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립적인 보안 리소스 규칙, URL 및 페이지 구조 검사, 시스템 보안 강화, 선택적 핑거프린트 제한을 지원합니다. 페이지 구조 관찰은 로딩 시작 후 첫 1분으로 제한됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tersedia peraturan sumber keselamatan berasingan, semakan URL dan struktur halaman, pengukuhan sistem serta had cap jari pilihan. Pemantauan struktur dihadkan kepada minit pertama selepas pemuatan bermula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estão disponíveis regras independentes de recursos de segurança, verificações de URL e da estrutura das páginas, reforço do sistema e limites opcionais de impressão digital. A observação da estrutura limita-se ao primeiro minuto após o início do carregamento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รองรับกฎทรัพยากรความปลอดภัยแบบแยกอิสระ การตรวจสอบ URL และโครงสร้างหน้า การเสริมความปลอดภัยระบบ และข้อจำกัดลายนิ้วมือที่เลือกเปิดได้ การสังเกตโครงสร้างหน้าจำกัดอยู่ในนาทีแรกหลังเริ่มโหลด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có quy tắc tài nguyên bảo mật độc lập, kiểm tra URL và cấu trúc trang, tăng cường bảo mật hệ thống cùng giới hạn dấu vân tay tùy chọn. Theo dõi cấu trúc chỉ diễn ra trong phút đầu tiên kể từ khi bắt đầu tải."
          }
        }
      }
    },
