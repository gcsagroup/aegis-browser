          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do modelo limitou os pedidos. Tente novamente dentro de %lld segundos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโมเดลจำกัดอัตราคำขอ โปรดลองอีกครั้งใน %lld วินาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ mô hình giới hạn tần suất yêu cầu. Hãy thử lại sau %lld giây."
          }
        }
      }
