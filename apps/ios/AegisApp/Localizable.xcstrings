        }
      }
    },
    "保存修改会撤销旧授权。试运行只使用临时存储；启用前再次确认网址和权限。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving changes revokes previous permissions. Trial runs use temporary storage; review sites and permissions before enabling."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存修改会撤销旧授权。试运行只使用临时存储；启用前再次确认网址和权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存修改會撤銷舊授權。試運行只使用臨時存儲；啓用前再次確認網址和權限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern von Änderungen widerruft bisherige Freigaben. Testläufe verwenden nur temporären Speicher. Bestätigen Sie vor der Aktivierung erneut URLs und Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar cambios revoca las autorizaciones anteriores. Las pruebas solo usan almacenamiento temporal; vuelve a confirmar las URL y los permisos antes de activar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les modifications révoque les autorisations précédentes. Les essais utilisent uniquement un stockage temporaire ; confirmez à nouveau les URL et les permissions avant l’activation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan perubahan mencabut izin sebelumnya. Uji coba hanya menggunakan penyimpanan sementara; konfirmasikan kembali URL dan izin sebelum mengaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio delle modifiche revoca le autorizzazioni precedenti. Le prove usano solo spazio temporaneo; conferma di nuovo URL e autorizzazioni prima di attivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存すると以前の許可は取り消されます。試行では一時ストレージのみを使用します。有効にする前に URL と権限を再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 저장하면 이전 승인이 취소됩니다. 시험 실행은 임시 저장소만 사용합니다. 활성화 전에 URL과 권한을 다시 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan perubahan membatalkan kebenaran terdahulu. Uji cuba hanya menggunakan storan sementara; sahkan semula URL dan kebenaran sebelum mendayakan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar alterações revoga as autorizações anteriores. Os testes usam apenas armazenamento temporário; confirme novamente os URL e as permissões antes de ativar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การบันทึกการเปลี่ยนแปลงจะเพิกถอนสิทธิ์เดิม การทดลองรันใช้พื้นที่จัดเก็บชั่วคราวเท่านั้น โปรดยืนยัน URL และสิทธิ์อีกครั้งก่อนเปิดใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thay đổi sẽ thu hồi quyền đã cấp trước đó. Chạy thử chỉ dùng bộ nhớ tạm; hãy xác nhận lại URL và quyền trước khi bật."
          }
        }
      }
    },
