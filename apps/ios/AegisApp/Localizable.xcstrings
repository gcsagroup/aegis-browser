    "已获准发送的崩溃报告无法撤回。": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits zum Senden freigegebene Absturzberichte können nicht zurückgerufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crash reports already authorized for sending cannot be recalled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de fallos ya autorizados para envío no pueden retirarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports de plantage déjà autorisés à l’envoi ne peuvent pas être rappelés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan kerusakan yang sudah diizinkan untuk dikirim tidak dapat ditarik kembali."
