          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca sumber yang diluluskan dan berikan rujukan yang boleh disahkan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ler fontes autorizadas e fornecer referências verificáveis"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านแหล่งข้อมูลที่อนุญาตและสร้างการอ้างอิงที่ตรวจสอบได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc nguồn được cho phép và tạo trích dẫn có thể kiểm chứng"
          }
        }
      }
    },
    "读取只保留在当前界面，点击保存后才进入本机加密资料库。PDF 从“文件”选择，只提取指定页的文字层。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read text remains in this view until you save it to the local encrypted library. Select a PDF from Files to extract the chosen page's text layer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取只保留在当前界面，点击保存后才进入本机加密资料库。PDF 从“文件”选择，只提取指定页的文字层。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取只保留在當前界面，點擊保存後才進入本機加密資料庫。PDF 從“文件”選擇，只提取指定頁的文字層。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesener Text bleibt nur in dieser Ansicht, bis Sie ihn in der lokalen verschlüsselten Bibliothek speichern. Wählen Sie eine PDF-Datei aus „Dateien“; nur die Textebene der angegebenen Seite wird extrahiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto leído permanece solo en esta vista hasta guardarlo en la biblioteca local cifrada. Selecciona un PDF de Archivos; solo se extrae la capa de texto de la página indicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte lu reste dans cette vue jusqu’à son enregistrement dans la bibliothèque locale chiffrée. Sélectionnez un PDF dans Fichiers ; seule la couche de texte de la page choisie est extraite."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang dibaca hanya berada di tampilan ini sampai Anda menyimpannya ke pustaka lokal terenkripsi. Pilih PDF dari File; hanya lapisan teks halaman yang ditentukan yang diekstrak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo letto resta solo in questa vista finché non lo salvi nella libreria locale crittografata. Seleziona un PDF da File: viene estratto solo il livello di testo della pagina indicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った内容は現在の画面内でのみ保持され、保存をタップするとデバイス内の暗号化ライブラリに入ります。PDF は「ファイル」から選び、指定ページのテキストレイヤーのみを抽出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽은 내용은 현재 화면에만 유지되며 저장을 눌러야 기기의 암호화된 자료실에 추가됩니다. PDF는 파일에서 선택하며 지정한 페이지의 텍스트 레이어만 추출합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang dibaca hanya kekal dalam paparan ini sehingga anda menyimpannya ke pustaka setempat yang disulitkan. Pilih PDF daripada Fail; hanya lapisan teks halaman yang ditentukan diekstrak."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto lido fica apenas nesta vista até o guardar na biblioteca local encriptada. Selecione um PDF em Ficheiros; apenas é extraída a camada de texto da página indicada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่อ่านจะอยู่เฉพาะในหน้าจอนี้ จนกว่าคุณจะแตะบันทึกเพื่อเก็บในคลังข้อมูลเข้ารหัสในเครื่อง เลือก PDF จาก “ไฟล์” โดยจะดึงเฉพาะชั้นข้อความของหน้าที่ระบุ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đã đọc chỉ nằm trong màn hình này cho đến khi bạn chạm lưu vào thư viện mã hóa cục bộ. Chọn PDF từ Tệp; chỉ trích xuất lớp văn bản của trang đã chỉ định."
          }
        }
      }
    },
