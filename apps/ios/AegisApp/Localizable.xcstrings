            "value": "Cette opération enregistre les URL privées sélectionnées dans un espace de travail ordinaire, conservé après la fermeture des onglets privés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini menyimpan URL pribadi yang dipilih sebagai ruang kerja normal, yang tetap ada setelah tab pribadi ditutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione salva gli URL privati selezionati come area di lavoro normale, che resta disponibile dopo la chiusura delle schede private."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したプライベート URL を通常のワークスペースとして保存します。プライベートタブを閉じた後も残ります。"
          }
