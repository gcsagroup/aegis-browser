        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트가 활성화되었습니다. 다음 페이지 로드 시 자동으로 실행됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrip didayakan. Skrip akan berjalan secara automatik pada pemuatan halaman seterusnya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Script ativado. Será executado automaticamente no próximo carregamento da página."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดใช้สคริปต์แล้ว จะทำงานอัตโนมัติเมื่อโหลดหน้าครั้งถัดไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bật tập lệnh. Tập lệnh sẽ tự chạy ở lần tải trang tiếp theo."
          }
        }
      }
    },
