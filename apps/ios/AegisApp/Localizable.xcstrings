    "1 描述需求 → 2 检查草稿与权限 → 3 试运行 → 4 确认启用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Describe → 2 Review source and permissions → 3 Trial run → 4 Enable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 描述需求 → 2 检查草稿与权限 → 3 试运行 → 4 确认启用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 描述需求 → 2 檢查草稿與權限 → 3 試運行 → 4 確認啓用"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Bedarf beschreiben → 2 Entwurf und Berechtigungen prüfen → 3 Testlauf → 4 Aktivierung bestätigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Describe lo que necesitas → 2 Revisa el borrador y los permisos → 3 Prueba → 4 Confirma la activación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Décrire le besoin → 2 Vérifier le brouillon et les autorisations → 3 Essai → 4 Confirmer l’activation"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Jelaskan kebutuhan → 2 Periksa draf dan izin → 3 Uji coba → 4 Konfirmasi pengaktifan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Descrivi l’esigenza → 2 Verifica bozza e autorizzazioni → 3 Prova → 4 Conferma l’attivazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 要望を説明 → 2 下書きと権限を確認 → 3 試行 → 4 有効化を確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1 요구사항 설명 → 2 초안 및 권한 확인 → 3 시험 실행 → 4 활성화 확인"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Terangkan keperluan → 2 Semak draf dan kebenaran → 3 Uji cuba → 4 Sahkan pengaktifan"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Descrever o pedido → 2 Rever rascunho e permissões → 3 Testar → 4 Confirmar ativação"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 อธิบายความต้องการ → 2 ตรวจร่างและสิทธิ์ → 3 ทดลองรัน → 4 ยืนยันการเปิดใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Mô tả nhu cầu → 2 Kiểm tra bản nháp và quyền → 3 Chạy thử → 4 Xác nhận bật"
          }
        }
      }
    },
