    "已编辑表单、媒体播放、含框架或有浏览历史的页面会保留。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages with edited forms, playing media, frames, or navigation history stay loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已编辑表单、媒体播放、含框架或有浏览历史的页面会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已編輯表單、媒體播放、含框架或有瀏覽歷史的頁面會保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten mit bearbeiteten Formularen, laufenden Medien, Frames oder Navigationsverlauf bleiben geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas con formularios editados, reproducción multimedia, marcos o historial de navegación permanecen cargadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages contenant des formulaires modifiés, des médias en lecture, des cadres ou un historique de navigation restent chargées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman dengan formulir yang diedit, media yang diputar, bingkai, atau riwayat navigasi tetap dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine con moduli modificati, contenuti multimediali in riproduzione, frame o cronologia di navigazione restano caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集済みのフォーム、再生中のメディア、フレーム、または閲覧履歴があるページは読み込んだまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정한 양식, 재생 중인 미디어, 프레임 또는 탐색 기록이 있는 페이지는 로드된 상태로 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman dengan borang yang diedit, media yang dimainkan, bingkai atau sejarah navigasi kekal dimuatkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Páginas com formulários editados, reprodução multimédia, frames ou histórico de navegação permanecem carregadas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าที่มีแบบฟอร์มที่แก้ไขแล้ว สื่อที่กำลังเล่น เฟรม หรือประวัติการนำทางจะยังคงโหลดไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trang có biểu mẫu đã sửa, nội dung đa phương tiện đang phát, khung hoặc lịch sử điều hướng vẫn được giữ trong bộ nhớ."
          }
        }
      }
    },
    "已计算文件摘要，未提供可信预期值。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash computed. No trusted expected value was supplied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已计算文件摘要，未提供可信预期值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已計算文件摘要，未提供可信預期值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateihash berechnet. Es wurde kein vertrauenswürdiger Sollwert angegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash del archivo calculado. No se proporcionó un valor esperado de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte du fichier calculée. Aucune valeur attendue fiable n’a été fournie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash file telah dihitung. Tidak ada nilai yang diharapkan dan tepercaya yang diberikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash del file calcolato. Non è stato fornito un valore atteso attendibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルのハッシュを計算しました。信頼できる期待値は指定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 해시를 계산했습니다. 신뢰할 수 있는 예상값이 제공되지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash fail telah dikira. Tiada nilai jangkaan yang dipercayai diberikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hash do ficheiro calculado. Não foi fornecido um valor esperado de confiança."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำนวณแฮชของไฟล์แล้ว แต่ไม่ได้ระบุค่าที่คาดไว้ที่เชื่อถือได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã tính hàm băm của tệp. Chưa cung cấp giá trị dự kiến đáng tin cậy."
          }
        }
      }
    },
    "已通过新的任务授权和动作确认恢复整理前的 %lld 条收藏。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored %lld bookmarks after fresh authorization and confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过新的任务授权和动作确认恢复整理前的 %lld 条收藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已通過新的任務授權和動作確認恢復整理前的 %lld 條收藏。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach erneuter Aufgabenfreigabe und Aktionsbestätigung wurden %lld Lesezeichen auf den Stand vor der Neuordnung zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauraron %lld marcadores anteriores a la reorganización tras una nueva autorización de tarea y confirmación de acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld favoris d’avant la réorganisation ont été restaurés après une nouvelle autorisation de tâche et une confirmation de l’action."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld markah sebelum penataan dipulihkan setelah otorisasi tugas dan konfirmasi tindakan yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinati %lld preferiti precedenti alla riorganizzazione dopo una nuova autorizzazione dell’attività e conferma dell’azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクの再承認と操作の確認を経て、整理前の %lld 件のブックマークを復元しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업 승인 및 동작 확인 후 정리 전 북마크 %lld개를 복원했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld penanda buku sebelum penyusunan dipulihkan selepas kebenaran tugas dan pengesahan tindakan yang baharu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram restaurados %lld marcadores anteriores à organização após nova autorização da tarefa e confirmação da ação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กู้คืนบุ๊กมาร์ก %lld รายการก่อนจัดระเบียบแล้ว หลังจากอนุญาตงานและยืนยันการดำเนินการใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã khôi phục %lld dấu trang trước khi sắp xếp sau khi cấp quyền tác vụ và xác nhận hành động lại."
          }
        }
