    "镜像失败后从下一个地址重新下载；不会合并不同镜像的文件片段。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜像失败后从下一个地址重新下载；不会合并不同镜像的文件片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡像失敗後從下一個地址重新下載；不會合併不同鏡像的文件片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a mirror fails, download again from the next URL. File fragments from different mirrors are not combined."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einem Spiegelserverfehler wird die Datei von der nächsten Adresse neu heruntergeladen. Dateifragmente verschiedener Spiegelserver werden nicht kombiniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si falla un servidor espejo, se descarga de nuevo desde la siguiente dirección. No se combinan fragmentos de archivos de distintos servidores espejo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un miroir échoue, le téléchargement recommence depuis l’URL suivante. Les fragments de fichiers provenant de miroirs différents ne sont pas combinés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika mirror gagal, file diunduh ulang dari URL berikutnya. Fragmen file dari mirror yang berbeda tidak digabungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un mirror non funziona, il download ricomincia dall’URL successivo. I frammenti di file provenienti da mirror diversi non vengono combinati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミラーで失敗した場合は、次の URL から再ダウンロードします。異なるミラーのファイル断片は結合しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미러가 실패하면 다음 주소에서 다시 다운로드합니다. 서로 다른 미러의 파일 조각은 합치지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika cermin gagal, muat turun semula daripada URL seterusnya. Fragmen fail daripada cermin yang berbeza tidak digabungkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se um espelho falhar, a transferência recomeça a partir do URL seguinte. Não são combinados fragmentos de ficheiros de espelhos diferentes."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากมิเรอร์ล้มเหลว จะดาวน์โหลดใหม่จากที่อยู่ถัดไป โดยไม่รวมส่วนของไฟล์จากมิเรอร์ที่ต่างกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu máy chủ bản sao thất bại, tải lại từ URL tiếp theo. Không ghép các phần tệp từ những máy chủ bản sao khác nhau."
          }
        }
      }
    },
