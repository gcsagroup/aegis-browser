        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan penyelesaian tidak tersimpan. File tetap disimpan. Coba unduh lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il record di completamento non è stato salvato. Il file è stato conservato. Riprova il download."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了記録を保存できませんでした。ファイルは保持されています。ダウンロードを再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료 기록이 저장되지 않았습니다. 파일은 보존되었습니다. 다운로드를 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekod penyelesaian tidak disimpan. Fail telah dikekalkan. Cuba muat turun semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O registo de conclusão não foi guardado. O ficheiro foi preservado. Tente transferir novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้บันทึกประวัติการเสร็จสิ้น โดยเก็บไฟล์ไว้แล้ว โปรดลองดาวน์โหลดอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản ghi hoàn tất chưa được lưu. Tệp đã được giữ lại. Hãy thử tải xuống lại."
          }
        }
      }
    },
