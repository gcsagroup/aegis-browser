    "仅对已授权来源的 Markdown 原文响应自动预览。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically preview Markdown responses only from approved origins."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对已授权来源的 Markdown 原文响应自动预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅對已授權來源的 Markdown 原文響應自動預覽。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
