    "模型服务返回错误（%lld），请检查连接、密钥和服务额度。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model service returned error %lld. Check the connection, key, and service quota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务返回错误（%lld），请检查连接、密钥和服务额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服務返回錯誤（%lld），請檢查連接、密鑰和服務額度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modelldienst hat den Fehler %lld zurückgegeben. Prüfen Sie Verbindung, Schlüssel und Dienstkontingent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del modelo devolvió el error %lld. Comprueba la conexión, la clave y la cuota del servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service du modèle a renvoyé l’erreur %lld. Vérifiez la connexion, la clé et le quota du service."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan model mengembalikan kesalahan %lld. Periksa koneksi, kunci, dan kuota layanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio del modello ha restituito l’errore %lld. Verifica la connessione, la chiave e la quota del servizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスがエラー（%lld）を返しました。接続、キー、サービスの利用枠を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 서비스가 오류(%lld)를 반환했습니다. 연결, 키 및 서비스 할당량을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan model mengembalikan ralat %lld. Semak sambungan, kunci dan kuota perkhidmatan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do modelo devolveu o erro %lld. Verifique a ligação, a chave e a quota do serviço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโมเดลส่งข้อผิดพลาดกลับมา (%lld) โปรดตรวจสอบการเชื่อมต่อ คีย์ และโควตาบริการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ mô hình trả về lỗi %lld. Hãy kiểm tra kết nối, khóa và hạn mức dịch vụ."
          }
        }
      }
    },
    "模型服务限流，请在 %lld 秒后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limited. Try again in %lld seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务限流，请在 %lld 秒后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服務限流，請在 %lld 秒後重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modelldienst begrenzt die Anfragerate. Versuchen Sie es in %lld Sekunden erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del modelo limita las solicitudes. Inténtalo de nuevo en %lld segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service du modèle limite le débit des requêtes. Réessayez dans %lld secondes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan model membatasi laju permintaan. Coba lagi dalam %lld detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio del modello limita la frequenza delle richieste. Riprova tra %lld secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスのリクエスト制限に達しました。%lld 秒後に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 서비스 요청 빈도가 제한되었습니다. %lld초 후에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
