    "当前系统保留默认 WebKit 保护；系统加固需 iOS 26.4 或更高版本。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前系统保留默认 WebKit 保护；系统加固需 iOS 26.4 或更高版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This system keeps default WebKit protection. Hardening requires iOS 26.4 or later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前系統保留預設 WebKit 保護；系統強化需要 iOS 26.4 或更新版本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses System behält den standardmäßigen WebKit-Schutz bei. Systemhärtung erfordert iOS 26.4 oder neuer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sistema mantiene la protección predeterminada de WebKit. El refuerzo del sistema requiere iOS 26.4 o posterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce système conserve la protection WebKit par défaut. Le durcissement du système nécessite iOS 26.4 ou ultérieur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ini mempertahankan perlindungan WebKit bawaan. Penguatan sistem memerlukan iOS 26.4 atau lebih baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sistema mantiene la protezione WebKit predefinita. Il rafforzamento del sistema richiede iOS 26.4 o versioni successive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のシステムでは標準の WebKit 保護を維持します。システムの堅牢化には iOS 26.4 以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시스템은 기본 WebKit 보호를 유지합니다. 시스템 보안 강화에는 iOS 26.4 이상이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem ini mengekalkan perlindungan WebKit lalai. Pengukuhan sistem memerlukan iOS 26.4 atau lebih baharu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este sistema mantém a proteção predefinida do WebKit. O reforço do sistema requer iOS 26.4 ou posterior."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระบบปัจจุบันยังคงใช้การป้องกัน WebKit ตามค่าเริ่มต้น การเสริมความปลอดภัยระบบต้องใช้ iOS 26.4 ขึ้นไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống hiện tại giữ cơ chế bảo vệ WebKit mặc định. Tăng cường bảo mật hệ thống yêu cầu iOS 26.4 trở lên."
          }
        }
      }
    },
