    "网络连接中断。连接恢复后可继续下载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost. Resume the download when connected again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接中断。连接恢复后可继续下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線中斷。連線恢復後可繼續下載。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkverbindung unterbrochen. Sie können den Download fortsetzen, sobald die Verbindung wiederhergestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió la conexión de red. Puedes reanudar la descarga cuando se restablezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion réseau a été interrompue. Reprenez le téléchargement une fois la connexion rétablie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi jaringan terputus. Lanjutkan unduhan setelah koneksi pulih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione di rete è stata interrotta. Puoi riprendere il download quando sarà ripristinata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続が切断されました。接続が回復したらダウンロードを再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결이 끊겼습니다. 연결이 복원되면 다운로드를 계속할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan rangkaian terputus. Sambung muat turun selepas sambungan dipulihkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação de rede foi interrompida. Pode retomar a transferência quando a ligação for restabelecida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อเครือข่ายขาดหาย สามารถดาวน์โหลดต่อได้เมื่อเชื่อมต่ออีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối mạng bị gián đoạn. Có thể tiếp tục tải xuống khi kết nối được khôi phục."
          }
        }
      }
    },
    "网络连接已中断，请恢复连接后重新确认发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection lost. Reconnect and confirm sending again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接已中断，请恢复连接后重新确认发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線已中斷，請恢復連線後重新確認傳送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerkverbindung unterbrochen. Stellen Sie die Verbindung wieder her und bestätigen Sie das Senden erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se interrumpió la conexión de red. Reconecta y confirma de nuevo el envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion réseau a été interrompue. Reconnectez-vous et confirmez à nouveau l’envoi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi jaringan terputus. Sambungkan kembali dan konfirmasikan pengiriman lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione di rete è stata interrotta. Riconnettiti e conferma di nuovo l’invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続が切断されました。接続を回復してから、送信を再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결이 끊겼습니다. 다시 연결한 후 전송을 다시 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan rangkaian terputus. Sambung semula dan sahkan penghantaran sekali lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação de rede foi interrompida. Volte a ligar e confirme novamente o envio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อเครือข่ายขาดหาย โปรดเชื่อมต่อใหม่แล้วยืนยันการส่งอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối mạng bị gián đoạn. Hãy kết nối lại rồi xác nhận gửi một lần nữa."
          }
        }
      }
    },
