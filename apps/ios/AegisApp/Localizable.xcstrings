          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memulakan perlindungan penjejakan. Cuba lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao iniciar a proteção contra rastreio. Tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เริ่มต้นการป้องกันการติดตามไม่สำเร็จ โปรดลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể khởi tạo bảo vệ chống theo dõi. Vui lòng thử lại."
          }
        }
      }
