        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 오른쪽 버튼을 누른 채 여기에 그리기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan butang kanan tetikus dan lukis di sini"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o botão direito do rato premido e desenhe aqui"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มขวาของเมาส์ค้างแล้ววาดที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nút chuột phải và vẽ tại đây"
          }
        }
      }
    },
    "按住鼠标右键画出方向，松开执行。支持网页、设置页和内置 PDF 阅读器。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the right mouse button to draw, then release. Works on webpages, settings and the built-in PDF viewer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住鼠标右键画出方向，松开执行。支持网页、设置页和内置 PDF 阅读器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住滑鼠右鍵畫出方向，松開執行。支持網頁、設定頁和內置 PDF 閱讀器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die rechte Maustaste gedrückt, zeichnen Sie eine Richtung und lassen Sie zur Ausführung los. Unterstützt Webseiten, Einstellungsseiten und den integrierten PDF-Leser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el botón derecho, dibuja una dirección y suelta para ejecutar. Funciona en páginas web, ajustes y el lector PDF integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le bouton droit, tracez une direction et relâchez pour exécuter. Fonctionne sur les pages web, les réglages et le lecteur PDF intégré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan tombol kanan mouse, gambar arah, lalu lepaskan untuk menjalankan. Mendukung halaman web, pengaturan, dan pembaca PDF bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il tasto destro, disegna una direzione e rilascia per eseguire. Funziona su pagine web, impostazioni e lettore PDF integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスの右ボタンを押したまま方向を描き、離すと実行します。ウェブページ、設定ページ、内蔵 PDF リーダーに対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 오른쪽 버튼을 누른 채 방향을 그리고 손을 떼면 실행됩니다. 웹페이지, 설정 페이지 및 내장 PDF 리더에서 지원됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan butang kanan tetikus, lukis arah dan lepaskan untuk melaksanakan. Menyokong halaman web, tetapan dan pembaca PDF terbina dalam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o botão direito do rato premido, desenhe uma direção e solte para executar. Funciona em páginas web, definições e no leitor PDF integrado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กดปุ่มขวาของเมาส์ค้าง วาดทิศทาง แล้วปล่อยเพื่อดำเนินการ ใช้ได้กับหน้าเว็บ หน้าการตั้งค่า และตัวอ่าน PDF ที่มีมาให้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ nút chuột phải, vẽ hướng rồi thả để thực hiện. Hỗ trợ trang web, trang cài đặt và trình đọc PDF tích hợp."
          }
        }
      }
    },
