    "模型引用了未提供的来源，请重新运行并核对资料。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型引用了未提供的来源，请重新运行并核对资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型引用了未提供的來源，請重新執行並核對資料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model cited a source that was not provided. Run again and check the sources."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat eine nicht bereitgestellte Quelle zitiert. Führen Sie die Aufgabe erneut aus und prüfen Sie die Quellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo citó una fuente que no se proporcionó. Vuelve a ejecutarlo y comprueba las fuentes."
          }
        },
        "fr": {
          "stringUnit": {
