          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica la pagina dopo il salvataggio per applicare la modalità del sito e le regole di JavaScript e autorizzazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後にページを再読み込みすると、サイトモード、スクリプト、権限のルールが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 후 페이지를 새로 고침하면 사이트 모드, 스크립트 및 권한 규칙이 적용됩니다."
          }
        },
        "ms": {
