    "已回退为草稿，请检查后重新启用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverted to a draft. Review before enabling again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已回退为草稿，请检查后重新启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已回退為草稿，請檢查後重新啓用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als Entwurf wiederhergestellt. Vor dem erneuten Aktivieren prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se volvió a un borrador. Revísalo antes de activarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétabli comme brouillon. Vérifiez-le avant de le réactiver."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikembalikan menjadi draf. Periksa sebelum mengaktifkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinato come bozza. Controlla prima di riattivare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きに戻しました。確認してから再度有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안으로 되돌렸습니다. 확인한 후 다시 활성화하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikembalikan sebagai draf. Semak sebelum mendayakan semula."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revertido para rascunho. Reveja antes de voltar a ativar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อนกลับเป็นร่างแล้ว โปรดตรวจสอบก่อนเปิดใช้อีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã quay về bản nháp. Hãy kiểm tra trước khi bật lại."
