    "安全规则快照已过期，继续使用现有规则，请更新 App。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全规则快照已过期，继续使用现有规则，请更新 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security snapshot has expired. Existing rules remain active; please update the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全規則快照已過期，繼續使用現有規則，請更新 App。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsregelsatz ist abgelaufen. Die vorhandenen Regeln bleiben aktiv. Bitte aktualisieren Sie die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea de reglas de seguridad ha caducado. Las reglas existentes siguen activas; actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’instantané des règles de sécurité a expiré. Les règles existantes restent actives. Veuillez mettre l’app à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot aturan keamanan telah kedaluwarsa. Aturan yang ada tetap aktif. Perbarui aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’istantanea delle regole di sicurezza è scaduta. Le regole esistenti restano attive. Aggiorna l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティルールのスナップショットが期限切れです。既存のルールを引き続き使用します。アプリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 규칙 스냅샷이 만료되었습니다. 기존 규칙은 계속 사용됩니다. 앱을 업데이트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Petikan peraturan keselamatan telah tamat tempoh. Peraturan sedia ada kekal aktif. Sila kemas kini aplikasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O instantâneo das regras de segurança expirou. As regras existentes continuam ativas. Atualize a app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแนปช็อตกฎความปลอดภัยหมดอายุแล้ว กฎเดิมยังคงทำงานอยู่ โปรดอัปเดตแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh chụp quy tắc bảo mật đã hết hạn. Các quy tắc hiện có vẫn được sử dụng. Hãy cập nhật ứng dụng."
          }
        }
      }
    },
    "安全规则校验失败，网页保护无法准备完成，请更新 App。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全规则校验失败，网页保护无法准备完成，请更新 App。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security rule verification failed. Web protection cannot be prepared; please update the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全規則驗證失敗，網頁保護無法準備完成，請更新 App。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überprüfung der Sicherheitsregeln ist fehlgeschlagen. Der Webschutz kann nicht vorbereitet werden. Bitte aktualisieren Sie die App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de las reglas de seguridad falló. No se puede preparar la protección web; actualiza la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des règles de sécurité a échoué. La protection web ne peut pas être préparée. Veuillez mettre l’app à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi aturan keamanan gagal. Perlindungan web tidak dapat disiapkan. Perbarui aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica delle regole di sicurezza non è riuscita. Non è possibile preparare la protezione web. Aggiorna l’app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティルールの検証に失敗しました。ウェブ保護の準備を完了できません。アプリを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 규칙 검증에 실패했습니다. 웹 보호 준비를 완료할 수 없습니다. 앱을 업데이트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengesahan peraturan keselamatan gagal. Perlindungan web tidak dapat disediakan. Sila kemas kini aplikasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação das regras de segurança falhou. Não é possível preparar a proteção web. Atualize a app."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบกฎความปลอดภัยไม่สำเร็จ จึงไม่สามารถเตรียมการป้องกันเว็บให้พร้อมได้ โปรดอัปเดตแอป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác minh quy tắc bảo mật thất bại. Không thể hoàn tất chuẩn bị bảo vệ web. Hãy cập nhật ứng dụng."
