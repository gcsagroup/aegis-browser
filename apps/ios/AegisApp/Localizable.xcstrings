    "观察到多种指纹读取接口；正常绘图与音频也可能使用这些接口。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察到多种指纹读取接口；正常绘图与音频也可能使用这些接口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several fingerprint-reading APIs were observed. Normal drawing and audio can also use these APIs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察到多種指紋讀取介面；正常繪圖與音訊也可能使用這些介面。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Schnittstellen zum Auslesen von Fingerabdrücken wurden beobachtet. Auch normale Grafik- und Audiofunktionen können diese nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se observaron varias interfaces de lectura de huellas digitales. Las funciones normales de gráficos y audio también pueden usarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs interfaces de lecture d’empreinte numérique ont été observées. Les fonctions normales de dessin et d’audio peuvent aussi les utiliser."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa antarmuka pembacaan sidik jari teramati. Fungsi grafis dan audio normal juga dapat menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state rilevate diverse interfacce di lettura delle impronte digitali. Anche le normali funzioni grafiche e audio possono usarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のフィンガープリント読み取りAPIが検出されました。通常の描画や音声処理でもこれらのAPIを使う場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 지문 읽기 인터페이스가 관찰되었습니다. 일반적인 그래픽 및 오디오 기능도 이 인터페이스를 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa antara muka bacaan cap jari diperhatikan. Fungsi grafik dan audio biasa juga boleh menggunakannya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foram observadas várias interfaces de leitura de impressão digital. Funções normais de gráficos e áudio também podem usá-las."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบการใช้หลายอินเทอร์เฟซสำหรับอ่านลายนิ้วมือดิจิทัล การวาดภาพและเสียงตามปกติก็อาจใช้อินเทอร์เฟซเหล่านี้เช่นกัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã quan sát thấy nhiều giao diện đọc dấu vân tay. Đồ họa và âm thanh thông thường cũng có thể dùng các giao diện này."
          }
        }
      }
    },
    "规则更新失败，已保留原有规则。请稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则更新失败，已保留原有规则。请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則更新失敗，已保留原有規則。請稍後重試。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rule update failed. Existing rules were kept. Try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Regelaktualisierung fehlgeschlagen. Die vorhandenen Regeln wurden beibehalten. Versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización de reglas falló. Se conservaron las reglas existentes. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour des règles a échoué. Les règles existantes ont été conservées. Réessayez plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan aturan gagal. Aturan yang ada tetap disimpan. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento delle regole non è riuscito. Le regole esistenti sono state conservate. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールの更新に失敗しました。既存のルールは保持されています。しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "규칙 업데이트에 실패했습니다. 기존 규칙은 유지되었습니다. 나중에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini peraturan gagal. Peraturan sedia ada dikekalkan. Cuba lagi kemudian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização das regras falhou. As regras existentes foram mantidas. Tente novamente mais tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตกฎไม่สำเร็จ โดยเก็บกฎเดิมไว้แล้ว โปรดลองอีกครั้งในภายหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật quy tắc thất bại. Các quy tắc hiện có đã được giữ lại. Hãy thử lại sau."
          }
        }
      }
    },
