    "可用空间不足，下载已停止。请释放空间后继续。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download stopped because storage is low. Free up space to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，下载已停止。请释放空间后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間不足，下載已停止。請釋放空間後繼續。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wurde wegen zu wenig Speicherplatz gestoppt. Geben Sie Speicherplatz frei, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga se detuvo por falta de espacio. Libera espacio para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement a été arrêté faute d’espace de stockage. Libérez de l’espace pour continuer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan dihentikan karena ruang penyimpanan tidak cukup. Kosongkan ruang untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download è stato interrotto per spazio insufficiente. Libera spazio per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が不足しているため、ダウンロードを停止しました。容量を確保してから再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 저장 공간이 부족하여 다운로드가 중지되었습니다. 공간을 확보한 후 계속하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat turun dihentikan kerana ruang storan tidak mencukupi. Kosongkan ruang untuk meneruskan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência parou por falta de espaço. Liberte espaço para continuar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดาวน์โหลดหยุดลงเนื่องจากพื้นที่ไม่เพียงพอ โปรดเพิ่มพื้นที่ว่างแล้วดำเนินการต่อ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dừng tải xuống vì thiếu dung lượng. Hãy giải phóng dung lượng rồi tiếp tục."
          }
        }
      }
    },
