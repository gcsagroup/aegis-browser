    "步骤已生成，尚未执行。请检查并确认。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps have been generated and are awaiting execution. Review and confirm them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
