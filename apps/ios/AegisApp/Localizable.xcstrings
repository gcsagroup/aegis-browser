          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel für kompatible APIs: https://ihr-dienst/v1. Schlüssel werden im Schlüsselbund gespeichert und nur für diesen Dienst verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo de API compatible: https://tu-servicio/v1. Las claves se guardan en el llavero y solo se usan para este servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple d’API compatible : https://votre-service/v1. Les clés sont enregistrées dans le trousseau et utilisées uniquement pour ce service."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh API yang kompatibel: https://layanan-anda/v1. Kunci disimpan di Rantai Kunci dan hanya digunakan untuk layanan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio di API compatibile: https://tuo-servizio/v1. Le chiavi sono salvate nel Portachiavi e usate solo per questo servizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換 API の例：https://サービスアドレス/v1。キーはシステムのキーチェーンに保存され、このサービスにのみ使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환 API 예: https://서비스주소/v1. 키는 시스템 키체인에 저장되며 현재 서비스에만 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh API serasi: https://perkhidmatan-anda/v1. Kunci disimpan dalam Rantai Kunci dan hanya digunakan untuk perkhidmatan ini."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemplo de API compatível: https://seu-servico/v1. As chaves são guardadas no Porta-chaves e usadas apenas para este serviço."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่าง API ที่เข้ากันได้: https://ที่อยู่บริการ/v1 คีย์จะถูกเก็บไว้ในพวงกุญแจของระบบและใช้กับบริการนี้เท่านั้น"
