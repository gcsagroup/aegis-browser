        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan dikirim dengan aman ke Aegis.\nBuka aplikasi dalam 60 detik untuk menerimanya."
          }
        },
        "it": {
          "stringUnit": {
