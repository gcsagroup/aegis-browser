    },
    "例如：隐藏右侧栏并加宽正文": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: hide the sidebar and widen the article"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：隐藏右侧栏并加宽正文"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
