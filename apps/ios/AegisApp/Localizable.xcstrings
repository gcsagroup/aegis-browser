    "PDF 专用动作仅在内置 PDF 阅读器内生效。普通动作在 PDF 中含义不变。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF actions work only in the built-in PDF viewer. Other actions keep their usual behavior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 专用动作仅在内置 PDF 阅读器内生效。普通动作在 PDF 中含义不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 專用動作僅在內置 PDF 閱讀器內生效。普通動作在 PDF 中含義不變。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF-spezifische Aktionen funktionieren nur im integrierten PDF-Leser. Normale Aktionen behalten in PDFs ihre gewohnte Bedeutung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones específicas de PDF solo funcionan en el lector PDF integrado. Las acciones normales conservan su comportamiento habitual en PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions propres aux PDF fonctionnent uniquement dans le lecteur PDF intégré. Les actions ordinaires conservent leur comportement habituel dans les PDF."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan khusus PDF hanya berfungsi di pembaca PDF bawaan. Tindakan biasa tetap memiliki perilaku yang sama dalam PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le azioni specifiche per i PDF funzionano solo nel lettore PDF integrato. Le azioni normali mantengono il loro comportamento nei PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 専用の操作は内蔵 PDF リーダーでのみ有効です。通常の操作は PDF でも意味が変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF 전용 동작은 내장 PDF 리더에서만 작동합니다. 일반 동작은 PDF에서도 기존과 동일하게 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan khusus PDF hanya berfungsi dalam pembaca PDF terbina dalam. Tindakan biasa mengekalkan tingkah laku yang sama dalam PDF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações específicas de PDF funcionam apenas no leitor PDF integrado. As ações normais mantêm o comportamento habitual nos PDF."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การดำเนินการเฉพาะ PDF ใช้ได้ในตัวอ่าน PDF ที่มีมาให้เท่านั้น การดำเนินการปกติยังมีความหมายเดิมใน PDF"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác riêng cho PDF chỉ hoạt động trong trình đọc PDF tích hợp. Các thao tác thông thường giữ nguyên hành vi trong PDF."
          }
        }
      }
    },
