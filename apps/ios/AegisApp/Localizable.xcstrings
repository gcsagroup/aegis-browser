    "资料中发现密钥或登录信息，已停止发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key or login credential was found. Nothing was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料中发现密钥或登录信息，已停止发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料中發現密鑰或登錄信息，已停止發送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Material wurden ein Schlüssel oder Anmeldedaten gefunden. Das Senden wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró una clave o información de acceso en el contenido. Se detuvo el envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé ou des identifiants de connexion ont été détectés dans le contenu. L’envoi a été bloqué."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci atau kredensial login ditemukan dalam bahan. Pengiriman dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel contenuto è stata trovata una chiave o una credenziale di accesso. L’invio è stato bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資料内にキーまたはログイン情報が見つかったため、送信を停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료에서 키 또는 로그인 정보를 발견하여 전송을 중지했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci atau maklumat log masuk ditemui dalam bahan. Penghantaran dihentikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi encontrada uma chave ou informação de início de sessão no conteúdo. O envio foi interrompido."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พบคีย์หรือข้อมูลเข้าสู่ระบบในเอกสาร จึงหยุดส่งแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã phát hiện khóa hoặc thông tin đăng nhập trong tài liệu. Việc gửi đã bị dừng."
          }
        }
      }
    },
    "资料内容或来源无效，无法保存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The item has invalid content or source information and cannot be saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料内容或来源无效，无法保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料內容或來源無效，無法保存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalt oder Quellenangabe des Materials sind ungültig. Speichern ist nicht möglich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido o la información de origen no son válidos y no se puede guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu ou les informations de source du document sont invalides. L’enregistrement est impossible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten atau informasi sumber bahan tidak valid dan tidak dapat disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto o le informazioni sulla fonte non sono validi. Impossibile salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資料の内容または参照元が無効なため、保存できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료 내용 또는 출처 정보가 유효하지 않아 저장할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan atau maklumat sumber bahan tidak sah dan tidak dapat disimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo ou a informação de origem do material é inválido e não pode ser guardado."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาหรือข้อมูลแหล่งที่มาไม่ถูกต้อง จึงบันทึกไม่ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung hoặc thông tin nguồn của tài liệu không hợp lệ nên không thể lưu."
          }
        }
      }
    },
    "资料已在另一处更改，请返回列表重新打开后再保存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item was changed elsewhere. Return to the list and reopen it before saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料已在另一处更改，请返回列表重新打开后再保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料已在另一處更改，請返回列表重新打開後再保存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Material wurde an anderer Stelle geändert. Kehren Sie zur Liste zurück und öffnen Sie es erneut, bevor Sie speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este material se modificó en otro lugar. Vuelve a la lista y ábrelo de nuevo antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document a été modifié ailleurs. Revenez à la liste et rouvrez-le avant de l’enregistrer."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahan ini telah diubah di tempat lain. Kembali ke daftar dan buka lagi sebelum menyimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo contenuto è stato modificato altrove. Torna all’elenco e riaprilo prima di salvare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資料が別の場所で変更されました。一覧に戻って開き直してから保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 자료가 변경되었습니다. 목록으로 돌아가 다시 연 후 저장하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahan ini telah diubah di tempat lain. Kembali ke senarai dan buka semula sebelum menyimpan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este material foi alterado noutro local. Volte à lista e abra-o novamente antes de guardar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอกสารนี้ถูกแก้ไขจากที่อื่น โปรดกลับไปที่รายการแล้วเปิดใหม่ก่อนบันทึก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài liệu đã được thay đổi ở nơi khác. Hãy quay lại danh sách và mở lại trước khi lưu."
          }
        }
      }
    },
