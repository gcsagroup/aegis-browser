    "Metalink 无效：需要单个文件、公开 HTTP(S) 镜像及 SHA-256 或 SHA-512 校验值。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalink 无效：需要单个文件、公开 HTTP(S) 镜像及 SHA-256 或 SHA-512 校验值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Metalink 無效：需要單個文件、公開 HTTP(S) 鏡像及 SHA-256 或 SHA-512 校驗值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid Metalink: provide one file, public HTTP(S) mirrors, and a SHA-256 or SHA-512 checksum."
          }
        }
      }
    },
