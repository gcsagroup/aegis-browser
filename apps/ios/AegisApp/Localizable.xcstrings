    "保存后重新载入页面，以应用网站模式、脚本及权限规则。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload the page after saving to apply site mode, JavaScript and permission rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后重新载入页面，以应用网站模式、脚本及权限规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後重新載入頁面，以應用網站模式、腳本及權限規則。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie die Seite nach dem Speichern neu, um Website-Modus, JavaScript- und Berechtigungsregeln anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarga la página después de guardar para aplicar el modo del sitio y las reglas de JavaScript y permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez la page après l’enregistrement pour appliquer le mode du site et les règles de JavaScript et d’autorisations."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
