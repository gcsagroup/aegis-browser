    "模型请求过于频繁或额度不足，请稍后重试并检查服务额度。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are too frequent or quota is exhausted. Check your quota and try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型请求过于频繁或额度不足，请稍后重试并检查服务额度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型請求過於頻繁或額度不足，請稍後重試並檢查服務額度。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellanfragen sind zu häufig oder das Kontingent ist aufgebraucht. Prüfen Sie das Dienstkontingent und versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes al modelo son demasiado frecuentes o la cuota se ha agotado. Comprueba la cuota del servicio e inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes au modèle sont trop fréquentes ou le quota est épuisé. Vérifiez le quota du service et réessayez plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan model terlalu sering atau kuota habis. Periksa kuota layanan dan coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste al modello sono troppo frequenti o la quota è esaurita. Verifica la quota del servizio e riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルへのリクエストが多すぎるか、利用枠が不足しています。サービスの利用枠を確認し、しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 요청이 너무 잦거나 할당량이 부족합니다. 서비스 할당량을 확인하고 나중에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan model terlalu kerap atau kuota telah habis. Semak kuota perkhidmatan dan cuba lagi kemudian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pedidos ao modelo são demasiado frequentes ou a quota está esgotada. Verifique a quota do serviço e tente novamente mais tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอไปยังโมเดลถี่เกินไปหรือโควตาไม่เพียงพอ โปรดตรวจสอบโควตาบริการแล้วลองอีกครั้งในภายหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu mô hình quá thường xuyên hoặc hết hạn mức. Hãy kiểm tra hạn mức dịch vụ rồi thử lại sau."
          }
        }
      }
    },
    "模型输出尚未完成，请缩小资料范围后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model output is incomplete. Use fewer sources and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型输出尚未完成，请缩小资料范围后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型輸出尚未完成，請縮小資料範圍後重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellausgabe ist unvollständig. Reduzieren Sie den Umfang des Materials und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida del modelo está incompleta. Reduce la cantidad de material e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du modèle est incomplète. Réduisez la quantité de documents et réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluaran model belum lengkap. Kurangi cakupan bahan dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’output del modello è incompleto. Riduci la quantità di materiale e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの出力が完了していません。資料の範囲を絞って再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 출력이 완료되지 않았습니다. 자료 범위를 줄이고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Output model belum lengkap. Kurangkan skop bahan dan cuba lagi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do modelo está incompleta. Reduza a quantidade de material e tente novamente."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์ของโมเดลยังไม่สมบูรณ์ โปรดลดขอบเขตข้อมูลแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đầu ra mô hình chưa hoàn tất. Hãy giảm phạm vi tài liệu rồi thử lại."
          }
        }
      }
    },
