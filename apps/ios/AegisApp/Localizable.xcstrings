    "窗口、浏览模式或页面已变化，请重新生成并确认操作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The window, browsing mode or page has changed. Generate and confirm a new operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口、浏览模式或页面已变化，请重新生成并确认操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口、瀏覽模式或頁面已變化，請重新生成並確認操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster, Browsermodus oder Seite haben sich geändert. Erstellen und bestätigen Sie eine neue Aktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ventana, el modo de navegación o la página han cambiado. Genera y confirma una nueva operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fenêtre, le mode de navigation ou la page a changé. Générez et confirmez une nouvelle opération."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela, mode penjelajahan, atau halaman telah berubah. Buat dan konfirmasikan tindakan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La finestra, la modalità di navigazione o la pagina è cambiata. Genera e conferma una nuova operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ、閲覧モード、またはページが変わりました。操作を再生成して確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창, 탐색 모드 또는 페이지가 변경되었습니다. 작업을 다시 생성하고 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetingkap, mod pelayaran atau halaman telah berubah. Jana dan sahkan operasi baharu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A janela, o modo de navegação ou a página mudou. Gere e confirme uma nova operação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าต่าง โหมดการท่องเว็บ หรือหน้าเว็บเปลี่ยนไป โปรดสร้างและยืนยันการดำเนินการใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ, chế độ duyệt hoặc trang đã thay đổi. Hãy tạo lại và xác nhận thao tác."
          }
        }
      }
    },
    "窗口存储已达上限，请先删除不需要的已关闭窗口。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window storage is full. Delete a saved window you no longer need."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口存储已达上限，请先删除不需要的已关闭窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口存儲已達上限，請先刪除不需要的已關閉窗口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fensterspeicher ist voll. Löschen Sie zuerst nicht mehr benötigte geschlossene Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de ventanas está lleno. Elimina primero las ventanas cerradas que ya no necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage des fenêtres est plein. Supprimez d’abord les fenêtres fermées dont vous n’avez plus besoin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan jendela penuh. Hapus dahulu jendela tertutup yang tidak diperlukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio per le finestre è pieno. Elimina prima le finestre chiuse che non ti servono più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウの保存容量が上限に達しました。不要な閉じたウインドウを先に削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창 저장소가 한도에 도달했습니다. 불필요한 닫힌 창을 먼저 삭제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Storan tetingkap penuh. Padam dahulu tetingkap tertutup yang tidak diperlukan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento de janelas está cheio. Elimine primeiro as janelas fechadas de que já não precisa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่จัดเก็บหน้าต่างเต็มแล้ว โปรดลบหน้าต่างที่ปิดแล้วและไม่ต้องการก่อน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ nhớ cửa sổ đã đầy. Hãy xóa các cửa sổ đã đóng không còn cần thiết trước."
          }
        }
      }
    },
    "窗口管理": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage windows"
          }
