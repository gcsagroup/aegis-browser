    "选择页面，确认范围，再查看分析和原文引用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择页面，确认范围，再查看分析和原文引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇頁面，確認範圍，再查看分析和原文引用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose pages, confirm the scope, then review the analysis and sources."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten auswählen, Umfang bestätigen und dann die Analyse mit Quellenzitaten ansehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona páginas, confirma el alcance y consulta el análisis y las citas originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez les pages, confirmez le périmètre, puis consultez l’analyse et les citations originales."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih halaman, konfirmasi cakupan, lalu lihat analisis dan kutipan sumber."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona le pagine, conferma l’ambito, poi consulta l’analisi e le citazioni originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを選び、範囲を確認してから、分析と原文の引用を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 선택하고 범위를 확인한 다음 분석과 원문 인용을 살펴보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih halaman, sahkan skop, kemudian lihat analisis dan petikan asal."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione páginas, confirme o âmbito e consulte a análise e as citações originais."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกหน้า ยืนยันขอบเขต แล้วดูผลวิเคราะห์และข้อความอ้างอิงต้นฉบับ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn trang, xác nhận phạm vi, rồi xem phân tích và trích dẫn gốc."
          }
        }
      }
    },
    "部分高级订阅语法无法转换为 WebKit 规则，会跳过处理。视频网站插播广告等内容不保证全部过滤。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分高级订阅语法无法转换为 WebKit 规则，会跳过处理。视频网站插播广告等内容不保证全部过滤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分高級訂閱語法無法轉換為 WebKit 規則，會跳過處理。視頻網站插播廣告等內容不保證全部過濾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some advanced subscription syntax cannot be converted to WebKit rules and is skipped. Filtering all ads, including ads within videos, is not guaranteed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
