    "服务返回的内容过大，已停止读取。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The response is too large. Reading stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回的内容过大，已停止读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務返回的內容過大，已停止讀取。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dienstantwort ist zu groß. Das Lesen wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido devuelto por el servicio es demasiado grande. Se detuvo la lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu renvoyé par le service est trop volumineux. La lecture a été arrêtée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten yang dikembalikan layanan terlalu besar. Pembacaan dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto restituito dal servizio è troppo grande. La lettura è stata interrotta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスから返された内容が大きすぎるため、読み取りを停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 반환한 콘텐츠가 너무 커서 읽기를 중지했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandungan yang dikembalikan oleh perkhidmatan terlalu besar. Pembacaan dihentikan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo devolvido pelo serviço é demasiado grande. A leitura foi interrompida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาที่บริการส่งกลับมามีขนาดใหญ่เกินไป จึงหยุดอ่านแล้ว"
          }
        },
        "vi": {
