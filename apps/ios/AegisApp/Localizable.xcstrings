          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht abgesendete Eingaben auf dieser Seite können verloren gehen. Diese Aktion wendet Regeln an oder entfernt die Seiteneffekte bereits ausgeführter Skripte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos sin enviar de esta página pueden perderse. Esta acción aplica las reglas o elimina los efectos de los scripts ya ejecutados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les saisies non envoyées de cette page peuvent être perdues. Cette opération applique les règles ou supprime les effets des scripts déjà exécutés sur la page."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Input yang belum dikirim pada halaman ini mungkin hilang. Tindakan ini menerapkan aturan atau menghapus efek skrip yang sudah dijalankan pada halaman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati non inviati di questa pagina potrebbero andare persi. Questa azione applica le regole o rimuove gli effetti degli script già eseguiti sulla pagina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のページの未送信の入力内容が失われる場合があります。この操作はルールの適用や、実行済みスクリプトによるページへの影響の除去に使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페이지의 제출하지 않은 입력은 사라질 수 있습니다. 이 작업은 규칙을 적용하거나 이미 실행된 스크립트의 페이지 효과를 제거합니다."
