            "value": "Seul le contenu modifiable ci-dessus est envoyé, jusqu’à 32 KiB."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya konten yang dapat diedit di atas yang dikirim, maksimal 32 KiB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene inviato solo il contenuto modificabile qui sopra, fino a 32 KiB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の編集可能な内容のみを送信します。上限は 32 KiB です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 편집 가능한 콘텐츠만 전송하며 최대 32 KiB입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kandungan boleh sunting di atas dihantar, sehingga 32 KiB."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas é enviado o conteúdo editável acima, até 32 KiB."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งเฉพาะเนื้อหาที่แก้ไขได้ด้านบน สูงสุด 32 KiB"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ gửi nội dung có thể chỉnh sửa ở trên, tối đa 32 KiB."
          }
        }
      }
    },
    "右键轻点仍打开菜单。按住 Shift 再右键可临时跳过手势。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A right click still opens the menu. Hold Shift to temporarily skip gestures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键轻点仍打开菜单。按住 Shift 再右键可临时跳过手势。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右鍵輕點仍打開菜單。按住 Shift 再右鍵可臨時跳過手勢。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Rechtsklick öffnet weiterhin das Menü. Halten Sie beim Rechtsklick die Umschalttaste gedrückt, um Gesten vorübergehend zu überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic derecho breve sigue abriendo el menú. Mantén pulsada Mayús al hacer clic derecho para omitir temporalmente los gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clic droit bref ouvre toujours le menu. Maintenez Maj pendant le clic droit pour ignorer temporairement les gestes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan singkat tetap membuka menu. Tahan Shift saat klik kanan untuk melewati gestur sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un breve clic destro apre comunque il menu. Tieni premuto Maiusc mentre fai clic destro per ignorare temporaneamente i gesti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右クリックすると従来どおりメニューが開きます。Shift を押しながら右クリックすると、ジェスチャーを一時的にスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧게 오른쪽 클릭하면 메뉴가 열립니다. Shift를 누른 채 오른쪽 클릭하면 제스처를 일시적으로 건너뛸 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan ringkas masih membuka menu. Tahan Shift semasa klik kanan untuk melangkau gerak isyarat buat sementara."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um clique direito breve continua a abrir o menu. Mantenha Shift premido ao clicar com o botão direito para ignorar temporariamente os gestos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกขวาสั้น ๆ ยังเปิดเมนูได้ กด Shift ค้างแล้วคลิกขวาเพื่อข้ามท่าทางชั่วคราว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp chuột phải ngắn vẫn mở menu. Giữ Shift khi nhấp chuột phải để tạm bỏ qua cử chỉ."
          }
        }
      }
    },
