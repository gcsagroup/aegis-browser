    "你正在私密浏览。确认后，所选页面内容会离开本机，模型服务可能保留请求或回答。Aegis 不会自动保存此次任务记录。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are browsing privately. Confirming sends the selected page content off this device. The model service may retain requests or answers. Aegis will not automatically save a task record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
