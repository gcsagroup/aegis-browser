    "草稿已保存。修改后的版本需要回到列表确认启用。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft saved. Return to the list to review and enable the changed version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存。修改后的版本需要回到列表确认启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已保存。修改後的版本需要回到列表確認啓用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwurf gespeichert. Kehren Sie zur Liste zurück, um die geänderte Version zu prüfen und ihre Aktivierung zu bestätigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrador guardado. Vuelve a la lista para revisar y confirmar la activación de la versión modificada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon enregistré. Revenez à la liste pour vérifier et confirmer l’activation de la version modifiée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf disimpan. Kembali ke daftar untuk memeriksa dan mengonfirmasi pengaktifan versi yang diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozza salvata. Torna all’elenco per verificare e confermare l’attivazione della versione modificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きを保存しました。変更したバージョンは一覧に戻って有効化を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안을 저장했습니다. 변경된 버전을 활성화하려면 목록으로 돌아가 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf disimpan. Kembali ke senarai untuk menyemak dan mengesahkan pengaktifan versi yang diubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunho guardado. Volte à lista para rever e confirmar a ativação da versão alterada."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกร่างแล้ว เวอร์ชันที่แก้ไขต้องกลับไปที่รายการเพื่อตรวจสอบและยืนยันการเปิดใช้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã lưu bản nháp. Quay lại danh sách để kiểm tra và xác nhận bật phiên bản đã sửa."
          }
        }
      }
    },
