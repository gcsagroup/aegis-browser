    "比价、结算预览与最终接管": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比价、结算预览与最终接管"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比價、結算預覽與最後接手"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Price comparison, checkout preview and handoff"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Preisvergleich, Bestellvorschau und abschließende Übernahme"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparación de precios, vista previa del pago y toma de control final"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparaison des prix, aperçu de commande et reprise en main finale"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbandingan harga, pratinjau pembayaran, dan pengambilalihan akhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronto prezzi, anteprima dell’ordine e controllo finale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格比較、決済プレビュー、最終操作の引き継ぎ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 비교, 결제 미리 보기 및 최종 제어권 인계"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbandingan harga, pratonton pembayaran dan pengambilalihan akhir"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparação de preços, pré-visualização da finalização da compra e controlo final"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบราคา ดูตัวอย่างการชำระเงิน และรับช่วงควบคุมขั้นสุดท้าย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh giá, xem trước thanh toán và tiếp quản bước cuối"
          }
        }
      }
    },
    "比较所选来源的观点、证据和分歧，逐项引用，说明资料不足之处。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the sources, their evidence, and disagreements. Cite each point and note missing information."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较所选来源的观点、证据和分歧，逐项引用，说明资料不足之处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較所選來源的觀點、證據和分歧，逐項引用，說明資料不足之處。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche die Standpunkte, Belege und Meinungsunterschiede der ausgewählten Quellen. Belege jeden Punkt mit Quellenangaben und benenne Informationslücken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara los puntos de vista, las pruebas y las discrepancias de las fuentes seleccionadas. Cita cada punto e indica dónde falta información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les points de vue, les preuves et les divergences des sources sélectionnées. Cite chaque point et précise les informations manquantes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan pandangan, bukti, dan perbedaan dari sumber yang dipilih. Berikan rujukan untuk setiap poin dan jelaskan kekurangan informasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta i punti di vista, le prove e le divergenze delle fonti selezionate. Cita ogni punto e indica le informazioni mancanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した情報源の見解、根拠、相違点を比較し、各項目に引用を付け、情報が不足している点を説明してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 출처의 관점, 근거 및 의견 차이를 비교하세요. 각 항목의 출처를 인용하고 정보가 부족한 부분을 설명하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan pandangan, bukti dan percanggahan sumber terpilih. Petik sumber bagi setiap perkara dan nyatakan kekurangan maklumat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara os pontos de vista, as provas e as divergências das fontes selecionadas. Cita cada ponto e indica onde falta informação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบมุมมอง หลักฐาน และข้อขัดแย้งของแหล่งข้อมูลที่เลือก อ้างอิงทีละประเด็นและระบุส่วนที่ข้อมูลไม่เพียงพอ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh quan điểm, bằng chứng và bất đồng của các nguồn đã chọn. Trích dẫn từng điểm và nêu rõ thông tin còn thiếu."
          }
        }
      }
    },
    "比较所选页面的商品、价格和规格，列出来源；说明未知的运费、库存和时效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare products, prices, and specifications in the selected pages. Cite sources and identify unknown shipping, stock, or timing details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较所选页面的商品、价格和规格，列出来源；说明未知的运费、库存和时效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "比較所選頁面的商品、價格和規格，列出來源；說明未知的運費、庫存和時效。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Produkte, Preise und technische Daten auf den ausgewählten Seiten und nenne die Quellen. Weise auf unbekannte Versandkosten, Lagerbestände und Zeitangaben hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara los productos, precios y especificaciones de las páginas seleccionadas y cita las fuentes. Indica los gastos de envío, existencias y plazos desconocidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare les produits, les prix et les caractéristiques des pages sélectionnées, en citant les sources. Précise les frais de livraison, les stocks et les délais inconnus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan produk, harga, dan spesifikasi pada halaman yang dipilih serta cantumkan sumber. Jelaskan ongkos kirim, stok, dan waktu yang belum diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta prodotti, prezzi e specifiche nelle pagine selezionate e cita le fonti. Indica i costi di spedizione, le disponibilità e i tempi non noti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したページの商品、価格、仕様を比較し、参照元を示してください。不明な送料、在庫、所要時間を明記してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 페이지의 상품, 가격 및 사양을 비교하고 출처를 나열하세요. 확인되지 않은 배송비, 재고 및 소요 시간을 명시하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan produk, harga dan spesifikasi pada halaman terpilih serta senaraikan sumber. Nyatakan kos penghantaran, stok dan tempoh yang belum diketahui."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara os produtos, preços e especificações das páginas selecionadas e cita as fontes. Indica os custos de envio, as existências e os prazos desconhecidos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปรียบเทียบสินค้า ราคา และข้อมูลจำเพาะในหน้าที่เลือก พร้อมระบุแหล่งที่มา และชี้แจงค่าจัดส่ง สต็อก และระยะเวลาที่ยังไม่ทราบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "So sánh sản phẩm, giá và thông số trên các trang đã chọn, liệt kê nguồn. Nêu rõ phí vận chuyển, tồn kho và thời gian chưa biết."
          }
        }
      }
    },
