    "已安全交给 Aegis\n60 秒内打开 App 即可接收": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安全交给 Aegis\n60 秒内打开 App 即可接收"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安全交給 Aegis\n60 秒內開啟 App 即可接收"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link sent to Aegis.\nOpen the app within 60 seconds to receive it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicher an Aegis übergeben.\nZum Empfangen die App innerhalb von 60 Sekunden öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace enviado de forma segura a Aegis.\nAbre la app en 60 segundos para recibirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien transmis à Aegis en toute sécurité.\nOuvrez l’app sous 60 secondes pour le recevoir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan dikirim dengan aman ke Aegis.\nBuka aplikasi dalam 60 detik untuk menerimanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Link inviato in sicurezza ad Aegis.\nApri l’app entro 60 secondi per riceverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Aegisに安全に送信しました。\n60秒以内にアプリを開いて受け取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Aegis에 안전하게 전달했습니다.\n60초 안에 앱을 열어 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan dihantar dengan selamat kepada Aegis.\nBuka app dalam masa 60 saat untuk menerimanya."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligação enviada em segurança para o Aegis.\nAbra a app dentro de 60 segundos para a receber."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์ให้ Aegis อย่างปลอดภัยแล้ว\nเปิดแอปภายใน 60 วินาทีเพื่อรับลิงก์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chuyển liên kết an toàn đến Aegis.\nMở ứng dụng trong 60 giây để nhận."
          }
        }
      }
    },
