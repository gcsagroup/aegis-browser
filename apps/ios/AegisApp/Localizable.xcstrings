    "将关闭普通标签并清除 Cookie、网站存储和缓存。网站登录会退出，收藏和工作区会保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将关闭普通标签并清除 Cookie、网站存储和缓存。网站登录会退出，收藏和工作区会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將關閉普通標籤並清除 Cookie、網站儲存和快取。網站登入會登出，收藏和工作區會保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This closes regular tabs and clears cookies, website storage and cache. You will be signed out of websites. Bookmarks and workspaces are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale Tabs werden geschlossen und Cookies, Website-Speicher sowie Cache gelöscht. Sie werden von Websites abgemeldet. Lesezeichen und Arbeitsbereiche bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrarán las pestañas normales y se borrarán las cookies, el almacenamiento de sitios web y la caché. Se cerrarán tus sesiones en los sitios web. Los marcadores y espacios de trabajo se conservarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les onglets ordinaires seront fermés et les cookies, le stockage des sites et le cache seront effacés. Vous serez déconnecté des sites web. Les favoris et espaces de travail seront conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab biasa akan ditutup dan cookie, penyimpanan situs web, serta cache akan dihapus. Anda akan keluar dari situs web. Markah dan ruang kerja tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schede normali verranno chiuse e verranno cancellati cookie, dati dei siti web e cache. Verrai disconnesso dai siti web. I preferiti e le aree di lavoro verranno conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常タブを閉じ、Cookie、ウェブサイトのストレージ、キャッシュを消去します。ウェブサイトからログアウトします。ブックマークとワークスペースは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 탭을 닫고 쿠키, 웹사이트 저장소 및 캐시를 지웁니다. 웹사이트에서 로그아웃됩니다. 북마크와 작업 공간은 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tab biasa akan ditutup dan kuki, storan laman web serta cache akan dipadam. Anda akan dilog keluar daripada laman web. Penanda buku dan ruang kerja dikekalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os separadores normais serão fechados e os cookies, o armazenamento dos sites e a cache serão apagados. A sessão nos sites será terminada. Os marcadores e espaços de trabalho serão mantidos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะปิดแท็บปกติและล้างคุกกี้ พื้นที่จัดเก็บเว็บไซต์ และแคช คุณจะออกจากระบบเว็บไซต์ โดยบุ๊กมาร์กและพื้นที่ทำงานจะยังคงอยู่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thẻ thông thường sẽ đóng và cookie, bộ nhớ trang web cùng bộ nhớ đệm sẽ bị xóa. Bạn sẽ bị đăng xuất khỏi các trang web. Dấu trang và không gian làm việc được giữ lại."
          }
        }
      }
    },
    "将发送以下脱敏正文，批注和浏览历史不发送。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following redacted text will be sent. Notes and browsing history are not sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发送以下脱敏正文，批注和浏览历史不发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將發送以下脫敏正文，批注和瀏覽歷史不發送。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der folgende, um sensible Daten bereinigte Text wird gesendet. Notizen und Browserverlauf werden nicht gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se enviará el siguiente texto con los datos sensibles ocultos. No se enviarán las notas ni el historial de navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte suivant, expurgé des données sensibles, sera envoyé. Les annotations et l’historique de navigation ne seront pas envoyés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks berikut yang telah disamarkan data sensitifnya akan dikirim. Catatan dan riwayat penjelajahan tidak dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà inviato il seguente testo con i dati sensibili oscurati. Le note e la cronologia di navigazione non verranno inviate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の機密情報を除去した本文を送信します。注釈や閲覧履歴は送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음과 같이 민감한 정보를 가린 본문이 전송됩니다. 주석과 탐색 기록은 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks berikut yang telah disunting untuk membuang maklumat sensitif akan dihantar. Nota dan sejarah pelayaran tidak dihantar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Será enviado o seguinte texto com os dados sensíveis ocultados. As anotações e o histórico de navegação não serão enviados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะส่งเนื้อหาต่อไปนี้ซึ่งปกปิดข้อมูลที่ละเอียดอ่อนแล้ว โดยไม่ส่งบันทึกย่อและประวัติการท่องเว็บ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung sau đã được che thông tin nhạy cảm sẽ được gửi đi. Ghi chú và lịch sử duyệt web không được gửi."
          }
        }
      }
    },
