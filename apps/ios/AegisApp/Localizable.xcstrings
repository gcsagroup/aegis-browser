    "处理部分网页的调试干扰，保留普通断点和导航。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle some debugger interference while keeping normal breakpoints and navigation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理部分网页的调试干扰，保留普通断点和导航。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "處理部分網頁的調試干擾，保留普通斷點和導航。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behandelt einige Debugging-Störungen durch Webseiten; normale Haltepunkte und Navigation bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona algunas interferencias de depuración de las páginas, manteniendo los puntos de interrupción normales y la navegación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gère certaines interférences de débogage des pages tout en conservant les points d’arrêt ordinaires et la navigation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menangani sebagian gangguan debugging pada halaman sambil mempertahankan breakpoint normal dan navigasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisce alcune interferenze di debug delle pagine mantenendo i normali punti di interruzione e la navigazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のページのデバッグ妨害に対応し、通常のブレークポイントとナビゲーションは維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 웹페이지의 디버깅 방해를 처리하며 일반 중단점과 탐색은 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengendalikan sesetengah gangguan nyahpepijat halaman sambil mengekalkan titik henti biasa dan navigasi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trata algumas interferências de depuração das páginas, mantendo os pontos de interrupção normais e a navegação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการการรบกวนการดีบักจากบางหน้าเว็บ โดยคงจุดพักปกติและการนำทางไว้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xử lý một số can thiệp gỡ lỗi của trang web, giữ nguyên điểm dừng thông thường và điều hướng."
          }
        }
      }
    },
