    "用当前页面或选中的标签页完成摘要、翻译、研究和商品比较。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize, translate, research, or compare products using the current page or selected tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用当前页面或选中的标签页完成摘要、翻译、研究和商品比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用當前頁面或選中的標籤頁完成摘要、翻譯、研究和商品比較。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie die aktuelle Seite oder ausgewählte Tabs zum Zusammenfassen, Übersetzen, Recherchieren und Vergleichen von Produkten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume, traduce, investiga o compara productos con la página actual o las pestañas seleccionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résumez, traduisez, effectuez des recherches ou comparez des produits à partir de la page actuelle ou des onglets sélectionnés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan halaman saat ini atau tab terpilih untuk merangkum, menerjemahkan, melakukan riset, dan membandingkan produk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassumi, traduci, fai ricerche o confronta prodotti usando la pagina attuale o le schede selezionate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のページや選択したタブを使って、要約、翻訳、調査、商品比較を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 페이지나 선택한 탭을 사용하여 요약, 번역, 조사 및 상품 비교를 수행합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan halaman semasa atau tab terpilih untuk meringkaskan, menterjemah, menyelidik dan membandingkan produk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuma, traduza, pesquise ou compare produtos usando a página atual ou os separadores selecionados."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้หน้าปัจจุบันหรือแท็บที่เลือกเพื่อสรุป แปล ค้นคว้า และเปรียบเทียบสินค้า"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng trang hiện tại hoặc các thẻ đã chọn để tóm tắt, dịch, nghiên cứu và so sánh sản phẩm."
          }
        }
      }
    },
