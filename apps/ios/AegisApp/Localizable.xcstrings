    "下载记录无法读取，原文件已保留，暂时无法开始或更改下载。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download records could not be read. The original file has been preserved. Downloads cannot be started or changed yet."
          }
        },
        "zh-Hans": {
