    "已支持广告与跟踪过滤、链接清理及本地风险网址检查。当前页面的导航拦截和清理结果显示在页面提示中。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad and tracker filtering, link cleanup and local URL risk checks are supported. Navigation notices show blocking and cleanup results for the current page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持广告与跟踪过滤、链接清理及本地风险网址检查。当前页面的导航拦截和清理结果显示在页面提示中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持廣告與跟蹤過濾、鏈接清理及本地風險網址檢查。當前頁面的導航攔截和清理結果顯示在頁面提示中。"
          }
        }
      }
    },
    "已支持独立安全资源规则、网址与页面结构检查、系统加固和可选指纹限制。页面结构观察限加载后的前一分钟。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已支持独立安全资源规则、网址与页面结构检查、系统加固和可选指纹限制。页面结构观察限加载后的前一分钟。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available: independent security resource rules, URL and page structure checks, system hardening and optional fingerprint limits. Structure monitoring lasts up to one minute after loading begins."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已支援獨立安全資源規則、網址與頁面結構檢查、系統強化及可選指紋限制。頁面結構觀察限載入後的前一分鐘。"
          }
        }
      }
    },
