    "取消任务或页面变化后，会停止尚未执行的操作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pending actions stop when you cancel or the page changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消任务或页面变化后，会停止尚未执行的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消任務或頁面變化後，會停止尚未執行的操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie die Aufgabe abbrechen oder sich die Seite ändert, werden noch nicht ausgeführte Aktionen gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones pendientes se detienen al cancelar la tarea o si cambia la página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations en attente sont arrêtées si vous annulez la tâche ou si la page change."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan yang belum dijalankan berhenti saat Anda membatalkan tugas atau halaman berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le operazioni non ancora eseguite vengono interrotte se annulli l’attività o se la pagina cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクをキャンセルするかページが変わると、未実行の操作は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 취소하거나 페이지가 변경되면 아직 실행하지 않은 작업이 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan yang belum dilaksanakan dihentikan apabila anda membatalkan tugas atau halaman berubah."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações pendentes param quando cancela a tarefa ou a página muda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อยกเลิกงานหรือหน้าเว็บเปลี่ยนไป การดำเนินการที่ยังไม่ได้เริ่มจะหยุดลง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thao tác chưa thực hiện sẽ dừng khi bạn hủy tác vụ hoặc trang thay đổi."
          }
        }
      }
    },
