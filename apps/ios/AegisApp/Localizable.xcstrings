    "导出的文本会包含正文、来源、批注和译文，保留在你选择的位置。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported text includes the original, source, notes and translation, and remains in the location you choose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出的文本会包含正文、来源、批注和译文，保留在你选择的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導出的文本會包含正文、來源、批注和譯文，保留在你選擇的位置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der exportierte Text enthält den Originaltext, die Quelle, Notizen und die Übersetzung und bleibt am von Ihnen gewählten Speicherort erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto exportado incluye el original, la fuente, las notas y la traducción, y permanecerá en la ubicación que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte exporté inclut le texte original, la source, les annotations et la traduction. Il reste à l’emplacement de votre choix."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang diekspor mencakup teks asli, sumber, catatan, dan terjemahan, serta tetap tersimpan di lokasi yang Anda pilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo esportato include il testo originale, la fonte, le note e la traduzione e resta nella posizione scelta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出すテキストには本文、参照元、注釈、翻訳が含まれ、選択した場所に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 텍스트에는 본문, 출처, 주석 및 번역이 포함되며 선택한 위치에 유지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang dieksport merangkumi teks asal, sumber, nota dan terjemahan, serta kekal di lokasi yang anda pilih."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto exportado inclui o original, a fonte, as anotações e a tradução, e permanece na localização que escolher."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความที่ส่งออกจะมีเนื้อหาต้นฉบับ แหล่งที่มา บันทึกย่อ และคำแปล โดยจะคงอยู่ในตำแหน่งที่คุณเลือก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản xuất ra bao gồm nội dung gốc, nguồn, ghi chú và bản dịch, được giữ lại ở vị trí bạn chọn."
          }
        }
      }
    },
