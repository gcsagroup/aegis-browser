          "stringUnit": {
            "state": "translated",
            "value": "追蹤保護初始化失敗，請重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking-Schutz konnte nicht gestartet werden. Bitte erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la protección contra el seguimiento. Reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’initialisation de la protection contre le suivi. Réessayez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memulai perlindungan pelacakan. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la protezione dal tracciamento. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラッキング防止の初期化に失敗しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
