    "任务已恢复，请重新读取页面并确认发送。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已恢复，请重新读取页面并确认发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務已恢復，請重新讀取頁面並確認發送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task restored. Read the pages again and confirm before sending."
          }
        },
        "de": {
          "stringUnit": {
