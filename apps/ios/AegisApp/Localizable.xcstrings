    "网站设置按协议、主机和端口分别保存。相机和麦克风的“询问”仍需系统许可；定位等权限由系统提示管理。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site settings are stored separately by protocol, host and port. Asking for camera or microphone access still requires system permission. Location and other permissions use system prompts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
