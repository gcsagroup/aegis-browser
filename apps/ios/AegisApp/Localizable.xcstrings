            "state": "translated",
            "value": "อ่านโครงสร้างหน้าปัจจุบันเพื่อตรวจสอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc cấu trúc trang hiện tại để kiểm tra"
          }
        }
      }
    },
    "距离越大，越不容易被小幅抖动触发。斜线方向不明确时不执行；按 Esc 或切换窗口可取消。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher distances reduce accidental gestures. Ambiguous diagonals are ignored. Press Esc or switch windows to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离越大，越不容易被小幅抖动触发。斜线方向不明确时不执行；按 Esc 或切换窗口可取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離越大，越不容易被小幅抖動觸發。斜線方向不明確時不執行；按 Esc 或切換窗口可取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größere Distanzen verringern versehentliche Auslösungen durch kleine Bewegungen. Unklare Diagonalrichtungen führen keine Aktion aus. Drücken Sie Esc oder wechseln Sie das Fenster zum Abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las distancias mayores reducen la activación por pequeños movimientos. Las diagonales ambiguas no ejecutan acciones. Pulsa Esc o cambia de ventana para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une distance plus grande réduit les déclenchements dus aux petits mouvements. Les diagonales ambiguës n’exécutent aucune action. Appuyez sur Échap ou changez de fenêtre pour annuler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak yang lebih besar mengurangi pemicu tidak sengaja akibat gerakan kecil. Arah diagonal yang tidak jelas tidak dijalankan. Tekan Esc atau pindah jendela untuk membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distanze maggiori riducono le attivazioni causate da piccoli movimenti. Le diagonali ambigue non eseguono azioni. Premi Esc o cambia finestra per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離を大きくすると、小さな揺れで誤作動しにくくなります。斜め方向が不明確な場合は実行しません。Esc を押すかウインドウを切り替えるとキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거리가 클수록 작은 흔들림으로 작동할 가능성이 줄어듭니다. 대각선 방향이 불명확하면 실행하지 않습니다. Esc를 누르거나 창을 전환하면 취소할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarak yang lebih besar mengurangkan pencetusan akibat gerakan kecil. Arah pepenjuru yang tidak jelas tidak dilaksanakan. Tekan Esc atau tukar tetingkap untuk membatalkan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Distâncias maiores reduzem ativações causadas por pequenos movimentos. Diagonais ambíguas não executam ações. Prima Esc ou mude de janela para cancelar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระยะที่มากขึ้นช่วยลดการเรียกใช้จากการสั่นเล็กน้อย หากทิศทแยงไม่ชัดเจนจะไม่ดำเนินการ กด Esc หรือสลับหน้าต่างเพื่อยกเลิก"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khoảng cách lớn hơn giảm kích hoạt do rung nhẹ. Hướng chéo không rõ sẽ không thực hiện. Nhấn Esc hoặc đổi cửa sổ để hủy."
          }
        }
      }
    },
    "输入 L / R / U / D，分别代表 ← → ↑ ↓。最多 8 个方向，同一手势不能重复绑定。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter L / R / U / D for ← → ↑ ↓, up to 8 directions. Each gesture can have one binding."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 L / R / U / D，分别代表 ← → ↑ ↓。最多 8 个方向，同一手势不能重复绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 L / R / U / D，分別代表 ← → ↑ ↓。最多 8 個方向，同一手勢不能重復綁定。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie L / R / U / D für ← → ↑ ↓ ein, höchstens 8 Richtungen. Jede Geste darf nur einmal zugewiesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce L / R / U / D para ← → ↑ ↓, hasta 8 direcciones. Cada gesto solo puede tener una asignación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez L / R / U / D pour ← → ↑ ↓, jusqu’à 8 directions. Un même geste ne peut avoir qu’une seule affectation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan L / R / U / D untuk ← → ↑ ↓, maksimal 8 arah. Setiap gestur hanya boleh memiliki satu pengikatan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci L / R / U / D per ← → ↑ ↓, fino a 8 direzioni. Ogni gesto può avere una sola assegnazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "L / R / U / D はそれぞれ ← → ↑ ↓ を表します。最大 8 方向まで入力できます。同じジェスチャーを重複して割り当てることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "L / R / U / D는 각각 ← → ↑ ↓를 의미하며 최대 8개 방향을 입력할 수 있습니다. 같은 제스처를 중복 연결할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan L / R / U / D untuk ← → ↑ ↓, sehingga 8 arah. Setiap gerak isyarat hanya boleh mempunyai satu ikatan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza L / R / U / D para ← → ↑ ↓, até 8 direções. Cada gesto só pode ter uma associação."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อน L / R / U / D แทน ← → ↑ ↓ ตามลำดับ สูงสุด 8 ทิศทาง ท่าทางเดียวกันผูกได้เพียงครั้งเดียว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập L / R / U / D tương ứng ← → ↑ ↓, tối đa 8 hướng. Mỗi cử chỉ chỉ được gán một lần."
          }
        }
      }
    },
    "过滤设置与网站增强分别管理。风险页面保护不会因此关闭。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtering and enhancements are managed separately. Risky-page protection remains active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过滤设置与网站增强分别管理。风险页面保护不会因此关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過濾設定與網站增強分別管理。風險頁面保護不會因此關閉。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filterung und Website-Erweiterungen werden getrennt verwaltet. Der Schutz vor riskanten Seiten bleibt aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado y las mejoras de sitios se gestionan por separado. La protección frente a páginas de riesgo sigue activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage et les améliorations de sites sont gérés séparément. La protection contre les pages à risque reste active."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemfilteran dan peningkatan situs dikelola terpisah. Perlindungan terhadap halaman berisiko tetap aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il filtraggio e i miglioramenti dei siti sono gestiti separatamente. La protezione dalle pagine rischiose resta attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルタリング設定とサイトの拡張機能は別々に管理します。危険なページへの保護は無効になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터링과 사이트 향상 기능은 별도로 관리됩니다. 위험한 페이지 보호는 비활성화되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penapisan dan penambahbaikan laman diurus secara berasingan. Perlindungan halaman berisiko kekal aktif."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A filtragem e as melhorias de sites são geridas separadamente. A proteção contra páginas de risco permanece ativa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การกรองและฟังก์ชันเสริมเว็บไซต์จัดการแยกกัน การป้องกันหน้าเสี่ยงจะไม่ถูกปิด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lọc và cải tiến trang web được quản lý riêng. Bảo vệ trang rủi ro vẫn hoạt động."
          }
        }
      }
    },
