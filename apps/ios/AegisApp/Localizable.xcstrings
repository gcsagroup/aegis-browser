    "网址或登录表单包含多项风险信号。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网址或登录表单包含多项风险信号。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL or login form contains several risk signals."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網址或登入表單包含多項風險訊號。"
          }
        },
        "de": {
