    "模型服务响应超时，请缩小资料范围或稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model service timed out. Use fewer sources or try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务响应超时，请缩小资料范围或稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服務回應逾時，請縮小資料範圍或稍後重試。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Modelldienstes hat das Zeitlimit überschritten. Reduzieren Sie den Umfang des Materials oder versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del modelo agotó el tiempo de respuesta. Reduce la cantidad de material o inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de réponse du service du modèle a été dépassé. Réduisez la quantité de documents ou réessayez plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Respons layanan model melewati batas waktu. Kurangi cakupan bahan atau coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio del modello ha superato il tempo di risposta. Riduci la quantità di materiale o riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスの応答がタイムアウトしました。資料の範囲を絞るか、しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 서비스 응답 시간이 초과되었습니다. 자료 범위를 줄이거나 나중에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Respons perkhidmatan model tamat masa. Kurangkan skop bahan atau cuba lagi kemudian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do modelo excedeu o tempo de resposta. Reduza a quantidade de material ou tente novamente mais tarde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโมเดลตอบกลับไม่ทันเวลาที่กำหนด โปรดลดขอบเขตข้อมูลหรือลองอีกครั้งในภายหลัง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ mô hình phản hồi quá thời gian chờ. Hãy giảm phạm vi tài liệu hoặc thử lại sau."
          }
        }
      }
    },
    "模型服务拒绝访问，请检查该服务的密钥和模型权限。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was denied. Check the service key and model permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务拒绝访问，请检查该服务的密钥和模型权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服務拒絕存取，請檢查該服務的金鑰和模型權限。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modelldienst hat den Zugriff verweigert. Prüfen Sie den Dienstschlüssel und die Modellberechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio del modelo denegó el acceso. Comprueba la clave del servicio y los permisos del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service du modèle a refusé l’accès. Vérifiez la clé du service et les autorisations du modèle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan model menolak akses. Periksa kunci layanan dan izin model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio del modello ha negato l’accesso. Verifica la chiave del servizio e le autorizzazioni del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスがアクセスを拒否しました。サービスのキーとモデルの権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 서비스가 접근을 거부했습니다. 서비스 키와 모델 권한을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan model menolak akses. Semak kunci perkhidmatan dan kebenaran model."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço do modelo recusou o acesso. Verifique a chave do serviço e as permissões do modelo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการโมเดลปฏิเสธการเข้าถึง โปรดตรวจสอบคีย์บริการและสิทธิ์ของโมเดล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ mô hình từ chối truy cập. Hãy kiểm tra khóa dịch vụ và quyền của mô hình."
          }
        }
      }
    },
    "模型服务暂时不可用，请稍后重试。": {
