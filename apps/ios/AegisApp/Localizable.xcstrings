    "已安全交给 Aegis\n60 秒内打开 App 即可接收": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安全交给 Aegis\n60 秒内打开 App 即可接收"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安全交給 Aegis\n60 秒內開啟 App 即可接收"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link sent to Aegis.\nOpen the app within 60 seconds to receive it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicher an Aegis übergeben.\nZum Empfangen die App innerhalb von 60 Sekunden öffnen."
          }
        },
        "es": {
          "stringUnit": {
