    "阅读库为空。在文档的更多操作中保存原文。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library is empty. Save original text from a document's More menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读库为空。在文档的更多操作中保存原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "閱讀庫為空。在文檔的更多操作中保存原文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Lesebibliothek ist leer. Speichern Sie den Originaltext über das Menü „Weitere Aktionen“ eines Dokuments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca está vacía. Guarda el texto original desde el menú Más acciones del documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre bibliothèque est vide. Enregistrez le texte original depuis le menu Autres actions du document."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka bacaan kosong. Simpan teks asli dari menu Tindakan lainnya pada dokumen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria è vuota. Salva il testo originale dal menu Altre azioni del documento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧ライブラリは空です。ドキュメントの「その他の操作」から原文を保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 자료실이 비어 있습니다. 문서의 기타 작업 메뉴에서 원문을 저장하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka bacaan kosong. Simpan teks asal daripada menu Lagi tindakan dokumen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca está vazia. Guarde o texto original no menu Mais ações do documento."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลังการอ่านว่างอยู่ บันทึกต้นฉบับจากเมนูการดำเนินการเพิ่มเติมของเอกสาร"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện đọc đang trống. Lưu văn bản gốc từ menu Thêm thao tác của tài liệu."
          }
        }
      }
    },
    "尚未授权自动预览网站。可以从在线文档的来源菜单开启。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sites approved for automatic preview. Enable it in an online document's Source menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授权自动预览网站。可以从在线文档的来源菜单开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未授權自動預覽網站。可以從在線文檔的來源菜單開啓。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Websites für automatische Vorschau freigegeben. Sie können dies im Quellenmenü eines Online-Dokuments aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay sitios autorizados para vista previa automática. Puedes activarla en el menú Origen de un documento en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun site n’est autorisé pour l’aperçu automatique. Activez-le dans le menu Source d’un document en ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada situs yang diizinkan untuk pratinjau otomatis. Aktifkan dari menu Sumber dokumen daring."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun sito autorizzato per l’anteprima automatica. Puoi attivarla dal menu Origine di un documento online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動プレビューを許可したサイトはまだありません。オンラインドキュメントの参照元メニューから有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 미리 보기를 허용한 사이트가 없습니다. 온라인 문서의 출처 메뉴에서 활성화할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada laman dibenarkan untuk pratonton automatik. Dayakannya dalam menu Sumber dokumen dalam talian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há sites autorizados para pré-visualização automática. Pode ativá-la no menu Origem de um documento online."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีเว็บไซต์ที่อนุญาตให้แสดงตัวอย่างอัตโนมัติ สามารถเปิดได้จากเมนูแหล่งที่มาของเอกสารออนไลน์"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trang web được phép tự động xem trước. Có thể bật trong menu Nguồn của tài liệu trực tuyến."
          }
        }
      }
    },
    "阅读外观已保存，下次打开文档时应用。": {
