      }
    },
    "仅对此次打开的文档生效。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only while this document is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅对此次打开的文档生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
