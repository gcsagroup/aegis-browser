    "此页面有登录风险信号，请核对网址和提交目的地。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面有登录风险信号，请核对网址和提交目的地。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page has login risk signals. Check the URL and submission destination."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面有登入風險訊號，請核對網址與提交目的地。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite zeigt Anmelderisiken. Bitte Adresse und Ziel der Übermittlung prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página muestra señales de riesgo al iniciar sesión. Comprueba la URL y el destino del envío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page présente des risques de connexion. Vérifiez l’URL et la destination de l’envoi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini menunjukkan risiko masuk. Periksa URL dan tujuan pengiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa pagina presenta segnali di rischio per l’accesso. Verifica l’URL e la destinazione dell’invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページにはログインのリスク兆候があります。URLと送信先を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에 로그인 위험 신호가 있습니다. URL과 제출 대상을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman ini menunjukkan risiko log masuk. Semak URL dan destinasi penghantaran."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página apresenta sinais de risco no início de sessão. Verifique o URL e o destino do envio."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้านี้มีสัญญาณความเสี่ยงในการเข้าสู่ระบบ โปรดตรวจสอบ URL และปลายทางที่ส่งข้อมูล"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang này có dấu hiệu rủi ro đăng nhập. Hãy kiểm tra URL và đích gửi dữ liệu."
          }
        }
      }
    },
