    "请输入不含账号或查询参数的 HTTPS 服务地址。本机测试可使用 localhost 或 127.0.0.1。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an HTTPS service URL without credentials or query parameters. Local tests can use localhost or 127.0.0.1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含账号或查询参数的 HTTPS 服务地址。本机测试可使用 localhost 或 127.0.0.1。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入不含賬號或查詢參數的 HTTPS 服務地址。本機測試可使用 localhost 或 127.0.0.1。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine HTTPS-Dienstadresse ohne Zugangsdaten oder Abfrageparameter ein. Für lokale Tests können Sie localhost oder 127.0.0.1 verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una URL de servicio HTTPS sin credenciales ni parámetros de consulta. Para pruebas locales puedes usar localhost o 127.0.0.1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une URL de service HTTPS sans identifiants ni paramètres de requête. Les tests locaux peuvent utiliser localhost ou 127.0.0.1."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan URL layanan HTTPS tanpa kredensial atau parameter kueri. Pengujian lokal dapat menggunakan localhost atau 127.0.0.1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un URL di servizio HTTPS senza credenziali o parametri di query. Per i test locali puoi usare localhost o 127.0.0.1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報やクエリパラメータを含まない HTTPS のサービス URL を入力してください。ローカルテストには localhost または 127.0.0.1 を使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 정보나 쿼리 매개변수가 없는 HTTPS 서비스 URL을 입력하세요. 로컬 테스트에는 localhost 또는 127.0.0.1을 사용할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan URL perkhidmatan HTTPS tanpa bukti kelayakan atau parameter pertanyaan. Ujian setempat boleh menggunakan localhost atau 127.0.0.1."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduza um URL de serviço HTTPS sem credenciais nem parâmetros de consulta. Os testes locais podem usar localhost ou 127.0.0.1."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดป้อน URL บริการ HTTPS ที่ไม่มีข้อมูลรับรองหรือพารามิเตอร์คำค้น การทดสอบในเครื่องใช้ localhost หรือ 127.0.0.1 ได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập URL dịch vụ HTTPS không có thông tin đăng nhập hoặc tham số truy vấn. Kiểm thử cục bộ có thể dùng localhost hoặc 127.0.0.1."
          }
        }
      }
    },
