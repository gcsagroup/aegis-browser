    "限制 Canvas、WebGL 和音频结果读取，可能影响绘图、游戏和音频。可在网站设置中恢复；Worker 等路径仍可能绕过。重新载入后生效。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制 Canvas、WebGL 和音频结果读取，可能影响绘图、游戏和音频。可在网站设置中恢复；Worker 等路径仍可能绕过。重新载入后生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
