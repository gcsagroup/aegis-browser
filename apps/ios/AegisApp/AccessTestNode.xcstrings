    "放弃更改": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃更改"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard Changes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄變更"
          }
        }
      }
    },
    "此版本无法编辑测试节点。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本无法编辑测试节点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test node editing is unavailable in this build."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本無法編輯測試節點。"
          }
        }
      }
    },
    "请输入一条 REALITY/Vision 或 WebSocket/TLS 的 VLESS 分享链接。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入一条 REALITY/Vision 或 WebSocket/TLS 的 VLESS 分享链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one VLESS share link using REALITY/Vision or WebSocket/TLS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入一條 REALITY/Vision 或 WebSocket/TLS 的 VLESS 分享連結。"
          }
        }
      }
    },
    "相机权限未开启，可继续输入节点链接。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限未开启，可继续输入节点链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is off. You can still enter a node link."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限未開啟，可繼續輸入節點連結。"
          }
        }
      }
    },
    "相机扫码暂不可用，可继续输入节点链接。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机扫码暂不可用，可继续输入节点链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera scanning is unavailable. You can still enter a node link."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機掃描暫時無法使用，可繼續輸入節點連結。"
          }
        }
      }
    },
    "另一窗口已保存。放弃更改后重新预览即可应用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一窗口已保存。放弃更改后重新预览即可应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another window saved changes. Discard your changes, then preview again to apply."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個視窗已儲存。捨棄變更後重新預覽即可套用。"
          }
        }
      }
    },
