    "节点已保存，网页连接暂不可用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点已保存，网页连接暂不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node saved. Web connection is currently unavailable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點已儲存，網頁連線暫時無法使用。"
          }
        }
      }
    },
