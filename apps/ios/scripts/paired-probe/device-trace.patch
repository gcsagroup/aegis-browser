+    func testDirectedDiagnosticsRetainOnlyCanonicalProbeDetails() throws {
+        let key = "AEGIS_DIRECTED_PROBE"
+        let original = ProcessInfo.processInfo.environment[key]
+        defer {
+            if let original { setenv(key, original, 1) }
+            else { unsetenv(key) }
+        }
+        let rows = [
+            "[Info] app/dispatcher: default route for tcp:route.example:443",
+            "[Warning] app/proxyman/outbound: connection refused relay-secret.example, no such host",
+            "[Error] proxy/vless/outbound: unexpected EOF https://relay-secret.example/item?private=query",
+            "[Info] app/dispatcher: default route for tcp:relay-secret.example:443"
+        ]
+        func capture(probeEnabled: Bool) throws -> [String] {
+            setenv(key, probeEnabled ? "1" : "0", 1)
+            let log = AccessDiagnosticLog(pollInterval: .milliseconds(15))
+            let capture = try XCTUnwrap(log.start(level: .info, secrets: ["relay-secret.example"]))
+            defer { log.stop() }
+            let writer = try FileHandle(forWritingTo: URL(fileURLWithPath: capture.path))
+            defer { try? writer.close() }
+            let input = rows.enumerated().map { index, row in "2026/11/11 00:00:0\(index) \(row)\n" }.joined()
+            try writer.write(contentsOf: Data(input.utf8))
+            let deadline = Date().addingTimeInterval(2)
+            var lines = log.snapshot().split(separator: "\n").map(String.init)
+            while lines.count < rows.count && Date() < deadline {
+                Thread.sleep(forTimeInterval: 0.01)
+                lines = log.snapshot().split(separator: "\n").map(String.init)
+            }
+            return lines
+        }
+        XCTAssertEqual(try capture(probeEnabled: true), [
+            "2026/11/11 00:00:00 [Info] default route for tcp:route.example:443",
+            "2026/11/11 00:00:01 [Warning] no such host | connection refused",
+            "2026/11/11 00:00:02 [Error] unexpected EOF",
+            "2026/11/11 00:00:03 [Info] default route for [redacted]"
+        ])
+        XCTAssertEqual(try capture(probeEnabled: false), [
+            "2026/11/11 00:00:00 [Info] details withheld",
+            "2026/11/11 00:00:01 [Warning] details withheld",
+            "2026/11/11 00:00:02 [Error] details withheld",
+            "2026/11/11 00:00:03 [Info] details withheld"
+        ])
+    }
