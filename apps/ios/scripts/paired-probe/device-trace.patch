+// Temporary, opt-in witness for the physical-device probe. Only sizes and
+// TLS record types leave this boundary, never stream bytes or credentials.
+private final class DirectedConnectTrace: @unchecked Sendable {
+    private let enabled = ProcessInfo.processInfo.environment["AEGIS_DIRECTED_PROBE"] == "1"
+    private let id = String(UUID().uuidString.prefix(8))
+    private let destination: String
+    private let sentUpstream = OSAllocatedUnfairLock(initialState: false)
+
+    init(host: String, port: UInt16) { destination = "\(host):\(port)" }
+
+    func uploaded(_ data: Data) {
+        let first = sentUpstream.withLock {
+            let first = !$0
+            $0 = true
+            return first
+        }
+        if first { emit("first-upstream", data: data) }
+    }
+
+    func failure(_ event: String, _ error: Error) {
+        let failure = error as NSError
+        emit(event + " domain=\(failure.domain) code=\(failure.code)")
+    }
+
+    func emit(_ event: String, data: Data? = nil) {
+        guard enabled else { return }
+        var metadata = ""
+        if let data, let first = data.first {
+            let header = data.prefix(2)
+            let type = (20...23).contains(first) && header.count == 2 && header.last == 3 ? Int(first) : 0
+            metadata = " bytes=\(data.count) tlsRecord=\(type)"
+        }
+        NSLog("AEGIS-DIRECTED-CONNECT %@ %@ %@%@", id, destination, event, metadata)
+    }
+}
