+// Temporary, opt-in witness for the physical-device probe. Only sizes and
+// TLS record types leave this boundary, never stream bytes or credentials.
+final class DirectedConnectTrace: @unchecked Sendable {
+    private let enabled = ProcessInfo.processInfo.environment["AEGIS_DIRECTED_PROBE"] == "1"
+    private let id = String(UUID().uuidString.prefix(8))
+    private let destination: String
+    private let sentUpstream = OSAllocatedUnfairLock(initialState: false)
+
+    init(host: String, port: UInt16) { destination = "\(Self.safeHost(host)):\(port)" }
+
+    static func nonConnectHost(in buffer: Data) -> String {
+        let prefix = buffer.prefix(1_024)
+        guard let boundary = prefix.range(of: Data([13, 10])),
+              let line = String(data: prefix[..<boundary.lowerBound], encoding: .utf8) else { return "unknown" }
+        let fields = line.split(separator: " ")
+        guard fields.count == 3,
+              let target = URLComponents(string: String(fields[1])),
+              let scheme = target.scheme?.lowercased(),
+              ["http", "https"].contains(scheme),
+              target.percentEncodedUser == nil, target.percentEncodedPassword == nil else { return "unknown" }
+        return safeHost(target.host)
+    }
+
+    static func safeHost(_ host: String?) -> String {
+        guard let host, host.utf8.count <= 253, !host.contains("%") else { return "unknown" }
+        let literal = host.hasPrefix("[") && host.hasSuffix("]") ? String(host.dropFirst().dropLast()) : host
+        if literal.utf8.allSatisfy({ byte in
+            (48...58).contains(byte) || (65...70).contains(byte) || (97...102).contains(byte) || byte == 46
+        }), IPv6Address(literal) != nil { return "[\(literal)]" }
+        let dns = host.hasSuffix(".") ? host.dropLast() : host[...]
+        let labels = dns.split(separator: ".", omittingEmptySubsequences: false)
+        guard !labels.isEmpty, labels.allSatisfy({ label in
+            (1...63).contains(label.utf8.count) && !label.hasPrefix("-") && !label.hasSuffix("-")
+                && label.utf8.allSatisfy { byte in
+                    (48...57).contains(byte) || (65...90).contains(byte) || (97...122).contains(byte) || byte == 45
+                }
+        }) else { return "unknown" }
+        return host
+    }
+
+    func uploaded(_ data: Data) {
+        let first = sentUpstream.withLock {
+            let first = !$0
+            $0 = true
+            return first
+        }
+        if first { emit("first-upstream", data: data) }
+    }
+
+    func failure(_ event: String, _ error: Error) {
+        let failure = error as NSError
+        emit(event + " domain=\(failure.domain) code=\(failure.code)")
+    }
+
+    func emit(_ event: String, data: Data? = nil) {
+        guard enabled else { return }
+        var metadata = ""
+        if let data, let first = data.first {
+            let header = data.prefix(2)
+            let type = (20...23).contains(first) && header.count == 2 && header.last == 3 ? Int(first) : 0
+            metadata = " bytes=\(data.count) tlsRecord=\(type)"
+        }
+        NSLog("AEGIS-DIRECTED-CONNECT %@ %@ %@%@", id, destination, event, metadata)
+    }
+}
