{
  "name": "gcsa-aegis",
  "version": "0.1.0",
  "private": true,
  "description": "GCSA-aegis: Chromium-fork privacy/security browser with local AI, phishing defense, and tracker blocking",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --filter @gcsa-aegis/core build",
    "ci:quality": "node ./scripts/ci/run-quality.mjs",
    "ci:test": "node --test ./scripts/ci/tests/*.test.mjs",
    "ci:validate-workflow": "node ./scripts/ci/validate-workflow.mjs .github/workflows/quality.yml && node ./scripts/ci/validate-promotion-workflow.mjs",
    "ci:check-public-diff": "node ./scripts/ci/check-public-diff.mjs",
    "quality:fast": "corepack pnpm run lint && corepack pnpm --filter @gcsa-aegis/core typecheck && corepack pnpm --filter @gcsa-aegis/core test && corepack pnpm --filter @gcsa-aegis/browser test:scripts && corepack pnpm --filter @gcsa-aegis/browser test:agent-ui && corepack pnpm --filter @gcsa-aegis/browser test:local-model && node ./scripts/check-repo-contracts.mjs && corepack pnpm --filter @gcsa-aegis/core build",
    "contracts:check": "node ./scripts/check-repo-contracts.mjs",
    "threat-feeds:compile": "pnpm --filter @gcsa-aegis/core compile-threat-feeds",
    "threat-feeds:install": "pnpm --filter @gcsa-aegis/browser install-threat-index",
    "script-risk:evaluate": "pnpm --filter @gcsa-aegis/core evaluate:script-risk",
    "script-risk:evaluate-gates": "pnpm --filter @gcsa-aegis/core evaluate:script-risk-gates",
    "script-risk:acquire-public-pilot": "pnpm --filter @gcsa-aegis/core acquire:script-risk-public-pilot",
    "script-risk:bridge-public-pilot": "pnpm --filter @gcsa-aegis/core bridge:script-risk-public-pilot",
    "script-risk:freeze-candidate": "pnpm --filter @gcsa-aegis/core freeze:script-risk-candidate",
    "script-risk:predict-blind": "pnpm --filter @gcsa-aegis/core predict:script-risk-blind",
    "script-risk:score-blind": "pnpm --filter @gcsa-aegis/core score:script-risk-blind",
    "browser:bootstrap": "pnpm --filter @gcsa-aegis/browser bootstrap",
    "browser:bootstrap:libtorrent": "pnpm --filter @gcsa-aegis/browser bootstrap:libtorrent",
    "browser:fetch": "pnpm --filter @gcsa-aegis/browser run fetch",
    "browser:apply-patches": "pnpm --filter @gcsa-aegis/browser apply-patches",
    "browser:build": "pnpm --filter @gcsa-aegis/browser build",
    "browser:build:release": "pnpm --filter @gcsa-aegis/browser build:release",
    "browser:run": "pnpm --filter @gcsa-aegis/browser run run",
    "browser:verify:cdp-runtime": "pnpm --filter @gcsa-aegis/browser verify:cdp-runtime",
    "browser:verify:agent-runtime": "pnpm --filter @gcsa-aegis/browser verify:agent-runtime",
    "browser:verify:download-runtime": "pnpm --filter @gcsa-aegis/browser verify:download-runtime",
    "browser:verify:bytecode-shadow-runtime": "pnpm --filter @gcsa-aegis/browser verify:bytecode-shadow-runtime",
    "browser:verify:bytecode-shadow-sites-runtime": "pnpm --filter @gcsa-aegis/browser verify:bytecode-shadow-sites-runtime",
    "browser:verify:fingerprint-runtime": "pnpm --filter @gcsa-aegis/browser verify:fingerprint-runtime",
    "browser:verify:miner-runtime": "pnpm --filter @gcsa-aegis/browser verify:miner-runtime",
    "browser:verify:multisite-runtime": "pnpm --filter @gcsa-aegis/browser verify:multisite-runtime",
    "browser:status": "pnpm --filter @gcsa-aegis/browser status",
    "test": "pnpm --filter @gcsa-aegis/core test",
    "lint": "eslint \"packages/core/src/**/*.ts\" \"scripts/ci/**/*.mjs\" --max-warnings 0",
    "typecheck": "pnpm --filter @gcsa-aegis/core typecheck",
    "quality:other-platforms": "corepack pnpm --filter @gcsa-aegis/browser test:android-target && corepack pnpm --filter @gcsa-aegis/browser test:android-ui && corepack pnpm --filter @gcsa-aegis/browser test:scripts:android && corepack pnpm --filter @gcsa-aegis/browser test:winrm-model-relay"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "c8": "12.0.0",
    "eslint": "9.39.3",
    "jsdom": "26.1.0",
    "typescript-eslint": "8.70.0",
    "yaml": "2.8.1"
  }
}
