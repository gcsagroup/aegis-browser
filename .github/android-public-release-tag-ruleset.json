{
  "name": "Android public release tags are immutable",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [
    {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
  ],
  "conditions": {
    "ref_name": {"include": ["refs/tags/android/*"], "exclude": []}
  },
  "rules": [{"type": "update"}, {"type": "deletion"}]
}
